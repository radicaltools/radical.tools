{
  "rules": {
    "metamodel": "error",
    "stale-reference": "error",
    "requirement-incomplete": "error",
    "requirement-unsatisfied": "error",
    "requirement-without-origin": "error",
    "need-without-requirement": "error",
    "scenario-verifies-nothing": "error",
    "adr-incomplete": "error",
    "adr-superseded-unlinked": "error",
    "fitness-fn-unlinked": "error",
    "fitness-fn-without-threshold": "error",
    "requirement-without-scenario": {
      "severity": "error",
      "max": 61
    },
    "adr-without-fitness-fn": {
      "severity": "error",
      "max": 2
    },
    "scenario-without-tests": {
      "severity": "error",
      "max": 9
    },
    "fitness-fn-without-tests": {
      "severity": "error",
      "max": 3
    },
    "test-unbound": {
      "severity": "warning",
      "include": [
        "apps/e2e/**"
      ],
      "exclude": [
        "**/known-issues.spec.ts"
      ]
    }
  }
}
