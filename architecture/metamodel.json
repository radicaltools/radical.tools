      "id": "adr",
      "label": "ADR",
      "properties": [
        {
          "default": "proposed",
          "key": "status",
          "label": "Status",
          "options": [
            "proposed",
            "accepted",
            "deprecated",
            "superseded"
          ],
          "type": "enum"
        },
        {
          "key": "date",
          "label": "Date",
          "type": "text"
        },
        {
          "key": "context",
          "label": "Context",
          "type": "textarea"
        },
        {
          "key": "decision",
          "label": "Decision",
          "type": "textarea"
        },
        {
          "key": "consequences",
          "label": "Consequences",
          "type": "textarea"
        },
        {
          "key": "alternatives",
          "label": "Alternatives considered",
          "type": "textarea"
        }
      ],
      "tableTab": true,
      "width": 180,
      "wizard": {
        "prefill": {
          "date": "{{today}}",
          "status": "proposed"
        },
        "steps": [
          {
            "fields": [
              "label",
              "status",
              "date"
            ],
            "help": "Name the decision in a few words, e.g. \"Use PostgreSQL for order storage\".",
            "kind": "fields",
            "title": "Title & status"
          },
          {
            "fields": [
              "context"
            ],
            "help": "What forces are at play — the problem, constraints and drivers that make a decision necessary now?",
            "kind": "fields",
            "title": "Context"
          },
          {
            "fields": [
              "decision"
            ],
            "help": "What did you decide? State it actively: \"We will …\".",
            "kind": "fields",
            "title": "Decision"
          },
          {
            "fields": [
              "alternatives"
            ],
            "help": "Which other options did you consider, and why were they rejected?",
            "kind": "fields",
            "title": "Alternatives"
          },
          {
            "fields": [
              "consequences"
            ],
            "help": "What becomes easier or harder? Include the downsides and the risks you accept.",
            "kind": "fields",
            "title": "Consequences"
          },
          {
            "direction": "out",
            "help": "Which parts of the architecture must follow this decision?",
            "kind": "relations",
            "relationType": "constrains",
            "title": "Affected elements"
          },
          {
            "direction": "out",
            "help": "Does this decision replace an earlier one? Leave empty if not.",
            "kind": "relations",
            "relationType": "supersedes",
            "title": "Supersedes"
          }
        ],
        "trigger": "create"
      }
    },
