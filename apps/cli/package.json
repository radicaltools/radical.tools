{
  "name": "@radicaltools/cli",
  "version": "0.2.0",
  "description": "Check, diff and export Radical Markdown architecture models from the command line.",
  "license": "MIT",
  "homepage": "https://radical.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radicaltools/radical.tools.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/radicaltools/radical.tools/issues",
  "keywords": ["cli", "architecture", "c4", "radical", "model-validation"],
  "type": "module",
  "bin": {
    "radical": "dist/index.js"
  },
  "files": ["dist", "LICENSE"],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:package"
  },
  "devDependencies": {
    "@radical/common": "*",
    "@radical/node-files": "*",
    "@types/node": "^22.20.4",
    "markdown-to-jsx": "^9.10.3",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
