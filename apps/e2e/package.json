{
  "name": "@radical/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end regression suite (Playwright) for the web builds of Studio and Hub.",
  "type": "module",
  "scripts": {
    "pree2e": "npm run build -w @radical/mcp",
    "e2e": "playwright test",
    "pree2e:ui": "npm run build -w @radical/mcp",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@modelcontextprotocol/client": "2.2.0",
    "@radical/common": "*",
    "@radical/hub": "*",
    "@radical/node-files": "*",
    "@types/node": "^20.19.39",
    "radical-model": "*",
    "typescript": "^5.3.3"
  }
}
