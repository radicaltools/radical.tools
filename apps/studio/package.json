{
  "name": "radical-model",
  "version": "1.0.0",
  "description": "C4 Architecture Diagram Tool",
  "author": "radical.tools contributors",
  "license": "MIT",
  "homepage": "https://radical.tools",
  "main": "out/main/index.js",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^2.0.1",
    "d3-dispatch": "^3.0.1",
    "d3-drag": "^3.0.0",
    "d3-timer": "^3.0.1",
    "html-to-image": "^1.11.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.11.4",
    "webcola": "^3.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@radical/common": "*",
    "@radical/host-bridge": "*",
    "@radical/hub-catalogue": "*",
    "@radical/ui": "*",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "29.4.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.0.0",
    "elkjs": "^0.9.3",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^4.1.4"
  },
  "private": true
}
