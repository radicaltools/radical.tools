{
  "hub": {
    "id": "adr-zero-trust-network",
    "category": "adr",
    "name": "Network Trust Model",
    "description": "Records whether the system trusts requests based on network location (perimeter/VPN model) or verifies every request's identity and context regardless of where it originates (zero trust).",
    "tags": [
      "security",
      "zero-trust",
      "network",
      "nist",
      "governance"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
