{
  "hub": {
    "id": "ff-latency-slo",
    "category": "fitness-function",
    "name": "Latency SLO Guard",
    "description": "Continuously compares tail latency against the SLO and fails the check when the budget is breached. The verification side of an API response-time requirement.",
    "tags": [
      "operational",
      "performance",
      "slo",
      "latency"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "LATENCY_PERCENTILE",
        "label": "Percentile",
        "hint": "p95",
        "defaultValue": "p95"
      },
      {
        "key": "LATENCY_THRESHOLD_MS",
        "label": "Threshold (ms)",
        "hint": "300",
        "type": "number",
        "defaultValue": "300"
      },
      {
        "key": "EVAL_WINDOW_MINUTES",
        "label": "Evaluation window (min)",
        "hint": "5",
        "type": "number",
        "defaultValue": "5"
      }
    ],
    "hubRefs": [
      "req-api-response-time",
      "ff-error-budget",
      "pattern-bulkhead"
    ]
  },
  "nodes": [
    {
      "id": "ff-latency-slo-1",
      "type": "fitness-fn",
      "label": "Latency SLO Guard",
      "description": "Queries the metrics backend for {{LATENCY_PERCENTILE}} request latency over a rolling {{EVAL_WINDOW_MINUTES}}-minute window, per endpoint group. Runs as a recording rule in production and as a synthetic load check in the pre-production gate.",
      "x": 0,
      "y": 0,
      "width": 180,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "continuous",
      "threshold": "{{LATENCY_PERCENTILE}} latency ≤ {{LATENCY_THRESHOLD_MS}} ms over every {{EVAL_WINDOW_MINUTES}}-minute window",
      "status": "proposed"
    }
  ],
