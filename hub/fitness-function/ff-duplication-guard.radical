{
  "hub": {
    "id": "ff-duplication-guard",
    "category": "fitness-function",
    "name": "Duplication Guard",
    "description": "Limits how much of the codebase is near-duplicate logic. High duplication is the earliest structural signal that a shared abstraction is missing, and it multiplies the cost of every future bug fix by however many copies exist.",
    "tags": [
      "structural",
      "duplication",
      "code-quality",
      "reusability"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
