        "key": "MAX_DUPLICATION_PCT",
        "label": "Max duplicated lines (%)",
        "hint": "3",
        "type": "number",
        "defaultValue": "3"
      }
    ],
    "hubRefs": [
      "ff-coupling-guard",
      "ff-dependency-rules",
      "req-code-complexity"
    ]
  },
