        "key": "MAX_FAN_OUT",
        "label": "Max outgoing dependencies per module",
        "hint": "6",
        "type": "number",
        "defaultValue": "6"
      }
    ],
    "hubRefs": [
      "ff-dependency-rules",
      "pattern-hexagonal",
