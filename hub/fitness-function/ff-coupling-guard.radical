      "id": "ff-coupling-guard-1",
      "type": "fitness-fn",
      "label": "Coupling Guard",
      "description": "Builds the dependency graph from source (imports/packages) and from deployment manifests (service-to-service calls), then reports efferent coupling per module. New violations fail the build; existing ones are tracked as a debt trend.",
      "x": 0,
      "y": 0,
      "width": 180,
      "height": 52,
      "collapsed": false,
      "category": "structural",
      "automated": true,
      "trigger": "on-deploy",
      "threshold": "Efferent coupling ≤ {{MAX_FAN_OUT}} for every module and service",
      "status": "proposed"
    }
  ],
