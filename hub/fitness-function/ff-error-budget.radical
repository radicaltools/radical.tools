{
  "hub": {
    "id": "ff-error-budget",
    "category": "fitness-function",
    "name": "Error Budget Burn Rate",
    "description": "Tracks how fast an SLO's error budget is being consumed and freezes risky releases when it burns too fast. The core SRE feedback loop between reliability and delivery speed.",
    "tags": [
      "operational",
      "sre",
      "slo",
      "reliability"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "FAST_BURN_RATE",
        "label": "Fast-burn alert multiplier (1 h window)",
        "hint": "14.4",
        "type": "number",
        "defaultValue": "14.4"
      },
      {
        "key": "SLOW_BURN_RATE",
        "label": "Slow-burn alert multiplier (6 h window)",
        "hint": "6",
        "type": "number",
        "defaultValue": "6"
      },
      {
        "key": "FREEZE_REMAINING_PCT",
        "label": "Freeze releases below remaining budget (%)",
        "hint": "20",
        "type": "number",
        "defaultValue": "20"
      }
    ],
    "hubRefs": [
      "req-availability",
      "req-error-rate",
      "req-alerting"
    ]
  },
  "nodes": [
    {
      "id": "ff-error-budget-1",
      "type": "fitness-fn",
      "label": "Error Budget Burn Rate",
      "description": "Computes burn rate = (observed error ratio) / (1 − SLO) over two windows. A fast burn of {{FAST_BURN_RATE}}× over 1 h pages immediately; a slow burn of {{SLOW_BURN_RATE}}× over 6 h opens a ticket. Remaining budget for the 30-day window gates the release pipeline.",
      "x": 0,
      "y": 0,
      "width": 180,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "threshold": "Burn rate < {{FAST_BURN_RATE}}× (1 h) and < {{SLOW_BURN_RATE}}× (6 h); releases blocked when remaining 30-day budget < {{FREEZE_REMAINING_PCT}}%"
    }
  ],
  "relations": []
}
