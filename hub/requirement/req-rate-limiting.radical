{
  "hub": {
    "id": "req-rate-limiting",
    "category": "requirement",
    "name": "API Rate Limiting",
    "description": "Per-client request quotas that protect shared capacity from abusive or runaway clients.",
    "tags": [
      "security",
      "api",
      "resilience"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "RATE_LIMIT_RPM",
        "label": "Requests per minute per client",
        "hint": "600",
        "type": "number",
        "defaultValue": "600"
      }
    ],
    "hubRefs": [
      "pattern-api-gateway",
      "pattern-rate-limiter"
    ]
  },
  "nodes": [
    {
      "id": "req-rate-limiting-1",
      "type": "requirement",
      "label": "API Rate Limiting",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "trigger": "a client exceeds {{RATE_LIMIT_RPM}} requests per minute",
      "action": "reject the excess requests with HTTP 429, include a Retry-After header and the remaining quota, and record the event for abuse monitoring",
      "rationale": "One misconfigured integration can consume the capacity of every other tenant; explicit quotas make fair use enforceable and give clients a predictable contract."
    }
  ],
  "relations": []
}
