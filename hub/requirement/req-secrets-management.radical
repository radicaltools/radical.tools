{
  "hub": {
    "id": "req-secrets-management",
    "category": "requirement",
    "name": "Secrets Management",
    "description": "Credentials, keys and tokens live only in a managed secret store and are rotated on a schedule.",
    "tags": [
      "security",
      "secrets",
      "devops"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "SECRET_ROTATION_DAYS",
        "label": "Maximum secret age (days)",
        "hint": "90",
        "type": "number",
        "defaultValue": "90"
      }
    ],
    "hubRefs": [
      "req-least-privilege",
      "req-iac",
      "ff-sast-scan"
    ]
  },
  "nodes": [
    {
      "id": "req-secrets-management-1",
      "type": "requirement",
      "label": "Secrets Management",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "store all credentials, API keys and certificates in a managed secret store, inject them at runtime rather than in source or images, and rotate each secret at least every {{SECRET_ROTATION_DAYS}} days",
      "rationale": "Secrets committed to repositories or baked into images cannot be revoked without a redeploy and tend to leak through logs and forks; a store with rotation makes exposure short-lived."
    }
  ],
  "relations": []
}
