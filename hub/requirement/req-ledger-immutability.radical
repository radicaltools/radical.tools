{
  "hub": {
    "id": "req-ledger-immutability",
    "category": "requirement",
    "name": "Immutable Ledger Entries",
    "description": "Once posted, a journal entry is never updated or deleted — corrections happen only through a new, linked compensating entry.",
    "tags": [
      "fintech",
      "ledger",
      "compliance",
      "audit",
      "correctness"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "hubRefs": [
