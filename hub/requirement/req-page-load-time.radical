{
  "hub": {
    "id": "req-page-load-time",
    "category": "requirement",
    "name": "Page Load Performance",
    "description": "Core Web Vitals targets for user-facing pages: how quickly the main content renders and how responsive the page is to input.",
    "tags": [
      "performance",
      "web",
      "core-web-vitals",
      "ux"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "LCP_SECONDS",
        "label": "Largest Contentful Paint (s)",
        "hint": "2.5",
        "type": "number",
        "defaultValue": "2.5"
      },
      {
        "key": "INP_MS",
        "label": "Interaction to Next Paint (ms)",
        "hint": "200",
        "type": "number",
        "defaultValue": "200"
      },
      {
        "key": "USER_PCT",
        "label": "Share of page views meeting the target (%)",
        "hint": "75",
        "type": "number",
        "defaultValue": "75"
      }
    ],
    "hubRefs": [
      "ff-web-vitals",
      "pattern-bff"
    ]
  },
  "nodes": [
    {
      "id": "req-page-load-time-1",
      "type": "requirement",
      "label": "Page Load Performance",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "state-driven",
      "precondition": "a user loads a page on a typical mid-range device and network connection",
      "action": "reach Largest Contentful Paint within {{LCP_SECONDS}} s and keep Interaction to Next Paint under {{INP_MS}} ms for at least {{USER_PCT}}% of real-user page views",
      "rationale": "Core Web Vitals are the industry-standard, field-measurable definition of perceived load speed and responsiveness, and they influence search ranking."
    }
