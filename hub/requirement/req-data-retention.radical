      "id": "req-data-retention-1",
      "type": "requirement",
      "label": "Data Retention Limit",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "trigger": "a record passes {{RETENTION_DAYS}} days since its last business use",
      "action": "move the record to cold storage or delete it according to its data classification, and log the disposal in the audit trail",
      "rationale": "Storage minimisation is both a legal obligation under GDPR and a practical one: data you no longer hold cannot be breached, subpoenaed or slow your queries down."
    }
