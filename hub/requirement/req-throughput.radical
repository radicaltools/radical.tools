      "performance",
      "throughput",
      "capacity"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "MIN_TPS",
        "label": "Sustained transactions per second",
        "hint": "1000",
        "type": "number",
        "defaultValue": "1000"
      },
      {
        "key": "PEAK_DURATION_MINUTES",
        "label": "Peak duration to sustain (minutes)",
        "hint": "30",
        "type": "number",
        "defaultValue": "30"
      }
    ],
    "hubRefs": [
      "req-api-response-time",
      "req-autoscaling"
    ]
  },
  "nodes": [
    {
      "id": "req-throughput-1",
      "type": "requirement",
      "label": "Peak Throughput",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "sustain at least {{MIN_TPS}} transactions per second for {{PEAK_DURATION_MINUTES}} minutes while continuing to meet all response-time requirements",
      "rationale": "Latency targets are meaningless without a stated load; fixing the peak rate makes capacity planning and load testing concrete."
    }
