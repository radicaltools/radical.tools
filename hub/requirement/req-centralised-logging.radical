{
  "hub": {
    "id": "req-centralised-logging",
    "category": "requirement",
    "name": "Structured Centralised Logging",
    "description": "All services emit structured logs with correlation identifiers into one queryable store.",
    "tags": [
      "observability",
      "logging",
      "operations"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "LOG_RETENTION_DAYS",
        "label": "Log retention (days)",
        "hint": "30",
        "type": "number",
        "defaultValue": "30"
      }
    ],
    "hubRefs": [
      "adr-observability",
      "req-distributed-tracing",
      "req-audit-logging"
    ]
  },
  "nodes": [
    {
      "id": "req-centralised-logging-1",
      "type": "requirement",
      "label": "Structured Centralised Logging",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "action": "emit logs as structured JSON with timestamp, severity, service, version and trace/correlation identifiers, shipped to a central store that is searchable for at least {{LOG_RETENTION_DAYS}} days",
      "rationale": "Diagnosing a cross-service incident requires joining logs by correlation id in one place; logs scattered across hosts in free text cannot be queried under time pressure."
    }
  ],
  "relations": []
