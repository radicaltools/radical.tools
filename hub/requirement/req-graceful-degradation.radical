  "hub": {
    "id": "req-graceful-degradation",
    "category": "requirement",
    "name": "Graceful Degradation",
    "description": "Core functionality keeps working when a non-critical dependency fails, instead of the whole page or request failing.",
    "tags": [
      "availability",
      "resilience",
      "fault-tolerance"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "hubRefs": [
      "pattern-circuit-breaker",
      "adr-integration-style",
      "req-error-recovery",
      "pattern-bulkhead"
