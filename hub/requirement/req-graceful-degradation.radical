  },
  "nodes": [
    {
      "id": "req-graceful-degradation-1",
      "type": "requirement",
      "label": "Graceful Degradation",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "should",
      "trigger": "a non-critical downstream service or third-party dependency becomes unavailable or exceeds its timeout",
      "action": "continue serving the core workflow using cached data, defaults or a reduced feature set, and show a clear status notice instead of an error",
      "rationale": "In a distributed system partial failure is the normal state; without explicit fallbacks every optional dependency becomes a single point of failure for the whole product."
    }
  ],
  "relations": []
}
