  "nodes": [
    {
      "id": "req-encryption-1",
      "type": "requirement",
      "label": "Encryption at Rest and in Transit",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "action": "encrypt personal and confidential data at rest with {{ENCRYPTION_ALGORITHM}} using managed keys, and encrypt all network traffic with {{MIN_TLS_VERSION}} or higher, refusing plaintext connections",
      "rationale": "Encryption is the baseline control expected by GDPR, PCI DSS and HIPAA alike, and it turns a lost disk, backup or network capture from a breach into a non-incident."
