{
  "hub": {
    "id": "req-mfa",
    "category": "requirement",
    "name": "Multi-Factor Authentication",
    "description": "A second factor is required for privileged access and high-risk operations.",
    "tags": [
      "security",
      "authentication",
      "access-control"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "hubRefs": [
