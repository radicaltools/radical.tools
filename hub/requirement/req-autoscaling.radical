{
  "hub": {
    "id": "req-autoscaling",
    "category": "requirement",
    "name": "Automatic Scale-Out",
    "description": "Horizontal scaling that reacts to load without operator intervention, bounded by a cost ceiling.",
    "tags": [
      "scalability",
      "elasticity",
      "cloud"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "SCALE_TRIGGER_CPU_PCT",
        "label": "Scale-out trigger (avg CPU %)",
        "hint": "60",
        "type": "number",
        "defaultValue": "60"
      },
      {
        "key": "SCALE_OUT_SECONDS",
        "label": "Time to add capacity (s)",
        "hint": "120",
        "type": "number",
        "defaultValue": "120"
      },
      {
        "key": "MAX_INSTANCES",
        "label": "Maximum instance count",
        "hint": "20",
        "type": "number",
        "defaultValue": "20"
      }
    ],
    "hubRefs": [
      "req-resource-headroom",
      "req-throughput",
      "req-resource-isolation",
      "ff-scale-out-verification",
      "req-fast-startup-graceful-shutdown"
    ]
  },
  "nodes": [
    {
      "id": "req-autoscaling-1",
      "type": "requirement",
      "label": "Automatic Scale-Out",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "complex",
      "status": "draft",
      "priority": "must",
      "trigger": "average CPU utilisation exceeds {{SCALE_TRIGGER_CPU_PCT}}% for two consecutive minutes",
      "precondition": "fewer than {{MAX_INSTANCES}} instances are running",
      "action": "add compute instances so that new capacity is serving traffic within {{SCALE_OUT_SECONDS}} seconds, and scale back in when load subsides",
      "rationale": "Manual scaling is too slow for traffic spikes and too expensive to leave permanently provisioned; an upper bound keeps a misbehaving client from turning into an unbounded bill."
    }
  ],
  "relations": []
}
