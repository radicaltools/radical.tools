{
  "hub": {
    "id": "bp-fintech-ledger-platform",
    "category": "blueprint",
    "name": "Fintech Ledger & Payments Platform",
    "description": "A regulated money-movement backend: every financial fact is posted as an immutable, balanced double-entry journal entry; account balances are projections rebuilt from the journal; continuous plus nightly-batch reconciliation against the banking rail catches drift before it ever reaches a customer statement.",
    "tags": [
      "fintech",
      "ledger",
      "payments",
      "compliance",
      "reconciliation"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "RECONCILIATION_LAG_MIN",
        "label": "Reconciliation freshness (minutes)",
        "hint": "15",
        "type": "number",
        "defaultValue": "15"
      },
      {
        "key": "STATEMENT_GENERATION_HOURS",
        "label": "Statement generation SLA (hours)",
        "hint": "24",
        "type": "number",
        "defaultValue": "24"
      },
      {
        "key": "DISPUTE_INVESTIGATION_DAYS",
        "label": "Dispute investigation SLA (days)",
        "hint": "10",
        "type": "number",
        "defaultValue": "10"
      },
      {
        "key": "MAX_ADJUSTMENT_RATE_PCT",
        "label": "Max monthly compensating-entry rate (%)",
        "hint": "0.1",
        "type": "number",
        "defaultValue": "0.1"
      }
    ],
    "hubRefs": [
      "pattern-event-sourced-ledger",
      "adr-ledger-reconciliation-strategy",
      "req-ledger-immutability",
      "ff-ledger-balance-integrity",
      "req-audit-logging",
      "req-encryption",
      "req-disaster-recovery",
      "adr-data-consistency-model"
    ]
  },
