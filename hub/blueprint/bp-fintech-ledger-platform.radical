  "sequences": [
    {
      "id": "bp-fintech-ledger-platform-seq",
      "name": "Settlement arrives, posts, and reconciles",
      "relationIds": [
        "bank-rail--settlement-events",
        "settlement-events--posting-api",
        "posting-api--journal-store",
        "balance-projector--journal-store",
        "balance-projector--balance-store",
        "reconciliation-worker--journal-store",
        "reconciliation-worker--bank-rail"
      ],
      "stepDescriptions": [
        "Bank / payment rail delivers a settlement webhook.",
        "Settlement event triggers posting of the now-confirmed transaction.",
        "Posting API checks the entry balances and appends it to the journal.",
        "Balance projector picks up the new entry from its subscription to the journal.",
        "Balance projector updates the affected accounts' balance — the customer sees the new balance immediately.",
        "Reconciliation worker independently reads posted entries from the journal.",
        "Reconciliation worker also fetches the bank's own end-of-day statement in a nightly batch and matches it against what was posted, catching anything the event stream alone would have missed."
      ]
    }
  ],
