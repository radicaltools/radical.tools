    {
      "id": "mockup-reconciliation-exceptions",
      "type": "mockup",
      "label": "Reconciliation Exceptions",
      "description": "Finance Ops queue of settlement events not matched within {{RECONCILIATION_LAG_MIN}} minutes. Corrections are compensating entries that must balance before they can be submitted — the journal itself is never edited.",
      "x": 640,
      "y": 2084,
      "width": 220,
      "height": 190,
