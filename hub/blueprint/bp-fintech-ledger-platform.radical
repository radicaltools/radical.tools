    {
      "id": "req-balanced-entry-enforcement",
      "type": "requirement",
      "label": "Balanced Entry Enforcement",
      "x": 0,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "unwanted-behaviour",
      "status": "draft",
      "priority": "must",
      "unwanted_condition": "a journal entry's debits and credits do not sum to zero",
      "action": "reject the entry at the posting API and never persist it to the journal",
      "rationale": "An unbalanced entry that reaches the journal is no longer a bug that can be fixed — it's a permanent, immutable fact the books now have to carry."
    },
    {
      "id": "req-reconciliation-freshness",
      "type": "requirement",
      "label": "Reconciliation Freshness",
      "x": 320,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "match at least 99.5% of settlement events against journal entries within {{RECONCILIATION_LAG_MIN}} minutes of receipt",
      "rationale": "The faster a mismatch surfaces, the more context — logs, the originating request, the person who can explain it — is still around to resolve it.",
      "templateParams": [
        {
          "key": "RECONCILIATION_LAG_MIN",
          "label": "Reconciliation freshness (minutes)",
          "hint": "15",
          "type": "number",
          "defaultValue": "15"
        }
      ]
    },
    {
      "id": "req-statement-accuracy-cutoff",
      "type": "requirement",
      "label": "Statement Accuracy Cutoff",
      "x": 640,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "generate each customer's statement strictly from balances as replayed through a fixed cutoff timestamp, delivered within {{STATEMENT_GENERATION_HOURS}} hours of period close",
      "rationale": "A statement that mixes balances from different points in time is not wrong by a little — it's internally inconsistent, and inconsistency is what erodes trust in a financial record fastest.",
      "templateParams": [
        {
          "key": "STATEMENT_GENERATION_HOURS",
          "label": "Statement generation SLA (hours)",
          "hint": "24",
          "type": "number",
          "defaultValue": "24"
        }
      ]
    },
    {
      "id": "req-dispute-investigation-sla",
      "type": "requirement",
      "label": "Dispute Investigation SLA",
      "x": 960,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "a customer disputes a transaction on their statement",
      "action": "open an investigation and provide a resolution or explanation within {{DISPUTE_INVESTIGATION_DAYS}} days",
      "rationale": "An open-ended dispute process is indistinguishable from an ignored one, both to the customer and to a regulator asking to see the process.",
      "templateParams": [
        {
          "key": "DISPUTE_INVESTIGATION_DAYS",
          "label": "Dispute investigation SLA (days)",
          "hint": "10",
          "type": "number",
          "defaultValue": "10"
        }
      ]
    },
    {
      "id": "ff-settlement-backlog-guard",
      "type": "fitness-fn",
      "label": "Settlement Backlog Guard",
      "description": "Watches how many inbound settlement events are waiting to be matched, and for how long.",
      "x": 0,
