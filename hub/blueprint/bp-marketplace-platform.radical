      "description": "Sends order, dispute and payout emails/SMS to buyers and sellers.",
      "width": 360,
      "height": 260,
      "collapsed": false,
      "x": 420,
      "y": 1160
    },
    {
      "id": "req-listing-moderation",
      "type": "requirement",
      "label": "Listing Moderation SLA",
      "x": 0,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "a seller publishes a new listing",
      "action": "review it against marketplace policy and either approve it for search or reject it with a reason within {{LISTING_REVIEW_SLA_HOURS}} hours",
      "rationale": "Every hour a policy-violating listing is live is an hour a buyer can be harmed by it; every hour a compliant listing waits in review is lost seller revenue — the SLA is the deliberate trade-off between the two.",
      "templateParams": [
        {
          "key": "LISTING_REVIEW_SLA_HOURS",
          "label": "Listing moderation SLA (hours)",
          "hint": "24",
          "type": "number",
          "defaultValue": "24"
        }
      ]
    },
    {
      "id": "req-commission-accuracy",
      "type": "requirement",
      "label": "Commission Deduction Accuracy",
      "x": 320,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "deduct exactly {{COMMISSION_PCT}}% commission from each payout and record the split so buyer, seller and platform amounts always sum to the original order total",
      "rationale": "A marketplace's entire revenue model is this deduction; a rounding or double-deduction bug here is a direct, compounding revenue or trust defect, not a cosmetic one.",
      "templateParams": [
        {
          "key": "COMMISSION_PCT",
          "label": "Platform commission (%)",
          "hint": "15",
          "type": "number",
          "defaultValue": "15"
        }
      ]
    },
    {
      "id": "req-dispute-window-hold",
      "type": "requirement",
      "label": "Dispute Window Hold",
      "x": 640,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "hold seller funds for {{DISPUTE_WINDOW_DAYS}} days after delivery before releasing payout, and freeze the hold if a buyer opens a dispute inside that window",
      "rationale": "Paying a seller out before the window closes means a valid chargeback has to be clawed back after the fact instead of simply withheld — clawbacks fail far more often than holds.",
      "templateParams": [
        {
          "key": "DISPUTE_WINDOW_DAYS",
          "label": "Buyer dispute window (days)",
          "hint": "7",
          "type": "number",
          "defaultValue": "7"
        }
      ]
    },
    {
      "id": "req-delisting-suppression",
      "type": "requirement",
      "label": "Delisted Item Suppression",
      "x": 960,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "a listing is removed or a seller is suspended",
      "action": "remove it from search results within {{SUPPRESSION_MINUTES}} minutes, before any further orders can be placed against it",
      "rationale": "A moderation decision that still lets buyers find and order the suspended listing for the next hour didn't actually happen from the buyer's point of view.",
      "templateParams": [
        {
          "key": "SUPPRESSION_MINUTES",
          "label": "Delisting suppression time (min)",
          "hint": "5",
          "type": "number",
          "defaultValue": "5"
        }
      ]
    },
    {
      "id": "ff-payout-reconciliation-guard",
      "type": "fitness-fn",
      "label": "Payout Reconciliation Guard",
      "description": "Checks every released payout against its order's total, commission and any open holds.",
      "x": 0,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "periodic",
      "threshold": "0 payouts released that don't net to (order total minus commission minus open holds), checked every settlement cycle",
      "status": "proposed"
    },
    {
      "id": "ff-chargeback-rate-guard",
      "type": "fitness-fn",
      "label": "Chargeback Rate Guard",
      "description": "Tracks chargebacks as a share of settled orders — a rising rate signals a fraud or listing-quality problem before the payment network penalises the platform for it.",
      "x": 320,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "continuous",
      "threshold": "Chargeback rate stays below 1% of settled orders, trailing 30 days",
      "status": "proposed"
    },
    {
      "id": "ff-search-relevance-guard",
      "type": "fitness-fn",
      "label": "Search Relevance Guard",
      "description": "Compares click-through on top search results before and after a ranking change.",
      "x": 640,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "holistic",
      "automated": true,
      "trigger": "periodic",
      "threshold": "Click-through rate on top-3 search results does not regress more than 5 pp versus the trailing 30-day baseline after a ranking change",
      "status": "proposed"
    },
    {
      "id": "adr-centralised-search-index",
      "type": "adr",
      "label": "ADR: Centralised search index over per-category services",
      "x": 0,
      "y": 1912,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "status": "accepted",
      "date": "",
      "context": "Buyers need to search and filter listings across every seller category in one query, and ranking quality needs to be tuned consistently.",
      "decision": "Feed a single shared search index from listing-change events rather than letting each category team own its own search stack.",
      "consequences": "Ranking and relevance tuning happen in one place and buyers can search across categories in a single call, at the cost of coupling every listing-producing service to one shared event schema.",
      "alternatives": "1. Per-category search services — team autonomy, but inconsistent ranking logic and no single cross-category search call. 2. Database-native full-text search — simplest to add, but ranking quality and scale are limited. 3. Centralised search index (chosen). 4. Third-party search-as-a-service — fast to start, but less control over ranking and cost at high listing volume."
    },
    {
      "id": "adr-suspend-first-moderation",
      "type": "adr",
      "label": "ADR: Suspend-first moderation for policy violations",
      "x": 320,
      "y": 1912,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "status": "accepted",
      "date": "",
      "context": "A high-confidence fraud or policy-violation signal has to be weighed against a seller's due process — acting immediately protects buyers fastest, but a false positive costs a legitimate seller sales and payout access during the investigation.",
      "decision": "Suspend first on a high-confidence signal — hide from search, freeze payouts — then investigate and either reinstate or ban, rather than investigating first and acting after.",
      "consequences": "Buyers are protected as fast as the platform can detect a problem; the investigation SLA becomes a trust-critical metric in its own right, since it's now the only thing standing between a wrongly-flagged seller and lost income.",
      "alternatives": "1. Investigate first, act after — protects sellers from false positives, but a genuine bad actor keeps selling and collecting funds during the investigation window. 2. Suspend first, investigate after (chosen). 3. Community reporting only, no proactive detection — cheapest, but slowest and worst for buyer trust. 4. Permanent ban on first signal, no reinstatement path — fastest, but the harshest possible cost of a false positive."
    },
