\"7.5\" fill=\"#666\" text-anchor=\"end\">OakHaus</text>\n  <rect x=\"264\" y=\"192\" width=\"116\" height=\"66\" rx=\"3\" fill=\"#eee\" stroke=\"#ccc\"/>\n  <line x1=\"264\" y1=\"192\" x2=\"380\" y2=\"258\" stroke=\"#ccc\"/>\n  <line x1=\"380\" y1=\"192\" x2=\"264\" y2=\"258\" stroke=\"#ccc\"/>\n  <rect x=\"264\" y=\"264\" width=\"100\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <text x=\"264\" y=\"282\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\">€310</text>\n  <text x=\"380\" y=\"282\" font-size=\"7.5\" fill=\"#666\" text-anchor=\"end\">retro.de</text>\n</svg>"
