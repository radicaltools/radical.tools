    {
      "id": "mockup-order-dispute",
      "type": "mockup",
      "label": "Order & Buyer Protection",
      "description": "Buyer view of an order: funds stay held for {{DISPUTE_WINDOW_DAYS}} days after delivery, and opening a dispute freezes the payout.",
      "x": 640,
      "y": 2084,
      "width": 220,
      "height": 190,
      "collapsed": false,
      "screen": "/orders/:id",
      "wireframe": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\">\n  <rect width=\"400\" height=\"300\" fill=\"#fff\"/>\n  <rect x=\"0\" y=\"0\" width=\"400\" height=\"30\" fill=\"#f3f4f6\" stroke=\"#333\"/>\n  <rect x=\"10\" y=\"8\" width=\"14\" height=\"14\" rx=\"3\" fill=\"#ccc\"/>\n  <text x=\"30\" y=\"20\" font-size=\"11\" fill=\"#333\" font-weight=\"bold\">Marketplace</text>\n  <text x=\"388\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Account</text>\n  <text x=\"337\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Orders</text>\n  <text x=\"291\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Search</text>\n  <text x=\"16\" y=\"54\" font-size=\"13\" fill=\"#333\" font-weight=\"bold\">Order #58213</text>\n  <text x=\"16\" y=\"70\" font-size=\"8\" fill=\"#666\">Sold by VintageCo · delivered 2 Apr</text>\n  <rect x=\"16\" y=\"80\" width=\"60\" height=\"60\" rx=\"3\" fill=\"#eee\" stroke=\"#ccc\"/>\n  <line x1=\"16\" y1=\"80\" x2=\"76\" y2=\"140\" stroke=\"#ccc\"/>\n  <line x1=\"76\" y1=\"80\" x2=\"16\" y2=\"140\" stroke=\"#ccc\"/>\n  <rect x=\"88\" y=\"88\" width=\"180\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"88\" y=\"98\" width=\"108\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <text x=\"384\" y=\"96\" font-size=\"10\" fill=\"#333\" font-weight=\"bold\" text-anchor=\"end\">€180.00</text>\n  <text x=\"16\" y=\"162\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\">Where your money is</text>\n  <rect x=\"16\" y=\"170\" width=\"39\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"35.5\" y=\"180\" font-size=\"8\" fill=\"#333\" text-anchor=\"middle\">Paid ✓</text>\n  <rect x=\"61\" y=\"170\" width=\"62\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"92.0\" y=\"180\" font-size=\"8\" fill=\"#333\" text-anchor=\"middle\">Delivered ✓</text>\n  <rect x=\"129\" y=\"170\" width=\"126\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"192.0\" y=\"180\" font-size=\"8\" fill=\"#333\" text-anchor=\"middle\">Held for buyer protection</text>\n  <rect x=\"261\" y=\"170\" width=\"94\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"308.0\" y=\"180\" font-size=\"8\" fill=\"#333\" text-anchor=\"middle\">Released to seller</text>\n  <text x=\"16\" y=\"204\" font-size=\"8\" fill=\"#333\">Buyer protection window</text>\n  <text x=\"384\" y=\"204\" font-size=\"8\" fill=\"#666\" text-anchor=\"end\">3 of 7 days</text>\n  <rect x=\"16\" y=\"208\" width=\"368\" height=\"6\" rx=\"3\" fill=\"#e5e7eb\"/>\n  <rect x=\"16\" y=\"208\" width=\"128\" height=\"6\" rx=\"3\" fill=\"#2563eb\"/>\n  <text x=\"16\" y=\"236\" font-size=\"8\" fill=\"#666\">Something wrong? Opening a dispute freezes the payout until it is resolved.</text>\n  <rect x=\"16\" y=\"256\" width=\"130\" height=\"20\" rx=\"3\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"81.0\" y=\"269.0\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\" text-anchor=\"middle\">Open a dispute</text>\n  <rect x=\"254\" y=\"256\" width=\"130\" height=\"20\" rx=\"3\" fill=\"#2563eb\" stroke=\"#2563eb\"/>\n  <text x=\"319.0\" y=\"269.0\" font-size=\"9\" fill=\"#fff\" font-weight=\"bold\" text-anchor=\"middle\">Confirm all good</text>\n</svg>"
    }
