      "screen": "/sell/listings/new",
      "wireframe": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\">\n  <rect width=\"400\" height=\"300\" fill=\"#fff\"/>\n  <rect x=\"0\" y=\"0\" width=\"400\" height=\"30\" fill=\"#f3f4f6\" stroke=\"#333\"/>\n  <rect x=\"10\" y=\"8\" width=\"14\" height=\"14\" rx=\"3\" fill=\"#ccc\"/>\n  <text x=\"30\" y=\"20\" font-size=\"11\" fill=\"#333\" font-weight=\"bold\">Marketplace — Sell</text>\n  <text x=\"388\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Payouts</text>\n  <text x=\"337\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">My listings</text>\n  <text x=\"16\" y=\"54\" font-size=\"13\" fill=\"#333\" font-weight=\"bold\">Create a listing</text>\n  <rect x=\"16\" y=\"64\" width=\"150\" height=\"118\" rx=\"3\" fill=\"#fff\" stroke=\"#999\" stroke-dasharray=\"4 3\"/>\n  <text x=\"91\" y=\"120\" font-size=\"9\" fill=\"#2563eb\" font-weight=\"bold\" text-anchor=\"middle\">+ Add photos</text>\n  <text x=\"91\" y=\"134\" font-size=\"8\" fill=\"#666\" text-anchor=\"middle\">up to 10</text>\n  <text x=\"180\" y=\"60\" font-size=\"8\" fill=\"#666\">Title</text>\n  <rect x=\"180\" y=\"64\" width=\"204\" height=\"18\" rx=\"2\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"186\" y=\"76.0\" font-size=\"8\" fill=\"#999\">Mid-century armchair</text>\n  <text x=\"180\" y=\"94\" font-size=\"8\" fill=\"#666\">Price</text>\n  <rect x=\"180\" y=\"98\" width=\"96\" height=\"18\" rx=\"2\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"186\" y=\"110.0\" font-size=\"8\" fill=\"#999\">€ 180.00</text>\n  <text x=\"288\" y=\"94\" font-size=\"8\" fill=\"#666\">Category</text>\n  <rect x=\"288\" y=\"98\" width=\"96\" height=\"18\" rx=\"2\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"294\" y=\"110.0\" font-size=\"8\" fill=\"#999\">Furniture</text>\n  <path d=\"M372 105 l4 4 l4 -4\" fill=\"none\" stroke=\"#666\"/>\n  <text x=\"180\" y=\"128\" font-size=\"8\" fill=\"#666\">Description</text>\n  <rect x=\"180\" y=\"132\" width=\"204\" height=\"54\" rx=\"2\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"186\" y=\"162.0\" font-size=\"8\" fill=\"#999\">Condition, dimensions, pickup…</text>\n  <rect x=\"16\" y=\"196\" width=\"368\" height=\"36\" rx=\"3\" fill=\"#f3f4f6\" stroke=\"#f3f4f6\"/>\n  <text x=\"26\" y=\"211\" font-size=\"8\" fill=\"#333\">Listings are reviewed against marketplace policy before they appear in search.</text>\n  <text x=\"26\" y=\"224\" font-size=\"8\" fill=\"#666\">You keep the price minus the platform commission.</text>\n  <rect x=\"16\" y=\"256\" width=\"110\" height=\"20\" rx=\"3\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"71.0\" y=\"269.0\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\" text-anchor=\"middle\">Save draft</text>\n  <rect x=\"254\" y=\"256\" width=\"130\" height=\"20\" rx=\"3\" fill=\"#2563eb\" stroke=\"#2563eb\"/>\n  <text x=\"319.0\" y=\"269.0\" font-size=\"9\" fill=\"#fff\" font-weight=\"bold\" text-anchor=\"middle\">Submit for review</text>\n</svg>"
    },
