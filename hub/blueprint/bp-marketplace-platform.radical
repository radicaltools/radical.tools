{
  "hub": {
    "id": "bp-marketplace-platform",
    "category": "blueprint",
    "name": "Marketplace / Two-Sided Platform",
    "description": "A managed marketplace matching buyers and sellers: listings and search on one side, browsing and checkout on the other, funds held and split by a payments facilitator so the platform never custodies money directly, and seller payouts release once the buyer's dispute window closes.",
    "tags": [
      "marketplace",
      "two-sided",
      "payments",
      "trust-and-safety",
      "search"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "LISTING_REVIEW_SLA_HOURS",
        "label": "Listing moderation SLA (hours)",
        "hint": "24",
        "type": "number",
        "defaultValue": "24"
      },
      {
        "key": "COMMISSION_PCT",
        "label": "Platform commission (%)",
        "hint": "15",
        "type": "number",
        "defaultValue": "15"
      },
      {
        "key": "DISPUTE_WINDOW_DAYS",
        "label": "Buyer dispute window (days)",
        "hint": "7",
        "type": "number",
        "defaultValue": "7"
      },
      {
        "key": "SUPPRESSION_MINUTES",
        "label": "Delisting suppression time (min)",
        "hint": "5",
        "type": "number",
        "defaultValue": "5"
      }
    ],
    "hubRefs": [
      "adr-marketplace-payments-model",
      "req-payout-latency",
      "req-search-response-time",
      "req-idempotency",
      "req-audit-logging",
      "pattern-event-driven",
      "pattern-saga",
      "req-availability"
    ]
  },
