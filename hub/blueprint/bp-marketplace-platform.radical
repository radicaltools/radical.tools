  "sequences": [
    {
      "id": "bp-marketplace-platform-seq",
      "name": "Seller lists, buyer orders, payout releases after the dispute window",
      "relationIds": [
        "seller--listings-service",
        "listings-service--search-index",
        "buyer--order-checkout-service",
        "order-checkout-service--payments-facilitator-adapter",
        "order-checkout-service--order-events",
        "order-events--payout-worker",
        "payout-worker--payments-facilitator-adapter"
      ],
      "stepDescriptions": [
        "Seller publishes a listing; it enters review before it can appear in search.",
        "Once approved, the listing is published to the search index.",
        "Buyer finds it and checks out.",
        "Order & Checkout Service authorises and holds payment through the facilitator — funds move, but nothing is released to the seller yet.",
        "Order lifecycle events (placed, delivered) are emitted.",
        "Once the order is delivered and the dispute window has passed with no dispute open, the payout worker marks it payout-eligible.",
        "Payout worker instructs the facilitator to release the seller's share, net of commission."
      ]
    },
    {
      "id": "seq-flow-buyer",
      "name": "Buyer journey",
      "relationIds": [
        "mockup-mp-search--mockup-mp-listing",
        "mockup-mp-listing--mockup-mp-checkout",
        "mockup-mp-checkout--mockup-order-dispute",
        "mockup-order-dispute--mockup-mp-open-dispute",
        "mockup-mp-open-dispute--mockup-mp-dispute-status"
      ],
      "stepDescriptions": [
        "Open listing → Listing. Listing page with seller reputation and buyer protection terms.",
        "Buy now → Checkout. Payment goes to the payments facilitator, which holds the funds; the platform never custodies them.",
        "Pay → Order & Buyer Protection. Buyer view of an order: funds stay held for {{DISPUTE_WINDOW_DAYS}} days after delivery, and opening a dispute freezes the payout.",
        "Open a dispute → Open a Dispute. Opening a dispute inside the {{DISPUTE_WINDOW_DAYS}}-day window freezes the seller payout.",
        "Open dispute → Dispute Status. Conversation and status while Trust & Safety reviews."
      ]
    },
    {
      "id": "seq-flow-seller",
      "name": "Seller journey",
      "relationIds": [
        "mockup-seller-dashboard--mockup-new-listing",
        "mockup-new-listing--mockup-my-listings",
        "mockup-my-listings--mockup-new-listing",
        "mockup-seller-dashboard--mockup-seller-payouts"
      ],
      "stepDescriptions": [
        "New listing → New Listing. Seller creates a listing; it goes into review and only appears in search once approved (within {{LISTING_REVIEW_SLA_HOURS}} h).",
        "Submit for review → My Listings. Listing states from the moderation workflow — in review, live, rejected with a reason.",
        "Edit & resubmit → New Listing. Seller creates a listing; it goes into review and only appears in search once approved (within {{LISTING_REVIEW_SLA_HOURS}} h).",
        "Payouts → Payouts. Per-order split: {{COMMISSION_PCT}}% commission deducted, payouts held for the protection window and frozen while a dispute is open."
      ]
    },
    {
      "id": "seq-flow-trust-safety",
      "name": "Trust & Safety journey",
      "relationIds": [
        "mockup-listing-review-queue--mockup-seller-investigation",
        "mockup-seller-investigation--mockup-ts-dispute-case",
        "mockup-seller-investigation--mockup-listing-review-queue"
      ],
      "stepDescriptions": [
        "Suspend → Seller Investigation. Suspending a seller removes every listing from search within {{SUPPRESSION_MINUTES}} minutes.",
        "Disputes → Dispute Case. Evidence from both sides; the payout stays frozen until a resolution is chosen.",
        "Suspend seller → Listing Review Queue. Trust & Safety queue sorted by time left on the review SLA."
      ]
    }
  ],
