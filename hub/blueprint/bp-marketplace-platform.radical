      "wireframe": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\">\n  <rect width=\"400\" height=\"300\" fill=\"#fff\"/>\n  <rect x=\"0\" y=\"0\" width=\"400\" height=\"30\" fill=\"#f3f4f6\" stroke=\"#333\"/>\n  <rect x=\"10\" y=\"8\" width=\"14\" height=\"14\" rx=\"3\" fill=\"#ccc\"/>\n  <text x=\"30\" y=\"20\" font-size=\"11\" fill=\"#333\" font-weight=\"bold\">Trust &amp; Safety</text>\n  <text x=\"388\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Disputes</text>\n  <text x=\"332\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Sellers</text>\n  <text x=\"281\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Listings (14)</text>\n  <rect x=\"0\" y=\"30\" width=\"150\" height=\"270\" rx=\"0\" fill=\"#fafafa\" stroke=\"#ccc\"/>\n  <rect x=\"4\" y=\"34\" width=\"142\" height=\"46\" rx=\"3\" fill=\"#eef2ff\" stroke=\"#eef2ff\"/>\n  <rect x=\"10\" y=\"38\" width=\"32\" height=\"32\" rx=\"3\" fill=\"#eee\" stroke=\"#ccc\"/>\n  <line x1=\"10\" y1=\"38\" x2=\"42\" y2=\"70\" stroke=\"#ccc\"/>\n  <line x1=\"42\" y1=\"38\" x2=\"10\" y2=\"70\" stroke=\"#ccc\"/>\n  <rect x=\"50\" y=\"42\" width=\"90\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"50\" y=\"51\" width=\"54\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"50\" y=\"60\" width=\"48\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"74.0\" y=\"70\" font-size=\"8\" fill=\"#333\" text-anchor=\"middle\">3 h left</text>\n  <rect x=\"10\" y=\"88\" width=\"32\" height=\"32\" rx=\"3\" fill=\"#eee\" stroke=\"#ccc\"/>\n  <line x1=\"10\" y1=\"88\" x2=\"42\" y2=\"120\" stroke=\"#ccc\"/>\n  <line x1=\"42\" y1=\"88\" x2=\"10\" y2=\"120\" stroke=\"#ccc\"/>\n  <rect x=\"50\" y=\"92\" width=\"90\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"50\" y=\"101\" width=\"54\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"50\" y=\"110\" width=\"48\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"74.0\" y=\"120\" fon