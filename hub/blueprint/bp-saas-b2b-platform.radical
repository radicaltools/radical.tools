    {
      "id": "req-tenant-isolation",
      "type": "requirement",
      "label": "Tenant Data Isolation",
      "width": 260,
      "height": 80,
      "collapsed": false,
      "x": 0,
      "y": 1780,
      "ears_type": "unwanted-behaviour",
      "status": "draft",
      "priority": "must",
      "unwanted_condition": "a query executes without a validated tenant context",
      "action": "reject the query, log a security event and alert the on-call rotation",
      "rationale": "A missing tenant filter is a cross-tenant data leak — the single most damaging failure mode a pooled multi-tenant system has."
    },
    {
      "id": "req-tenant-provisioning-time",
      "type": "requirement",
      "label": "Tenant Provisioning Time",
      "width": 260,
      "height": 80,
      "collapsed": false,
      "x": 320,
      "y": 1780,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "a new tenant completes sign-up",
      "action": "provision an isolated, ready-to-use workspace within {{PROVISION_MINUTES}} minutes",
      "rationale": "Slow provisioning is the first thing a trial user experiences; it sets the tone for the whole evaluation.",
      "templateParams": [
        {
          "key": "PROVISION_MINUTES",
          "label": "Max provisioning time (minutes)",
          "hint": "2",
          "type": "number",
          "defaultValue": "2"
        }
      ]
    },
    {
      "id": "req-subscription-enforcement",
      "type": "requirement",
      "label": "Subscription Enforcement",
      "width": 260,
      "height": 80,
      "collapsed": false,
      "x": 640,
      "y": 1780,
      "ears_type": "state-driven",
      "status": "draft",
      "priority": "must",
      "precondition": "a tenant's subscription is past due beyond the grace period",
      "action": "restrict the tenant to read-only access until payment succeeds or the account is cancelled",
      "rationale": "Non-payment must degrade access, not delete data — the tenant may still resolve billing and expects their data intact."
    },
    {
      "id": "req-usage-metering-accuracy",
      "type": "requirement",
      "label": "Usage Metering Accuracy",
      "width": 260,
      "height": 80,
      "collapsed": false,
      "x": 960,
      "y": 1780,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "record every billable usage event exactly once, reconciled against source-of-truth logs within {{RECONCILIATION_PCT}}% at month end",
      "rationale": "Usage-based billing that overcounts erodes trust; undercounting is silent revenue loss. Both need to be caught before the invoice goes out.",
      "templateParams": [
        {
          "key": "RECONCILIATION_PCT",
          "label": "Max metering discrepancy at reconciliation (%)",
          "hint": "0.5",
          "type": "number",
          "defaultValue": "0.5"
        }
      ]
    },
    {
      "id": "ff-tenant-isolation-fuzz",
      "type": "fitness-fn",
      "label": "Tenant Isolation Fuzz Test",
      "width": 260,
      "height": 52,
      "collapsed": false,
      "x": 0,
      "y": 1980,
      "category": "structural",
      "automated": true,
      "trigger": "on-deploy",
      "threshold": "Zero cross-tenant rows returned across {{FUZZ_QUERY_COUNT}} randomised queries run against two seeded tenants",
      "status": "proposed",
      "templateParams": [
        {
          "key": "FUZZ_QUERY_COUNT",
          "label": "Randomised queries per run",
          "hint": "500",
          "type": "number",
          "defaultValue": "500"
        }
      ]
    },
    {
      "id": "ff-noisy-neighbor-guard",
      "type": "fitness-fn",
      "label": "Noisy Neighbour Guard",
      "width": 260,
      "height": 52,
      "collapsed": false,
      "x": 320,
      "y": 1980,
      "category": "operational",
      "automated": true,
      "trigger": "continuous",
      "threshold": "No single tenant sustains more than {{MAX_TENANT_SHARE_PCT}}% of pooled database CPU for over 5 minutes",
      "status": "proposed",
      "templateParams": [
        {
          "key": "MAX_TENANT_SHARE_PCT",
          "label": "Max sustained CPU share per tenant (%)",
          "hint": "20",
          "type": "number",
          "defaultValue": "20"
        }
      ]
    },
    {
      "id": "ff-billing-reconciliation",
      "type": "fitness-fn",
      "label": "Billing Reconciliation",
      "width": 260,
      "height": 52,
      "collapsed": false,
      "x": 640,
      "y": 1980,
      "category": "process",
      "automated": true,
      "trigger": "periodic",
      "threshold": "Metered usage matches the payment provider's invoiced usage within the tolerance defined by Usage Metering Accuracy",
      "status": "proposed"
    },
    {
      "id": "adr-tenancy-model",
      "type": "adr",
      "label": "ADR: Pooled tenancy, siloed for enterprise",
      "width": 260,
      "height": 52,
      "collapsed": false,
      "x": 0,
      "y": 2152,
      "status": "accepted",
      "date": "",
      "context": "Same trade-off as the standalone Multi-Tenancy Strategy ADR, applied concretely to this platform's tenant tiers.",
      "decision": "Self-serve and mid-market tenants are pooled with row-level security; the top enterprise tier is siloed on request.",
      "consequences": "Pooled tenants launch in minutes at low marginal cost; siloed tenants get a dedicated migration runbook and higher per-tenant ops cost.",
      "alternatives": "Always-siloed was rejected as uneconomical for the self-serve tier; always-pooled was rejected as a blocker for enterprise compliance reviews."
    },
    {
      "id": "adr-sso-federation",
      "type": "adr",
      "label": "ADR: Short-lived tenant-scoped tokens after IdP federation",
      "width": 260,
      "height": 52,
      "collapsed": false,
      "x": 320,
      "y": 2152,
      "status": "accepted",
      "date": "",
      "context": "Enterprise tenants federate via their own SAML/OIDC IdP; the platform must not become a long-lived credential store for those identities.",
      "decision": "After a successful SSO handshake, the gateway issues its own short-lived, tenant-scoped JWT. The IdP is the source of truth for the identity; the platform never stores the tenant's SSO credentials.",
      "consequences": "A tenant revoking a user at their IdP takes effect on the token's next short expiry, not instantly, which is an accepted trade-off; token issuance adds one extra hop to first login.",
      "alternatives": "Storing IdP session cookies directly was rejected — it would tie the platform's session lifetime to each IdP's own cookie semantics and leak IdP-specific state into the app tier."
    }
  ],
