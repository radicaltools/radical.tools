      "collapsed": false,
      "screen": "/settings/billing",
      "wireframe": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\">\n  <rect width=\"400\" height=\"300\" fill=\"#fff\"/>\n  <rect x=\"0\" y=\"0\" width=\"400\" height=\"30\" fill=\"#f3f4f6\" stroke=\"#333\"/>\n  <rect x=\"10\" y=\"8\" width=\"14\" height=\"14\" rx=\"3\" fill=\"#ccc\"/>\n  <text x=\"30\" y=\"20\" font-size=\"11\" fill=\"#333\" font-weight=\"bold\">Acme ▾</text>\n  <text x=\"388\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Settings</text>\n  <text x=\"332\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Reports</text>\n  <text x=\"281\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Projects</text>\n  <rect x=\"0\" y=\"30\" width=\"110\" height=\"270\" rx=\"0\" fill=\"#fafafa\" stroke=\"#ccc\"/>\n  <text x=\"14\" y=\"55\" font-size=\"9\" fill=\"#666\">Profile</text>\n  <text x=\"14\" y=\"79\" font-size=\"9\" fill=\"#666\">Users &amp; roles</text>\n  <text x=\"14\" y=\"103\" font-size=\"9\" fill=\"#666\">Single sign-on</text>\n  <rect x=\"6\" y=\"114\" width=\"98\" height=\"20\" rx=\"3\" fill=\"#eef2ff\" stroke=\"#eef2ff\"/>\n  <text x=\"14\" y=\"127\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\">Billing &amp; usage</text>\n  <text x=\"14\" y=\"151\" font-size=\"9\" fill=\"#666\">Audit log</text>\n  <text x=\"126\" y=\"54\" font-size=\"12\" fill=\"#333\" font-weight=\"bold\">Billing &amp; usage</text>\n  <rect x=\"126\" y=\"64\" width=\"258\" height=\"44\" rx=\"3\" fill=\"#fafafa\" stroke=\"#ccc\"/>\n  <text x=\"136\" y=\"80\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\">Business plan</text>\n  <text x=\"136\" y=\"98\" font-size=\"8\" fill=\"#666\">€49 per seat / month · 48 seats</text>\n  <rect x=\"290\" y=\"76\" width=\"86\" height=\"20\" rx=\"3\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"333.0\" y=\"89.0\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\" text-anchor=\"middle\">Change plan</text>\n  <text x=\"126\" y=\"126\" font-size=\"8\" fill=\"#333\">API calls</text>\n  <text x=\"384\" y=\"126\" font-size=\"8\" fill=\"#666\" text-anchor=\"end\">812k / 1M</text>\n  <rect x=\"126\" y=\"130\" width=\"258\" height=\"6\" rx=\"3\" fill=\"#e5e7eb\"/>\n  <rect x=\"126\" y=\"130\" width=\"208\" height=\"6\" rx=\"3\" fill=\"#2563eb\"/>\n  <text x=\"126\" y=\"152\" font-size=\"8\" fill=\"#333\">Storage</text>\n  <text x=\"384\" y=\"152\" font-size=\"8\" fill=\"#666\" text-anchor=\"end\">38 / 100 GB</text>\n  <rect x=\"126\" y=\"156\" width=\"258\" height=\"6\" rx=\"3\" fill=\"#e5e7eb\"/>\n  <rect x=\"126\" y=\"156\" width=\"98\" height=\"6\" rx=\"3\" fill=\"#2563eb\"/>\n  <text x=\"126\" y=\"186\" font-size=\"7.5\" fill=\"#666\">Usage is metered per event and reconciled daily against source logs.</text>\n  <rect x=\"126\" y=\"196\" width=\"258\" height=\"18\" fill=\"#f3f4f6\"/>\n  <text x=\"132\" y=\"208.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Invoice</text>\n  <text x=\"222\" y=\"208.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Amount</text>\n  <text x=\"302\" y=\"208.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Status</text>\n  <line x1=\"126\" y1=\"232\" x2=\"384\" y2=\"232\" stroke=\"#e5e7eb\"/>\n  <text x=\"132\" y=\"226.0\" font-size=\"8\" fill=\"#333\">Mar 2026</text>\n  <text x=\"222\" y=\"226.0\" font-size=\"8\" fill=\"#333\">€2,352.00</text>\n  <rect x=\"300\" y=\"216.0\" width=\"76\" height=\"14\" rx=\"7\" fill=\"#333\"/>\n  <text x=\"338.0\" y=\"226.0\" font-size=\"8\" fill=\"#fff\" text-anchor=\"middle\">payment failed</text>\n  <line x1=\"126\" y1=\"250\" x2=\"384\" y2=\"250\" stroke=\"#e5e7eb\"/>\n  <text x=\"132\" y=\"244.0\" font-size=\"8\" fill=\"#333\">Feb 2026</text>\n  <text x=\"222\" y=\"244.0\" font-size=\"8\" fill=\"#333\">€2,254.00</text>\n  <rect x=\"300\" y=\"234.0\" width=\"30\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"315.0\" y=\"244.0\" font-size=\"8\" fill=\"#333\" text-anchor=\"middle\">paid</text>\n  <rect x=\"126\" y=\"262\" width=\"150\" height=\"20\" rx=\"3\" fill=\"#2563eb\" stroke=\"#2563eb\"/>\n  <text x=\"201.0\" y=\"275.0\" font-size=\"9\" fill=\"#fff\" font-weight=\"bold\" text-anchor=\"middle\">Update payment method</text>\n</svg>"
