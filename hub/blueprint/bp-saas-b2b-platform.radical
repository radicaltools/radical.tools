alls</text>\n  <text x=\"384\" y=\"126\" font-size=\"8\" fill=\"#666\" text-anchor=\"end\">812k / 1M</text>\n  <rect x=\"126\" y=\"130\" width=\"258\" height=\"6\" rx=\"3\" fill=\"#e5e7eb\"/>\n  <rect x=\"126\" y=\"130\" width=\"208\" height=\"6\" rx=\"3\" fill=\"#2563eb\"/>\n  <text x=\"126\" y=\"152\" font-size=\"8\" fill=\"#333\">Storage</text>\n  <text x=\"384\" y=\"152\" font-size=\"8\" fill=\"#666\" text-anchor=\"end\">38 / 100 GB</text>\n  <rect x=\"126\" y=\"156\" width=\"258\" height=\"6\" rx=\"3\" fill=\"#e5e7eb\"/>\n  <rect x=\"126\" y=\"156\" width=\"98\" height=\"6\" rx=\"3\" fill=\"#2563eb\"/>\n  <text x=\"126\" y=\"186\" font-size=\"7.5\" fill=\"#666\">Usage is metered per event and reconciled daily against source logs.</text>\n  <rect x=\"126\" y=\"196\" width=\"258\" height=\"18\" fill=\"#f3f4f6\"/>\n  <text x=\"132\" y=\"208.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Invoice</text>\n  <text x=\"222\" y=\"208.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Amount</text>\n  <text x=\"302\" y=\"208.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Status</text>\n  <line x1=\"126\" y1=\"232\" x2=\"384\" y2=\"232\" stroke=\"#e5e7eb\"/>\n  <text x=\"132\" y=\"226.0\" font-size=\"8\" fill=\"#333\">Mar 2026</text>\n  <text x=\"222\" y=\"226.0\" font-size=\"8\" fill=\"#333\">€2,352.00</text>\n  <rect x=\"300\" y=\"216.0\" width=\"76\" height=\"14\" rx=\"7\" fill=\"#333\"/>\n  <text x=\"338.0\" y=\"226.0\" font-size=\"8\" fill=\"#fff\" text-anchor=\"middle\">payment failed</text>\n  <line x1=\"126\" y1=\"250\" x2=\"384\" y2=\"250\" stroke=\"#e5e7eb\"/>\n  <text x=\"132\" y=\"244.0\" font-size=\"8\" fill=\"#333\">Feb 2026</text>\n  <text x=\"222\" y=\"244.0\" font-size=\"8\" fill=\"#333\">€2,254.00</text>\n  <rect x=\"300\" y=\"234.0\" width=\"30\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"315.0\" y=\"244.0\" font-size=\"8\" fill=\"#333\" text-anchor=\"middle\">paid</text>\n  <rect x=\"126\" y=\"262\" width=\"150\" height=\"2