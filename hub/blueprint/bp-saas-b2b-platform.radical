      "screen": "/admin/tenants/:id",
      "wireframe": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\">\n  <rect width=\"400\" height=\"300\" fill=\"#fff\"/>\n  <rect x=\"0\" y=\"0\" width=\"400\" height=\"30\" fill=\"#f3f4f6\" stroke=\"#333\"/>\n  <rect x=\"10\" y=\"8\" width=\"14\" height=\"14\" rx=\"3\" fill=\"#ccc\"/>\n  <text x=\"30\" y=\"20\" font-size=\"11\" fill=\"#333\" font-weight=\"bold\">Admin Console</text>\n  <text x=\"388\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Audit</text>\n  <text x=\"347\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Incidents</text>\n  <text x=\"286\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Tenants</text>\n  <text x=\"16\" y=\"46\" font-size=\"8\" fill=\"#2563eb\">← Tenants</text>\n  <text x=\"16\" y=\"66\" font-size=\"13\" fill=\"#333\" font-weight=\"bold\">Initech</text>\n  <rect x=\"80\" y=\"56\" width=\"62\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"111.0\" y=\"66\" font-size=\"8\" fill=\"#333\" text-anchor=\"middle\">pooled tier</text>\n  <rect x=\"16.0\" y=\"76\" width=\"117.33333333333333\" height=\"42\" rx=\"3\" fill=\"#fafafa\" stroke=\"#ccc\"/>\n  <text x=\"26.0\" y=\"91\" font-size=\"8\" fill=\"#666\">Share of pooled load</text>\n  <text x=\"26.0\" y=\"108\" font-size=\"13\" fill=\"#333\" font-weight=\"bold\">21.4%</text>\n  <rect x=\"141.33333333333331\" y=\"76\" width=\"117.33333333333333\" height=\"42\" rx=\"3\" fill=\"#fafafa\" stroke=\"#ccc\"/>\n  <text x=\"151.33333333333331\" y=\"91\" font-size=\"8\" fill=\"#666\">p95 latency</text>\n  <text x=\"151.33333333333331\" y=\"108\" font-size=\"13\" fill=\"#333\" font-weight=\"bold\">310 ms</text>\n  <rect x=\"266.66666666666663\" y=\"76\" width=\"117.33333333333333\" height=\"42\" rx=\"3\" fill=\"#fafafa\" stroke=\"#ccc\"/>\n  <text x=\"276.66666666666663\" y=\"91\" font-size=\"8\" fill=\"#666\">Seats</text>\n  <text x=\"276.66666666666663\" y=\"108\" font-size=\"13\" fill=\"#333\" font-weight=\"bold\">420</text>\n  <text x=\"16\" y=\"140\" font-size=\"8\" fill=\"#333\">Load share vs 20% limit</text>\n  <text x=\"384\" y=\"140\" font-size=\"8\" fill=\"#666\" text-anchor=\"end\">21.4% / 20%</text>\n  <rect x=\"16\" y=\"144\" width=\"368\" height=\"6\" rx=\"3\" fill=\"#e5e7eb\"/>\n  <rect x=\"16\" y=\"144\" width=\"262\" height=\"6\" rx=\"3\" fill=\"#2563eb\"/>\n  <text x=\"16\" y=\"176\" font-size=\"8\" fill=\"#333\">Over the noisy-neighbour limit — consider moving to a silo.</text>\n  <rect x=\"16\" y=\"190\" width=\"368\" height=\"40\" rx=\"3\" fill=\"#fafafa\" stroke=\"#ccc\"/>\n  <text x=\"26\" y=\"206\" font-size=\"8\" fill=\"#333\">Impersonation is logged to the tenant's audit log</text>\n  <text x=\"26\" y=\"220\" font-size=\"8\" fill=\"#666\">and requires a support ticket id.</text>\n  <rect x=\"16\" y=\"256\" width=\"130\" height=\"20\" rx=\"3\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"81.0\" y=\"269.0\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\" text-anchor=\"middle\">Impersonate…</text>\n  <rect x=\"254\" y=\"256\" width=\"130\" height=\"20\" rx=\"3\" fill=\"#2563eb\" stroke=\"#2563eb\"/>\n  <text x=\"319.0\" y=\"269.0\" font-size=\"9\" fill=\"#fff\" font-weight=\"bold\" text-anchor=\"middle\">Migrate to silo</text>\n</svg>"
    }
