{
  "hub": {
    "id": "bp-saas-b2b-platform",
    "category": "blueprint",
    "name": "SaaS B2B Multi-Tenant Platform",
    "description": "A B2B SaaS reference architecture: one pooled, row-level-secured data tier serves self-serve and mid-market tenants, enterprise SSO federates through a dedicated identity service, and usage-based billing meters and enforces subscription state.",
    "tags": [
      "saas",
      "multi-tenancy",
      "b2b",
      "sso",
      "billing",
      "governance"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "PROVISION_MINUTES",
        "label": "Max provisioning time (minutes)",
        "hint": "2",
        "type": "number",
        "defaultValue": "2"
      },
      {
        "key": "RECONCILIATION_PCT",
        "label": "Max metering discrepancy at reconciliation (%)",
        "hint": "0.5",
        "type": "number",
        "defaultValue": "0.5"
      },
      {
        "key": "FUZZ_QUERY_COUNT",
        "label": "Randomised queries per run",
        "hint": "500",
        "type": "number",
        "defaultValue": "500"
      },
      {
        "key": "MAX_TENANT_SHARE_PCT",
        "label": "Max sustained CPU share per tenant (%)",
        "hint": "20",
        "type": "number",
        "defaultValue": "20"
      }
    ],
    "hubRefs": [
      "adr-multi-tenancy-strategy",
      "pattern-api-gateway",
      "req-mfa",
      "req-secrets-management",
      "req-availability",
      "pattern-event-driven",
      "ff-error-budget",
      "req-audit-logging"
    ]
  },
