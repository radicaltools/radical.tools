      "wireframe": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\">\n  <rect width=\"400\" height=\"300\" fill=\"#fff\"/>\n  <rect x=\"0\" y=\"0\" width=\"400\" height=\"300\" rx=\"0\" fill=\"#e5e7eb\" stroke=\"#e5e7eb\"/>\n  <rect x=\"60.0\" y=\"40.0\" width=\"280\" height=\"220\" rx=\"6\" fill=\"#fff\" stroke=\"#333\"/>\n  <text x=\"76.0\" y=\"66.0\" font-size=\"12\" fill=\"#333\" font-weight=\"bold\">Update payment method</text>\n  <text x=\"76.0\" y=\"86.0\" font-size=\"8\" fill=\"#666\">Card number</text>\n  <rect x=\"76.0\" y=\"90.0\" width=\"248\" height=\"18\" rx=\"2\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"82.0\" y=\"102.0\" font-size=\"8\" fill=\"#999\">•••• •••• •••• ••••</text>\n  <text x=\"76.0\" y=\"120.0\" font-size=\"8\" fill=\"#666\">Expiry</text>\n  <rect x=\"76.0\" y=\"124.0\" width=\"120\" height=\"18\" rx=\"2\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"82.0\" y=\"136.0\" font-size=\"8\" fill=\"#999\">MM / YY</text>\n  <text x=\"204.0\" y=\"120.0\" font-size=\"8\" fill=\"#666\">CVC</text>\n  <rect x=\"204.0\" y=\"124.0\" width=\"120\" height=\"18\" rx=\"2\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"210.0\" y=\"136.0\" font-size=\"8\" fill=\"#999\">•••</text>\n  <text x=\"76.0\" y=\"168.0\" font-size=\"8\" fill=\"#666\">We retry the failed invoice right away; write access</text>\n  <text x=\"76.0\" y=\"180.0\" font-size=\"8\" fill=\"#666\">returns as soon as the payment succeeds.</text>\n  <rect x=\"76.0\" y=\"212.0\" width=\"110\" height=\"20\" rx=\"3\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"131.0\" y=\"225.0\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\" text-anchor=\"middle\">Cancel</text>\n  <rect x=\"214.0\" y=\"212.0\" width=\"110\" height=\"20\" rx=\"3\" fill=\"#2563eb\" stroke=\"#2563eb\"/>\n  <text x=\"269.0\" y=\"225.0\" font-size=\"9\" fill=\"#fff\" font-weight=\"bold\" text-anchor=\"middle\">Save &amp; pay €2,352</text>\n</svg>"
