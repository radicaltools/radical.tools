34\" width=\"84\" height=\"20\" rx=\"3\" fill=\"#e5e7eb\" stroke=\"#e5e7eb\"/>\n  <text x=\"342.0\" y=\"147.0\" font-size=\"9\" fill=\"#999\" font-weight=\"bold\" text-anchor=\"middle\">+ New project</text>\n  <rect x=\"16\" y=\"160\" width=\"368\" height=\"18\" fill=\"#f3f4f6\"/>\n  <text x=\"22\" y=\"172.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Name</text>\n  <text x=\"192\" y=\"172.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Owner</text>\n  <text x=\"292\" y=\"172.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Updated</text>\n  <line x1=\"16\" y1=\"196\" x2=\"384\" y2=\"196\" stroke=\"#e5e7eb\"/>\n  <rect x=\"22\" y=\"184.5\" width=\"120\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"192\" y=\"184.5\" width=\"60\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <text x=\"292\" y=\"190.0\" font-size=\"8\" fill=\"#333\">2 h ago</text>\n  <line x1=\"16\" y1=\"214\" x2=\"384\" y2=\"214\" stroke=\"#e5e7eb\"/>\n  <rect x=\"22\" y=\"202.5\" width=\"100\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"192\" y=\"202.5\" width=\"70\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <text x=\"292\" y=\"208.0\" font-size=\"8\" fill=\"#333\">yesterday</text>\n  <line x1=\"16\" y1=\"232\" x2=\"384\" y2=\"232\" stroke=\"#e5e7eb\"/>\n  <rect x=\"22\" y=\"220.5\" width=\"130\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"192\" y=\"220.5\" width=\"50\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <text x=\"292\" y=\"226.0\" font-size=\"8\" fill=\"#333\">3 days ago</text>\n  <line x1=\"16\" y1=\"250\" x2=\"384\" y2=\"250\" stroke=\"#e5e7eb\"/>\n  <rect x=\"22\" y=\"238.5\" width=\"90\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"192\" y=\"238.5\" width=\"60\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <text x=\"292\" y=\"244.0\" font-size=\"8\" fill=\"#333\">last week</text>\n  <line x1=\"16\" y1=\"268\" x2=\"384\" y2=\"268\" stroke=\"#e5e7eb\"/>\n  <rect x=\"22\" y=\"256.5\" width=\"110\" height=\"5\" rx=\"2\" fill=\"#e5e7