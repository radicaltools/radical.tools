    {
      "id": "mockup-billing-usage",
      "type": "mockup",
      "label": "Billing & Usage",
      "description": "Tenant admin view of plan, metered usage and invoices; usage figures are recorded exactly once and reconciled against source logs.",
      "x": 640,
      "y": 2324,
      "width": 220,
      "height": 190,
