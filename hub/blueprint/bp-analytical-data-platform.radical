    {
      "id": "mockup-quality-runs",
      "type": "mockup",
      "label": "Data Quality Runs",
      "description": "Run results with the quality gate applied: failing records are quarantined, the affected models fail and the dataset owner is notified before anything reaches consumers.",
      "x": 640,
      "y": 1534,
      "width": 220,
      "height": 190,
