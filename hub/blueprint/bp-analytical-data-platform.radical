    {
      "id": "mockup-freshness",
      "type": "mockup",
      "label": "Freshness Monitor",
      "description": "Streaming latency against the {{INGESTION_LATENCY_SECONDS}} s target from event to raw zone.",
      "parentId": "flow-data-engineer",
      "x": 990,
      "y": 110,
      "width": 220,
      "height": 190,
      "collapsed": false,
      "screen": "/freshness",
      "wireframe": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\">\n  <rect width=\"400\" height=\"300\" fill=\"#fff\"/>\n  <rect x=\"0\" y=\"0\" width=\"400\" height=\"30\" fill=\"#f3f4f6\" stroke=\"#333\"/>\n  <rect x=\"10\" y=\"8\" width=\"14\" height=\"14\" rx=\"3\" fill=\"#ccc\"/>\n  <text x=\"30\" y=\"20\" font-size=\"11\" fill=\"#333\" font-weight=\"bold\">Orchestrator</text>\n  <text x=\"388\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Freshness</text>\n  <text x=\"327\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Runs</text>\n  <text x=\"291\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Pipelines</text>\n  <text x=\"16\" y=\"54\" font-size=\"12\" fill=\"#333\" font-weight=\"bold\">Streaming freshness</text>\n  <rect x=\"250\" y=\"44\" width=\"122\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"311.0\" y=\"54\" font-size=\"8\" fill=\"#333\" text-anchor=\"middle\">Target: queryable ≤ 60 s</text>\n  <rect x=\"16\" y=\"66\" width=\"368\" height=\"120\" rx=\"3\" fill=\"#fff\" stroke=\"#ccc\"/>\n  <text x=\"24\" y=\"80\" font-size=\"8\" fill=\"#333\">Event → raw zone latency (p95, last 24 h)</text>\n  <line x1=\"24\" y1=\"176\" x2=\"376\" y2=\"176\" stroke=\"#ccc\"/>\n  <polyline points=\"24.0,150.2 56.0,148.5 88.0,151.9 120.0,145.9 152.0,150.2 184.0,124.4 216.0,98.6 248.0,137.3 280.0,147.6 312.0,150.2 344.0,149.3 376.0,151.1\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n  <line x1=\"24\" y1=\"111.5\" x2=\"376\" y2=\"111.5\" stroke=\"#333\" stroke-dasharray=\"3 3\"/>\n  <text x=\"376\" y=\"107.5\" font-size=\"7.5\" fill=\"#333\" text-anchor=\"end\">60 s</text>\n  <rect x=\"16\" y=\"200\" width=\"368\" height=\"22\" fill=\"#f3f4f6\"/>\n  <text x=\"22\" y=\"214.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Topic</text>\n  <text x=\"172\" y=\"214.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">p95 now</text>\n  <text x=\"262\" y=\"214.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Breaches 24 h</text>\n  <line x1=\"16\" y1=\"244\" x2=\"384\" y2=\"244\" stroke=\"#e5e7eb\"/>\n  <text x=\"22\" y=\"236.0\" font-size=\"8\" fill=\"#333\">orders</text>\n  <text x=\"172\" y=\"236.0\" font-size=\"8\" fill=\"#333\">38 s</text>\n  <text x=\"262\" y=\"236.0\" font-size=\"8\" fill=\"#333\">1</text>\n  <line x1=\"16\" y1=\"266\" x2=\"384\" y2=\"266\" stroke=\"#e5e7eb\"/>\n  <text x=\"22\" y=\"258.0\" font-size=\"8\" fill=\"#333\">clickstream</text>\n  <text x=\"172\" y=\"258.0\" font-size=\"8\" fill=\"#333\">22 s</text>\n  <text x=\"262\" y=\"258.0\" font-size=\"8\" fill=\"#333\">0</text>\n</svg>"
