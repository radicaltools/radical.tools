    {
      "id": "req-freshness",
      "type": "requirement",
      "label": "Streaming Freshness",
      "x": 0,
      "y": 990,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "make streaming events queryable in the raw zone within {{INGESTION_LATENCY_SECONDS}} seconds of production",
      "rationale": "Operational dashboards and alerting on business events are only useful if the data is near real time.",
      "templateParams": [
        {
          "key": "INGESTION_LATENCY_SECONDS",
          "label": "Event-to-lake latency (s)",
          "hint": "60",
          "type": "number",
          "defaultValue": "60"
        }
      ]
    },
    {
      "id": "req-quality-gate",
      "type": "requirement",
      "label": "Data Quality Gate",
      "x": 320,
      "y": 990,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "a transformation run produces records that fail schema, uniqueness or referential checks",
      "action": "quarantine the failing records, fail the run for the affected models and notify the dataset owner before anything reaches the curated zone",
      "rationale": "Bad data that reaches curated tables propagates into every downstream dashboard and is expensive to recall."
    },
    {
      "id": "req-rls",
      "type": "requirement",
      "label": "Row & Column Security",
      "x": 640,
      "y": 990,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "enforce row- and column-level access on every curated dataset according to the classification and the querying user's role, with policies defined once in the catalogue",
      "rationale": "Financial and personal data must be visible only to authorised roles regardless of which tool issues the query."
    },
    {
      "id": "req-lineage",
      "type": "requirement",
      "label": "Column-Level Lineage",
      "x": 960,
      "y": 990,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "should",
      "action": "record column-level lineage for every transformation and expose it in the catalogue and via API",
      "rationale": "Lineage is required for audits, impact analysis of schema changes and trust in reported figures."
    },
    {
      "id": "ff-freshness",
      "type": "fitness-fn",
      "label": "Dataset Freshness Guard",
      "description": "Compares each critical model's last successful run time and max source timestamp with its declared SLA; alerts the owner and on-call when exceeded.",
      "x": 0,
      "y": 1190,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "continuous",
      "threshold": "Every critical model refreshed within {{FRESHNESS_SLA_HOURS}} h",
      "status": "proposed",
      "templateParams": [
        {
          "key": "FRESHNESS_SLA_HOURS",
          "label": "Freshness SLA for critical models (h)",
          "hint": "4",
          "type": "number",
          "defaultValue": "4"
        }
      ]
    },
    {
      "id": "ff-quality",
      "type": "fitness-fn",
      "label": "Data Quality Score",
      "description": "Runs the dbt / Great Expectations test suites after every transformation run and computes the pass rate per model.",
      "x": 320,
      "y": 1190,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "on-deploy",
      "threshold": "Test pass rate ≥ {{QUALITY_PASS_PCT}}% for curated models",
      "status": "proposed",
      "templateParams": [
        {
          "key": "QUALITY_PASS_PCT",
          "label": "Test pass rate (%)",
          "hint": "99",
          "type": "number",
          "defaultValue": "99"
        }
      ]
    },
    {
      "id": "ff-cost",
      "type": "fitness-fn",
      "label": "Query Cost Guard",
      "description": "Attributes query engine spend to teams via tags and workload groups; blocks new ad-hoc queries once a team exceeds its daily budget.",
      "x": 640,
      "y": 1190,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "holistic",
      "automated": true,
      "trigger": "continuous",
      "threshold": "Daily attributed spend ≤ {{DAILY_BUDGET}} per team",
      "status": "proposed",
      "templateParams": [
        {
          "key": "DAILY_BUDGET",
          "label": "Daily compute budget per team (currency units)",
          "hint": "500",
          "type": "number",
          "defaultValue": "500"
        }
      ]
    },
    {
      "id": "adr-lakehouse",
      "type": "adr",
      "label": "ADR: Lakehouse over pure warehouse",
      "x": 0,
      "y": 1362,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "status": "accepted",
      "date": "",
      "context": "The organisation needs SQL reporting and machine-learning workloads on the same data. A proprietary warehouse copy of raw data doubles storage cost and locks ML tooling out.",
      "decision": "Store all zones in an open table format on object storage and run both the SQL engine and ML tooling directly on it.",
      "consequences": "One copy of the data; ML and BI share lineage and governance. Compaction, vacuuming and schema management become platform responsibilities.",
      "alternatives": "1. Warehouse-only — simpler operations, expensive at ML scale. 2. Hadoop data lake — mature but operationally heavy and weak on ACID."
    },
    {
      "id": "adr-dbt",
      "type": "adr",
      "label": "ADR: dbt as transformation standard",
      "x": 320,
      "y": 1362,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "status": "accepted",
      "date": "",
      "context": "Transformation logic is spread across ad-hoc SQL, notebooks and stored procedures without tests or lineage.",
      "decision": "All curated-zone transformations are dbt models with at least one test and a description; Spark is reserved for raw ingestion and feature engineering.",
      "consequences": "Version control, testing and documentation by default; CI/CD required for model deployment; learning curve for SQL-only teams.",
      "alternatives": "1. Spark jobs only — flexible, no conventions for tests or lineage. 2. Stored procedures — vendor-coupled and hard to review."
    }
  ],
