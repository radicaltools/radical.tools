      "screen": "/runs",
      "wireframe": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\">\n  <rect width=\"400\" height=\"300\" fill=\"#fff\"/>\n  <rect x=\"0\" y=\"0\" width=\"400\" height=\"30\" fill=\"#f3f4f6\" stroke=\"#333\"/>\n  <rect x=\"10\" y=\"8\" width=\"14\" height=\"14\" rx=\"3\" fill=\"#ccc\"/>\n  <text x=\"30\" y=\"20\" font-size=\"11\" fill=\"#333\" font-weight=\"bold\">Orchestrator</text>\n  <text x=\"388\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Quarantine</text>\n  <text x=\"322\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Runs</text>\n  <text x=\"286\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Pipelines</text>\n  <text x=\"16\" y=\"54\" font-size=\"12\" fill=\"#333\" font-weight=\"bold\">Transformation runs — today</text>\n  <rect x=\"16\" y=\"64\" width=\"368\" height=\"18\" fill=\"#f3f4f6\"/>\n  <text x=\"22\" y=\"76.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Model</text>\n  <text x=\"142\" y=\"76.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Checks</text>\n  <text x=\"202\" y=\"76.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Result</text>\n  <text x=\"332\" y=\"76.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Owner</text>\n  <rect x=\"16\" y=\"82\" width=\"368\" height=\"18\" fill=\"#eef2ff\"/>\n  <line x1=\"16\" y1=\"100\" x2=\"384\" y2=\"100\" stroke=\"#e5e7eb\"/>\n  <text x=\"22\" y=\"94.0\" font-size=\"8\" fill=\"#333\">curated.orders</text>\n  <text x=\"142\" y=\"94.0\" font-size=\"8\" fill=\"#333\">14 / 16</text>\n  <rect x=\"200\" y=\"84.0\" width=\"122\" height=\"14\" rx=\"7\" fill=\"#333\"/>\n  <text x=\"261.0\" y=\"94.0\" font-size=\"8\" fill=\"#fff\" text-anchor=\"middle\">failed — 132 quarantined</text>\n  <text x=\"332\" y=\"94.0\" font-size=\"8\" fill=\"#333\">notified ✓</text>\n  <line x1=\"16\" y1=\"118\" x2=\"384\" y2=\"118\" stroke=\"#e5e7eb\"/>\n  <text x=\"22\" y=\"112.0\" font-size=\"8\" fill=\"#333\">curated.customers</text>\n  <text x=\"142\" y=\"112.0\" font-size=\"8\" fill=\"#333\">9 / 9</text>\n  <rect x=\"200\" y=\"102.0\" width=\"39\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"219.5\" y=\"112.0\" font-size=\"8\" fill=\"#333\" text-anchor=\"middle\">passed</text>\n  <text x=\"332\" y=\"112.0\" font-size=\"8\" fill=\"#333\">—</text>\n  <line x1=\"16\" y1=\"136\" x2=\"384\" y2=\"136\" stroke=\"#e5e7eb\"/>\n  <text x=\"22\" y=\"130.0\" font-size=\"8\" fill=\"#333\">agg.daily_sales</text>\n  <text x=\"142\" y=\"130.0\" font-size=\"8\" fill=\"#333\">—</text>\n  <rect x=\"200\" y=\"120.0\" width=\"126\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"263.0\" y=\"130.0\" font-size=\"8\" fill=\"#333\" text-anchor=\"middle\">skipped (upstream failed)</text>\n  <text x=\"332\" y=\"130.0\" font-size=\"8\" fill=\"#333\">—</text>\n  <line x1=\"16\" y1=\"154\" x2=\"384\" y2=\"154\" stroke=\"#e5e7eb\"/>\n  <text x=\"22\" y=\"148.0\" font-size=\"8\" fill=\"#333\">curated.products</text>\n  <text x=\"142\" y=\"148.0\" font-size=\"8\" fill=\"#333\">11 / 11</text>\n  <rect x=\"200\" y=\"138.0\" width=\"39\" height=\"14\" rx=\"7\" fill=\"#eee\"/>\n  <text x=\"219.5\" y=\"148.0\" font-size=\"8\" fill=\"#333\" text-anchor=\"middle\">passed</text>\n  <text x=\"332\" y=\"148.0\" font-size=\"8\" fill=\"#333\">—</text>\n  <rect x=\"16\" y=\"166\" width=\"368\" height=\"84\" rx=\"3\" fill=\"#fafafa\" stroke=\"#ccc\"/>\n  <text x=\"26\" y=\"184\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\">Failed checks — curated.orders</text>\n  <text x=\"26\" y=\"202\" font-size=\"8\" fill=\"#333\">✕ unique(order_id) — 132 duplicate rows</text>\n  <text x=\"26\" y=\"218\" font-size=\"8\" fill=\"#333\">✕ relationships(customer_id → curated.customers) — 4 orphans</text>\n  <text x=\"26\" y=\"238\" font-size=\"8\" fill=\"#666\">Failing rows were quarantined; downstream models were not updated.</text>\n  <rect x=\"16\" y=\"262\" width=\"130\" height=\"20\" rx=\"3\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"81.0\" y=\"275.0\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\" text-anchor=\"middle\">Open quarantine</text>\n  <rect x=\"296\" y=\"262\" width=\"88\" height=\"20\" rx=\"3\" fill=\"#2563eb\" stroke=\"#2563eb\"/>\n  <text x=\"340.0\" y=\"275.0\" font-size=\"9\" fill=\"#fff\" font-weight=\"bold\" text-anchor=\"middle\">Re-run</text>\n</svg>"
