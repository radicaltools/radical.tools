{
  "hub": {
    "id": "bp-analytical-data-platform",
    "category": "blueprint",
    "name": "Analytical Data Platform",
    "description": "Lakehouse-style analytics platform: ingestion, storage, transformation and serving, with the requirements, fitness functions and decisions that govern it. Import everything or pick the parts you need; generic controls are linked as related concepts.",
    "tags": [
      "data",
      "analytics",
      "lakehouse",
      "warehouse",
      "etl",
      "governance"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "INGESTION_LATENCY_SECONDS",
        "label": "Event-to-lake latency (s)",
        "hint": "60",
        "type": "number",
        "defaultValue": "60"
      },
      {
        "key": "FRESHNESS_SLA_HOURS",
        "label": "Freshness SLA for critical models (h)",
        "hint": "4",
        "type": "number",
        "defaultValue": "4"
      },
      {
        "key": "QUALITY_PASS_PCT",
        "label": "Test pass rate (%)",
        "hint": "99",
        "type": "number",
        "defaultValue": "99"
      },
      {
        "key": "DAILY_BUDGET",
        "label": "Daily compute budget per team (currency units)",
        "hint": "500",
        "type": "number",
        "defaultValue": "500"
      }
    ],
    "hubRefs": [
      "req-availability",
      "req-encryption",
      "req-least-privilege",
      "req-data-retention",
      "req-gdpr-erasure",
      "ff-data-residency",
      "ff-infra-drift",
      "adr-observability",
      "adr-multi-region"
    ]
  },
