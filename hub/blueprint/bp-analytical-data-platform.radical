      "wireframe": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\">\n  <rect width=\"400\" height=\"300\" fill=\"#fff\"/>\n  <rect x=\"0\" y=\"0\" width=\"400\" height=\"30\" fill=\"#f3f4f6\" stroke=\"#333\"/>\n  <rect x=\"10\" y=\"8\" width=\"14\" height=\"14\" rx=\"3\" fill=\"#ccc\"/>\n  <text x=\"30\" y=\"20\" font-size=\"11\" fill=\"#333\" font-weight=\"bold\">Orchestrator</text>\n  <text x=\"388\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Quarantine</text>\n  <text x=\"322\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Runs</text>\n  <text x=\"286\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Pipelines</text>\n  <text x=\"16\" y=\"46\" font-size=\"8\" fill=\"#2563eb\">← Runs</text>\n  <text x=\"16\" y=\"66\" font-size=\"12\" fill=\"#333\" font-weight=\"bold\">Quarantine · curated.orders</text>\n  <text x=\"16\" y=\"82\" font-size=\"8\" fill=\"#666\">132 rows held back from run 2026-03-24 02:00 · owner notified</text>\n  <rect x=\"16\" y=\"92\" width=\"368\" height=\"22\" fill=\"#f3f4f6\"/>\n  <text x=\"22\" y=\"106.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">order_id</text>\n  <text x=\"102\" y=\"106.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">amount</text>\n  <text x=\"172\" y=\"106.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">customer_id</text>\n  <text x=\"262\" y=\"106.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Failed check</text>\n  <line x1=\"16\" y1=\"136\" x2=\"384\" y2=\"136\" stroke=\"#e5e7eb\"/>\n  <text x=\"22\" y=\"128.0\" font-size=\"8\" fill=\"#333\">98213</text>\n  <text x=\"102\" y=\"128.0\" font-size=\"8\" fill=\"#333\">42.10</text>\n  <text x=\"172\" y=\"128.0\" font-size=\"8\" fill=\"#333\">C-10293</text>\n  <text x=\"262\" y=\"128.0\" font-size=\"8\" fill=\"#333\">unique(order_id)</text>\n  <line x1=\"16\" y1=\"158\" x2=\"384\" y2=\"158\" stroke=\"#e5e7eb\"/>\n  <text x=\"22\" y=\"150.0\" font-size=\"8\" fill=\"#333\">98213</text>\n  <text x=\"102\" y=\"150.0\" font-size=\"8\" fill=\"#333\">42.10</text>\n  <text x=\"172\" y=\"150.0\" font-size=\"8\" fill=\"#333\">C-10293</text>\n  <text x=\"262\" y=\"150.0\" font-size=\"8\" fill=\"#333\">unique(order_id)</text>\n  <line x1=\"16\" y1=\"180\" x2=\"384\" y2=\"180\" stroke=\"#e5e7eb\"/>\n  <text x=\"22\" y=\"172.0\" font-size=\"8\" fill=\"#333\">98277</text>\n  <text x=\"102\" y=\"172.0\" font-size=\"8\" fill=\"#333\">15.00</text>\n  <text x=\"172\" y=\"172.0\" font-size=\"8\" fill=\"#333\">—</text>\n  <text x=\"262\" y=\"172.0\" font-size=\"8\" fill=\"#333\">not_null(customer_id)</text>\n  <line x1=\"16\" y1=\"202\" x2=\"384\" y2=\"202\" stroke=\"#e5e7eb\"/>\n  <rect x=\"22\" y=\"188.5\" width=\"40\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"102\" y=\"188.5\" width=\"30\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"172\" y=\"188.5\" width=\"50\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"262\" y=\"188.5\" width=\"90\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <line x1=\"16\" y1=\"224\" x2=\"384\" y2=\"224\" stroke=\"#e5e7eb\"/>\n  <rect x=\"22\" y=\"210.5\" width=\"40\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"102\" y=\"210.5\" width=\"30\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"172\" y=\"210.5\" width=\"50\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"262\" y=\"210.5\" width=\"90\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"16\" y=\"256\" width=\"120\" height=\"20\" rx=\"3\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"76.0\" y=\"269.0\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\" text-anchor=\"middle\">Download sample</text>\n  <rect x=\"144\" y=\"256\" width=\"110\" height=\"20\" rx=\"3\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"199.0\" y=\"269.0\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\" text-anchor=\"middle\">Discard rows</text>\n  <rect x=\"262\" y=\"256\" width=\"122\" height=\"20\" rx=\"3\" fill=\"#2563eb\" stroke=\"#2563eb\"/>\n  <text x=\"323.0\" y=\"269.0\" font-size=\"9\" fill=\"#fff\" font-weight=\"bold\" text-anchor=\"middle\">Release after fix</text>\n</svg>"
