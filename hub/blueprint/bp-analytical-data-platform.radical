  "sequences": [
    {
      "id": "seq-technical",
      "name": "From event to dashboard",
      "relationIds": [
        "stream--ingestion",
        "ingestion--lake",
        "orchestrator--transform",
        "transform--lake",
        "transform--catalog",
        "analyst--bi",
        "bi--query",
        "query--catalog",
        "query--lake"
      ],
      "stepDescriptions": [
        "Operational events stream into ingestion.",
        "Raw events land in the lake within the freshness target.",
        "Orchestrator schedules the transformation run.",
        "Models turn raw into curated tables; failing rows are quarantined.",
        "Lineage and test results are published to the catalog.",
        "Analyst opens a dashboard.",
        "BI runs the governed query.",
        "Query engine resolves row and column policies for the user.",
        "Curated tables are read with the policies applied."
      ]
    },
    {
      "id": "seq-flow-analyst",
      "name": "Analyst journey",
      "relationIds": [
        "mockup-bi-home--mockup-sales-dashboard",
        "mockup-sales-dashboard--mockup-explore",
        "mockup-explore--mockup-access-request",
        "mockup-access-request--mockup-dataset-lineage",
        "mockup-dataset-lineage--mockup-access-request",
        "mockup-sales-dashboard--mockup-dataset-lineage"
      ],
      "stepDescriptions": [
        "Open → Sales Dashboard. Self-service dashboard showing how fresh the data is; restricted columns are masked for users whose role does not allow them.",
        "Explore → Explore. Self-service exploration; row and column policies from the catalogue still apply.",
        "Request access → Request Access. Access to restricted columns is requested from the dataset owner, time-boxed and audited.",
        "Send request → Dataset & Lineage. Catalogue page for a curated dataset with owner, classification and column-level lineage from source to dashboard.",
        "Request access → Request Access. Access to restricted columns is requested from the dataset owner, time-boxed and audited.",
        "View dataset → Dataset & Lineage. Catalogue page for a curated dataset with owner, classification and column-level lineage from source to dashboard."
      ]
    },
    {
      "id": "seq-flow-data-engineer",
      "name": "Data engineer journey",
      "relationIds": [
        "mockup-pipelines--mockup-quality-runs",
        "mockup-quality-runs--mockup-quarantine",
        "mockup-quarantine--mockup-quality-runs",
        "mockup-pipelines--mockup-freshness"
      ],
      "stepDescriptions": [
        "Open runs → Data Quality Runs. Run results with the quality gate applied: failing records are quarantined, the affected models fail and the dataset owner is notified before anything reaches consumers.",
        "Open quarantine → Quarantine. Rows that failed the quality gate, held back until fixed, discarded or released.",
        "Release after fix → Data Quality Runs. Run results with the quality gate applied: failing records are quarantined, the affected models fail and the dataset owner is notified before anything reaches consumers.",
        "Freshness → Freshness Monitor. Streaming latency against the {{INGESTION_LATENCY_SECONDS}} s target from event to raw zone."
      ]
    }
  ],
