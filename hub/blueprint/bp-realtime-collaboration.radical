{
  "hub": {
    "id": "bp-realtime-collaboration",
    "category": "blueprint",
    "name": "Real-Time Collaboration Platform",
    "description": "A multiplayer document or whiteboard editor: each client holds a local CRDT replica for instant, offline-capable edits, a stateless gateway fleet relays operations and presence between clients over a shared broadcast bus, and periodic snapshots keep reconnects fast — so any number of concurrent collaborators converge without locking or conflicts.",
    "tags": [
      "real-time",
      "collaboration",
      "crdt",
      "offline-first",
      "websocket"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "OFFLINE_GRACE_HOURS",
        "label": "Offline edit merge window (hours)",
        "hint": "72",
        "type": "number",
        "defaultValue": "72"
      },
      {
        "key": "MAX_DOC_COLLABORATORS",
        "label": "Concurrent collaborators per document",
        "hint": "50",
        "type": "number",
        "defaultValue": "50"
      },
      {
        "key": "SNAPSHOT_INTERVAL_OPS",
        "label": "Operations between snapshots",
        "hint": "500",
        "type": "number",
        "defaultValue": "500"
      },
      {
        "key": "PROPAGATION_MS",
        "label": "Presence / op fan-out (ms, p95)",
        "hint": "150",
        "type": "number",
        "defaultValue": "150"
      }
    ],
    "hubRefs": [
      "pattern-crdt-sync",
      "adr-realtime-transport",
      "req-presence-latency",
      "ff-sync-convergence-test",
      "pattern-event-driven",
      "req-availability",
      "req-mfa",
      "adr-tech-stack"
    ]
  },
  "nodes": [
    {
      "id": "collaborator",
      "type": "person",
