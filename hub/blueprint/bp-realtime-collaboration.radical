      "wireframe": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\">\n  <rect width=\"400\" height=\"300\" fill=\"#fff\"/>\n  <rect x=\"0\" y=\"0\" width=\"400\" height=\"300\" rx=\"0\" fill=\"#e5e7eb\" stroke=\"#e5e7eb\"/>\n  <rect x=\"60.0\" y=\"55.0\" width=\"280\" height=\"190\" rx=\"6\" fill=\"#fff\" stroke=\"#333\"/>\n  <text x=\"76.0\" y=\"81.0\" font-size=\"12\" fill=\"#333\" font-weight=\"bold\">Remove Chris Lee?</text>\n  <text x=\"76.0\" y=\"101.0\" font-size=\"9\" fill=\"#333\">Chris is editing 2 documents right now.</text>\n  <rect x=\"76.0\" y=\"117.0\" width=\"9\" height=\"9\" rx=\"2\" fill=\"#fff\" stroke=\"#999\"/>\n  <path d=\"M78.0 121.5 l2 2 l3.5 -4\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n  <text x=\"91.0\" y=\"125.0\" font-size=\"8\" fill=\"#333\">Disconnect open sessions immediately</text>\n  <rect x=\"76.0\" y=\"135.0\" width=\"9\" height=\"9\" rx=\"2\" fill=\"#fff\" stroke=\"#999\"/>\n  <path d=\"M78.0 139.5 l2 2 l3.5 -4\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n  <text x=\"91.0\" y=\"143.0\" font-size=\"8\" fill=\"#333\">Transfer ownership of 5 documents to me</text>\n  <text x=\"76.0\" y=\"167.0\" font-size=\"8\" fill=\"#666\">Further edits from Chris are rejected from now on.</text>\n  <rect x=\"76.0\" y=\"203.0\" width=\"110\" height=\"20\" rx=\"3\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"131.0\" y=\"216.0\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\" text-anchor=\"middle\">Cancel</text>\n  <rect x=\"214.0\" y=\"203.0\" width=\"110\" height=\"20\" rx=\"3\" fill=\"#2563eb\" stroke=\"#2563eb\"/>\n  <text x=\"269.0\" y=\"216.0\" font-size=\"9\" fill=\"#fff\" font-weight=\"bold\" text-anchor=\"middle\">Remove</text>\n</svg>"
