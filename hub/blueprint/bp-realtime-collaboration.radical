      "y": 1160
    },
    {
      "id": "req-offline-merge",
      "type": "requirement",
      "label": "Offline Edit Merge Window",
      "x": 0,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "a client reconnects after being offline",
      "action": "replay its local operation log against the server and merge without data loss or manual conflict resolution, even after up to {{OFFLINE_GRACE_HOURS}} hours offline",
      "rationale": "Local-first only pays off if reconnecting after a real gap — a flight, a dead laptop battery — is as unremarkable as reconnecting after a second's blip.",
      "templateParams": [
        {
          "key": "OFFLINE_GRACE_HOURS",
          "label": "Offline edit merge window (hours)",
          "hint": "72",
          "type": "number",
          "defaultValue": "72"
        }
      ]
    },
    {
      "id": "req-room-capacity",
      "type": "requirement",
      "label": "Concurrent Collaborator Capacity",
      "x": 320,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "should",
      "action": "support at least {{MAX_DOC_COLLABORATORS}} concurrent collaborators per document without a perceptible increase in edit propagation latency",
      "rationale": "A collaboration feature that visibly slows down exactly when a lot of people show up fails at the moment it matters most.",
      "templateParams": [
        {
          "key": "MAX_DOC_COLLABORATORS",
          "label": "Concurrent collaborators per document",
          "hint": "50",
          "type": "number",
          "defaultValue": "50"
        }
      ]
    },
    {
      "id": "req-access-revocation",
      "type": "requirement",
      "label": "Access Revocation Propagation",
      "x": 640,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "a workspace admin revokes a collaborator's access to a document",
      "action": "disconnect that collaborator's active session and reject any further operations from them within seconds, not only on their next reconnect",
      "rationale": "A local-first replica keeps a full copy of the document; revocation has to end the live session immediately, or removing access is theatre."
    },
    {
      "id": "req-snapshot-recovery",
      "type": "requirement",
      "label": "Snapshot-Free Recovery Point",
      "x": 960,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "should",
      "action": "be able to reconstruct any document's state as of any point in the last {{SNAPSHOT_INTERVAL_OPS}}-operation window from the op log alone, without the snapshot store",
      "rationale": "The op log, not the snapshot, is the actual system of record; the snapshot store is only ever a performance optimisation and must stay one, not a hidden second source of truth.",
      "templateParams": [
        {
          "key": "SNAPSHOT_INTERVAL_OPS",
          "label": "Operations between snapshots",
          "hint": "500",
          "type": "number",
          "defaultValue": "500"
        }
      ]
    },
    {
      "id": "ff-presence-fanout-guard",
      "type": "fitness-fn",
      "label": "Presence Fan-out Latency Guard",
      "description": "Measures the time from an accepted operation to it being delivered to every other connected replica of the same document.",
      "x": 0,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "continuous",
      "threshold": "p95 presence / operation fan-out to all connected replicas stays under {{PROPAGATION_MS}} ms",
      "status": "proposed"
    },
    {
      "id": "ff-snapshot-compaction-lag",
      "type": "fitness-fn",
      "label": "Snapshot Compaction Lag",
      "description": "Checks how far behind the snapshot worker is on any actively-edited document.",
      "x": 320,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "periodic",
      "threshold": "Op log for any active document never exceeds {{SNAPSHOT_INTERVAL_OPS}} unsnapshotted operations",
      "status": "proposed"
    },
    {
      "id": "ff-reconnect-success-rate",
      "type": "fitness-fn",
      "label": "Reconnect Success Rate",
      "description": "Tracks whether a client reconnecting after a network blip resumes syncing or falls back to a full document re-download.",
      "x": 640,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "continuous",
      "threshold": "At least 99.9% of reconnect attempts resume syncing without a full document re-download",
      "status": "proposed"
    },
    {
      "id": "adr-crdt-over-ot",
      "type": "adr",
      "label": "ADR: CRDT over Operational Transformation",
      "x": 0,
      "y": 1912,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "status": "accepted",
      "date": "",
      "context": "Concurrent edits from many clients need to merge without a central lock and, ideally, without a live connection to a sequencing server.",
      "decision": "Use CRDTs for the document's data structure rather than Operational Transformation.",
      "consequences": "No central transform server is required and offline editing works without special-casing; CRDT metadata overhead grows with edit history and needs periodic compaction and tombstone pruning.",
      "alternatives": "1. Operational Transformation — proven at large scale, but requires a central sequencing server and is notoriously hard to implement correctly for rich documents. 2. Lock-based pessimistic editing — simplest to reason about, but kills the \"everyone edits at once\" experience. 3. Last-write-wins on the whole document — trivial, but silently discards concurrent edits. 4. CRDT (chosen)."
    },
    {
      "id": "adr-stateless-gateway-fleet",
      "type": "adr",
      "label": "ADR: Stateless gateway fleet with a shared broadcast bus",
      "x": 320,
      "y": 1912,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "status": "accepted",
      "date": "",
      "context": "WebSocket connections need to scale horizontally while every replica of a document stays in sync regardless of which gateway instance a client lands on.",
      "decision": "Gateways hold no document state themselves; they publish and subscribe to operations through a shared broadcast bus, so any instance can serve any client.",
      "consequences": "Gateway instances scale and restart freely with no handoff logic, but every operation takes an extra hop through the bus, adding a small amount of latency to the common case.",
      "alternatives": "1. Sticky sessions routing all of a document's clients to one gateway instance — lower latency per operation, but that instance becomes a single point of failure and a hot-spot for popular documents. 2. Shared broadcast bus (chosen). 3. Peer-to-peer mesh between clients — no server bottleneck, but NAT traversal and offline persistence become much harder to get right."
    },
