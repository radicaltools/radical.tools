  "sequences": [
    {
      "id": "bp-realtime-collaboration-seq",
      "name": "An edit is accepted, broadcast, and persisted",
      "relationIds": [
        "editor-client--sync-gateway",
        "sync-gateway--permission-service",
        "sync-gateway--op-broadcast-bus",
        "op-broadcast-bus--sync-gateway",
        "sync-gateway--op-log-store"
      ],
      "stepDescriptions": [
        "Collaborator edits; the local CRDT applies the change instantly and sends the resulting operation to the gateway.",
        "Gateway checks the operation is still within the collaborator's current access before accepting it.",
        "Gateway publishes the accepted operation onto the broadcast bus.",
        "Every other gateway instance receives it and relays it to its own connected replicas — merge order doesn't matter, so this can happen in any order relative to other concurrent edits.",
        "The originating gateway durably appends the operation to the op log."
      ]
    }
  ],
