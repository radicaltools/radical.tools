y=\"184\" font-size=\"7.5\" fill=\"#666\">Ben</text>\n  <rect x=\"40\" y=\"206\" width=\"300\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"40\" y=\"217\" width=\"300\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <rect x=\"40\" y=\"228\" width=\"180\" height=\"5\" rx=\"2\" fill=\"#e5e7eb\"/>\n  <text x=\"40\" y=\"280\" font-size=\"8\" fill=\"#2563eb\">Show what changed while I was offline</text>\n</svg>"
