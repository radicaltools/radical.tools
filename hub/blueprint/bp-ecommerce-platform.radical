1=\"252\" x2=\"102\" y2=\"292\" stroke=\"#ccc\"/>\n  <line x1=\"102\" y1=\"252\" x2=\"16\" y2=\"292\" stroke=\"#ccc\"/>\n  <rect x=\"110\" y=\"252\" width=\"86\" height=\"40\" rx=\"3\" fill=\"#eee\" stroke=\"#ccc\"/>\n  <line x1=\"110\" y1=\"252\" x2=\"196\" y2=\"292\" stroke=\"#ccc\"/>\n  <line x1=\"196\" y1=\"252\" x2=\"110\" y2=\"292\" stroke=\"#ccc\"/>\n  <rect x=\"204\" y=\"252\" width=\"86\" height=\"40\" rx=\"3\" fill=\"#eee\" stroke=\"#ccc\"/>\n  <line x1=\"204\" y1=\"252\" x2=\"290\" y2=\"292\" stroke=\"#ccc\"/>\n  <line x1=\"290\" y1=\"252\" x2=\"204\" y2=\"292\" stroke=\"#ccc\"/>\n  <rect x=\"298\" y=\"252\" width=\"86\" height=\"40\" rx=\"3\" fill=\"#eee\" stroke=\"#ccc\"/>\n  <line x1=\"298\" y1=\"252\" x2=\"384\" y2=\"292\" stroke=\"#ccc\"/>\n  <line x1=\"384\" y1=\"252\" x2=\"298\" y2=\"292\" stroke=\"#ccc\"/>\n</svg>"
