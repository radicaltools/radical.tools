{
  "hub": {
    "id": "bp-ecommerce-platform",
    "category": "blueprint",
    "name": "E-commerce Platform",
    "description": "Modular commerce backend — storefront, catalogue, cart and checkout, orders, payments and fulfilment — with the controls a payment-handling system needs. Generic requirements, fitness functions and decisions are linked as related concepts.",
    "tags": [
      "e-commerce",
      "retail",
      "payments",
      "microservices",
      "event-driven"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "CHECKOUT_P95_MS",
        "label": "p95 checkout step latency (ms)",
        "hint": "800",
        "type": "number",
        "defaultValue": "800"
      },
      {
        "key": "RESERVATION_MINUTES",
        "label": "Reservation hold (min)",
        "hint": "15",
        "type": "number",
        "defaultValue": "15"
      },
      {
        "key": "MAX_DROP_PP",
        "label": "Max step-conversion drop vs 7-day baseline (pp)",
        "hint": "3",
        "type": "number",
        "defaultValue": "3"
      },
      {
        "key": "INDEX_LAG_SECONDS",
        "label": "Max catalogue-to-index lag (s)",
        "hint": "30",
        "type": "number",
        "defaultValue": "30"
      }
    ],
    "hubRefs": [
