    {
      "id": "req-checkout-latency",
      "type": "requirement",
      "label": "Checkout Step Latency",
      "x": 0,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "a shopper submits a checkout step (address, shipping, payment)",
      "action": "respond within {{CHECKOUT_P95_MS}} ms at the 95th percentile including tax, shipping and payment-provider calls",
      "rationale": "Checkout is where latency converts directly into abandoned carts; every step has a visible cost.",
      "templateParams": [
        {
          "key": "CHECKOUT_P95_MS",
          "label": "p95 checkout step latency (ms)",
          "hint": "800",
          "type": "number",
          "defaultValue": "800"
        }
      ]
    },
    {
      "id": "req-payment-once",
      "type": "requirement",
      "label": "Exactly-Once Payment Capture",
      "x": 320,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "capture payment for an order at most once, using the provider's idempotency key derived from the order id, and reconcile captures against orders daily",
      "rationale": "Double charges are the most damaging defect a shop can ship; idempotency at the provider boundary plus reconciliation makes them detectable and preventable."
    },
    {
      "id": "req-stock-reservation",
      "type": "requirement",
      "label": "Stock Reservation",
      "x": 640,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "an order is placed",
      "action": "reserve stock for each line within the same transaction that records the order and release it automatically if payment is not captured within {{RESERVATION_MINUTES}} minutes",
      "rationale": "Overselling creates cancellations and support load; unbounded reservations starve other shoppers.",
      "templateParams": [
        {
          "key": "RESERVATION_MINUTES",
          "label": "Reservation hold (min)",
          "hint": "15",
          "type": "number",
          "defaultValue": "15"
        }
      ]
    },
    {
      "id": "req-pci-scope",
      "type": "requirement",
      "label": "No Card Data at Rest",
      "x": 960,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "never store, log or transmit primary account numbers through platform services; use provider tokenisation and hosted payment fields so card data reaches only the provider",
      "rationale": "Keeping card data out of the platform reduces PCI DSS scope from the whole system to the integration boundary."
    },
    {
      "id": "ff-checkout-conversion",
      "type": "fitness-fn",
      "label": "Checkout Funnel Guard",
      "description": "Compares per-step checkout conversion from product analytics with the trailing 7-day baseline after each deployment; a significant drop triggers rollback review.",
      "x": 0,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "holistic",
      "automated": true,
      "trigger": "continuous",
      "threshold": "No checkout step conversion more than {{MAX_DROP_PP}} pp below baseline in the hour after a release",
      "status": "proposed",
      "templateParams": [
        {
          "key": "MAX_DROP_PP",
          "label": "Max step-conversion drop vs 7-day baseline (pp)",
          "hint": "3",
          "type": "number",
          "defaultValue": "3"
        }
      ]
    },
    {
      "id": "ff-payment-reconciliation",
      "type": "fitness-fn",
      "label": "Payment Reconciliation",
      "description": "Nightly job matches provider settlement reports against captured payments and orders; unmatched records are reported to finance and on-call.",
      "x": 320,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "periodic",
      "threshold": "0 unmatched captures or orders older than 24 h",
      "status": "proposed"
    },
    {
      "id": "ff-search-freshness",
      "type": "fitness-fn",
      "label": "Search Index Freshness",
      "description": "Measures the lag between catalogue changes and their appearance in the search projection via a canary product updated every minute.",
      "x": 640,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "continuous",
      "threshold": "Index lag ≤ {{INDEX_LAG_SECONDS}} s",
      "status": "proposed",
      "templateParams": [
        {
          "key": "INDEX_LAG_SECONDS",
          "label": "Max catalogue-to-index lag (s)",
          "hint": "30",
          "type": "number",
          "defaultValue": "30"
        }
      ]
    },
    {
      "id": "adr-hosted-payments",
      "type": "adr",
      "label": "ADR: Hosted payment fields",
      "x": 0,
      "y": 1912,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "status": "accepted",
      "date": "",
      "context": "Handling card data directly puts the entire platform in PCI DSS scope with yearly audits and strict controls.",
      "decision": "Use the provider's hosted fields and tokenisation; the platform stores only payment tokens and intent ids.",
      "consequences": "PCI scope shrinks to SAQ A-EP level; checkout UI is partially controlled by the provider; switching providers requires re-tokenisation.",
      "alternatives": "1. Own card form with server-side tokenisation — more control, full PCI scope. 2. Redirect to provider page — smallest scope, visibly worse UX."
    },
    {
      "id": "adr-database-per-service",
      "type": "adr",
      "label": "ADR: Database per service",
      "x": 320,
      "y": 1912,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "status": "accepted",
      "date": "",
      "context": "A shared schema couples deployment of all services and makes ownership of data ambiguous.",
      "decision": "Each service owns its store; other services get data through APIs or events, never through the database.",
      "consequences": "Independent deployment and scaling; cross-service reports require projections or a data platform; joins across services are not possible in SQL.",
      "alternatives": "1. Shared database — simple joins, tight coupling. 2. Shared schema with per-service tables — coupling through migrations remains."
    },
