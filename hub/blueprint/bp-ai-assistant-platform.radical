      "wireframe": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 300\" font-family=\"sans-serif\">\n  <rect width=\"400\" height=\"300\" fill=\"#fff\"/>\n  <rect x=\"0\" y=\"0\" width=\"400\" height=\"30\" fill=\"#f3f4f6\" stroke=\"#333\"/>\n  <rect x=\"10\" y=\"8\" width=\"14\" height=\"14\" rx=\"3\" fill=\"#ccc\"/>\n  <text x=\"30\" y=\"20\" font-size=\"11\" fill=\"#333\" font-weight=\"bold\">Agent Console</text>\n  <text x=\"388\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Audit</text>\n  <text x=\"347\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">My cases</text>\n  <text x=\"291\" y=\"19\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Queue</text>\n  <text x=\"16\" y=\"54\" font-size=\"12\" fill=\"#333\" font-weight=\"bold\">Case audit trail</text>\n  <rect x=\"16\" y=\"64\" width=\"200\" height=\"18\" rx=\"2\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"22\" y=\"76.0\" font-size=\"8\" fill=\"#999\">Case, customer or agent</text>\n  <rect x=\"224\" y=\"64\" width=\"80\" height=\"18\" rx=\"2\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"230\" y=\"76.0\" font-size=\"8\" fill=\"#999\">90 days</text>\n  <path d=\"M292 71 l4 4 l4 -4\" fill=\"none\" stroke=\"#666\"/>\n  <rect x=\"312\" y=\"64\" width=\"72\" height=\"18\" rx=\"3\" fill=\"#2563eb\" stroke=\"#2563eb\"/>\n  <text x=\"348.0\" y=\"76.0\" font-size=\"9\" fill=\"#fff\" font-weight=\"bold\" text-anchor=\"middle\">Search</text>\n  <rect x=\"16\" y=\"94\" width=\"368\" height=\"24\" fill=\"#f3f4f6\"/>\n  <text x=\"22\" y=\"109.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Case</text>\n  <text x=\"72\" y=\"109.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Decision</text>\n  <text x=\"202\" y=\"109.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Conf.</text>\n  <text x=\"252\" y=\"109.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">Sources</text>\n  <text x=\"312\" y=\"109.0\" font-size=\"8\" fill=\"#333\" font-weight=\"bold\">By</