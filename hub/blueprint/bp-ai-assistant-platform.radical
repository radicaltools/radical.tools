      "targetId": "mockup-quality-drift",
      "relationType": "navigates-to",
      "label": "Quality"
    },
    {
      "id": "mockup-quality-drift--platform",
      "sourceId": "mockup-quality-drift",
      "targetId": "platform",
      "relationType": "presented-by"
    },
    {
      "id": "mockup-quality-drift--mockup-kb-sources",
      "sourceId": "mockup-quality-drift",
      "targetId": "mockup-kb-sources",
      "relationType": "navigates-to",
      "label": "Fix stale source"
    }
  ],
  "sequences": [
    {
      "id": "bp-ai-assistant-platform-seq",
      "name": "Autonomous resolution with escalation fallback",
      "relationIds": [
        "customer--ingestion-api",
        "ingestion-api--orchestrator",
        "orchestrator--retriever",
        "retriever--knowledge-base",
        "orchestrator--handoff-queue",
        "handoff-queue--agent-console",
        "agent-console--case-store"
      ],
      "stepDescriptions": [
        "Customer submits a request.",
        "Ingestion API opens a case and hands it to the orchestrator.",
        "Orchestrator requests grounding context from the retriever.",
        "Retriever finds the supporting passages in the knowledge base.",
        "Confidence is below threshold, or the proposed action is irreversible, so the orchestrator escalates instead of acting.",
        "The case surfaces in the handoff queue for the next available agent.",
        "The agent resolves it from the console; had confidence been high enough, the orchestrator would instead have answered the customer directly."
      ]
    },
    {
      "id": "seq-flow-customer",
      "name": "Customer journey",
      "relationIds": [
        "mockup-chat-start--mockup-chat-answer",
        "mockup-chat-answer--mockup-support-chat",
        "mockup-support-chat--mockup-chat-human"
      ],
      "stepDescriptions": [
        "Ask → Chat — Grounded Answer. Answer grounded in retrieved sources; actions need the customer's confirmation.",
        "Not resolved → Chat — Handoff. Customer-facing chat: the assistant answers with cited sources when it can ground the answer and hands off to a person when it cannot.",
        "Agent joins → Chat — Agent Joined. A person joins with the full case history, within {{ESCALATION_SLA_MIN}} minutes of the handoff."
      ]
    },
    {
      "id": "seq-flow-human-agent",
      "name": "Human agent journey",
      "relationIds": [
        "mockup-escalation-queue--mockup-case-review",
        "mockup-case-review--mockup-case-resolved",
        "mockup-case-resolved--mockup-case-audit",
        "mockup-case-resolved--mockup-escalation-queue"
      ],
      "stepDescriptions": [
        "Pick up → Case Review. The assistant's proposed action with its confidence, per-field extraction confidence (below {{EXTRACTION_REVIEW_THRESHOLD_PCT}}% needs review) and the sources it used.",
        "Approve & send → Case Resolved. Resolution with every autonomous and human decision recorded for {{AUDIT_RETENTION_DAYS}} days.",
        "Audit trail → Case Audit Trail. Search decisions, sources and confidence across cases for audits.",
        "Next case → Escalation Queue. Human agents pick up escalated cases oldest-first; each case must be picked up within {{ESCALATION_SLA_MIN}} minutes."
      ]
    },
    {
      "id": "seq-flow-assistant-ops",
      "name": "Assistant ops journey",
      "relationIds": [
        "mockup-kb-sources--mockup-quality-drift",
        "mockup-quality-drift--mockup-kb-sources"
      ],
      "stepDescriptions": [
        "Quality → Quality & Drift. Autonomous resolution rate, eval results and cost per case.",
        "Fix stale source → Knowledge Sources. Source sync status against the {{KB_STALENESS_HOURS}}-hour freshness limit."
      ]
    }
  ],
