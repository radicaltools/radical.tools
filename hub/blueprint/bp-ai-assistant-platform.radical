      "description": "Where customer requests originate — shared inbox, chat widget, or ticketing system.",
      "width": 360,
      "height": 260,
      "collapsed": false,
      "x": 420,
      "y": 1160
    },
    {
      "id": "req-escalation-pickup",
      "type": "requirement",
      "label": "Escalation Pickup Time",
      "x": 0,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "a case is escalated to the human queue",
      "action": "be picked up by an available human agent within {{ESCALATION_SLA_MIN}} minutes",
      "rationale": "An escalation nobody picks up is worse than not escalating at all — the customer is left waiting on a channel no one is actively watching.",
      "templateParams": [
        {
          "key": "ESCALATION_SLA_MIN",
          "label": "Escalation pickup SLA (min)",
          "hint": "15",
          "type": "number",
          "defaultValue": "15"
        }
      ]
    },
    {
      "id": "req-extraction-review",
      "type": "requirement",
      "label": "Low-Confidence Extraction Review",
      "x": 320,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "extracted-field confidence for a case falls below {{EXTRACTION_REVIEW_THRESHOLD_PCT}}%",
      "action": "route the case to a human review queue instead of auto-filing the extracted values",
      "rationale": "Auto-filing a low-confidence extraction — wrong order id, wrong amount — fails silently and is expensive to trace back; a review queue makes the uncertainty visible instead.",
      "templateParams": [
        {
          "key": "EXTRACTION_REVIEW_THRESHOLD_PCT",
          "label": "Extraction review threshold (%)",
          "hint": "90",
          "type": "number",
          "defaultValue": "90"
        }
      ]
    },
    {
      "id": "req-kb-freshness",
      "type": "requirement",
      "label": "Knowledge Base Freshness",
      "x": 640,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "should",
      "action": "keep the retrieval knowledge base no more than {{KB_STALENESS_HOURS}} hours behind the source-of-truth content systems it's built from",
      "rationale": "A grounded answer is only as good as what's indexed; stale policy content produces confidently wrong, fully-cited answers.",
      "templateParams": [
        {
          "key": "KB_STALENESS_HOURS",
          "label": "Max knowledge base staleness (hours)",
          "hint": "4",
          "type": "number",
          "defaultValue": "4"
        }
      ]
    },
    {
      "id": "req-case-audit-trail",
      "type": "requirement",
      "label": "Case Decision Audit Trail",
      "x": 960,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "log every autonomous decision, the sources retrieved, and the confidence score for each case, retained for {{AUDIT_RETENTION_DAYS}} days",
      "rationale": "When an autonomous decision is questioned later, the trail has to already exist — it can't be reconstructed from a model that doesn't remember why it answered the way it did.",
      "templateParams": [
        {
          "key": "AUDIT_RETENTION_DAYS",
          "label": "Case audit trail retention (days)",
          "hint": "365",
          "type": "number",
          "defaultValue": "365"
        }
      ]
    },
    {
      "id": "ff-escalation-backlog-guard",
      "type": "fitness-fn",
      "label": "Escalation Backlog Guard",
      "description": "Watches the handoff queue depth against on-duty agent headcount.",
      "x": 0,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "continuous",
      "threshold": "Handoff queue depth never exceeds 5 open cases per on-duty agent",
      "status": "proposed"
    },
    {
      "id": "ff-extraction-drift-monitor",
      "type": "fitness-fn",
      "label": "Extraction Accuracy Drift Monitor",
      "description": "Compares live, human-reviewed extraction accuracy against the offline evaluation-set baseline.",
      "x": 320,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "periodic",
      "threshold": "Live sampled extraction accuracy stays within 3 pp of the offline evaluation-set baseline, checked weekly",
      "status": "proposed"
    },
    {
      "id": "ff-cost-per-case-guard",
      "type": "fitness-fn",
      "label": "Cost per Resolved Case Guard",
      "description": "Tracks fully-loaded cost (LLM calls, compute, human time) per case actually resolved.",
      "x": 640,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "periodic",
      "threshold": "Fully-loaded cost per autonomously resolved case stays under $2.50, checked daily",
      "status": "proposed"
    },
    {
      "id": "adr-confidence-gated-autonomy",
      "type": "adr",
      "label": "ADR: Confidence-gated autonomy, not full automation",
      "x": 0,
      "y": 1912,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "status": "accepted",
      "date": "",
      "context": "Full automation maximises savings but makes every wrong autonomous action a direct customer-facing incident; full human review eliminates the savings automation exists to capture.",
      "decision": "The orchestrator acts autonomously only above the confidence threshold and only for a pre-approved list of reversible action types; everything else queues for a human.",
      "consequences": "Wrong autonomous actions are bounded to low-stakes, reversible ones; the pre-approved action list becomes a piece of configuration that has to be reviewed as deliberately as code.",
      "alternatives": "1. Fully autonomous with post-hoc audit — highest savings, but irreversible mistakes reach the customer before anyone reviews them. 2. Human-in-the-loop for every action — safest, but removes the automation benefit entirely. 3. Confidence-gated autonomy on reversible actions only (chosen). 4. Rule-based automation without model judgement calls — safe and predictable, but handles far fewer cases."
    },
    {
      "id": "adr-retrieval-over-finetuning",
      "type": "adr",
      "label": "ADR: Retrieval over fine-tuning for knowledge updates",
      "x": 320,
      "y": 1912,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "status": "accepted",
      "date": "",
      "context": "The knowledge the assistant needs — policies, prices, procedures — changes far more often than a model retraining cycle can track.",
      "decision": "Keep the base model frozen and push knowledge updates through the retrieval index rather than fine-tuning on new content.",
      "consequences": "Knowledge freshness becomes index-refresh latency instead of training-cycle latency, but overall answer quality is now capped by retrieval quality, not just model quality.",
      "alternatives": "1. Periodic fine-tuning on new knowledge — keeps knowledge \"in\" the model, but the feedback loop is slow and risks catastrophic forgetting of earlier knowledge. 2. Retrieval only (chosen). 3. Retrieval plus light fine-tuning for tone and format only — a reasonable hybrid, at the cost of a second training pipeline. 4. Stuffing all knowledge into the prompt without retrieval — doesn't scale past a small, static document set."
    }
  ],
