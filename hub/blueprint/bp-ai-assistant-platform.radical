{
  "hub": {
    "id": "bp-ai-assistant-platform",
    "category": "blueprint",
    "name": "AI Support Assistant Platform",
    "description": "A retrieval-grounded AI agent that resolves customer or ops requests end to end where it safely can, extracts structured data from inbound tickets and documents, and hands off to a human when confidence is low or the action is irreversible — with a continuous evaluation gate blocking any model or prompt change that regresses quality.",
    "tags": [
      "ai",
      "llm",
      "rag",
      "agentic-ai",
      "customer-support",
      "governance"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "ESCALATION_SLA_MIN",
        "label": "Escalation pickup SLA (min)",
        "hint": "15",
        "type": "number",
        "defaultValue": "15"
      },
      {
        "key": "EXTRACTION_REVIEW_THRESHOLD_PCT",
        "label": "Extraction review threshold (%)",
        "hint": "90",
        "type": "number",
        "defaultValue": "90"
      },
      {
        "key": "KB_STALENESS_HOURS",
        "label": "Max knowledge base staleness (hours)",
        "hint": "4",
        "type": "number",
        "defaultValue": "4"
      },
      {
        "key": "AUDIT_RETENTION_DAYS",
        "label": "Case audit trail retention (days)",
        "hint": "365",
        "type": "number",
        "defaultValue": "365"
      }
    ],
    "hubRefs": [
      "req-ai-groundedness",
      "req-ai-human-handoff",
      "req-ai-autonomous-resolution",
      "req-ml-extraction-accuracy",
      "ff-ai-eval-gate",
      "pattern-rag-pipeline",
      "adr-llm-provider-strategy",
      "req-audit-logging",
      "req-encryption",
      "adr-tech-stack"
    ]
  },
