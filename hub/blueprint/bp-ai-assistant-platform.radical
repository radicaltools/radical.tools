      "targetId": "req-kb-freshness",
      "relationType": "illustrates"
    },
    {
      "id": "mockup-kb-sources--platform",
      "sourceId": "mockup-kb-sources",
      "targetId": "platform",
      "relationType": "presented-by"
    },
    {
