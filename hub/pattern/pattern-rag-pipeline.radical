      ],
      "stepDescriptions": [
        "User asks a question.",
        "Orchestrator asks the retriever for supporting context.",
        "Retriever embeds the question and finds the closest passages in the vector store.",
        "Orchestrator sends the question plus retrieved passages to the LLM.",
        "Orchestrator returns the answer with citations to the retrieved passages — or a refusal if nothing relevant was retrieved."
      ]
    }
