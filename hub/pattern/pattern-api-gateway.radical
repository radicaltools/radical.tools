{
  "hub": {
    "id": "pattern-api-gateway",
    "category": "pattern",
    "name": "API Gateway",
    "description": "A single entry point that terminates TLS, authenticates callers, enforces quotas and routes requests to backend services, so the services themselves stay free of edge concerns.",
    "tags": [
      "api-gateway",
      "edge",
      "security",
      "routing",
      "microservices"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "hubRefs": [
      "req-auth",
      "req-rate-limiting",
      "adr-auth-strategy",
      "pattern-microservices"
    ]
  },
