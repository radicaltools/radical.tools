{
  "hub": {
    "id": "pattern-event-driven",
    "category": "pattern",
    "name": "Event-Driven Architecture",
    "description": "Producers publish immutable domain events to a durable event bus; any number of consumers react independently. Decouples teams and services in time, availability and deployment.",
    "tags": [
      "event-driven",
      "messaging",
      "asynchronous",
      "decoupling",
      "kafka"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "hubRefs": [
      "adr-integration-style",
      "adr-event-schema-evolution",
      "req-event-schema-compatibility",
      "req-idempotency",
      "pattern-transactional-outbox",
      "adr-data-consistency-model"
    ]
  },
  "nodes": [
