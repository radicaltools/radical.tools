{
  "hub": {
    "id": "pattern-bff",
    "category": "pattern",
    "name": "Backend for Frontend (BFF)",
    "description": "Each client channel gets its own thin backend shaped around that channel's screens and interaction model, instead of every channel consuming one generic API. Aggregation, field-shaping and channel-specific session handling live in the BFF; domain logic stays in the services behind it.",
    "tags": [
      "bff",
      "api-aggregation",
      "mobile",
      "frontend",
      "api-gateway"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "hubRefs": [
      "pattern-api-gateway",
      "req-page-load-time",
      "adr-integration-style"
    ]
  },
  "nodes": [
