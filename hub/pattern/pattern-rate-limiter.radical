{
  "hub": {
    "id": "pattern-rate-limiter",
    "category": "pattern",
    "name": "Rate Limiter (Token Bucket)",
    "description": "Requests are metered against a per-client token bucket at the edge before they reach any backend service. Buckets refill at a fixed rate, absorbing short bursts while enforcing a hard ceiling on sustained traffic per client.",
    "tags": [
      "rate-limiting",
      "throttling",
      "token-bucket",
      "api-gateway",
      "resilience"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "hubRefs": [
      "pattern-api-gateway",
      "req-rate-limiting",
      "req-throughput"
    ]
  },
  "nodes": [
    {
      "id": "client",
      "type": "person",
      "label": "API Client",
      "description": "A third-party integration or another internal service.",
      "width": 150,
      "height": 170,
      "collapsed": false,
      "x": 0,
      "y": 0
    },
    {
      "id": "platform",
      "type": "system",
      "label": "Public API",
      "description": "Protects shared capacity and enforces fair use per API key.",
      "width": 590,
      "height": 580,
      "collapsed": false,
      "x": 0,
      "y": 290
    },
    {
      "id": "gateway",
      "type": "container",
      "label": "API Gateway",
      "description": "Enforces a per-key token bucket before forwarding any request.",
      "technology": "Envoy / Lua filter",
      "parentId": "platform",
      "width": 300,
      "height": 200,
      "collapsed": false,
      "x": 30,
      "y": 110
    },
    {
      "id": "limit-store",
      "type": "database",
      "label": "Rate Limit Store",
      "description": "Shared token-bucket counters, so the limit holds across every gateway instance.",
      "technology": "Redis",
      "parentId": "platform",
      "width": 190,
      "height": 130,
      "collapsed": false,
      "x": 370,
      "y": 110
    },
    {
      "id": "backend-service",
      "type": "container",
      "label": "Backend Service",
      "description": "Only ever sees traffic that already passed the limiter.",
      "technology": "Java",
      "parentId": "platform",
      "width": 300,
      "height": 200,
      "collapsed": false,
      "x": 30,
      "y": 350
    }
  ],
  "relations": [
    {
      "id": "client--gateway",
      "sourceId": "client",
      "targetId": "gateway",
      "label": "Sends request with API key",
      "technology": "HTTPS"
    },
    {
      "id": "gateway--limit-store",
      "sourceId": "gateway",
      "targetId": "limit-store",
      "label": "Checks and decrements the caller's token bucket",
      "technology": "RESP"
    },
    {
      "id": "gateway--backend-service",
      "sourceId": "gateway",
      "targetId": "backend-service",
      "label": "Forwards if a token was available",
      "technology": "HTTPS"
    },
    {
      "id": "gateway--client",
      "sourceId": "gateway",
      "targetId": "client",
      "label": "Otherwise rejects with 429 + Retry-After",
      "technology": "HTTPS"
    }
  ]
}
