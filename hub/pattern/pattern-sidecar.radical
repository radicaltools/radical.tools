{
  "hub": {
    "id": "pattern-sidecar",
    "category": "pattern",
    "name": "Sidecar (Service Mesh)",
    "description": "A proxy process runs alongside each service instance and intercepts all of its network traffic, handling mTLS, retries, timeouts and telemetry so the service's own code stays free of that logic. A control plane pushes routing and security policy to every sidecar.",
    "tags": [
      "sidecar",
      "service-mesh",
      "mtls",
      "observability",
      "infrastructure"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "hubRefs": [
      "pattern-circuit-breaker",
      "req-distributed-tracing",
      "req-least-privilege"
    ]
  },
  "nodes": [
    {
      "id": "platform",
      "type": "system",
      "label": "Service Mesh",
      "description": "Cross-cutting network concerns move out of application code and into a uniform sidecar proxy per instance.",
      "width": 620,
      "height": 640,
      "collapsed": false,
      "x": 0,
      "y": 0
    },
    {
