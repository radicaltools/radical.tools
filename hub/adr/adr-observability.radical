  "nodes": [
    {
      "id": "adr-observability-1",
      "type": "adr",
      "label": "ADR: OpenTelemetry-based observability",
      "x": 0,
      "y": 0,
      "width": 180,
      "height": 52,
      "collapsed": false,
      "status": "proposed",
      "date": "",
      "context": "Operating a distributed system requires correlating logs, metrics and traces across services during incidents and measuring SLOs continuously. Forces: avoiding per-vendor instrumentation lock-in, cost of high-cardinality telemetry at scale, data residency of logs that may contain personal data, and the team's ability to run stateful backends.",
      "decision": "Instrument all services with OpenTelemetry SDKs and export through an OpenTelemetry Collector. Metrics are stored in {{METRICS_BACKEND}}, logs in {{LOGS_BACKEND}}, traces in {{TRACES_BACKEND}}. Services never depend on a vendor SDK directly; the Collector is the only place where backends are configured.",
      "consequences": "• Backends can be swapped or added by changing Collector configuration, not application code.\n• Every log line and span carries trace id, service name and version, enabling pivoting between signals.\n• Sampling, redaction of personal data and retention are enforced centrally in the Collector pipeline.\n• The Collector is a critical shared component and needs capacity planning and its own monitoring.\n• Teams must agree on naming conventions for metrics and attributes to keep dashboards reusable.",
      "alternatives": "1. Single commercial APM suite — fastest time to value; per-host or per-GB pricing grows steeply and instrumentation is vendor-specific.\n2. Hyperscaler-native tooling (CloudWatch, Azure Monitor, Cloud Operations) — no extra infrastructure; weaker cross-cloud and local-development story.\n3. ELK for everything — mature logging; metrics and traces are second-class and storage cost is high.\n4. No tracing, logs and metrics only — lower cost; root-causing latency across services becomes guesswork."
    }
  ],
  "relations": []
}
