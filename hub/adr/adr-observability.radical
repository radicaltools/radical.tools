{
  "hub": {
    "id": "adr-observability",
    "category": "adr",
    "name": "Observability Stack",
    "description": "Records how logs, metrics and traces are produced, collected and stored, and which tools own each signal.",
    "tags": [
      "observability",
      "monitoring",
      "logging",
      "tracing"
    ],
