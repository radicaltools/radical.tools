{
  "hub": {
    "id": "adr-multi-region",
    "category": "adr",
    "name": "Multi-Region Topology",
    "description": "Records how the system is distributed across regions to meet availability and disaster-recovery objectives.",
    "tags": [
      "availability",
      "disaster-recovery",
      "cloud",
      "resilience"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
