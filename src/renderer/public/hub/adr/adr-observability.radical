        "key": "METRICS_TOOL",
        "label": "Metrics tool",
        "hint": "Prometheus"
      },
      {
        "key": "TRACES_TOOL",
        "label": "Distributed tracing tool",
        "hint": "Jaeger / Tempo"
      }
    ]
