        "key": "AUTH_MECHANISM",
        "label": "Authentication mechanism",
        "hint": "OAuth 2.0 / OIDC with an external IdP",
        "defaultValue": "OAuth 2.0 / OIDC with an external IdP"
      },
      {
        "key": "TOKEN_LIFETIME_MINUTES",
        "label": "Access-token lifetime (min)",
        "hint": "15",
        "defaultValue": "15"
      }
    ],
