        "key": "APPROVED_REGIONS",
        "label": "Approved data residency regions",
        "hint": "EU only / EU + US-East",
        "defaultValue": "approved regions"
      }
    ]
  },
  "nodes": [
    {
      "id": "ff-data-res-1",
      "type": "fitness-fn",
      "label": "Data Residency Check",
      "description": "Verifies that PII is stored only in approved regions (e.g. EU-only for GDPR). Checks cloud resource tags, database locations, and CDN configs.",
