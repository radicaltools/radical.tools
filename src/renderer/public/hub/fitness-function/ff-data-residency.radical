{
  "hub": {
    "id": "ff-data-residency",
    "category": "fitness-function",
    "name": "Data Residency Check",
    "description": "Verifies that personal data is stored and processed only in approved regions, catching drift in cloud configuration before an auditor does.",
    "tags": [
      "holistic",
      "compliance",
      "privacy",
      "gdpr"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "APPROVED_REGIONS",
        "label": "Approved regions",
        "hint": "eu-west-1, eu-central-1",
        "defaultValue": "eu-west-1, eu-central-1"
      }
    ],
    "hubRefs": [
      "req-encryption",
      "req-data-retention"
    ]
  },
  "nodes": [
    {
      "id": "ff-data-residency-1",
      "type": "fitness-fn",
      "label": "Data Residency Check",
      "description": "Inventories storage resources tagged as holding personal data (databases, buckets, backups, search indexes, logging sinks) via the cloud API and compares their region and replication targets with the approved list. Runs against IaC plans before apply and against live accounts daily.",
      "x": 0,
      "y": 0,
      "width": 180,
      "height": 52,
      "collapsed": false,
      "category": "holistic",
      "automated": true,
      "trigger": "continuous",
      "threshold": "All resources tagged data-class=personal located and replicated only in {{APPROVED_REGIONS}}",
      "status": "proposed"
    }
  ],
  "relations": []
}
