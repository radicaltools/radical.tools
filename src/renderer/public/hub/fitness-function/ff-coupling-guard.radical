        "key": "MAX_FAN_OUT",
        "label": "Max outgoing dependencies per component",
        "hint": "5",
        "type": "number",
        "defaultValue": "5"
      }
    ]
  },
  "nodes": [
    {
      "id": "ff-coupling-guard-1",
