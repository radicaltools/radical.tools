{
  "hub": {
    "id": "ff-test-coverage",
    "category": "fitness-function",
    "name": "Test Coverage Gate",
    "description": "Enforces a minimum code coverage percentage on every PR/deployment. Prevents untested code from reaching production. Best combined with mutation testing for quality, not just quantity.",
    "tags": [
      "testing",
      "quality",
      "process",
      "coverage"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "MIN_COVERAGE_PCT",
        "label": "Minimum line coverage (%)",
        "hint": "80",
        "type": "number",
        "defaultValue": "80"
      }
    ]
  },
  "nodes": [
    {
      "id": "ff-test-cov-1",
      "type": "fitness-fn",
      "label": "Test Coverage Gate",
      "description": "Blocks deployment when line/branch coverage falls below the threshold. Ratchets up: new code must meet or exceed current coverage.",
      "x": 0,
      "y": 0,
      "width": 180,
      "height": 52,
      "collapsed": false,
      "category": "process",
      "automated": true,
      "trigger": "on-deploy",
      "threshold": "≥ {{MIN_COVERAGE_PCT}}% line coverage, no decrease on diff",
      "status": "active"
    }
  ]
}
