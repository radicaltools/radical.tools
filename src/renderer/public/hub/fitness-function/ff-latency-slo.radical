{
  "hub": {
    "id": "ff-latency-slo",
    "category": "fitness-function",
    "name": "Latency SLO Guard",
    "description": "Monitors service response time against a defined SLO target. Triggers an alert or blocks deployment when the p99 latency exceeds the threshold. Ideal for user-facing APIs where response time directly impacts experience.",
    "tags": [
      "performance",
      "slo",
      "operational",
      "latency"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "LATENCY_PERCENTILE",
        "label": "Measured percentile",
        "hint": "p99",
        "defaultValue": "p99"
      },
      {
        "key": "LATENCY_THRESHOLD_MS",
        "label": "Latency threshold (ms)",
        "hint": "200",
        "type": "number",
        "defaultValue": "200"
      }
    ]
  },
  "nodes": [
    {
      "id": "ff-latency-slo-1",
      "type": "fitness-fn",
      "label": "Latency SLO Guard",
      "description": "Ensures p99 response time stays within the defined SLO target. Measures end-to-end latency from client request to response.",
      "x": 0,
      "y": 0,
      "width": 180,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "continuous",
      "threshold": "{{LATENCY_PERCENTILE}} latency < {{LATENCY_THRESHOLD_MS}}ms",
      "status": "active"
    }
  ]
}
