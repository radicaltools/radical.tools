      "width": 200,
      "height": 56,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "approved",
      "priority": "must",
      "action": "emit all logs in structured JSON format with correlation IDs, severity, timestamp, and service name, aggregated into a centralised log store with a minimum {{LOG_RETENTION_DAYS}}-day retention",
      "rationale": "Unstructured logs scattered across hosts are unqueryable in production incidents. Structured, centralised logs reduce mean time to diagnosis."
