      {
        "key": "MESSAGE_BROKER",
        "label": "Message broker",
        "hint": "RabbitMQ / Azure Service Bus",
        "defaultValue": "RabbitMQ"
      }
    ]
  },
  "nodes": [
    {
      "id": "req-messaging-1",
      "type": "requirement",
      "label": "Async Messaging Standard",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 56,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "approved",
      "priority": "must",
      "action": "implement all asynchronous inter-service communication using AMQP via {{MESSAGE_BROKER}} (or MQTT for IoT workloads), with end-to-end message tracing enabled",
      "rationale": "Standardised messaging protocols decouple producers from consumers, enable broker-level durability, and allow services to evolve independently without tight-coupling."
    }
