        "key": "MAX_PIPELINE_MINUTES",
        "label": "Max pipeline duration (minutes)",
        "hint": "10",
        "type": "number",
        "defaultValue": "10"
      }
    ]
  },
  "nodes": [
    {
      "id": "req-ci-time-1",
      "type": "requirement",
      "label": "CI Pipeline Duration",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 56,
      "collapsed": false,
      "ears_type": "state-driven",
      "status": "draft",
      "priority": "should",
      "precondition": "a developer pushes a commit to a feature branch",
      "action": "complete the full build, lint, test, and security scan pipeline within {{MAX_PIPELINE_MINUTES}} minutes",
      "rationale": "Pipelines longer than 10 minutes break developer flow, discourage frequent commits, and slow down feedback on regressions."
