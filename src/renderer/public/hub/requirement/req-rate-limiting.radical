      "width": 200,
      "height": 56,
      "collapsed": false,
      "ears_type": "complex",
      "status": "approved",
      "priority": "must",
      "precondition": "the API gateway is operating normally",
      "trigger": "a single client exceeds {{RATE_LIMIT_RPM}} requests per minute",
      "action": "reject excess requests with HTTP 429 and include a Retry-After header",
