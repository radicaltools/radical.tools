{
  "hub": {
    "id": "req-disaster-recovery",
    "category": "requirement",
    "name": "Regional Failover",
    "description": "Recovery objectives when an entire region or availability zone becomes unavailable.",
    "tags": [
      "availability",
      "disaster-recovery",
      "resilience"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "OUTAGE_THRESHOLD_SECONDS",
        "label": "Outage detection threshold (s)",
        "hint": "60",
        "type": "number",
        "defaultValue": "60"
      },
      {
        "key": "RTO_MINUTES",
        "label": "Recovery Time Objective (min)",
        "hint": "15",
        "type": "number",
        "defaultValue": "15"
      },
      {
        "key": "RPO_MINUTES",
        "label": "Recovery Point Objective (min)",
        "hint": "5",
        "type": "number",
        "defaultValue": "5"
      }
    ],
    "hubRefs": [
      "adr-multi-region",
      "req-availability"
    ]
  },
  "nodes": [
    {
      "id": "req-disaster-recovery-1",
      "type": "requirement",
      "label": "Regional Failover",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "the primary region has been unreachable for more than {{OUTAGE_THRESHOLD_SECONDS}} seconds",
      "action": "fail over to the secondary region and resume service within {{RTO_MINUTES}} minutes, losing no more than {{RPO_MINUTES}} minutes of committed data",
      "rationale": "RTO and RPO are the two numbers that decide the replication topology and the price of the DR setup; stating them up front avoids discovering the gap during an outage."
    }
  ],
  "relations": []
}
