{
  "hub": {
    "id": "req-report-generation",
    "category": "requirement",
    "name": "Report Generation Time",
    "description": "Time limit for synchronous report generation, with an explicit hand-off to asynchronous delivery for anything slower.",
    "tags": [
      "performance",
      "reporting",
      "analytics"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "REPORT_MAX_SECONDS",
        "label": "Synchronous report limit (s)",
        "hint": "30",
        "type": "number",
        "defaultValue": "30"
      }
    ]
  },
  "nodes": [
    {
      "id": "req-report-generation-1",
      "type": "requirement",
      "label": "Report Generation Time",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "a user requests a standard report",
      "action": "deliver the report within {{REPORT_MAX_SECONDS}} seconds, or immediately switch to asynchronous generation and notify the user when the report is ready",
      "rationale": "Users abandon blocking requests that appear to hang; a fixed cut-over to async keeps the UI responsive regardless of data volume."
    }
  ],
