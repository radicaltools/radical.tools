{
  "hub": {
    "id": "req-alerting-slo",
    "category": "requirement",
    "name": "SLO Breach Alerting",
    "description": "Manageability: event-driven requirement triggering on-call alerting before an SLO breach occurs.",
    "tags": [
      "manageability",
      "monitoring",
      "alerting",
      "nfr",
      "sre"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "BUDGET_ALERT_PCT",
        "label": "Error budget alert threshold (%)",
        "hint": "80",
        "type": "number",
        "defaultValue": "80"
      }
    ]
  },
  "nodes": [
    {
      "id": "req-alert-slo-1",
      "type": "requirement",
      "label": "SLO Breach Alerting",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 56,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "approved",
      "priority": "must",
      "trigger": "any service metric (error rate, latency, availability) approaches {{BUDGET_ALERT_PCT}}% of its SLO error budget",
      "action": "fire a P2 alert to the on-call engineer via PagerDuty with the affected metric, current value, and a link to the relevant dashboard",
      "rationale": "Reacting to SLO breaches after the fact is too late. Burn-rate alerting allows intervention before users are impacted."
    }
  ]
}
