      "width": 200,
      "height": 56,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "approved",
      "priority": "must",
      "action": "implement idempotency keys for all state-changing API operations, ensuring that duplicate requests within a {{IDEMPOTENCY_WINDOW_HOURS}}-hour window produce the same result without creating duplicate records",
      "rationale": "Network retries are unavoidable. Without idempotency, transient failures cause double-charges, duplicate orders, or data corruption."
    }
