    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radical/common": "*",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^4.1.4"
  }
}
