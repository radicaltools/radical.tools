{
  "name": "@radical/hub-catalogue",
  "version": "0.0.0",
  "private": true,
  "description": "The Architecture Hub's concept catalogue (.radical documents), its validation and index, and the Vite plugin that serves and bundles it.",
  "type": "module",
  "exports": {
    ".": "./src/catalogue.ts",
    "./vite": {
      "types": "./vite.d.cts",
