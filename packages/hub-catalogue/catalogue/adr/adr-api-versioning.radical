      "versioning",
      "compatibility",
      "governance"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "VERSIONING_SCHEME",
        "label": "Versioning scheme",
        "hint": "URL path major version (/v1, /v2)",
        "defaultValue": "URL path major version (/v1, /v2)"
      },
      {
        "key": "DEPRECATION_MONTHS",
        "label": "Minimum deprecation period (months)",
        "hint": "6",
        "defaultValue": "6"
      }
    ],
    "hubRefs": [
      "req-backward-compatibility",
