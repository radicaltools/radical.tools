  "hub": {
    "id": "adr-marketplace-payments-model",
    "category": "adr",
    "name": "Marketplace Payments Model",
    "description": "Records how money moves between buyer and seller — who legally holds funds in transit, when the platform's commission is taken, and what licensing obligations that creates.",
    "tags": [
      "marketplace",
      "payments",
      "governance",
      "compliance"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "hubRefs": [
