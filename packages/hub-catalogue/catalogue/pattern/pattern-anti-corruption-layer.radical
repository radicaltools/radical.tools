{
  "hub": {
    "id": "pattern-anti-corruption-layer",
    "category": "pattern",
    "name": "Anti-Corruption Layer",
    "description": "A translation layer sits between your clean domain model and a legacy or external system's model, so that system's concepts, quirks and technical debt never leak into your domain. The layer absorbs the cost of translation once, instead of every consumer redoing it.",
    "tags": [
      "ddd",
      "anti-corruption-layer",
      "integration",
      "legacy",
      "hexagonal"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "hubRefs": [
      "pattern-hexagonal",
      "pattern-strangler-fig",
      "adr-integration-style"
    ]
  },
  "nodes": [
    {
      "id": "platform",
      "type": "system",
      "label": "Modern Domain",
      "description": "The current, clean domain model — protected from a legacy system's design decisions by a dedicated translation boundary.",
