      "label": "Opens product page",
      "technology": "HTTPS"
    },
    {
      "id": "storefront--product-api",
      "sourceId": "storefront",
      "targetId": "product-api",
      "label": "GET /products/{id}",
      "technology": "HTTPS / JSON"
    },
    {
      "id": "handler--breaker",
      "sourceId": "handler",
      "targetId": "breaker",
      "label": "Requests recommendations"
    },
    {
      "id": "product-api--recs",
      "sourceId": "product-api",
      "targetId": "recs",
      "label": "Fetches recommendations (through the breaker)",
      "technology": "HTTPS, 300 ms timeout"
    },
    {
      "id": "breaker--fallback",
      "sourceId": "breaker",
      "targetId": "fallback",
      "label": "On open circuit / failure"
    },
    {
      "id": "fallback--cache",
      "sourceId": "fallback",
      "targetId": "cache",
      "label": "Reads popular items",
      "technology": "Redis protocol"
    }
  ],
  "sequences": [
    {
      "id": "pattern-circuit-breaker-seq",
      "name": "Provider outage",
      "relationIds": [
        "customer--storefront",
        "storefront--product-api",
        "handler--breaker",
        "breaker--fallback",
        "fallback--cache"
      ],
      "stepDescriptions": [
        "Customer opens a product page.",
        "Page data is requested.",
        "Handler asks for recommendations.",
        "Circuit is open — the provider is not called at all.",
        "Popular items are read from cache and returned; the page renders normally."
      ]
    }
  ],
