{
  "hub": {
    "id": "pattern-microservices",
    "category": "pattern",
    "name": "Microservices with Database per Service",
    "description": "Independently deployable services, each owning its data store, fronted by a gateway and integrated through synchronous calls for queries and events for state changes.",
    "tags": [
      "microservices",
      "distributed-systems",
      "architecture",
      "event-driven"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "hubRefs": [
      "pattern-api-gateway",
      "pattern-event-driven",
      "adr-integration-style",
      "req-health-checks",
      "ff-coupling-guard",
      "pattern-saga"
    ]
  },
