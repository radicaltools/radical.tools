{
  "hub": {
    "id": "req-api-response-time",
    "category": "requirement",
    "name": "API Response Time",
    "description": "Latency budget for synchronous API calls under normal load, expressed as a percentile target with a hard tail ceiling.",
    "tags": [
      "performance",
      "latency",
      "api"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "P95_MS",
        "label": "p95 response time (ms)",
        "hint": "300",
        "type": "number",
        "defaultValue": "300"
      },
      {
        "key": "P99_MS",
        "label": "p99 ceiling (ms)",
        "hint": "1000",
        "type": "number",
        "defaultValue": "1000"
      }
    ],
    "hubRefs": [
      "ff-latency-slo",
      "req-db-query-response"
    ]
  },
  "nodes": [
    {
      "id": "req-api-response-time-1",
      "type": "requirement",
      "label": "API Response Time",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "state-driven",
      "precondition": "the system is serving normal production traffic",
      "action": "respond to API requests within {{P95_MS}} ms at the 95th percentile and never exceed {{P99_MS}} ms at the 99th percentile, measured at the service boundary",
      "rationale": "Downstream callers size their own timeouts and retry budgets around this figure; a percentile target with a tail ceiling prevents a small fraction of slow requests from cascading into upstream failures."
    }
  ],
