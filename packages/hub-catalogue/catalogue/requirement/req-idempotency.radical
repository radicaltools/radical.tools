{
  "hub": {
    "id": "req-idempotency",
    "category": "requirement",
    "name": "Idempotent Write Operations",
    "description": "Retried or duplicated requests must not create duplicate side effects such as double orders or double charges.",
    "tags": [
      "principle",
      "reliability",
      "correctness",
      "api"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "IDEMPOTENCY_WINDOW_HOURS",
        "label": "Idempotency key retention (h)",
        "hint": "24",
        "type": "number",
        "defaultValue": "24"
      }
    ],
    "hubRefs": [
      "pattern-transactional-outbox",
      "pattern-event-driven",
      "req-batch-job-completion",
      "pattern-saga",
      "adr-data-consistency-model"
    ]
  },
  "nodes": [
    {
      "id": "req-idempotency-1",
      "type": "requirement",
      "label": "Idempotent Write Operations",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "action": "accept an idempotency key on every state-changing operation and return the original result for any repeat of that key within {{IDEMPOTENCY_WINDOW_HOURS}} hours without re-executing the side effects",
      "rationale": "Network timeouts make it impossible for a client to know whether a request was applied; safe retries are only possible when repeating a request is harmless."
    }
  ],
  "relations": []
