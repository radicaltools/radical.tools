{
  "hub": {
    "id": "req-fail-safe-default",
    "category": "requirement",
    "name": "Fail-Safe Default Behaviour",
    "description": "When the system cannot determine a safe or correct outcome with sufficient confidence, it defaults to the least harmful, most reversible action and escalates to a human — instead of guessing or proceeding blindly.",
    "tags": [
      "principle",
      "safety",
      "ai",
      "fail-safe",
      "reliability"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "MIN_CONFIDENCE_PCT",
        "label": "Minimum confidence to act (%)",
        "hint": "85",
        "type": "number",
        "defaultValue": "85"
      }
    ],
    "hubRefs": [
      "ff-fail-safe-verification",
      "req-ai-human-handoff",
      "req-ai-autonomous-resolution"
    ]
  },
  "nodes": [
    {
      "id": "req-fail-safe-default-1",
      "type": "requirement",
      "label": "Fail-Safe Default Behaviour",
      "x": 0,
      "y": 0,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "an automated decision (an AI action, a payment, an irreversible write) cannot be made with confidence above {{MIN_CONFIDENCE_PCT}}%",
      "action": "take the least harmful, most reversible fallback action available and hand off to a human instead of proceeding on a low-confidence guess",
      "rationale": "An autonomous system that always acts on its best guess will eventually act confidently on a wrong guess; a system that recognises its own uncertainty and defaults to safety is what keeps a rare bad call from becoming an incident.",
      "templateParams": [
        {
          "key": "MIN_CONFIDENCE_PCT",
          "label": "Minimum confidence to act (%)",
          "hint": "85",
          "type": "number",
          "defaultValue": "85"
        }
      ]
    }
  ]
