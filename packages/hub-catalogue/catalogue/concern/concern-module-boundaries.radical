{
  "hub": {
    "id": "concern-module-boundaries",
    "category": "concern",
    "name": "Module boundaries",
    "description": "Keeping the parts of the code apart: which part may depend on which, through what, with no cycles; what they may share; who owns each; and how the build enforces it on the code there is today.",
    "tags": [
      "maintainability",
      "modularity",
      "dependencies",
      "architecture rules",
      "cycles",
      "shared kernel",
      "codeowners"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "concern": {
      "id": "module-boundaries",
      "trigger": "LIST NODES WHERE (type = \"container\" OR type = \"webapp\") AND external != true",
      "why": "code lives in these elements, so which of its parts may depend on which, and how the build keeps it that way, has to be decided.",
      "group": "architecture"
    },
    "sources": [
      {
        "title": "ISO/IEC 25010, Maintainability: modularity, analysability, modifiability, testability",
        "url": "https://iso25000.com/index.php/en/iso-25000-standards/iso-25010"
      },
      {
        "title": "Ford, Parsons, Kua, Sadalage: Building Evolutionary Architectures, 2nd ed. (fitness functions)",
        "url": "https://www.oreilly.com/library/view/building-evolutionary-architectures/9781492097532/"
      },
      {
        "title": "Martin Fowler: BoundedContext",
        "url": "https://martinfowler.com/bliki/BoundedContext.html"
      },
      {
        "title": "Spring Modulith reference documentation",
        "url": "https://docs.spring.io/spring-modulith/reference/"
      },
      {
        "title": "Nx: Enforce module boundaries",
        "url": "https://nx.dev/features/enforce-module-boundaries"
      },
      {
        "title": "ArchUnit user guide",
        "url": "https://www.archunit.org/userguide/html/000_Index.html"
      },
      {
        "title": "dependency-cruiser",
        "url": "https://github.com/sverweij/dependency-cruiser"
      }
    ],
    "templateParams": [
      {
        "key": "RULES",
        "title": "Dependency rules",
        "label": "How are the allowed dependencies between parts declared?",
        "hint": "Either each part says which others it may use, or parts are ranked in levels and may only use lower ones. Anything not allowed fails the build.",
        "defaultValue": "allowlist",
        "options": [
          {
            "value": "allowlist",
            "label": "each part lists what it may use",
            "description": "Every part declares the parts it may depend on (Spring Modulith allowedDependencies, import-linter contracts, an explicit map in dependency-cruiser); everything else is forbidden. Pick it for up to about fifteen parts that are peers, such as the modules of a modular monolith, where each dependency deserves a decision."
          },
          {
            "value": "levels",
            "label": "parts ranked in levels",
            "description": "Each part is tagged with a level (for example app, feature, domain, util) and may depend only on parts of lower levels, never on its own level's peers or higher. Pick it for a monorepo with dozens of libraries, where a list per part would be unmaintainable."
          }
        ]
      },
      {
        "key": "ENFORCE",
        "title": "Enforcement",
        "label": "How are the rules enforced on the code there is today?",
        "hint": "Rules that only fail on new code can be adopted on an old codebase today; rules that fail on everything need a clean codebase first.",
        "defaultValue": "fail",
        "options": [
          {
            "value": "fail",
            "label": "every violation fails the build",
            "description": "The rule check fails the build on any violation. Pick it for new code, or when the existing violations are few enough to fix before switching the check on."
          },
          {
            "value": "ratchet",
            "label": "existing violations frozen, new ones fail",
            "description": "Today's violations are recorded in a baseline; only new ones fail, and the baseline must shrink every quarter. Pick it for an existing codebase with more violations than can be fixed at once."
          }
        ]
      },
      {
        "key": "SHARED",
        "title": "Shared code",
        "label": "What may the parts share?",
        "hint": "Shared code couples the parts that use it: a change to it is a change to each of them. The policy decides how much coupling is accepted, and who decides.",
        "defaultValue": "kernel",
        "options": [
          {
            "value": "kernel",
            "label": "a small shared kernel",
            "description": "A few value types and contracts (money, identifiers, event schemas) live in one shared part that every user of it must approve changes to. Pick it when parts genuinely speak the same language about a few concepts."
          },
          {
            "value": "library",
            "label": "versioned internal libraries",
            "description": "Shared code is published as libraries with semantic versions; each part upgrades on its own schedule. Pick it when the parts are released separately (services, several repositories)."
          },
          {
            "value": "none",
            "label": "nothing but third-party libraries",
            "description": "Parts share no code of their own; small helpers are duplicated and data crosses only through APIs or events. Pick it when teams must never wait for each other, accepting some duplication."
          }
        ]
      },
      {
        "key": "OWNERS",
        "title": "Ownership",
        "label": "Does each part have a team that owns it?",
        "hint": "Boundaries hold better when someone is responsible for each side: a change to a part asks its owners.",
        "defaultValue": "team",
        "options": [
          {
            "value": "team",
            "label": "yes, one owning team per part",
            "description": "Each part has an owning team in CODEOWNERS whose approval a change to it needs. Pick it when more than one team works in the code."
          },
          {
            "value": "collective",
            "label": "no, one team owns the whole codebase",
            "description": "One team owns everything and any member may change any part. Pick it for a single team of up to about eight people."
          }
        ]
      },
      {
        "key": "RATCHET_PERCENT",
        "label": "By how much must the baseline of known violations shrink each quarter (%)?",
        "defaultValue": "20",
        "type": "number"
      },
      {
        "key": "KERNEL_PERCENT",
        "label": "At most how much of the code may the shared kernel be (% of lines)?",
        "defaultValue": "5",
        "type": "number"
      }
    ]
  },
  "nodes": [
    {
      "id": "need",
      "type": "need",
      "label": "Parts change on their own",
      "x": 0,
      "y": 0,
      "kind": "brief",
      "source": "Hub concern pack: Module boundaries",
      "description": "The code in this element must stay easy to understand, test and change as it grows and as people come and go. That needs parts with clear boundaries: a change to one part should not ripple through the others, each part should be testable on its own, and the rules about what may depend on what should hold because the build checks them, not because everyone remembers them."
    },
    {
      "id": "req-allowlist",
      "type": "requirement",
      "label": "Only declared dependencies",
      "x": 260,
      "y": 0,
      "ears_type": "ubiquitous",
      "action": "let each part depend only on the parts it declares as allowed, with 0 undeclared dependencies between parts on the main branch outside the recorded baseline",
      "rationale": "Declaring each dependency makes it a decision visible in review; rules that are not checked erode with every shortcut (Building Evolutionary Architectures, ch. 2; Spring Modulith, allowed dependencies).",
      "hubWhen": {
        "RULES": [
          "allowlist"
        ]
      }
    },
    {
      "id": "req-levels",
      "type": "requirement",
      "label": "Dependencies point down levels",
      "x": 260,
      "y": 130,
      "ears_type": "ubiquitous",
      "action": "let each part depend only on parts of a lower level, with 0 dependencies on a part of the same or a higher level on the main branch outside the recorded baseline",
      "rationale": "Levels give a large number of parts one direction without a list per part (Nx, enforce module boundaries; ISO/IEC 25010 modularity).",
      "hubWhen": {
        "RULES": [
          "levels"
        ]
      }
    },
    {
      "id": "req-public-api",
      "type": "requirement",
      "label": "Parts meet through APIs",
      "x": 260,
      "y": 260,
      "ears_type": "ubiquitous",
      "action": "let a part use another only through that part's published API (its public package or index), with 0 imports of another part's internal files and 0 queries on another part's tables",
      "rationale": "A part whose internals others reach into cannot change them alone, and cannot later be extracted (Fowler, BoundedContext; Spring Modulith, application modules)."
    },
    {
      "id": "req-cycles",
      "type": "requirement",
      "label": "No cycles between parts",
      "x": 260,
      "y": 390,
      "ears_type": "ubiquitous",
      "action": "keep the dependency graph between parts free of cycles, with 0 cycles between modules, packages or libraries",
      "rationale": "Parts in a cycle can only be understood, tested and released together, which makes them one part (Acyclic Dependencies Principle, R. C. Martin; ISO/IEC 25010 modularity)."
    },
    {
      "id": "req-fail",
      "type": "requirement",
      "label": "Violations fail the build",
      "x": 260,
      "y": 520,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a change adds a dependency the rules forbid or a cycle",
      "action": "fail the build of that change before it can be merged, naming the rule and the two parts involved",
      "rationale": "A violation is cheapest to fix in the pull request that brings it; after the merge others start to depend on it (Building Evolutionary Architectures, atomic fitness functions).",
      "hubWhen": {
        "ENFORCE": [
          "fail"
        ]
      }
    },
    {
      "id": "req-ratchet",
      "type": "requirement",
      "label": "Known violations shrink",
      "x": 260,
      "y": 650,
      "ears_type": "state-driven",
      "precondition": "known violations remain in the recorded baseline",
      "action": "fail any change that adds a violation outside the baseline, and shrink the baseline by at least {{RATCHET_PERCENT}}% each quarter",
      "rationale": "An old codebase cannot be fixed at once; freezing what is there stops it getting worse while the baseline records the debt to pay down (ArchUnit FreezingArchRule, dependency-cruiser known violations).",
      "hubWhen": {
        "ENFORCE": [
          "ratchet"
        ]
      }
    },
    {
      "id": "req-kernel",
      "type": "requirement",
      "label": "Shared kernel stays small",
      "x": 260,
      "y": 780,
      "ears_type": "ubiquitous",
      "action": "keep in the shared kernel only types and contracts used by at least two parts, with no I/O, framework or rule of a single part, at most {{KERNEL_PERCENT}}% of the code, and changes approved by an owner of every part that uses it",
      "rationale": "A shared kernel is shared on purpose and kept small; a growing \"common\" folder couples everything to everything (Evans, Domain-Driven Design, Shared Kernel).",
      "hubWhen": {
        "SHARED": [
          "kernel"
        ]
      }
    },
    {
      "id": "req-library",
      "type": "requirement",
      "label": "Shared libraries are versioned",
      "x": 260,
      "y": 910,
      "ears_type": "event-driven",
      "trigger": "shared code changes",
      "action": "publish it as a new semantic version of its library, and keep every consumer at most one major version behind the latest for no longer than 90 days",
      "rationale": "Versioned libraries let each part upgrade on its own schedule; bounding the lag keeps old versions from piling up (Semantic Versioning 2.0.0).",
      "hubWhen": {
        "SHARED": [
          "library"
        ]
      }
    },
    {
      "id": "req-no-shared",
      "type": "requirement",
      "label": "Nothing shared but contracts",
      "x": 260,
      "y": 1040,
      "ears_type": "ubiquitous",
      "action": "share no source code between parts apart from third-party libraries and API clients generated from published contracts, with 0 imports of another part's code",
      "rationale": "Every shared line is a reason for two teams to coordinate; duplication of small helpers is cheaper than that coupling (Building Evolutionary Architectures, coupling).",
      "hubWhen": {
        "SHARED": [
          "none"
        ]
      }
    },
    {
      "id": "req-owners",
      "type": "requirement",
      "label": "Every part has an owner",
      "x": 260,
      "y": 1170,
      "ears_type": "ubiquitous",
      "action": "name an owning team in CODEOWNERS for 100% of the parts, and require that team's approval to merge a change to its part",
      "rationale": "A boundary nobody owns is crossed by whoever is in a hurry; owners review what crosses theirs (Conway's law; GitHub CODEOWNERS).",
      "hubWhen": {
        "OWNERS": [
          "team"
        ]
      }
    },
    {
      "id": "sc-allowlist",
      "type": "scenario",
      "label": "Undeclared dependency found",
      "x": 520,
      "y": 0,
      "given": "the ordering module, allowed to use catalog only",
      "when": "a change makes it import a class of billing",
      "then": "the rule check reports the undeclared dependency naming both modules",
      "hubWhen": {
        "RULES": [
          "allowlist"
        ]
      }
    },
    {
      "id": "sc-levels",
      "type": "scenario",
      "label": "Upward dependency found",
      "x": 520,
      "y": 130,
      "given": "a domain library and a feature library",
      "when": "the domain library imports the feature library",
      "then": "the rule check reports the dependency on a higher level",
      "hubWhen": {
        "RULES": [
          "levels"
        ]
      }
    },
    {
      "id": "sc-public-api",
      "type": "scenario",
      "label": "Internal access refused",
      "x": 520,
      "y": 260,
      "given": "two parts, each with a published API",
      "when": "one imports the other's internal class",
      "then": "the rule check reports it and the build fails"
    },
    {
      "id": "sc-cycles",
      "type": "scenario",
      "label": "Cycle refused",
      "x": 520,
      "y": 390,
      "given": "two parts where A depends on B",
      "when": "a change makes B depend on A",
      "then": "the rule check reports the cycle with both parts named and the change is not merged"
    },
    {
      "id": "sc-fail",
      "type": "scenario",
      "label": "Violation blocks merge",
      "x": 520,
      "y": 520,
      "given": "a pull request that adds a forbidden dependency",
      "when": "the build runs",
      "then": "the build fails naming the rule and both parts, and the pull request cannot be merged",
      "hubWhen": {
        "ENFORCE": [
          "fail"
        ]
      }
    },
    {
      "id": "sc-ratchet",
      "type": "scenario",
      "label": "Baseline holds and shrinks",
      "x": 520,
      "y": 650,
      "given": "a baseline of known violations",
      "when": "a change adds a new violation, and a quarter ends",
      "then": "the change fails the build, and the baseline holds at least {{RATCHET_PERCENT}}% fewer violations than a quarter earlier",
      "hubWhen": {
        "ENFORCE": [
          "ratchet"
        ]
      }
    },
    {
      "id": "sc-kernel",
      "type": "scenario",
      "label": "Kernel stays small",
      "x": 520,
      "y": 780,
      "given": "the shared kernel",
      "when": "a change adds code used by one part only, or the kernel passes {{KERNEL_PERCENT}}% of the lines",
      "then": "the check fails and the change is moved into the part that uses it",
      "hubWhen": {
        "SHARED": [
          "kernel"
        ]
      }
    },
    {
      "id": "sc-library",
      "type": "scenario",
      "label": "Library upgraded in time",
      "x": 520,
      "y": 910,
      "given": "a shared library and its consumers",
      "when": "a new major version is published",
      "then": "within 90 days every consumer is on it or the previous major",
      "hubWhen": {
        "SHARED": [
          "library"
        ]
      }
    },
    {
      "id": "sc-no-shared",
      "type": "scenario",
      "label": "Cross-part import refused",
      "x": 520,
      "y": 1040,
      "given": "two parts",
      "when": "one imports a helper from the other",
      "then": "the rule check reports it and the build fails",
      "hubWhen": {
        "SHARED": [
          "none"
        ]
      }
    },
    {
      "id": "sc-owners",
      "type": "scenario",
      "label": "Owner approves change",
      "x": 520,
      "y": 1170,
      "given": "a part owned by a team",
      "when": "someone outside the team opens a pull request changing it",
      "then": "the pull request cannot be merged until the owning team approves it",
      "hubWhen": {
        "OWNERS": [
          "team"
        ]
      }
    },
    {
      "id": "adr-allowlist",
      "type": "adr",
      "label": "Declared dependencies only",
      "x": 780,
      "y": 0,
      "concern": "module-boundaries",
      "status": "accepted",
      "date": "",
      "context": "The code in this element is cut into parts (modules, packages, libraries) and keeps changing. Without written and checked rules, every shortcut adds a dependency nobody decided on: one module reads another's internals, two packages import each other, and a \"common\" folder grows until every change touches everything. The forces: rules kept only in a wiki erode within months; a cycle makes two parts one, so neither can be tested, owned or released alone; sharing code saves typing but couples the teams that share it; a boundary nobody owns is crossed by whoever is in a hurry; and an old codebase cannot fix every violation at once. What the parts are (layers, rings, slices) is the Architecture style pack; this pack keeps the boundaries between them.",
      "decision": "Each part (module, package or library) declares the parts it may depend on and exposes a published API; any other dependency, any access to another part's internals and any cycle fails the rule check, which runs as a test in every build ({{ENFORCE}}). Shared code: {{SHARED}}. Ownership: {{OWNERS}}. The checker by stack: Spring Modulith (@ApplicationModule(allowedDependencies = …) with ApplicationModules.verify()) for Spring Boot, ArchUnit slices for other JVM code, import-linter contracts for Python, NetArchTest for .NET, dependency-cruiser with an explicit map for TypeScript. Pick the one that runs as a unit test in the existing test runner, so a violation shows up like any failing test.",
      "consequences": "• Every dependency between parts is a visible decision, reviewed when it is added.\n• The declarations are code to maintain: adding a dependency means changing two lines and convincing a reviewer.\n• Boundaries hold only while the check runs in every build.\n• With many parts the lists become noise; levels scale better.",
      "alternatives": "1. Levels: one rule for many parts, but less precise between peers.\n2. Only forbidding known-bad dependencies: easy to start, but anything not foreseen is allowed.\n3. No checked rules: fastest to start, and boundaries erode within months.",
      "hubWhen": {
        "RULES": [
          "allowlist"
        ]
      }
    },
    {
      "id": "adr-levels",
      "type": "adr",
      "label": "Parts ranked in levels",
      "x": 780,
      "y": 130,
      "concern": "module-boundaries",
      "status": "accepted",
      "date": "",
      "context": "The code in this element is cut into parts (modules, packages, libraries) and keeps changing. Without written and checked rules, every shortcut adds a dependency nobody decided on: one module reads another's internals, two packages import each other, and a \"common\" folder grows until every change touches everything. The forces: rules kept only in a wiki erode within months; a cycle makes two parts one, so neither can be tested, owned or released alone; sharing code saves typing but couples the teams that share it; a boundary nobody owns is crossed by whoever is in a hurry; and an old codebase cannot fix every violation at once. What the parts are (layers, rings, slices) is the Architecture style pack; this pack keeps the boundaries between them.",
      "decision": "Each part is tagged with a level (app, feature, data-access, domain, util; or the levels the codebase needs) and may depend only on parts of lower levels and only through their public entry point; cycles are forbidden. The rules run in every build ({{ENFORCE}}). Shared code: {{SHARED}}. Ownership: {{OWNERS}}. The checker by stack: Nx's @nx/enforce-module-boundaries with type tags (plus scope tags per domain) in a TypeScript monorepo, eslint-plugin-boundaries without Nx, ArchUnit layeredArchitecture() over module packages on the JVM, import-linter's layers contract for Python.",
      "consequences": "• One rule covers dozens of parts; a new library only needs its tags.\n• Peers at the same level cannot use each other, which pushes shared code down a level.\n• Says nothing about which domain may use which; add scope tags when that matters.\n• Boundaries hold only while the lint runs in every build.",
      "alternatives": "1. Per-part lists: precise, but unmaintainable for dozens of parts.\n2. Separate repositories per part: strong boundaries, slow cross-part changes.\n3. No checked rules: boundaries erode within months.",
      "hubWhen": {
        "RULES": [
          "levels"
        ]
      }
    },
    {
      "id": "adr-shared-kernel",
      "type": "adr",
      "label": "A small shared kernel",
      "x": 780,
      "y": 260,
      "concern": "module-boundaries",
      "status": "accepted",
      "date": "",
      "context": "The code in this element is cut into parts (modules, packages, libraries) and keeps changing. Without written and checked rules, every shortcut adds a dependency nobody decided on: one module reads another's internals, two packages import each other, and a \"common\" folder grows until every change touches everything. The forces: rules kept only in a wiki erode within months; a cycle makes two parts one, so neither can be tested, owned or released alone; sharing code saves typing but couples the teams that share it; a boundary nobody owns is crossed by whoever is in a hurry; and an old codebase cannot fix every violation at once. What the parts are (layers, rings, slices) is the Architecture style pack; this pack keeps the boundaries between them.",
      "decision": "Code shared between parts lives in one shared kernel: value types and contracts (money, identifiers, event schemas) used by at least two parts, with no I/O, no framework and no rule of a single part, at most {{KERNEL_PERCENT}}% of the source lines. Every part that uses the kernel has an owner among its CODEOWNERS, so a change to it is approved by them all.",
      "consequences": "• Parts speak the same language about the few concepts they share.\n• Every kernel change is a change to every part that uses it, hence the approvals and the size limit.\n• Helpers that are convenient but not shared concepts stay in the parts and are sometimes duplicated.",
      "alternatives": "1. Versioned internal libraries: each part upgrades on its own schedule.\n2. Nothing shared: no coupling through code, at the cost of duplication.\n3. A free-for-all \"common\" folder: easy, and it couples everything to everything.",
      "hubWhen": {
        "SHARED": [
          "kernel"
        ]
      }
    },
    {
      "id": "adr-shared-libraries",
      "type": "adr",
      "label": "Versioned internal libraries",
      "x": 780,
      "y": 390,
      "concern": "module-boundaries",
      "status": "accepted",
      "date": "",
      "context": "The code in this element is cut into parts (modules, packages, libraries) and keeps changing. Without written and checked rules, every shortcut adds a dependency nobody decided on: one module reads another's internals, two packages import each other, and a \"common\" folder grows until every change touches everything. The forces: rules kept only in a wiki erode within months; a cycle makes two parts one, so neither can be tested, owned or released alone; sharing code saves typing but couples the teams that share it; a boundary nobody owns is crossed by whoever is in a hurry; and an old codebase cannot fix every violation at once. What the parts are (layers, rings, slices) is the Architecture style pack; this pack keeps the boundaries between them.",
      "decision": "Code shared between parts is published as internal libraries with semantic versions to the internal registry (npm, Maven, NuGet or PyPI on Artifactory, GitHub Packages or a cloud artifact registry). Each part upgrades on its own schedule; Renovate opens the upgrade pull requests, minor and patch versions merge automatically on green builds, and no consumer stays more than one major version behind for over 90 days.",
      "consequences": "• Parts released apart are not forced to upgrade together.\n• Several versions of a library live at once; fixes have to be released and picked up.\n• Library owners must keep compatibility within a major version and announce majors.",
      "alternatives": "1. A shared kernel in the same repository: always one version, but every change hits every user at once.\n2. Nothing shared: no versions to manage, some duplication.",
      "hubWhen": {
        "SHARED": [
          "library"
        ]
      }
    },
    {
      "id": "adr-share-nothing",
      "type": "adr",
      "label": "Parts share no code",
      "x": 780,
      "y": 520,
      "concern": "module-boundaries",
      "status": "accepted",
      "date": "",
      "context": "The code in this element is cut into parts (modules, packages, libraries) and keeps changing. Without written and checked rules, every shortcut adds a dependency nobody decided on: one module reads another's internals, two packages import each other, and a \"common\" folder grows until every change touches everything. The forces: rules kept only in a wiki erode within months; a cycle makes two parts one, so neither can be tested, owned or released alone; sharing code saves typing but couples the teams that share it; a boundary nobody owns is crossed by whoever is in a hurry; and an old codebase cannot fix every violation at once. What the parts are (layers, rings, slices) is the Architecture style pack; this pack keeps the boundaries between them.",
      "decision": "Parts share no source code of their own: small helpers are duplicated, and data crosses only through published APIs or events, with clients generated in each consumer from the provider's contract. Third-party libraries are allowed.",
      "consequences": "• No team ever waits for another to change shared code.\n• Some duplication, and a bug in a copied helper is fixed in each copy.\n• Contracts carry the whole weight of the coupling, so they must be versioned and checked.",
      "alternatives": "1. A small shared kernel: less duplication for genuinely shared concepts.\n2. Versioned internal libraries: sharing without lock-step upgrades.",
      "hubWhen": {
        "SHARED": [
          "none"
        ]
      }
    },
    {
      "id": "ff-cycles",
      "type": "fitness-fn",
      "label": "No dependency cycles",
      "x": 1040,
      "y": 0,
      "category": "structural",
      "threshold": "0 cycles between modules, packages or libraries on the main branch",
      "description": "A dependency rule in the build fails on any cycle between the folders that make up the parts. On the JVM the same check is ArchUnit's slices().matching(\"..(*)..\").should().beFreeOfCycles(); for Python, import-linter's independence contract.\n\nTool: dependency-cruiser\n\n```js\n// .dependency-cruiser.cjs\nmodule.exports = {\n  forbidden: [{\n    name: 'no-circular',\n    comment: 'ADR Module boundaries: parts in a cycle are one part',\n    severity: 'error',\n    from: { path: '^src/' },\n    to: { circular: true },\n  }],\n  options: { tsConfig: { fileName: 'tsconfig.json' }, doNotFollow: { path: 'node_modules' } },\n}\n// package.json: \"check:deps\": \"depcruise src --config .dependency-cruiser.cjs\"\n```"
    },
    {
      "id": "ff-public-api",
      "type": "fitness-fn",
      "label": "Only public APIs used",
      "x": 1040,
      "y": 130,
      "category": "structural",
      "threshold": "0 imports from one part into another part's internal files",
      "description": "A dependency rule allows a part to import another only through its index (the published API); a deep import into another part's folder fails the build. Spring Modulith's verify() and Nx's module boundaries do the same in their stacks.\n\nTool: dependency-cruiser\n\n```js\n// .dependency-cruiser.cjs\nmodule.exports = {\n  forbidden: [{\n    name: 'only-through-public-api',\n    comment: 'ADR Module boundaries: parts meet through their published API',\n    severity: 'error',\n    from: { path: '^src/modules/([^/]+)/' },\n    to: { path: '^src/modules/', pathNot: ['^src/modules/$1/', '^src/modules/[^/]+/index\\\\.ts$'] },\n  }],\n}\n```"
    },
    {
      "id": "ff-allowlist",
      "type": "fitness-fn",
      "label": "Only declared dependencies",
      "x": 1040,
      "y": 260,
      "category": "structural",
      "threshold": "0 dependencies on modules a module does not declare, 0 accesses to internals and 0 cycles between modules",
      "description": "Each module declares its allowed dependencies in package-info.java; a test lets Spring Modulith find the modules and verify every dependency against those lists, and writes the module diagram. In Python, import-linter contracts per module do the same.\n\nTool: Spring Modulith (ArchUnit underneath)\n\n```java\n// ordering/package-info.java\n@ApplicationModule(allowedDependencies = { \"catalog\", \"customer::api\" })\npackage com.example.shop.ordering;\n\nclass ModuleStructureTest {\n  static final ApplicationModules modules = ApplicationModules.of(ShopApplication.class);\n\n  @Test\n  void modulesUseOnlyDeclaredDependencies() {\n    modules.verify(); // fails on undeclared dependencies, internals and cycles\n  }\n\n  @Test\n  void writeDocumentation() {\n    new Documenter(modules).writeModulesAsPlantUml();\n  }\n}\n```",
      "hubWhen": {
        "RULES": [
          "allowlist"
        ]
      }
    },
    {
      "id": "ff-levels",
      "type": "fitness-fn",
      "label": "Dependencies point down levels",
      "x": 1040,
      "y": 390,
      "category": "structural",
      "threshold": "0 dependencies on a library of the same or a higher level",
      "description": "Each Nx project is tagged with its level; the lint rule fails when a project depends on a project of a level it may not use, or imports past a library's public entry point.\n\nTool: Nx module boundaries (@nx/enforce-module-boundaries)\n\n```js\n// eslint.config.mjs\nimport nx from '@nx/eslint-plugin'\nexport default [\n  ...nx.configs['flat/base'],\n  {\n    files: ['**/*.ts'],\n    rules: {\n      '@nx/enforce-module-boundaries': ['error', {\n        enforceBuildableLibDependency: true,\n        depConstraints: [\n          { sourceTag: 'type:app', onlyDependOnLibsWithTags: ['type:feature', 'type:data-access', 'type:domain', 'type:util'] },\n          { sourceTag: 'type:feature', onlyDependOnLibsWithTags: ['type:data-access', 'type:domain', 'type:util'] },\n          { sourceTag: 'type:data-access', onlyDependOnLibsWithTags: ['type:domain', 'type:util'] },\n          { sourceTag: 'type:domain', onlyDependOnLibsWithTags: ['type:util'] },\n          { sourceTag: 'type:util', onlyDependOnLibsWithTags: [] },\n        ],\n      }],\n    },\n  },\n]\n```",
      "hubWhen": {
        "RULES": [
          "levels"
        ]
      }
    },
    {
      "id": "ff-ratchet",
      "type": "fitness-fn",
      "label": "Known violations frozen",
      "x": 1040,
      "y": 520,
      "category": "structural",
      "threshold": "0 new violations outside the baseline; the baseline shrinks by at least {{RATCHET_PERCENT}}% each quarter",
      "description": "The rules run with today's violations frozen in a baseline committed to the repository: a new violation fails, a fixed one is removed from the store automatically. A quarterly review compares the size of the baseline with the quarter before. With dependency-cruiser the same is `depcruise-baseline` and `--ignore-known`.\n\nTool: ArchUnit FreezingArchRule\n\n```java\n@AnalyzeClasses(packages = \"com.example.shop\")\nclass FrozenRulesTest {\n  // archunit.properties:\n  //   freeze.store.default.path=src/test/resources/archunit_store\n  //   freeze.store.default.allowStoreCreation=true   (first run only)\n  //   freeze.refreeze=false\n  @ArchTest\n  static final ArchRule noCycles =\n      freeze(slices().matching(\"com.example.shop.(*)..\").should().beFreeOfCycles());\n\n  @ArchTest\n  static final ArchRule noInternals =\n      freeze(noClasses().that().resideInAPackage(\"com.example.shop.ordering..\")\n          .should().dependOnClassesThat().resideInAPackage(\"com.example.shop.billing.internal..\"));\n}\n```",
      "hubWhen": {
        "ENFORCE": [
          "ratchet"
        ]
      }
    },
    {
      "id": "ff-kernel",
      "type": "fitness-fn",
      "label": "Shared kernel stays small",
      "x": 1040,
      "y": 650,
      "category": "structural",
      "threshold": "The shared kernel imports no part and no I/O library, and holds at most {{KERNEL_PERCENT}}% of the source lines",
      "description": "A dependency rule keeps the kernel free of the parts and of I/O; a second step in the same job compares the kernel's line count with the whole and fails above the limit.\n\nTool: dependency-cruiser and cloc\n\n```js\n// .dependency-cruiser.cjs\nmodule.exports = {\n  forbidden: [{\n    name: 'kernel-depends-on-nothing',\n    comment: 'ADR A small shared kernel: types and contracts only',\n    severity: 'error',\n    from: { path: '^src/shared-kernel/' },\n    to: { path: ['^src/modules/', 'node_modules/(pg|mongodb|axios|express|fastify|kafkajs)'] },\n  }],\n}\n// CI: fail when the kernel passes the limit\n// kernel=$(cloc --json src/shared-kernel | jq '.SUM.code'); all=$(cloc --json src | jq '.SUM.code')\n// [ $((kernel * 100 / all)) -le {{KERNEL_PERCENT}} ]\n```",
      "hubWhen": {
        "SHARED": [
          "kernel"
        ]
      }
    },
    {
      "id": "ff-library",
      "type": "fitness-fn",
      "label": "Library versions not left behind",
      "x": 1040,
      "y": 780,
      "category": "process",
      "threshold": "An update pull request for a new internal library version is opened within 1 day; no consumer stays more than one major version behind for over 90 days",
      "description": "Renovate watches the internal registry and opens a pull request in every consumer when a shared library is released; patch and minor versions merge automatically on green tests, majors go to the owning team, and the dependency dashboard shows who lags.\n\nTool: Renovate\n\n```json\n{\n  \"$schema\": \"https://docs.renovatebot.com/renovate-schema.json\",\n  \"extends\": [\"config:recommended\", \":dependencyDashboard\"],\n  \"packageRules\": [\n    {\n      \"matchPackageNames\": [\"@shop/**\"],\n      \"groupName\": \"internal libraries\",\n      \"schedule\": [\"at any time\"],\n      \"automerge\": true,\n      \"matchUpdateTypes\": [\"minor\", \"patch\"]\n    },\n    {\n      \"matchPackageNames\": [\"@shop/**\"],\n      \"matchUpdateTypes\": [\"major\"],\n      \"labels\": [\"internal-major\"],\n      \"prPriority\": 5\n    }\n  ]\n}\n```",
      "hubWhen": {
        "SHARED": [
          "library"
        ]
      }
    },
    {
      "id": "ff-no-shared",
      "type": "fitness-fn",
      "label": "No code shared between parts",
      "x": 1040,
      "y": 910,
      "category": "structural",
      "threshold": "0 imports from one part's folder into another's",
      "description": "A dependency rule forbids any import from one part into another; generated API clients live in each consumer and are generated from the provider's published contract.\n\nTool: dependency-cruiser\n\n```js\n// .dependency-cruiser.cjs\nmodule.exports = {\n  forbidden: [{\n    name: 'parts-share-nothing',\n    comment: 'ADR Parts share no code',\n    severity: 'error',\n    from: { path: '^src/modules/([^/]+)/' },\n    to: { path: '^src/modules/', pathNot: '^src/modules/$1/' },\n  }],\n}\n```",
      "hubWhen": {
        "SHARED": [
          "none"
        ]
      }
    },
    {
      "id": "ff-owners",
      "type": "fitness-fn",
      "label": "Every part has owners",
      "x": 1040,
      "y": 1040,
      "category": "process",
      "threshold": "100% of the part folders are matched by a CODEOWNERS entry naming an existing team; branch protection requires code owner review",
      "description": "A workflow validates CODEOWNERS on every pull request: every file is owned, and each owner exists and has write access. Branch protection on main requires a review from code owners.\n\nTool: codeowners-validator (GitHub Action) with GitHub branch protection\n\n```yaml\n# .github/workflows/codeowners.yml\nname: CODEOWNERS\non: [pull_request]\njobs:\n  validate:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: mszostok/codeowners-validator@v0.7.4\n        with:\n          checks: \"files,owners,duppatterns,syntax\"\n          experimental_checks: \"notowned\"\n          github_access_token: \"${{ secrets.OWNERS_VALIDATOR_TOKEN }}\"\n```",
      "hubWhen": {
        "OWNERS": [
          "team"
        ]
      }
    }
  ],
