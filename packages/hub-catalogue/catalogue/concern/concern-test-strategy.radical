{
  "hub": {
    "id": "concern-test-strategy",
    "category": "concern",
    "name": "Test strategy",
    "description": "Which tests the element has at which level, which gates a change must pass, where end-to-end tests run, where test data comes from, and what happens to a flaky test.",
    "tags": [
      "maintainability",
      "testing",
      "test pyramid",
      "contract testing",
      "mutation testing",
      "flaky tests"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "concern": {
      "id": "test-strategy",
      "trigger": "LIST NODES WHERE (type = \"container\" OR type = \"webapp\") AND external != true",
      "why": "code lives in these elements, so how it is tested before a change is released has to be decided.",
      "group": "maintainability"
    },
    "sources": [
      {
        "title": "Martin Fowler: TestPyramid",
        "url": "https://martinfowler.com/bliki/TestPyramid.html"
      },
      {
        "title": "Ham Vocke: The Practical Test Pyramid (martinfowler.com)",
        "url": "https://martinfowler.com/articles/practical-test-pyramid.html"
      },
      {
        "title": "Ian Robinson: Consumer-Driven Contracts (martinfowler.com)",
        "url": "https://martinfowler.com/articles/consumerDrivenContracts.html"
      },
      {
        "title": "Martin Fowler: Eradicating Non-Determinism in Tests",
        "url": "https://martinfowler.com/articles/nonDeterminism.html"
      },
      {
        "title": "Martin Fowler: Continuous Integration",
        "url": "https://martinfowler.com/articles/continuousIntegration.html"
      },
      {
        "title": "ISO/IEC 25010, Maintainability: testability",
        "url": "https://iso25000.com/index.php/en/iso-25000-standards/iso-25010"
      },
      {
        "title": "Stryker Mutator",
        "url": "https://stryker-mutator.io/"
      }
    ],
    "templateParams": [
      {
        "key": "SHAPE",
        "title": "Test shape",
        "label": "Where does most of the testing happen?",
        "hint": "The shape says which level carries the bulk of the tests: it decides how fast feedback is, how much a refactoring breaks, and what a green build proves.",
        "defaultValue": "pyramid",
        "options": [
          {
            "value": "pyramid",
            "label": "a test pyramid, mostly unit tests",
            "description": "Many fast unit tests, fewer integration tests, a handful of end-to-end tests. Pick it when the element holds real domain logic (calculations, rules, state machines) that can be tested in isolation."
          },
          {
            "value": "trophy",
            "label": "a testing trophy, mostly integration tests",
            "description": "Most tests run the element with its real database in a container and fake only what lies outside it; static analysis and a few unit tests below, a few end-to-end tests above. Pick it for web apps and services that mostly glue a framework, a database and other APIs together."
          },
          {
            "value": "contract",
            "label": "contract-heavy, consumer-driven contracts",
            "description": "Each service is tested alone, and the calls between services are covered by consumer-driven contract tests instead of end-to-end tests across them. Pick it when several services owned by different teams deploy independently."
          }
        ]
      },
      {
        "key": "GATE",
        "title": "Quality gate",
        "label": "What must the tests prove before a merge?",
        "hint": "Coverage shows which lines ran; mutation testing shows whether a test would notice a line being wrong. Mutation testing costs build time.",
        "defaultValue": "coverage",
        "options": [
          {
            "value": "coverage",
            "label": "coverage of new code",
            "description": "New and changed lines must be covered by tests to a set percentage. Pick it as the baseline for any codebase, or when build time is tight."
          },
          {
            "value": "mutation",
            "label": "coverage and mutation score",
            "description": "Coverage, plus a minimum share of mutants killed in changed code. Pick it when the element holds business rules where a wrong condition costs money or trust, and the build can afford a few extra minutes."
          }
        ]
      },
      {
        "key": "DATA",
        "title": "Test data",
        "label": "Where does test data come from?",
        "hint": "Data shared between tests makes them depend on order; production copies carry personal data.",
        "defaultValue": "synthetic",
        "options": [
          {
            "value": "synthetic",
            "label": "built by each test",
            "description": "Each test creates the data it needs with builders or factories, in a fresh or rolled-back database. Pick it by default: tests stay independent and can run in parallel."
          },
          {
            "value": "fixtures",
            "label": "versioned seed datasets",
            "description": "Reviewed seed datasets kept with the tests are loaded into a fresh database for each run. Pick it when the data needed is large or intricate (a product catalogue, tariffs) and the same for many tests."
          },
          {
            "value": "masked",
            "label": "masked copies of production",
            "description": "Production data, with personal data masked or replaced, is copied into test environments. Pick it only when realistic volume and distribution matter (performance, migrations, reports) and synthetic data cannot reproduce them."
          }
        ]
      },
      {
        "key": "E2E",
        "title": "End-to-end",
        "label": "Where do the end-to-end tests run?",
        "hint": "End-to-end tests are the slowest and most brittle; where they run decides what they can stop.",
        "defaultValue": "pipeline",
        "options": [
          {
            "value": "pipeline",
            "label": "on each pull request, in an ephemeral environment",
            "description": "Every pull request is deployed to a short-lived environment and the journeys run there before the merge. Pick it when environments can be created in minutes (containers, infrastructure as code)."
          },
          {
            "value": "staging",
            "label": "after the merge, on staging",
            "description": "Merged builds deploy to a shared staging environment and the journeys gate the promotion to production. Pick it when a full environment is too costly to create per pull request."
          },
          {
            "value": "production",
            "label": "in production, as synthetic checks",
            "description": "No end-to-end gate before release; the journeys run against production after each deploy and on a schedule, and a failure rolls back. Pick it when you deploy many times a day behind feature flags with fast, automated rollback."
          }
        ]
      },
      {
        "key": "FLAKY",
        "title": "Flaky tests",
        "label": "What happens to a test that fails at random?",
        "hint": "A test that fails and passes on the same code teaches everyone to rerun until green, and then real failures are rerun too.",
        "defaultValue": "quarantine",
        "options": [
          {
            "value": "quarantine",
            "label": "quarantined, then fixed or deleted",
            "description": "The flaky test is moved out of the gate within a day, given an owner, and fixed or deleted within a deadline. Pick it for larger suites and several teams, where blocking everyone on one test costs more than the lost check."
          },
          {
            "value": "zero",
            "label": "a flaky test is a failure",
            "description": "No automatic retries: a test that fails and then passes fails the build, and is fixed before anything else merges. Pick it for a small suite and one team, where flakes are rare and fixed at once."
          }
        ]
      },
      {
        "key": "PIPELINE_MINUTES",
        "label": "Within how many minutes must the pull-request test run finish?",
        "defaultValue": "10",
        "type": "number"
      },
      {
        "key": "COVERAGE",
        "label": "What coverage of new code is required (%)?",
        "defaultValue": "80",
        "type": "number"
      },
      {
        "key": "MUTATION",
        "label": "What mutation score is required on changed code (%)?",
        "defaultValue": "70",
        "type": "number"
      },
      {
        "key": "JOURNEYS",
        "label": "Which user journeys do the end-to-end tests cover?",
        "defaultValue": "sign-in, search, checkout"
      },
      {
        "key": "QUARANTINE_DAYS",
        "label": "Within how many days must a quarantined test be fixed or deleted?",
        "defaultValue": "7",
        "type": "number"
      }
    ]
  },
  "nodes": [
    {
      "id": "need",
      "type": "need",
      "label": "Changes are released with confidence",
      "x": 0,
      "y": 0,
      "kind": "brief",
      "source": "Hub concern pack: Test strategy",
      "description": "The element changes often, and every change must be releasable without fear: the tests have to catch a broken rule, a broken integration and a broken journey before users do, give that answer quickly enough that people wait for it, and give the same answer every time they run on the same code. A green build must mean something."
    },
    {
      "id": "req-pr-suite",
      "type": "requirement",
      "label": "Fast tests on every change",
      "x": 260,
      "y": 0,
      "ears_type": "event-driven",
      "trigger": "a pull request is opened or updated",
      "action": "run the unit and integration tests within {{PIPELINE_MINUTES}} minutes and block the merge on any failure",
      "rationale": "Feedback that takes longer than about ten minutes is no longer waited for, and changes pile up untested (Fowler, Continuous Integration: keep the build fast)."
    },
    {
      "id": "req-coverage",
      "type": "requirement",
      "label": "New code is covered",
      "x": 260,
      "y": 130,
      "ears_type": "ubiquitous",
      "action": "cover at least {{COVERAGE}}% of new and changed lines, branches included, with automated tests, measured on each pull request",
      "rationale": "A gate on new code keeps coverage from falling without demanding that old code be fixed first (SonarQube \"Clean as You Code\"; ISO 25010 testability)."
    },
    {
      "id": "req-mutation",
      "type": "requirement",
      "label": "Tests notice wrong code",
      "x": 260,
      "y": 260,
      "ears_type": "ubiquitous",
      "action": "kill at least {{MUTATION}}% of the mutants generated in the changed code of each pull request",
      "rationale": "Coverage shows that a line ran, not that a test would fail if it were wrong; a surviving mutant is a change no test notices (Stryker, PIT; Building Evolutionary Architectures).",
      "hubWhen": {
        "GATE": [
          "mutation"
        ]
      }
    },
    {
      "id": "req-pyramid",
      "type": "requirement",
      "label": "Mostly fast unit tests",
      "x": 260,
      "y": 390,
      "ears_type": "ubiquitous",
      "action": "keep at least 70% of the automated tests as unit tests that touch no network, database or file system and run in under 100 ms each, and at most 10% as end-to-end tests",
      "rationale": "Tests low in the pyramid are fast, precise about what broke and cheap to keep; high ones are slow and brittle, so few of them (Fowler, TestPyramid; Vocke, The Practical Test Pyramid).",
      "hubWhen": {
        "SHAPE": [
          "pyramid"
        ]
      }
    },
    {
      "id": "req-trophy",
      "type": "requirement",
      "label": "Integration tests use real services",
      "x": 260,
      "y": 520,
      "ears_type": "ubiquitous",
      "action": "test behaviour mostly through integration tests that run the element with its real database and broker in containers and fake only systems outside it, with integration tests at least 50% of the suite and 0 in-memory substitutes for the database",
      "rationale": "For code that mostly glues a framework and a database together, the bugs live in the wiring; an in-memory substitute hides exactly those (Vocke, The Practical Test Pyramid: integration tests; Testcontainers).",
      "hubWhen": {
        "SHAPE": [
          "trophy"
        ]
      }
    },
    {
      "id": "req-contracts",
      "type": "requirement",
      "label": "Contracts verified before deploy",
      "x": 260,
      "y": 650,
      "ears_type": "event-driven",
      "trigger": "a consumer changes how it calls a provider, or a provider is about to be deployed",
      "action": "verify every consumer's contract against the provider in the provider's build, and refuse to deploy a version that has not verified the contracts of the consumers in the target environment",
      "rationale": "Contract tests find a breaking change between services in the provider's build, in minutes, without an environment with every service in it (Robinson, Consumer-Driven Contracts).",
      "hubWhen": {
        "SHAPE": [
          "contract"
        ]
      }
    },
    {
      "id": "req-own-data",
      "type": "requirement",
      "label": "Tests build their own data",
      "x": 260,
      "y": 780,
      "ears_type": "ubiquitous",
      "action": "create the data each test needs in the test itself with builders or factories, and leave nothing behind, so that the suite passes in random order and in parallel",
      "rationale": "Tests sharing data depend on order and break each other, the most common cause of flaky suites (Fowler, Eradicating Non-Determinism in Tests: isolation).",
      "hubWhen": {
        "DATA": [
          "synthetic"
        ]
      }
    },
    {
      "id": "req-fixtures",
      "type": "requirement",
      "label": "Seed data is versioned",
      "x": 260,
      "y": 910,
      "ears_type": "ubiquitous",
      "action": "keep seed datasets in version control next to the tests, load them into a fresh database for each test run after the current migrations, and change them only through a reviewed pull request",
      "rationale": "Shared data is safe when it is the same on every run and every change to it is visible; a database kept between runs drifts (Vocke, The Practical Test Pyramid).",
      "hubWhen": {
        "DATA": [
          "fixtures"
        ]
      }
    },
    {
      "id": "req-masking",
      "type": "requirement",
      "label": "No personal data in tests",
      "x": 260,
      "y": 1040,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a copy of production data is made for a test environment",
      "action": "mask or replace every personal-data field before the copy leaves the production environment, so that 0 real names, e-mail addresses, phone numbers, addresses or payment details reach a test environment",
      "rationale": "Test environments are less protected than production; personal data in them is a breach waiting to happen (GDPR Art. 25 and 32: data protection by design, security of processing).",
      "hubWhen": {
        "DATA": [
          "masked"
        ]
      }
    },
    {
      "id": "req-e2e-pr",
      "type": "requirement",
      "label": "Journeys tested before merge",
      "x": 260,
      "y": 1170,
      "ears_type": "event-driven",
      "trigger": "a pull request is opened or updated",
      "action": "deploy it to an ephemeral environment, run the end-to-end tests of {{JOURNEYS}} there, block the merge on a failure, and remove the environment when the pull request closes",
      "rationale": "A broken journey is cheapest to fix before the merge; an environment per pull request keeps changes from waiting for a shared one (Vocke, The Practical Test Pyramid: end-to-end tests).",
      "hubWhen": {
        "E2E": [
          "pipeline"
        ]
      }
    },
    {
      "id": "req-e2e-staging",
      "type": "requirement",
      "label": "Journeys gate promotion",
      "x": 260,
      "y": 1300,
      "ears_type": "event-driven",
      "trigger": "a build is merged to the main branch",
      "action": "deploy it to staging, run the end-to-end tests of {{JOURNEYS}} there, and promote it to production only when all pass",
      "rationale": "One shared environment is cheaper than one per change; the gate keeps a broken journey out of production (Humble, Farley: Continuous Delivery, the deployment pipeline).",
      "hubWhen": {
        "E2E": [
          "staging"
        ]
      }
    },
    {
      "id": "req-e2e-prod",
      "type": "requirement",
      "label": "Journeys checked in production",
      "x": 260,
      "y": 1430,
      "ears_type": "event-driven",
      "trigger": "a release reaches production",
      "action": "run synthetic checks of {{JOURNEYS}} against it within 5 minutes and every 5 minutes after, and roll the release back automatically when a check fails twice in a row",
      "rationale": "With many deploys a day, production is the only environment where every journey can be proved; fast rollback bounds the harm of what slipped through (Sridharan, Testing in production; Google SRE, release engineering).",
      "hubWhen": {
        "E2E": [
          "production"
        ]
      }
    },
    {
      "id": "req-quarantine",
      "type": "requirement",
      "label": "Flaky tests quarantined",
      "x": 260,
      "y": 1560,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a test fails and then passes on the same commit",
      "action": "move it to quarantine within 1 working day, where it runs but no longer blocks merges, assign it an owner, and fix or delete it within {{QUARANTINE_DAYS}} days",
      "rationale": "A flaky test left in the gate teaches everyone to rerun until green; one left in quarantine forever is a deleted test nobody decided to delete (Fowler, Eradicating Non-Determinism in Tests: quarantine).",
      "hubWhen": {
        "FLAKY": [
          "quarantine"
        ]
      }
    },
    {
      "id": "req-no-retry",
      "type": "requirement",
      "label": "Flaky tests fail the build",
      "x": 260,
      "y": 1690,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a test fails and then passes on the same commit",
      "action": "fail the build, naming the test as flaky, and merge nothing else to the main branch until it is fixed or deleted",
      "rationale": "A small suite stays trustworthy only if every flake is treated as a defect at once (Fowler, Eradicating Non-Determinism in Tests).",
      "hubWhen": {
        "FLAKY": [
          "zero"
        ]
      }
    },
    {
      "id": "sc-pr-suite",
      "type": "scenario",
      "label": "Change is tested in time",
      "x": 520,
      "y": 0,
      "given": "a pull request with a failing test",
      "when": "it is pushed",
      "then": "the test run reports the failure within {{PIPELINE_MINUTES}} minutes and the pull request cannot be merged"
    },
    {
      "id": "sc-coverage",
      "type": "scenario",
      "label": "Uncovered code refused",
      "x": 520,
      "y": 130,
      "given": "a pull request adding code",
      "when": "its tests cover less than {{COVERAGE}}% of the new lines",
      "then": "the quality gate fails and the pull request cannot be merged"
    },
    {
      "id": "sc-mutation",
      "type": "scenario",
      "label": "Weak tests refused",
      "x": 520,
      "y": 260,
      "given": "a pull request whose tests run the new code but assert nothing about a condition",
      "when": "mutation testing flips that condition",
      "then": "the mutant survives, the score falls below {{MUTATION}}% and the merge is blocked",
      "hubWhen": {
        "GATE": [
          "mutation"
        ]
      }
    },
    {
      "id": "sc-pyramid",
      "type": "scenario",
      "label": "Unit test stays isolated",
      "x": 520,
      "y": 390,
      "given": "the unit test suite with network access disabled",
      "when": "it runs",
      "then": "every test passes in under 100 ms and unit tests are at least 70% of all tests",
      "hubWhen": {
        "SHAPE": [
          "pyramid"
        ]
      }
    },
    {
      "id": "sc-trophy",
      "type": "scenario",
      "label": "Real database in tests",
      "x": 520,
      "y": 520,
      "given": "the integration test suite",
      "when": "it runs",
      "then": "it starts the same database engine and version as production in a container, and no test uses an in-memory substitute",
      "hubWhen": {
        "SHAPE": [
          "trophy"
        ]
      }
    },
    {
      "id": "sc-contracts",
      "type": "scenario",
      "label": "Breaking change refused",
      "x": 520,
      "y": 650,
      "given": "a consumer whose contract expects a field",
      "when": "the provider removes the field and tries to deploy",
      "then": "contract verification fails and the deployment is refused",
      "hubWhen": {
        "SHAPE": [
          "contract"
        ]
      }
    },
    {
      "id": "sc-own-data",
      "type": "scenario",
      "label": "Order does not matter",
      "x": 520,
      "y": 780,
      "given": "the test suite",
      "when": "it runs three times in random order with parallel workers",
      "then": "all three runs pass",
      "hubWhen": {
        "DATA": [
          "synthetic"
        ]
      }
    },
    {
      "id": "sc-fixtures",
      "type": "scenario",
      "label": "Seed loads on fresh database",
      "x": 520,
      "y": 910,
      "given": "the seed datasets and the current migrations",
      "when": "a test run starts",
      "then": "a fresh database is migrated, the seed loads without error, and tests that change it run in a transaction rolled back afterwards",
      "hubWhen": {
        "DATA": [
          "fixtures"
        ]
      }
    },
    {
      "id": "sc-masking",
      "type": "scenario",
      "label": "Copy carries no personal data",
      "x": 520,
      "y": 1040,
      "given": "a production snapshot",
      "when": "it is copied to a test environment",
      "then": "a scan of the copy finds 0 personal-data values and the copy is refused otherwise",
      "hubWhen": {
        "DATA": [
          "masked"
        ]
      }
    },
    {
      "id": "sc-e2e-pr",
      "type": "scenario",
      "label": "Broken journey blocks merge",
      "x": 520,
      "y": 1170,
      "given": "a pull request that breaks one of: {{JOURNEYS}}",
      "when": "its ephemeral environment is tested",
      "then": "the journey fails and the pull request cannot be merged",
      "hubWhen": {
        "E2E": [
          "pipeline"
        ]
      }
    },
    {
      "id": "sc-e2e-staging",
      "type": "scenario",
      "label": "Broken build not promoted",
      "x": 520,
      "y": 1300,
      "given": "a merged build that breaks one of: {{JOURNEYS}}",
      "when": "it is tested on staging",
      "then": "it is not promoted to production and the team is told",
      "hubWhen": {
        "E2E": [
          "staging"
        ]
      }
    },
    {
      "id": "sc-e2e-prod",
      "type": "scenario",
      "label": "Failing journey rolls back",
      "x": 520,
      "y": 1430,
      "given": "a release that breaks one of: {{JOURNEYS}}",
      "when": "the synthetic check fails twice in a row",
      "then": "the release is rolled back automatically and the team is alerted",
      "hubWhen": {
        "E2E": [
          "production"
        ]
      }
    },
    {
      "id": "sc-quarantine",
      "type": "scenario",
      "label": "Flaky test leaves the gate",
      "x": 520,
      "y": 1560,
      "given": "a test that fails and then passes on the same commit",
      "when": "it is reported as flaky",
      "then": "within 1 working day it is quarantined with an owner, and after {{QUARANTINE_DAYS}} days it is fixed or deleted",
      "hubWhen": {
        "FLAKY": [
          "quarantine"
        ]
      }
    },
    {
      "id": "sc-no-retry",
      "type": "scenario",
      "label": "Flaky test stops the line",
      "x": 520,
      "y": 1690,
      "given": "a test that fails and then passes on the same commit",
      "when": "the build runs",
      "then": "the build fails naming the test as flaky",
      "hubWhen": {
        "FLAKY": [
          "zero"
        ]
      }
    },
    {
      "id": "adr-pyramid",
      "type": "adr",
      "label": "A test pyramid",
      "x": 780,
      "y": 0,
      "concern": "test-strategy",
      "status": "accepted",
      "date": "",
      "context": "Code lives in this element and changes every week; the tests decide whether a change can be released with confidence or only with hope. The forces: fast tests give feedback in minutes but exercise little of the wiring, while end-to-end tests exercise everything but are slow, brittle and late; coverage shows what was run, not what was checked; tests that share data or depend on order fail at random, and a suite that fails at random is soon ignored; copies of production data make realistic tests but carry personal data; and every service another team depends on is a contract that can break without a test of its own failing.",
      "decision": "Tests follow the pyramid: most are unit tests of the domain logic, run without network or database (JUnit 5, xUnit, Vitest or pytest by stack); integration tests cover each adapter against the real dependency in a container (Testcontainers); a few end-to-end tests cover {{JOURNEYS}} (Playwright). Every pull request runs unit and integration tests within {{PIPELINE_MINUTES}} minutes. Gate: {{GATE}}, measured in the SonarQube (or SonarCloud) quality gate on new code; mutation testing with Stryker (JS/TS, .NET) or PIT (JVM). Test data: {{DATA}}. End-to-end tests run {{E2E}}. Flaky tests: {{FLAKY}}.",
      "consequences": "• Fast, precise feedback: a failing unit test names the rule that broke.\n• Refactoring that changes internal interfaces rewrites many unit tests; test behaviour, not methods, to limit it.\n• Wiring bugs (configuration, queries, serialisation) are caught only by the thinner integration layer.\n• Requires code where the logic can be called without infrastructure.",
      "alternatives": "1. A testing trophy: mostly integration tests, better for glue code, slower feedback.\n2. Contract-heavy: for many independently deployed services.\n3. An ice-cream cone of manual and end-to-end tests: slow, brittle and late; the shape to move away from.",
      "hubWhen": {
        "SHAPE": [
          "pyramid"
        ]
      }
    },
    {
      "id": "adr-trophy",
      "type": "adr",
      "label": "A testing trophy",
      "x": 780,
      "y": 130,
      "concern": "test-strategy",
      "status": "accepted",
      "date": "",
      "context": "Code lives in this element and changes every week; the tests decide whether a change can be released with confidence or only with hope. The forces: fast tests give feedback in minutes but exercise little of the wiring, while end-to-end tests exercise everything but are slow, brittle and late; coverage shows what was run, not what was checked; tests that share data or depend on order fail at random, and a suite that fails at random is soon ignored; copies of production data make realistic tests but carry personal data; and every service another team depends on is a contract that can break without a test of its own failing.",
      "decision": "Most tests are integration tests that run the element through its public interface (HTTP or the UI component tree) with its real database and broker started by Testcontainers, faking only systems outside it (WireMock or MSW); static analysis (TypeScript strict, ESLint or the compiler and SonarQube) and a few unit tests for pure logic sit below; a few end-to-end tests cover {{JOURNEYS}} with Playwright. Every pull request runs them within {{PIPELINE_MINUTES}} minutes. Gate: {{GATE}}, in the SonarQube quality gate on new code. Test data: {{DATA}}. End-to-end tests run {{E2E}}. Flaky tests: {{FLAKY}}. In-memory substitutes for the database (H2, SQLite for PostgreSQL, pg-mem) are not used.",
      "consequences": "• Tests survive refactoring because they use the element as its callers do.\n• Wiring, queries and serialisation are tested for real.\n• Slower than unit tests: containers start once per run and tests must clean up; keeping the run under {{PIPELINE_MINUTES}} minutes needs parallel workers.\n• A failing test says which behaviour broke, not which line; debugging takes longer.",
      "alternatives": "1. A test pyramid: faster and more precise where there is real domain logic.\n2. In-memory database substitutes: faster, but they differ from the real engine exactly where bugs hide.\n3. Contract-heavy: needed in addition when several services are owned by different teams.",
      "hubWhen": {
        "SHAPE": [
          "trophy"
        ]
      }
    },
    {
      "id": "adr-contract",
      "type": "adr",
      "label": "Consumer-driven contracts",
      "x": 780,
      "y": 260,
      "concern": "test-strategy",
      "status": "accepted",
      "date": "",
      "context": "Code lives in this element and changes every week; the tests decide whether a change can be released with confidence or only with hope. The forces: fast tests give feedback in minutes but exercise little of the wiring, while end-to-end tests exercise everything but are slow, brittle and late; coverage shows what was run, not what was checked; tests that share data or depend on order fail at random, and a suite that fails at random is soon ignored; copies of production data make realistic tests but carry personal data; and every service another team depends on is a contract that can break without a test of its own failing.",
      "decision": "Each service is tested alone (unit and integration tests with Testcontainers), and every call between services is covered by consumer-driven contract tests with Pact: consumers publish their contracts to a Pact Broker (or PactFlow), providers verify them in their build, and every deployment asks can-i-deploy first. Asynchronous messages get message pacts. End-to-end tests across services shrink to {{JOURNEYS}}, run {{E2E}}. Every pull request runs its service's tests within {{PIPELINE_MINUTES}} minutes. Gate: {{GATE}}, in the SonarQube quality gate on new code. Test data: {{DATA}}. Flaky tests: {{FLAKY}}. Choose Pact for HTTP and messages across languages; Spring Cloud Contract only when every service is on Spring.",
      "consequences": "• A breaking change between services is found in the provider's build in minutes, not in a shared environment days later.\n• Teams deploy independently without a full environment of every service.\n• Contracts cover only what consumers use; a consumer without a contract is unprotected.\n• The broker is one more thing to run (or a PactFlow subscription), and teams must learn the workflow.",
      "alternatives": "1. End-to-end tests across all services in a shared environment: realistic, but slow, flaky and blocking every team.\n2. Provider-written OpenAPI schema tests: check the provider against its own document, not against what consumers rely on.\n3. A test pyramid per service without contracts: fast, but blind to breaking changes between services.",
      "hubWhen": {
        "SHAPE": [
          "contract"
        ]
      }
    },
    {
      "id": "ff-pr-time",
      "type": "fitness-fn",
      "label": "Pull-request tests in time",
      "x": 1040,
      "y": 0,
      "category": "process",
      "threshold": "The pull-request test job finishes within {{PIPELINE_MINUTES}} minutes and is a required check for merging",
      "description": "The test job has a hard timeout of {{PIPELINE_MINUTES}} minutes and is a required status check in branch protection, so a slow suite fails instead of quietly growing.\n\nTool: GitHub Actions (timeout-minutes) with branch protection\n\n```yaml\n# .github/workflows/test.yml\nname: test\non: [pull_request]\njobs:\n  test:\n    runs-on: ubuntu-latest\n    timeout-minutes: 10   # PIPELINE_MINUTES\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with: { node-version-file: .nvmrc, cache: npm }\n      - run: npm ci\n      - run: npm test -- --reporter=junit --outputFile=reports/junit.xml\n```"
    },
    {
      "id": "ff-coverage",
      "type": "fitness-fn",
      "label": "Coverage of new code",
      "x": 1040,
      "y": 130,
      "category": "process",
      "threshold": "Coverage on new code at least {{COVERAGE}}%; the quality gate fails the pull request below it",
      "description": "The pipeline sends the coverage report to SonarQube and waits for the quality gate, whose condition is \"Coverage on New Code is less than {{COVERAGE}}%\".\n\nTool: SonarQube quality gate\n\n```properties\n# sonar-project.properties\nsonar.projectKey=shop-order-api\nsonar.sources=src\nsonar.tests=test\nsonar.javascript.lcov.reportPaths=coverage/lcov.info\nsonar.newCode.referenceBranch=main\n# fail the pipeline when the gate fails\nsonar.qualitygate.wait=true\n# Quality gate (in SonarQube): Coverage on New Code < 80% -> failed\n```"
    },
    {
      "id": "ff-mutation",
      "type": "fitness-fn",
      "label": "Mutation score",
      "x": 1040,
      "y": 260,
      "category": "process",
      "threshold": "Mutation score on changed code at least {{MUTATION}}%; the build breaks below it",
      "description": "Stryker runs incrementally on the files the pull request changes and breaks the build when the score falls below the threshold. On the JVM, PIT with mutationThreshold and the git-based scm goal does the same.\n\nTool: Stryker Mutator\n\n```json\n{\n  \"$schema\": \"./node_modules/@stryker-mutator/core/schema/stryker-schema.json\",\n  \"testRunner\": \"vitest\",\n  \"mutate\": [\"src/**/*.ts\", \"!src/**/*.test.ts\"],\n  \"incremental\": true,\n  \"reporters\": [\"clear-text\", \"html\", \"json\"],\n  \"thresholds\": { \"high\": 85, \"low\": 75, \"break\": 70 }\n}\n```",
      "hubWhen": {
        "GATE": [
          "mutation"
        ]
      }
    },
    {
      "id": "ff-unit-isolated",
      "type": "fitness-fn",
      "label": "Unit tests stay isolated",
      "x": 1040,
      "y": 390,
      "category": "structural",
      "threshold": "0 unit tests reach the network; unit tests at least 70% of all tests",
      "description": "The unit-test project disables network connections in its setup, so a unit test that reaches a server fails; a step in CI counts tests per suite from the JUnit reports and fails when unit tests are below 70%.\n\nTool: Vitest with nock\n\n```ts\n// test/unit/setup.ts (vitest.config.ts: test.setupFiles for the unit project)\nimport nock from 'nock'\nimport { afterAll, beforeAll } from 'vitest'\n\nbeforeAll(() => nock.disableNetConnect())   // any real HTTP call throws\nafterAll(() => nock.enableNetConnect())\n\n// CI: unit share from the JUnit reports\n// unit=$(xmllint --xpath 'sum(//testsuites/@tests)' reports/unit.xml)\n// all=$(xmllint --xpath 'sum(//testsuites/@tests)' reports/*.xml)\n// [ $((unit * 100 / all)) -ge 70 ]\n```",
      "hubWhen": {
        "SHAPE": [
          "pyramid"
        ]
      }
    },
    {
      "id": "ff-no-fakes",
      "type": "fitness-fn",
      "label": "No in-memory database",
      "x": 1040,
      "y": 520,
      "category": "structural",
      "threshold": "0 test files import an in-memory database substitute",
      "description": "A dependency rule fails the build when a test imports an in-memory substitute for the database; the integration tests use Testcontainers with the production engine and version.\n\nTool: dependency-cruiser\n\n```js\n// .dependency-cruiser.cjs\nmodule.exports = {\n  forbidden: [{\n    name: 'no-in-memory-database',\n    comment: 'ADR Testing trophy: integration tests use the real engine (Testcontainers)',\n    severity: 'error',\n    from: { path: '\\\\.(test|spec)\\\\.ts$' },\n    to: { path: 'node_modules/(pg-mem|sqlite3|better-sqlite3|mongodb-memory-server)' },\n  }],\n}\n```",
      "hubWhen": {
        "SHAPE": [
          "trophy"
        ]
      }
    },
    {
      "id": "ff-can-i-deploy",
      "type": "fitness-fn",
      "label": "Contracts verified",
      "x": 1040,
      "y": 650,
      "category": "process",
      "threshold": "0 deployments of a version that has not verified the contracts of the consumers in the target environment",
      "description": "The deploy job asks the Pact Broker whether this version is compatible with what is deployed in the target environment, and stops when it is not; after deploying it records the deployment.\n\nTool: Pact Broker can-i-deploy (pact-broker CLI)\n\n```bash\npact-broker can-i-deploy \\\n  --pacticipant order-api --version \"$GIT_SHA\" \\\n  --to-environment production \\\n  --broker-base-url \"$PACT_BROKER_URL\" --retry-while-unknown 6 --retry-interval 10\n\n# after a successful deploy\npact-broker record-deployment \\\n  --pacticipant order-api --version \"$GIT_SHA\" --environment production\n```",
      "hubWhen": {
        "SHAPE": [
          "contract"
        ]
      }
    },
    {
      "id": "ff-shuffle",
      "type": "fitness-fn",
      "label": "Tests pass in any order",
      "x": 1040,
      "y": 780,
      "category": "process",
      "threshold": "The suite passes in 3 consecutive runs with random order and parallel workers",
      "description": "A nightly job runs the suite three times with shuffled order and a different seed each time; a failure prints the seed, so the order can be reproduced. JUnit 5: junit.jupiter.testmethod.order.default=org.junit.jupiter.api.MethodOrderer$Random; pytest: pytest-randomly.\n\nTool: Vitest (sequence.shuffle)\n\n```ts\n// vitest.config.ts\nimport { defineConfig } from 'vitest/config'\nexport default defineConfig({\n  test: {\n    sequence: { shuffle: true },  // files and tests in random order\n    pool: 'threads',\n  },\n})\n// nightly: for seed in 1 2 3; do npx vitest run --sequence.seed=$RANDOM || exit 1; done\n```",
      "hubWhen": {
        "DATA": [
          "synthetic",
          "fixtures"
        ]
      }
    },
    {
      "id": "ff-pii-scan",
      "type": "fitness-fn",
      "label": "Test copies hold no personal data",
      "x": 1040,
      "y": 910,
      "category": "operational",
      "threshold": "0 personal-data findings in a sample of 10,000 rows per table of each copy; a copy with findings is not released to test environments",
      "description": "Before a masked copy is released, a job samples every text column and runs Presidio's analyzer over it; any finding stops the release of the copy.\n\nTool: Microsoft Presidio\n\n```python\nfrom presidio_analyzer import AnalyzerEngine\nanalyzer = AnalyzerEngine()\nENTITIES = [\"PERSON\", \"EMAIL_ADDRESS\", \"PHONE_NUMBER\", \"IBAN_CODE\", \"CREDIT_CARD\", \"LOCATION\"]\n\ndef findings(rows):\n    for table, column, value in rows:           # sampled text columns of the copy\n        for hit in analyzer.analyze(text=str(value), entities=ENTITIES, language=\"en\"):\n            if hit.score >= 0.6:\n                yield table, column, hit.entity_type\n\nhits = list(findings(sample_rows(limit_per_table=10_000)))\nassert not hits, f\"personal data in the test copy: {hits[:20]}\"\n```",
      "hubWhen": {
        "DATA": [
          "masked"
        ]
      }
    },
    {
      "id": "ff-e2e-gate",
      "type": "fitness-fn",
      "label": "Journeys gate the release",
      "x": 1040,
      "y": 1040,
      "category": "process",
      "threshold": "All end-to-end tests of {{JOURNEYS}} pass before the build is merged or promoted; 0 skipped",
      "description": "Playwright runs the journeys against the environment the pipeline deployed (an ephemeral one per pull request, or staging after the merge); its job is a required check for the merge or for the promotion.\n\nTool: Playwright\n\n```ts\n// playwright.config.ts\nimport { defineConfig } from '@playwright/test'\nexport default defineConfig({\n  testDir: 'e2e',\n  forbidOnly: true,                       // no test.only left in the gate\n  retries: 0,\n  reporter: [['junit', { outputFile: 'reports/e2e.xml' }]],\n  use: { baseURL: process.env.E2E_BASE_URL, trace: 'retain-on-failure' },\n})\n```",
      "hubWhen": {
        "E2E": [
          "pipeline",
          "staging"
        ]
      }
    },
    {
      "id": "ff-synthetic",
      "type": "fitness-fn",
      "label": "Journeys checked in production",
      "x": 1040,
      "y": 1170,
      "category": "operational",
      "threshold": "Each journey of {{JOURNEYS}} runs every 5 minutes from 2 locations; 2 failures in a row roll the release back",
      "description": "The Playwright journeys run as Checkly browser checks against production after each deploy and every 5 minutes; an alert channel triggers the rollback.\n\nTool: Checkly (Playwright browser checks)\n\n```ts\n// checkly/checkout.check.ts\nimport { BrowserCheck, Frequency } from 'checkly/constructs'\nnew BrowserCheck('checkout-journey', {\n  name: 'Checkout journey',\n  frequency: Frequency.EVERY_5M,\n  locations: ['eu-west-1', 'eu-central-1'],\n  degradedResponseTime: 8000,\n  maxResponseTime: 15000,\n  code: { entrypoint: '../e2e/checkout.spec.ts' },\n})\n```",
      "hubWhen": {
        "E2E": [
          "production"
        ]
      }
    },
    {
      "id": "ff-quarantine",
      "type": "fitness-fn",
      "label": "Quarantine is emptied",
      "x": 1040,
      "y": 1300,
      "category": "process",
      "threshold": "0 tests in quarantine for more than {{QUARANTINE_DAYS}} days; every entry has an owner and a ticket",
      "description": "Quarantined tests are listed in quarantine.json and tagged @quarantine, which the gate skips and a separate non-blocking job runs. A test over the list fails the build when an entry is older than the deadline or has no owner.\n\nTool: Vitest (a test over quarantine.json)\n\n```ts\nimport { expect, it } from 'vitest'\nimport quarantine from '../quarantine.json'   // [{ test, owner, ticket, since: \"2026-10-01\" }]\n\nconst DAYS = Number(process.env.QUARANTINE_DAYS ?? 7)\n\nit('no test stays in quarantine past the deadline', () => {\n  const overdue = quarantine.filter((q) =>\n    !q.owner || !q.ticket || (Date.now() - Date.parse(q.since)) / 86_400_000 > DAYS)\n  expect(overdue).toEqual([])\n})\n```",
      "hubWhen": {
        "FLAKY": [
          "quarantine"
        ]
      }
    },
    {
      "id": "ff-flaky-fails",
      "type": "fitness-fn",
      "label": "Flaky tests fail the build",
      "x": 1040,
      "y": 1430,
      "category": "process",
      "threshold": "0 tests that pass only on retry; such a test fails the build",
      "description": "The test-retry plugin reruns a failed test once only to tell a flake from a real failure; with failOnPassedAfterRetry a test that passes on retry still fails the build and is reported as flaky.\n\nTool: Gradle test-retry plugin\n\n```kotlin\n// build.gradle.kts\nplugins { id(\"org.gradle.test-retry\") version \"1.6.2\" }\n\ntasks.test {\n  retry {\n    maxRetries.set(1)\n    failOnPassedAfterRetry.set(true)  // a flake is a failure\n  }\n}\n```",
      "hubWhen": {
        "FLAKY": [
          "zero"
        ]
      }
    }
  ],
