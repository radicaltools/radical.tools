{
  "hub": {
    "id": "concern-code-quality-gate",
    "category": "concern",
    "name": "Code quality gate",
    "description": "What a change must pass before it is merged, beyond the tests: which static analysis is enforced, how strict the types are, whether size and complexity are limited, how new findings are treated against the old ones, and what happens to duplicated code.",
    "tags": [
      "maintainability",
      "static analysis",
      "linting",
      "quality gate",
      "complexity",
      "technical debt",
      "type safety"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "concern": {
      "id": "code-quality-gate",
      "trigger": "LIST NODES WHERE (type = \"container\" OR type = \"webapp\") AND external != true",
      "why": "code lives in these elements, so what a change must pass before it is merged, beyond the tests, has to be decided; one decision usually covers a whole repository and is bound to every element built from it.",
      "group": "sdlc"
    },
    "sources": [
      {
        "title": "SonarSource: Clean as You Code",
        "url": "https://docs.sonarsource.com/sonarqube-server/latest/core-concepts/clean-as-you-code/introduction/"
      },
      {
        "title": "Google Engineering Practices: The Code Reviewer's Guide",
        "url": "https://google.github.io/eng-practices/review/reviewer/"
      },
      {
        "title": "Google Engineering Practices: Small CLs",
        "url": "https://google.github.io/eng-practices/review/developer/small-cls.html"
      },
      {
        "title": "Martin Fowler: Continuous Integration",
        "url": "https://martinfowler.com/articles/continuousIntegration.html"
      },
      {
        "title": "Watson, McCabe: Structured Testing, NIST Special Publication 500-235 (cyclomatic complexity)",
        "url": "https://www.mccabe.com/pdf/mccabe-nist235r.pdf"
      },
      {
        "title": "ISO/IEC 25010, Maintainability: modularity, analysability, modifiability",
        "url": "https://iso25000.com/index.php/en/iso-25000-standards/iso-25010"
      },
      {
        "title": "ESLint: Configuration Files (flat config)",
        "url": "https://eslint.org/docs/latest/use/configure/configuration-files"
      },
      {
        "title": "Ruff: An extremely fast Python linter and code formatter",
        "url": "https://docs.astral.sh/ruff/"
      },
      {
        "title": "Forsgren, Humble, Kim: Accelerate",
        "url": "https://itrevolution.com/product/accelerate/"
      },
      {
        "title": "jscpd: copy/paste detector",
        "url": "https://github.com/kucherenko/jscpd"
      }
    ],
    "templateParams": [
      {
        "key": "STATIC",
        "title": "Static analysis",
        "label": "Which static analysis is enforced before a merge?",
        "hint": "This decides who finds the obvious mistakes: a linter in the build, a platform with a gate on new code, or nobody but the reviewer. It also decides what the rest of the gate can hang on: with only a formatter there are no findings to treat.",
        "defaultValue": "linter",
        "options": [
          {
            "value": "linter",
            "label": "a linter and a formatter in CI",
            "description": "A linter (ESLint or Biome, ruff, golangci-lint, detekt) with a recommended rule set and a formatter (Prettier or Biome, ruff format or Black, gofmt) run on every pull request and fail it on an error; the same versions run locally on commit. Pick it as the default for any codebase with more than one contributor."
          },
          {
            "value": "sonar",
            "label": "a code-analysis platform with a gate on new code",
            "description": "SonarQube or SonarCloud analyses every pull request and its quality gate (\"Clean as You Code\") fails the build when new code brings a bug, a vulnerability, a security hotspot left unreviewed or a maintainability rating below A; the linter and formatter still run locally and in CI for fast feedback. Pick it when several teams or many repositories need one standard with a dashboard, or when a regulator or customer asks for evidence."
          },
          {
            "value": "format-only",
            "label": "only a formatter",
            "description": "A formatter is enforced in CI and on commit; no lint rule set and no analysis platform, so the findings question below does not apply (there are none to treat until a linter arrives). Pick it for prototypes, scripts and tools under 5,000 lines with one or two owners, where review covers what a linter would; the decision records when to revisit it."
          }
        ]
      },
      {
        "key": "TYPES",
        "title": "Types",
        "label": "How strict are the types?",
        "hint": "A type checker is the cheapest reviewer there is, but turning it to strict on an old codebase produces thousands of errors at once. Dynamic languages have the same choice with mypy, Sorbet or Psalm.",
        "defaultValue": "strict",
        "options": [
          {
            "value": "strict",
            "label": "strict everywhere",
            "description": "The strictest mode of the checker is on for the whole element: TypeScript strict with noImplicitAny and noUncheckedIndexedAccess, mypy --strict, C# nullable enabled with warnings as errors, Kotlin explicit API. Pick it for a new codebase or one that is already close to it."
          },
          {
            "value": "ratchet",
            "label": "raised file by file with a baseline",
            "description": "Strict mode is on for new files and for a growing list of old ones; files not yet strict are listed in a baseline that may only shrink (typescript-strict-plugin, mypy per-module overrides, a #nullable enable per file). Pick it for an existing codebase where strict everywhere would be a months-long stop."
          },
          {
            "value": "loose",
            "label": "types only at module boundaries",
            "description": "Dynamic typing inside modules, with type annotations required and checked only on the parameters and return values of exported or public functions, by one lint rule that runs even where only a formatter is enforced. Pick it for scripts, notebooks and glue code, or a language without a mature checker."
          }
        ]
      },
      {
        "key": "COMPLEXITY",
        "title": "Complexity",
        "label": "Are size and complexity limited?",
        "hint": "A function with a cyclomatic complexity over 10 needs more than 10 test paths and is where defects cluster; a limit enforced in the build keeps it from being written, a number shown in review only keeps it visible.",
        "defaultValue": "limits",
        "options": [
          {
            "value": "limits",
            "label": "enforced limits",
            "description": "Cyclomatic complexity per function (10 by default), function length (50 lines), file length (400 lines) and nesting (4 levels) fail the check and block the merge; old code over the limit is baselined per the findings rule. Pick it for code that will be maintained for years by people other than its authors."
          },
          {
            "value": "advisory",
            "label": "measured and shown, not blocking",
            "description": "The same measures are computed on every pull request and posted as review annotations on the changed functions, but do not block. Pick it for the first months on a codebase where most functions are already over the limit, with the intent to turn the limits on later."
          },
          {
            "value": "none",
            "label": "no limits",
            "description": "Size and complexity are left to review. Pick it only for small, short-lived code with one owner."
          }
        ]
      },
      {
        "key": "DEBT",
        "title": "Findings",
        "label": "How are new findings treated against the old ones?",
        "hint": "Only when static analysis is a linter or a platform: with only a formatter there are no findings. On an existing codebase the first run of a linter reports thousands of findings; what the gate does with the old ones decides whether the new rules are kept or switched off within a week.",
        "defaultValue": "zero-new",
        "options": [
          {
            "value": "zero-new",
            "label": "no new findings",
            "description": "A change may bring no new finding in the lines it adds or changes; findings in untouched old code are baselined and reported but do not block. Pick it as the default for any codebase with history: the code gets cleaner where it is being changed, which is where it matters."
          },
          {
            "value": "ratchet",
            "label": "a count that may only go down",
            "description": "The total number of findings is kept in a committed baseline; a pull request that raises it fails, and one that lowers it lowers the baseline. Pick it when the tooling cannot tell new lines from old (a custom check, a language without a Sonar or reviewdog integration), or when the team wants the debt visibly shrinking."
          },
          {
            "value": "fix-all",
            "label": "every finding fixed before merge",
            "description": "No baseline: the whole element has zero findings on the main branch, and a change with one cannot merge. Pick it for a new codebase, or after a one-time clean-up; it is the only option that keeps the rule set from drifting into a list of exceptions."
          }
        ]
      },
      {
        "key": "DUPLICATION",
        "title": "Duplication",
        "label": "What happens to duplicated code?",
        "hint": "Copied code is the most common way a fix is applied in one place and missed in the others; the question is whether the gate stops it or only shows it.",
        "defaultValue": "report",
        "options": [
          {
            "value": "block",
            "label": "blocked above a threshold",
            "description": "Duplicated lines in the element above a threshold (3% by default, measured by jscpd over the whole source tree, or by the Sonar condition on new code) fail the pull request. Pick it when the element has a history of copy-paste fixes, or when it holds business rules that must exist once."
          },
          {
            "value": "report",
            "label": "reported in the pull request",
            "description": "Duplication is measured on every pull request and the clones are posted as a comment, and the reviewer decides. Pick it as the default: some duplication is better than a wrong abstraction, and the reviewer can tell the two apart."
          }
        ]
      },
      {
        "key": "LINT_MINUTES",
        "label": "Within how many minutes must the static checks of a pull request finish?",
        "defaultValue": "5",
        "type": "number"
      },
      {
        "key": "MAX_COMPLEXITY",
        "label": "What is the highest cyclomatic complexity allowed per function?",
        "defaultValue": "10",
        "type": "number"
      },
      {
        "key": "MAX_FUNCTION_LINES",
        "label": "How many lines may a function have at most?",
        "defaultValue": "50",
        "type": "number"
      },
      {
        "key": "MAX_FILE_LINES",
        "label": "How many lines may a file have at most?",
        "defaultValue": "400",
        "type": "number"
      },
      {
        "key": "DUPLICATION_PCT",
        "label": "What share of duplicated lines is allowed (%)?",
        "defaultValue": "3",
        "type": "number"
      }
    ]
  },
  "nodes": [
    {
      "id": "need",
      "type": "need",
      "label": "Code stays readable as it changes",
      "x": 0,
      "y": 0,
      "kind": "brief",
      "source": "Hub concern pack: Code quality gate",
      "description": "The element is changed by several people and will be maintained by people who did not write it. Every change must leave the code at least as readable, typed and small as it found it, and the obvious mistakes (an unused variable, a wrong null check, a 300-line function, a copied block) must be found by a machine in minutes, so that review time goes to design and correctness. A rule that is not enforced is not a rule; one that blocks on code nobody is touching gets switched off."
    },
    {
      "id": "req-gate-on-pr",
      "type": "requirement",
      "label": "Static checks on every change",
      "x": 260,
      "y": 0,
      "ears_type": "event-driven",
      "trigger": "a pull request is opened or updated",
      "action": "run the static checks of this decision within {{LINT_MINUTES}} minutes as a required status check, and block the merge on any error",
      "rationale": "A check that runs after the merge, or that people can skip, does not change what is merged; one that takes longer than a few minutes is not waited for (Fowler, Continuous Integration: every commit builds on an integration machine, keep the build fast)."
    },
    {
      "id": "req-formatted",
      "type": "requirement",
      "label": "Code is formatted by the formatter",
      "x": 260,
      "y": 130,
      "ears_type": "ubiquitous",
      "action": "keep every source file exactly as the formatter prints it, with the formatter run on staged files at commit and its check run in CI, so that 0 lines of a pull request differ from the formatter's output",
      "rationale": "Formatting is the cheapest thing to automate and the most expensive thing to argue about in review; a formatter with no options ends the argument (Google, The Code Reviewer's Guide: style guide is the absolute authority, formatting comments are not needed)."
    },
    {
      "id": "req-lint-rules",
      "type": "requirement",
      "label": "Lint rules enforced as errors",
      "x": 260,
      "y": 260,
      "ears_type": "ubiquitous",
      "action": "run the linter with its recommended rule set plus the type-aware rules of the stack, every rule at error severity, with an unused disable comment itself an error and any disable comment allowed only with a description naming the reason",
      "rationale": "A rule at warning severity is noise within a month; a disable comment without a reason is a rule removed in silence (ESLint docs: linter-options.reportUnusedDisableDirectives; ISO 25010 analysability).",
      "hubWhen": {
        "STATIC": [
          "linter"
        ]
      }
    },
    {
      "id": "req-sonar-gate",
      "type": "requirement",
      "label": "Quality gate on new code",
      "x": 260,
      "y": 390,
      "ears_type": "event-driven",
      "trigger": "a pull request is analysed",
      "action": "fail the pipeline unless the quality gate on new code holds: 0 new bugs, 0 new vulnerabilities, 100% of new security hotspots reviewed, maintainability rating A on new code, with new code defined against the main branch",
      "rationale": "A gate on new code is one every pull request can pass, so it stays on; a gate on the whole codebase is failed from day one and ignored (SonarSource, Clean as You Code).",
      "hubWhen": {
        "STATIC": [
          "sonar"
        ]
      }
    },
    {
      "id": "req-format-only-revisit",
      "type": "requirement",
      "label": "Formatter only, until the element grows",
      "x": 260,
      "y": 520,
      "ears_type": "event-driven",
      "trigger": "the element passes 5,000 source lines or gains a third regular contributor",
      "action": "revisit this decision and introduce a linter with a recommended rule set through a new decision within one month",
      "rationale": "The case for no lint rules is a small codebase that review can hold in its head; past that size the obvious mistakes slip through, and the decision says so before it happens (Google, Small CLs; ISO 25010 analysability).",
      "hubWhen": {
        "STATIC": [
          "format-only"
        ]
      }
    },
    {
      "id": "req-strict-types",
      "type": "requirement",
      "label": "Strict types everywhere",
      "x": 260,
      "y": 650,
      "ears_type": "ubiquitous",
      "action": "type-check the whole element in the checker's strict mode (TypeScript strict with noImplicitAny and noUncheckedIndexedAccess, mypy --strict, nullable enabled with warnings as errors) on every pull request, with 0 type errors and 0 suppression comments (@ts-ignore, @ts-expect-error, type: ignore, #pragma warning disable) without an issue id",
      "rationale": "Strict typing moves a class of defects from production to the editor at no runtime cost, and a suppression without a reason is a type error nobody will revisit (ISO 25010 analysability; Accelerate: shift left on quality).",
      "hubWhen": {
        "TYPES": [
          "strict"
        ]
      }
    },
    {
      "id": "req-type-ratchet",
      "type": "requirement",
      "label": "Strictness only goes up",
      "x": 260,
      "y": 780,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a pull request adds a file to the non-strict baseline, or a file in the baseline passes strict checking and is not removed from it",
      "action": "fail the check, and require new files to be strict from their first commit",
      "rationale": "Raising strictness file by file is the only way through an old codebase without stopping delivery, and it works only if the list of exceptions can never grow (Accelerate: work in small batches; SonarSource, Clean as You Code applied to types).",
      "hubWhen": {
        "TYPES": [
          "ratchet"
        ]
      }
    },
    {
      "id": "req-boundary-types",
      "type": "requirement",
      "label": "Types at module boundaries",
      "x": 260,
      "y": 910,
      "ears_type": "ubiquitous",
      "action": "declare the types of the parameters and return values of every exported or public function, check them on every pull request, and leave the rest of the code untyped",
      "rationale": "Types pay most where a caller cannot see the implementation; inside a module the reader has the code (ISO 25010 modularity, analysability).",
      "hubWhen": {
        "TYPES": [
          "loose"
        ]
      }
    },
    {
      "id": "req-complexity-limits",
      "type": "requirement",
      "label": "Size and complexity limited",
      "x": 260,
      "y": 1040,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a changed function has a cyclomatic complexity above {{MAX_COMPLEXITY}} or more than {{MAX_FUNCTION_LINES}} lines, nests deeper than 4 levels, or a changed file has more than {{MAX_FILE_LINES}} lines",
      "action": "report it as an error and block the merge, with functions over the limit before this decision baselined per the findings rule",
      "rationale": "Cyclomatic complexity above 10 means more than 10 independent paths to test and is where defects cluster; function and file length limit what a reader has to hold at once (McCabe, NIST 500-235, the limit of 10; ISO 25010 modularity).",
      "hubWhen": {
        "COMPLEXITY": [
          "limits"
        ]
      }
    },
    {
      "id": "req-complexity-shown",
      "type": "requirement",
      "label": "Complexity shown in review",
      "x": 260,
      "y": 1170,
      "ears_type": "event-driven",
      "trigger": "a pull request is opened or updated",
      "action": "compute cyclomatic complexity and length for every changed function and annotate in the pull request each one above {{MAX_COMPLEXITY}} or {{MAX_FUNCTION_LINES}} lines, without blocking the merge",
      "rationale": "What is shown in review gets discussed; a number nobody sees is a limit nobody keeps (McCabe, NIST 500-235; Google, The Code Reviewer's Guide: complexity).",
      "hubWhen": {
        "COMPLEXITY": [
          "advisory"
        ]
      }
    },
    {
      "id": "req-zero-new",
      "type": "requirement",
      "label": "No new findings in changed lines",
      "x": 260,
      "y": 1300,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a finding of any enabled rule lies on a line the pull request added or changed",
      "action": "fail the check, while findings on untouched lines are reported in the pull request but do not block",
      "rationale": "Fixing the code where it is being changed is where clean-up pays; blocking on old code nobody is touching gets the rules switched off (SonarSource, Clean as You Code: focus on new code).",
      "hubWhen": {
        "DEBT": [
          "zero-new"
        ],
        "STATIC": [
          "linter",
          "sonar"
        ]
      }
    },
    {
      "id": "req-ratchet",
      "type": "requirement",
      "label": "Findings only go down",
      "x": 260,
      "y": 1430,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "the number of linter findings after a change is higher than the committed baseline",
      "action": "fail the check; when the number is lower, lower the baseline in the same pull request",
      "rationale": "A count that can only fall makes the debt visible and shrinking, and needs no tool that tells new lines from old (Accelerate: visibility of work; Fowler, Continuous Integration: fix broken builds immediately).",
      "hubWhen": {
        "DEBT": [
          "ratchet"
        ],
        "STATIC": [
          "linter",
          "sonar"
        ]
      }
    },
    {
      "id": "req-fix-all",
      "type": "requirement",
      "label": "Zero findings, no baseline",
      "x": 260,
      "y": 1560,
      "ears_type": "ubiquitous",
      "action": "keep 0 linter findings on the main branch, with no findings baseline file in the repository, and fail any pull request with a finding",
      "rationale": "Zero is the only count that needs no explanation and cannot drift; it is affordable on a new or freshly cleaned codebase and costly afterwards (Fowler, Continuous Integration; Google, Small CLs).",
      "hubWhen": {
        "DEBT": [
          "fix-all"
        ],
        "STATIC": [
          "linter",
          "sonar"
        ]
      }
    },
    {
      "id": "req-duplication",
      "type": "requirement",
      "label": "Duplication blocked",
      "x": 260,
      "y": 1690,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "the duplicated lines of the element (blocks of 10 or more lines found twice) exceed {{DUPLICATION_PCT}}% of its source lines after a pull request",
      "action": "fail the check, naming both copies of every clone",
      "rationale": "A fix applied to one copy and missed in the other is the most common way duplicated code fails; the gate names the second copy while it is still cheap to remove (ISO 25010 modifiability; SonarSource, duplicated lines on new code).",
      "hubWhen": {
        "DUPLICATION": [
          "block"
        ]
      }
    },
    {
      "id": "req-duplication-reported",
      "type": "requirement",
      "label": "Duplication reported",
      "x": 260,
      "y": 1820,
      "ears_type": "event-driven",
      "trigger": "a pull request is opened or updated",
      "action": "measure the duplicated lines of the element and post every clone with both locations as a comment on the pull request, without blocking the merge",
      "rationale": "The reviewer can tell a wrong abstraction from a copy-paste fix only when the copies are in front of them; a report nobody sees decides nothing (Google, The Code Reviewer's Guide; ISO 25010 modifiability).",
      "hubWhen": {
        "DUPLICATION": [
          "report"
        ]
      }
    },
    {
      "id": "sc-gate-on-pr",
      "type": "scenario",
      "label": "Finding blocks the merge",
      "x": 520,
      "y": 0,
      "given": "a pull request whose change brings an error in a static check",
      "when": "it is pushed",
      "then": "the check reports the error within {{LINT_MINUTES}} minutes, and the branch rules list the check as required so the pull request cannot be merged"
    },
    {
      "id": "sc-formatted",
      "type": "scenario",
      "label": "Unformatted change refused",
      "x": 520,
      "y": 130,
      "given": "a pull request with a file the formatter would change",
      "when": "the CI check runs",
      "then": "it fails naming the file, and the same file is reformatted by the pre-commit hook on the next commit"
    },
    {
      "id": "sc-lint-rules",
      "type": "scenario",
      "label": "Warnings are errors",
      "x": 520,
      "y": 260,
      "given": "the linter configuration",
      "when": "a rule fires in a changed file, a disable comment covers nothing, and another disable comment has no description",
      "then": "all three fail the check, and no rule is configured at warning severity",
      "hubWhen": {
        "STATIC": [
          "linter"
        ]
      }
    },
    {
      "id": "sc-sonar-gate",
      "type": "scenario",
      "label": "New bug fails the gate",
      "x": 520,
      "y": 390,
      "given": "a pull request adding a function with a bug the analyser detects",
      "when": "the analysis runs",
      "then": "the quality gate fails on new code, the pipeline waits for it and fails, and the merge is blocked",
      "hubWhen": {
        "STATIC": [
          "sonar"
        ]
      }
    },
    {
      "id": "sc-format-only-revisit",
      "type": "scenario",
      "label": "Growth triggers a linter",
      "x": 520,
      "y": 520,
      "given": "an element with only a formatter enforced",
      "when": "a monthly count shows 5,000 source lines or three regular contributors",
      "then": "an issue to introduce a linter is opened with this decision linked, and the monthly job stays red until a new decision supersedes this one",
      "hubWhen": {
        "STATIC": [
          "format-only"
        ]
      }
    },
    {
      "id": "sc-strict-types",
      "type": "scenario",
      "label": "Implicit any refused",
      "x": 520,
      "y": 650,
      "given": "a pull request adding a parameter without a type",
      "when": "the type check runs",
      "then": "it fails with noImplicitAny, and adding @ts-ignore without an issue id fails the suppression check as well",
      "hubWhen": {
        "TYPES": [
          "strict"
        ]
      }
    },
    {
      "id": "sc-type-ratchet",
      "type": "scenario",
      "label": "Baseline cannot grow",
      "x": 520,
      "y": 780,
      "given": "a baseline listing the non-strict files",
      "when": "a pull request marks a new file non-strict, and another makes a listed file pass strict checking",
      "then": "the first fails the check, and the second fails until the file is unmarked and removed from the baseline",
      "hubWhen": {
        "TYPES": [
          "ratchet"
        ]
      }
    },
    {
      "id": "sc-boundary-types",
      "type": "scenario",
      "label": "Untyped export refused",
      "x": 520,
      "y": 910,
      "given": "a pull request exporting a function without parameter types",
      "when": "the check runs",
      "then": "it fails on the export, while an untyped local helper in the same file passes",
      "hubWhen": {
        "TYPES": [
          "loose"
        ]
      }
    },
    {
      "id": "sc-complexity-limits",
      "type": "scenario",
      "label": "Complex function refused",
      "x": 520,
      "y": 1040,
      "given": "a pull request adding a function with cyclomatic complexity {{MAX_COMPLEXITY}} plus 1",
      "when": "the complexity check runs",
      "then": "it fails naming the function and its complexity, and the merge is blocked",
      "hubWhen": {
        "COMPLEXITY": [
          "limits"
        ]
      }
    },
    {
      "id": "sc-complexity-shown",
      "type": "scenario",
      "label": "Complex function annotated",
      "x": 520,
      "y": 1170,
      "given": "a pull request changing a function with complexity {{MAX_COMPLEXITY}} plus 5",
      "when": "the check runs",
      "then": "the function is annotated with its complexity in the pull request and the check passes",
      "hubWhen": {
        "COMPLEXITY": [
          "advisory"
        ]
      }
    },
    {
