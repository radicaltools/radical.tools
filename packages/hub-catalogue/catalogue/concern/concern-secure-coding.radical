{
  "hub": {
    "id": "concern-secure-coding",
    "category": "concern",
    "name": "Secure coding",
    "description": "How the code itself is kept free of the common vulnerability classes: the standard it is held to, where input is validated and output encoded, how static and dynamic security testing runs, and what happens to a finding.",
    "tags": [
      "security",
      "secure-coding",
      "owasp",
      "asvs",
      "sast",
      "dast",
      "input-validation"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "concern": {
      "id": "secure-coding",
      "trigger": "LIST NODES WHERE (type = \"container\" OR type = \"webapp\") AND external != true",
      "why": "code is written for these elements, so the standard it is held to, where input is validated, how it is tested for vulnerabilities and what happens to a finding has to be decided.",
      "group": "security"
    },
    "sources": [
      {
        "title": "OWASP Application Security Verification Standard (ASVS) 4.0.3 and 5.0",
        "url": "https://owasp.org/www-project-application-security-verification-standard/"
      },
      {
        "title": "OWASP Top 10:2021",
        "url": "https://owasp.org/Top10/"
      },
      {
        "title": "OWASP Input Validation Cheat Sheet",
        "url": "https://cheatsheetseries.owasp.org/cheatsheets/Input_Validation_Cheat_Sheet.html"
      },
      {
        "title": "OWASP SQL Injection Prevention Cheat Sheet",
        "url": "https://cheatsheetseries.owasp.org/cheatsheets/SQL_Injection_Prevention_Cheat_Sheet.html"
      },
      {
        "title": "OWASP Cross Site Scripting Prevention Cheat Sheet",
        "url": "https://cheatsheetseries.owasp.org/cheatsheets/Cross_Site_Scripting_Prevention_Cheat_Sheet.html"
      },
      {
        "title": "OWASP Top 10 Proactive Controls 2024",
        "url": "https://top10proactive.owasp.org/"
      },
      {
        "title": "SEI CERT Coding Standards (C, C++, Java)",
        "url": "https://wiki.sei.cmu.edu/confluence/display/seccode"
      },
      {
        "title": "MISRA C:2023, Guidelines for the use of the C language in critical systems",
        "url": "https://misra.org.uk/"
      },
      {
        "title": "NIST SP 800-218, Secure Software Development Framework (SSDF) 1.1",
        "url": "https://csrc.nist.gov/pubs/sp/800/218/final"
      },
      {
        "title": "Semgrep documentation",
        "url": "https://semgrep.dev/docs/"
      },
      {
        "title": "GitHub CodeQL documentation",
        "url": "https://codeql.github.com/docs/"
      },
      {
        "title": "OWASP ZAP documentation",
        "url": "https://www.zaproxy.org/docs/"
      },
      {
        "title": "Threat Modeling Manifesto",
        "url": "https://www.threatmodelingmanifesto.org/"
      }
    ],
    "templateParams": [
      {
        "key": "STANDARD",
        "title": "Standard",
        "label": "Which standard is the code held to?",
        "hint": "The standard decides what \"secure\" means for a change: a list of controls a tool can verify, the same plus design-level controls carried by a threat model, or a language rule set for code where a wrong index is a remote code execution.",
        "defaultValue": "asvs-l1",
        "options": [
          {
            "value": "asvs-l1",
            "label": "OWASP ASVS level 1",
            "description": "The ASVS Level 1 controls: the ones that can be verified automatically or with a black-box test, mapped to lint rules, tests and scanners. Pick it for most applications: anything without personal, financial or health data, as the floor every element reaches."
          },
          {
            "value": "asvs-l2",
            "label": "OWASP ASVS level 2, with a threat model as the Threat modelling pack decides",
            "description": "ASVS Level 2: everything in Level 1, plus design-level controls, carried by the threat model the Threat modelling pack decides (when it is made, with which method, where it lives). Pick it for applications handling personal, financial or health data, or where a flaw in one feature's design would be a reportable incident."
          },
          {
            "value": "cert-misra",
            "label": "a language coding standard (SEI CERT or MISRA)",
            "description": "SEI CERT C/C++ or Java, or MISRA C:2023, checked by a compliant analyser in CI: bounds checks, no banned functions, integer overflow handled, deviations recorded. Pick it for embedded, safety-related or systems-level code in C, C++ or Rust-with-unsafe, where memory corruption is the vulnerability class that matters."
          }
        ]
      },
      {
        "key": "INPUT",
        "title": "Input",
        "label": "Where is input validated?",
        "hint": "Validation at one boundary gives the inside typed values and one place to look; validation everywhere is what a library needs when it does not know who calls it.",
        "defaultValue": "boundary-schema",
        "options": [
          {
            "value": "boundary-schema",
            "label": "once at the boundary, against a schema",
            "description": "Every request, message and file is validated against a declared schema (zod or valibot, Pydantic, Bean Validation or JSON Schema) before any handler runs; the inside trusts the typed values. Pick it for services and web apps with a clear boundary (HTTP, a queue consumer, a file import)."
          },
          {
            "value": "everywhere",
            "label": "defensively, at every layer",
            "description": "Every exported function and handler checks its own arguments for type, range, length and allowed values. Pick it for libraries, SDKs and code called from many places, where no single boundary exists; it costs duplicated checks and needs discipline about what each layer owns."
          }
        ]
      },
      {
        "key": "SAST",
        "title": "Static analysis",
        "label": "How does static application security testing run?",
        "hint": "A scanner on the pull request finds the flaw while the author still remembers the code; a scheduled one finds it later and hands it to a queue. The lint rules for banned constructs and string-built queries run in every case; this is about the scanner suites.",
        "defaultValue": "pr-blocking",
        "options": [
          {
            "value": "pr-blocking",
            "label": "a scan of every pull request that blocks the merge on high findings",
            "description": "Semgrep (p/owasp-top-ten, p/default), CodeQL security-extended and the language's scanner (Bandit, gosec, SpotBugs find-sec-bugs) run as required checks; a high or critical finding without a reviewed suppression stops the merge. Pick it for anything reached from the internet or holding personal data."
          },
          {
            "value": "scheduled",
            "label": "a nightly scan with findings triaged within a deadline",
            "description": "The same scanners run on a schedule over the default branch, and every new finding gets an owner and a deadline from a triage queue. Pick it for a codebase with a large backlog of findings you are working through, or where the scanners are too slow or noisy for the pull request; move to blocking once the queue is empty."
          },
          {
            "value": "none",
            "label": "no scanner suite, code review only",
            "description": "No Semgrep or CodeQL suite; the lint rules for banned constructs and string-built queries still run on the pull request, and reviewers check the rest against the standard's checklist. Pick it only for small internal tools with no outside callers and no personal data, and record it so that the first external caller supersedes this decision."
          }
        ]
      },
      {
        "key": "DAST",
        "title": "Dynamic testing",
        "label": "How does dynamic security testing run?",
        "hint": "Static analysis sees the code; a dynamic scan sees what the deployed system exposes: headers, cookies, error pages, forgotten routes.",
        "defaultValue": "pipeline",
        "options": [
          {
            "value": "pipeline",
            "label": "a ZAP scan of each environment the pipeline deploys to",
            "description": "An OWASP ZAP baseline scan (or API scan from the OpenAPI document) runs against every environment the pipeline deploys to, and a high alert fails the deployment's check. Pick it when the pipeline deploys to an environment it can reach, which is most pipelines."
          },
          {
            "value": "periodic",
            "label": "a scheduled ZAP full scan",
            "description": "A ZAP full scan runs on a schedule against staging, and its findings enter the same deadlines; how often an external penetration test runs is decided in the Secure development process pack. Pick it when deployments are rare or the pipeline cannot reach the running system."
          },
          {
            "value": "none",
            "label": "no dynamic testing",
            "description": "No dynamic testing. Pick it only for an element with no HTTP or network surface of its own (a batch job, a library), where fuzzing or unit tests cover its inputs instead."
          }
        ]
      },
      {
        "key": "FINDINGS",
        "title": "Findings",
        "label": "What happens to a security finding?",
        "hint": "A deadline by severity turns a finding into work; a signed acceptance with an expiry date is the only honest way to leave one open.",
        "defaultValue": "sla",
        "options": [
          {
            "value": "sla",
            "label": "a deadline by severity",
            "description": "Every finding (scanner, pentest, review, bug bounty) is fixed within its severity's deadline, and the main branch's build fails on an overdue one. Pick it when the team can fix what the scanners find; it is the simplest rule and the hardest to argue with."
          },
          {
            "value": "risk-accepted",
            "label": "a deadline by severity, or a written acceptance until a date",
            "description": "The same deadlines, but a finding may be left open with a written risk acceptance in a register, signed by the owner and a second person from security, that expires. Pick it for codebases with findings nobody can fix in time (a vendor library, a legacy module slated for replacement); every acceptance comes up again when it expires."
          }
        ]
      },
      {
        "key": "CRITICAL_DAYS",
        "label": "Days to fix a critical finding in our code",
        "defaultValue": "2",
        "type": "number"
      },
      {
        "key": "HIGH_DAYS",
        "label": "Days to fix a high finding in our code",
        "defaultValue": "7",
        "type": "number"
      },
      {
        "key": "MEDIUM_DAYS",
        "label": "Days to fix a medium finding in our code",
        "defaultValue": "30",
        "type": "number"
      },
      {
        "key": "ACCEPTANCE_DAYS",
        "label": "Most days a risk acceptance stays valid. Only with written acceptances",
        "defaultValue": "90",
        "type": "number"
      },
      {
        "key": "SAST_MINUTES",
        "label": "Within how many minutes must the static analysis of a pull request finish? Only with a scan of every pull request",
        "defaultValue": "10",
        "type": "number"
      },
      {
        "key": "DAST_DAYS",
        "label": "Most days between two ZAP full scans of the production configuration. Only with a scheduled ZAP full scan",
        "defaultValue": "90",
        "type": "number"
      }
    ]
  },
  "nodes": [
    {
      "id": "need",
      "type": "need",
      "label": "The code has no known class of hole",
      "x": 0,
      "y": 0,
      "kind": "brief",
      "source": "Hub concern pack: Secure coding",
      "description": "The element's own code must not let an attacker inject a query or a command, run their script in another user's browser, read or change data they may not, deserialise their objects or overrun a buffer. Developers must know which standard a change is held to, where input is checked and output encoded, and a tool must tell them on the pull request when they slipped, before a reviewer and long before an attacker. A finding, from a scanner, a test or a report, must be fixed by a deadline or accepted in writing by someone who may accept it, for a limited time."
    },
    {
      "id": "req-param-queries",
      "type": "requirement",
      "label": "Queries are parameterised",
      "x": 260,
      "y": 0,
      "ears_type": "ubiquitous",
      "action": "pass every value that reaches a database, directory, OS command or interpreter as a bound parameter of a prepared statement or through the ORM's query builder, and build 0 queries or commands by string concatenation, interpolation or formatting",
      "rationale": "Injection is OWASP Top 10 A03:2021; a parameterised query keeps data from ever being parsed as code, whatever the input holds, and is the one defence that needs no judgement per call site (OWASP SQL Injection Prevention Cheat Sheet, Option 1; ASVS 4.0.3 V5.3.4, V5.3.8)."
    },
    {
      "id": "req-output-encoding",
      "type": "requirement",
      "label": "Output encoded by the template engine",
      "x": 260,
      "y": 130,
      "ears_type": "ubiquitous",
      "action": "render every value in HTML, attributes, JavaScript, CSS and URLs through the template engine's contextual auto-escaping (React, Jinja2 and Django templates with autoescape on, Thymeleaf, Razor), and write to 0 raw-HTML sinks (innerHTML, dangerouslySetInnerHTML, |safe, Html.Raw) from data that came from outside, with a sanitiser (DOMPurify) as the only exception for rich text",
      "rationale": "Cross-site scripting is the oldest entry in the Top 10 and is prevented by encoding at the output, in the context the value lands in, which the template engine does on every value when nobody bypasses it (OWASP XSS Prevention Cheat Sheet; ASVS 4.0.3 V5.3.1, V5.3.3).",
      "hubWhen": {
        "STANDARD": [
          "asvs-l1",
          "asvs-l2"
        ]
      }
    },
    {
      "id": "req-input-boundary",
      "type": "requirement",
      "label": "Input validated at the boundary",
      "x": 260,
      "y": 260,
      "ears_type": "event-driven",
      "trigger": "a request, message or file arrives at the element's boundary",
      "action": "validate it against a declared schema (zod or valibot, Pydantic, Bean Validation or JSON Schema) that refuses unknown fields, before any handler runs; reject an invalid one with status 400 (or the protocol's equivalent) that names every failing field and carries no stack trace; and let code inside the boundary work with the typed, validated values only",
      "rationale": "Validation in one place with a schema is validation someone can read and test; naming the field makes rejections usable for honest clients and gives attackers nothing they did not send (OWASP Input Validation Cheat Sheet: allow-list validation at the boundary; ASVS 4.0.3 V5.1.3, V5.1.4; OWASP Proactive Controls 2024, C3: Validate all Input and Handle Exceptions).",
      "hubWhen": {
        "INPUT": [
          "boundary-schema"
        ]
      }
    },
    {
      "id": "req-input-everywhere",
      "type": "requirement",
      "label": "Every layer checks its arguments",
      "x": 260,
      "y": 390,
      "ears_type": "ubiquitous",
      "action": "check the arguments of every exported function and every message handler for type, range, length and allowed values before using them, fail with a typed error that names the argument, and never assume a caller in the same process has validated them",
      "rationale": "A library or shared module has as many boundaries as callers; a check it does not do itself depends on every caller doing it (OWASP Input Validation Cheat Sheet; SEI CERT API00-C and MET00-J: validate the arguments of exported functions and methods).",
      "hubWhen": {
        "INPUT": [
          "everywhere"
        ]
      }
    },
    {
      "id": "req-no-dynamic-code",
      "type": "requirement",
      "label": "Dangerous constructs banned by lint",
      "x": 260,
      "y": 520,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a change introduces eval or new Function, OS command execution with an interpolated string, deserialisation of untrusted data (pickle, ObjectInputStream, BinaryFormatter), a regular expression or a file path built from input, or a function the standard bans",
      "action": "fail the lint of the pull request naming the file and line, unless a reviewed suppression with the reason is written beside it",
      "rationale": "Code built from data is injection by another name, and deserialising untrusted objects is remote code execution in most runtimes; a ban enforced by lint costs nothing per review (OWASP Top 10 A03:2021 and A08:2021; ASVS 4.0.3 V5.2.4, V5.5.1, V5.5.3; OWASP Proactive Controls 2024, C3)."
    },
    {
      "id": "req-framework-defaults",
      "type": "requirement",
      "label": "Framework defenses on by default",
      "x": 260,
      "y": 650,
      "ears_type": "ubiquitous",
      "action": "take CSRF protection, CORS, cookie flags (Secure, HttpOnly, SameSite) and the security headers from the framework's middleware configured once at start (helmet and a CSRF middleware for Express, Spring Security's defaults, Django's SecurityMiddleware and CsrfViewMiddleware, ASP.NET Core antiforgery), with the framework's strict modes on, and write 0 hand-rolled replacements; where a gateway sets the headers, set none in the code that conflict",
      "rationale": "The framework's security middleware is reviewed by more people than any hand-rolled version and is wrong only where it is turned off (OWASP Proactive Controls 2024, C5: Secure by Default Configurations; OWASP Top 10 A05:2021; ASVS 4.0.3 V4.2.2, V14.4, V14.5).",
      "hubWhen": {
        "STANDARD": [
          "asvs-l1",
          "asvs-l2"
        ]
      }
    },
    {
      "id": "req-sast-pr",
      "type": "requirement",
      "label": "Static analysis on every change",
      "x": 260,
      "y": 780,
      "ears_type": "event-driven",
      "trigger": "a pull request is opened or updated",
      "action": "run static application security testing (Semgrep with p/owasp-top-ten and p/default, CodeQL security-extended, and the language's scanner: Bandit, gosec or SpotBugs find-sec-bugs) within {{SAST_MINUTES}} minutes, and block the merge on any high or critical finding not covered by a reviewed suppression",
      "rationale": "A flaw found on the pull request is fixed by its author in minutes; the same flaw found later is a ticket (NIST SSDF PW.7, PW.8; GitHub CodeQL documentation: code scanning as a required check).",
      "hubWhen": {
        "SAST": [
          "pr-blocking"
        ]
      }
    },
    {
      "id": "req-sast-scheduled",
      "type": "requirement",
      "label": "Scheduled findings triaged",
      "x": 260,
      "y": 910,
      "ears_type": "event-driven",
      "trigger": "the scheduled static analysis reports a new high or critical finding",
      "action": "give it an owner from the triage queue within 1 working day, recorded as an assigned issue that names the alert, after which the deadline of its severity runs",
      "rationale": "A scheduled scan without triage produces a list nobody owns; the working-day limit on triage keeps the deadlines meaningful (NIST SSDF RV.1, RV.2).",
      "hubWhen": {
        "SAST": [
          "scheduled"
        ]
      }
    },
    {
      "id": "req-dast-pipeline",
      "type": "requirement",
      "label": "Deployed environments scanned",
      "x": 260,
      "y": 1040,
      "ears_type": "event-driven",
      "trigger": "a build is deployed to an environment of the pipeline (ephemeral, staging or production)",
      "action": "run an OWASP ZAP baseline scan, or the API scan from the OpenAPI document, against it within 30 minutes, fail the deployment's check on an alert raised to FAIL, and keep the report with the build",
      "rationale": "What the running system exposes (missing headers, verbose errors, forgotten routes, reflected input) is visible only to a scan of the running system (OWASP ZAP documentation: baseline and API scans; NIST SSDF PW.8).",
      "hubWhen": {
        "DAST": [
          "pipeline"
        ]
      }
    },
    {
      "id": "req-dast-periodic",
      "type": "requirement",
      "label": "Full scans stay recent",
      "x": 260,
      "y": 1170,
      "ears_type": "state-driven",
      "precondition": "the last ZAP full scan of the production configuration is more than {{DAST_DAYS}} days old",
      "action": "run a new one within 14 days, and put each of its high and critical findings under the deadlines of its severity as code scanning alerts",
      "rationale": "A dynamic scan ages with every release; a bound on its age is what keeps \"we scanned it\" from meaning a scan of a configuration three releases old (NIST SSDF PW.8; OWASP ZAP documentation: full scan). External penetration tests and how often they run are decided in the Secure development process pack.",
      "hubWhen": {
        "DAST": [
          "periodic"
        ]
      }
    },
    {
      "id": "req-findings-sla",
      "type": "requirement",
      "label": "Findings fixed by deadline",
      "x": 260,
      "y": 1300,
      "ears_type": "state-driven",
      "precondition": "an open security finding (static analysis, dynamic scan, penetration test, review or report) is older than its deadline: {{CRITICAL_DAYS}} days for critical, {{HIGH_DAYS}} for high, {{MEDIUM_DAYS}} for medium",
      "action": "fail the main branch's build and the release, naming the finding, until it is fixed",
      "rationale": "A deadline the build enforces is the only one that holds under delivery pressure (NIST SSDF RV.2; the same rule for vulnerable dependencies is decided in Software supply chain).",
      "hubWhen": {
        "FINDINGS": [
          "sla"
        ]
      }
    },
    {
      "id": "req-risk-accepted",
      "type": "requirement",
      "label": "Open findings accepted in writing",
      "x": 260,
      "y": 1430,
      "ears_type": "state-driven",
      "precondition": "a security finding cannot be fixed within its deadline ({{CRITICAL_DAYS}} days for critical, {{HIGH_DAYS}} for high, {{MEDIUM_DAYS}} for medium)",
      "action": "keep it open only with a risk acceptance in the register that names the finding, the owner, a second approver from security, the reason and the compensating controls, and expires after at most {{ACCEPTANCE_DAYS}} days; fail the main branch's build on an overdue finding without a valid acceptance and on an expired acceptance",
      "rationale": "A written acceptance with an expiry date keeps the decision visible and brings it back for a new one; an open finding without one is a decision nobody made (NIST SSDF RV.2.2; Threat Modeling Manifesto: a dialogue about risk, recorded).",
      "hubWhen": {
        "FINDINGS": [
          "risk-accepted"
        ]
      }
    },
    {
      "id": "req-authz-tests",
      "type": "requirement",
      "label": "Negative tests on sensitive paths",
      "x": 260,
      "y": 1560,
      "ears_type": "ubiquitous",
      "action": "cover every authorization-sensitive operation (reading or changing another user's or tenant's data, admin functions, object ids taken from the request) with negative tests that call it as the wrong user, the wrong tenant and anonymously and expect 403 or 404 and 401, kept in the pull-request suite and tagged with the operation they cover",
      "rationale": "Broken access control is OWASP Top 10 A01:2021 and no scanner finds it, because the code is correct for the right user; only a test that is the wrong user does (ASVS 4.0.3 V4.1.1, V4.1.3; the rules themselves are decided in Authorization)."
    },
    {
      "id": "req-memory-safety",
      "type": "requirement",
      "label": "Memory safety rules",
      "x": 260,
      "y": 1690,
      "ears_type": "ubiquitous",
      "action": "check every array index and buffer length before use, use only bounded string and memory functions (snprintf, strlcpy or strncpy_s, memcpy with a checked length), check integer arithmetic on sizes and indices for overflow, run the tests under AddressSanitizer and UndefinedBehaviorSanitizer, and ban gets, strcpy, strcat, sprintf, scanf without field widths, system and alloca by the analyser, with every deviation recorded",
      "rationale": "In unmanaged code the vulnerability class that matters is memory corruption, and the standards name the rules that prevent it (SEI CERT ARR30-C, STR31-C, INT30-C, ENV33-C; MISRA C:2023 Rule 21.6, Rule 21.8, Directive 4.11, Directive 4.14).",
      "hubWhen": {
        "STANDARD": [
          "cert-misra"
        ]
      }
    },
    {
      "id": "sc-param-queries",
      "type": "scenario",
      "label": "Injection goes nowhere",
      "x": 520,
      "y": 0,
      "given": "a request whose search field holds ' OR 1=1 --",
      "when": "it is handled",
      "then": "the database receives the string as a bound parameter, the query returns no extra rows, and the lint finds 0 string-built queries in the code"
    },
    {
      "id": "sc-output-encoding",
      "type": "scenario",
      "label": "Script rendered as text",
      "x": 520,
      "y": 130,
      "given": "a user whose display name is <script>alert(1)</script>",
      "when": "a page that shows the name is rendered",
      "then": "the response holds the name entity-encoded, no script runs, and the lint finds 0 raw-HTML sinks fed from request or database data",
      "hubWhen": {
        "STANDARD": [
          "asvs-l1",
          "asvs-l2"
        ]
      }
    },
    {
      "id": "sc-input-boundary",
      "type": "scenario",
      "label": "Malformed request named",
      "x": 520,
      "y": 260,
      "given": "a POST /orders with quantity \"two\" and an unknown field \"extra\"",
      "when": "it arrives",
      "then": "the answer is 400 and names quantity and extra, no handler ran, and the body holds no stack trace or class name",
      "hubWhen": {
        "INPUT": [
          "boundary-schema"
        ]
      }
    },
    {
      "id": "sc-input-everywhere",
      "type": "scenario",
      "label": "Bad argument refused",
      "x": 520,
      "y": 390,
      "given": "an exported function that takes a length",
      "when": "it is called with -1 and with 2^31",
      "then": "both calls fail with a typed error naming the argument and nothing is read or written",
      "hubWhen": {
        "INPUT": [
          "everywhere"
        ]
      }
    },
    {
      "id": "sc-no-dynamic-code",
      "type": "scenario",
      "label": "eval refused",
      "x": 520,
      "y": 520,
      "given": "a pull request that adds eval(req.query.expr) and a child_process.exec with a template string",
      "when": "the lint runs",
      "then": "it fails naming both lines and the pull request cannot merge"
    },
    {
      "id": "sc-framework-defaults",
      "type": "scenario",
      "label": "Forged request refused",
      "x": 520,
      "y": 650,
      "given": "the element started with its production configuration",
      "when": "a state-changing request arrives without the CSRF token and a response is inspected",
      "then": "the request is refused with 403, and the response carries the middleware's headers and cookie flags",
      "hubWhen": {
        "STANDARD": [
          "asvs-l1",
          "asvs-l2"
        ]
      }
    },
    {
      "id": "sc-sast-pr",
      "type": "scenario",
      "label": "High finding blocks merge",
      "x": 520,
      "y": 780,
      "given": "a pull request that adds a SQL query built from a request parameter",
      "when": "its checks run",
      "then": "the static analysis reports it as high within {{SAST_MINUTES}} minutes and the pull request cannot merge",
      "hubWhen": {
        "SAST": [
