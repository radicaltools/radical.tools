{
  "hub": {
    "id": "concern-operational-readiness",
    "category": "concern",
    "name": "Operational readiness",
    "description": "What must be true before it first takes production traffic, and how the team keeps practising running it: the production readiness review and its checklist, the runbooks the alerts link to, game days or chaos experiments, and who owns it and whom to call.",
    "tags": [
      "operations",
      "readiness review",
      "runbooks",
      "game days",
      "chaos engineering",
      "ownership"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "concern": {
      "id": "operational-readiness",
      "trigger": "LIST NODES WHERE (type = \"container\" OR type = \"webapp\") AND external != true",
      "why": "these elements will run in production, so what must be ready before their first production traffic, and how the team keeps practising running them, has to be decided.",
      "group": "operability"
    },
    "sources": [
      {
        "title": "Google SRE book, chapter 32: The Evolving SRE Engagement Model (Production Readiness Review)",
        "url": "https://sre.google/sre-book/evolving-sre-engagement-model/"
      },
      {
        "title": "Google SRE workbook, chapter 18: SRE Engagement Model",
        "url": "https://sre.google/workbook/engagement-model/"
      },
      {
        "title": "Google SRE book, chapter 1: Introduction (playbooks and MTTR)",
        "url": "https://sre.google/sre-book/introduction/"
      },
      {
        "title": "AWS Well-Architected, Operational Excellence: OPS07-BP02 Ensure a consistent review of operational readiness",
        "url": "https://docs.aws.amazon.com/wellarchitected/latest/operational-excellence-pillar/ops_ready_to_support_const_orr.html"
      },
      {
        "title": "AWS Well-Architected, Operational Excellence: OPS07-BP03 Use runbooks to perform procedures",
        "url": "https://docs.aws.amazon.com/wellarchitected/latest/operational-excellence-pillar/ops_ready_to_support_use_runbooks.html"
      },
      {
        "title": "AWS whitepaper: Operational Readiness Reviews (ORR)",
        "url": "https://docs.aws.amazon.com/wellarchitected/latest/operational-readiness-reviews/wa-operational-readiness-reviews.html"
      },
      {
        "title": "AWS Well-Architected, Reliability: REL12-BP05 Conduct game days regularly",
        "url": "https://docs.aws.amazon.com/wellarchitected/latest/reliability-pillar/rel_testing_resiliency_game_days_resiliency.html"
      },
      {
        "title": "AWS Well-Architected, Reliability: REL12-BP04 Test resiliency using chaos engineering",
        "url": "https://docs.aws.amazon.com/wellarchitected/latest/reliability-pillar/rel_testing_resiliency_failure_injection_resiliency.html"
      },
      {
        "title": "Principles of Chaos Engineering",
        "url": "https://principlesofchaos.org/"
      },
      {
        "title": "AWS Fault Injection Service: stop conditions",
        "url": "https://docs.aws.amazon.com/fis/latest/userguide/stop-conditions.html"
      },
      {
        "title": "Chaos Mesh documentation",
        "url": "https://chaos-mesh.org/docs/"
      },
      {
        "title": "Backstage: Descriptor Format of Catalog Entities",
        "url": "https://backstage.io/docs/features/software-catalog/descriptor-format/"
      },
      {
        "title": "GitHub Docs: About code owners",
        "url": "https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners"
      }
    ],
    "templateParams": [
      {
        "key": "PRR",
        "title": "Readiness review",
        "label": "Who reviews it before it takes production traffic?",
        "hint": "A production readiness review checks against a written checklist that the element can be run: who owns it, what pages and who answers, where the next step is written, and that its targets, load tests, restores and rollback have been decided and tried. Held before the first production traffic and again after a major change, it is the cheapest point to find what is missing. The checklist links to the decisions of the Availability, Observability, Capacity and scaling, Backup and recovery, Deployment and rollback and Incident management packs instead of repeating them.",
        "defaultValue": "self",
        "options": [
          {
            "value": "sre",
            "label": "a readiness review signed off by SRE or the platform team",
            "description": "The owning team fills in the checklist with evidence; an engineer of the SRE or platform team who is not in the owning team checks every item and approves the record, before the first production traffic and after each major change. Pick it when such a team exists and will help run the element or its platform, or when the element is on a revenue path."
          },
          {
            "value": "self",
            "label": "a self-assessment by the owning team",
            "description": "The owning team fills in the same checklist with evidence and its lead signs the record; nobody outside the team checks it. Pick it when there is no SRE or platform team, or when the team builds and runs the element alone."
          },
          {
            "value": "none",
            "label": "no readiness review",
            "description": "The element goes to production without a review, and the decision says so and until when. Pick it only for a prototype or an internal tool that the owning team alone uses; the first user outside the team ends it."
          }
        ]
      },
      {
        "key": "RUNBOOKS",
        "title": "Runbooks",
        "label": "How are the runbooks organised?",
        "hint": "Whoever is paged needs the next step one click from the alert. The alerts, their routing and who is paged are decided in the Observability pack; this decides where the steps are written and how an alert leads to them. Either way, each alerting rule carries a runbook_url annotation.",
        "defaultValue": "alert",
        "options": [
          {
            "value": "alert",
            "label": "a runbook per alert, linked from the alert",
            "description": "Each alerting rule links to a page of its own under docs/runbooks, named after the alert: what it means, the user impact, how to diagnose, mitigate and escalate. Pick it when the element has more than a handful of alerts or several people on the rotation, so that each page stays short and is found from the page."
          },
          {
            "value": "element",
            "label": "one runbook per element, a section per alert",
            "description": "One document per element under docs/runbooks with its dependencies, dashboards and routine operations, and one section per alert, which the alert links to by its anchor. Pick it for an element with a few alerts and one small team, where one document is easier to keep current than many."
          }
        ]
      },
      {
        "key": "PRACTICE",
        "title": "Practice",
        "label": "How does the team keep practising running it?",
        "hint": "Runbooks and a response that are never exercised fail on the night they are needed. The drills that prove a decision are decided where the decision is: instance, zone and region loss in the Availability pack, restores in the Backup and recovery pack, rollback in the Deployment and rollback pack, peak load in the Capacity and scaling pack. This decides how the team practises the rest: the runbooks, the response, and the failure modes the readiness review listed.",
        "defaultValue": "gameday",
        "options": [
          {
            "value": "gameday",
            "label": "game days on a written scenario",
            "description": "Every quarter by default, the people on the rotation spend a few hours responding with the runbooks to a failure a facilitator injects into staging, while observers note what was missing; the findings become tickets. Pick it when the team is starting to practise, or when what most needs exercising is people, runbooks and communication."
          },
          {
            "value": "chaos",
            "label": "automated chaos experiments in staging",
            "description": "Fault experiments, each with a steady-state hypothesis and a stop condition, run on a schedule (weekly by default) against staging with AWS Fault Injection Service, Chaos Mesh or LitmusChaos, and a broken hypothesis becomes a ticket. Pick it when the platform can inject faults safely and the element changes so often that a quarterly exercise falls behind."
          },
          {
            "value": "none",
            "label": "no practice beyond the drills of the other packs",
            "description": "No game days and no chaos experiments; the team relies on the drills the other packs decide and on real incidents, and the decision records it. Pick it for an internal tool with an availability target of 99.0 % or less, or a team of two or three people."
          }
        ]
      },
      {
        "key": "OWNERSHIP",
        "title": "Ownership",
        "label": "Where are the owner and the escalation contact recorded?",
        "hint": "When it breaks at night, or another team needs a change, the first question is who owns it and whom to call. The on-call rotation and its escalation policy are decided in the Observability pack; this decides where the element points to them.",
        "defaultValue": "catalog",
        "options": [
          {
            "value": "catalog",
            "label": "a service catalogue entry (Backstage catalog-info.yaml)",
            "description": "A catalog-info.yaml beside the code describes the element as a Backstage Component with its owning team (spec.owner), its lifecycle (spec.lifecycle) and the paging service to escalate to (the PagerDuty plugin's pagerduty.com/service-id annotation); the catalogue shows every element's owner in one place. Pick it when the organisation runs Backstage (self-hosted or as Roadie), or has more than a handful of teams."
          },
          {
            "value": "readme",
            "label": "an ownership section in the README",
            "description": "The repository's README.md has an Ownership section naming the owning GitHub team, its channel and the on-call schedule to escalate to. Pick it for a few teams without a service catalogue; move to a catalogue when people start asking which repository is whose."
          }
        ]
      },
      {
        "key": "PRR_TEAM",
        "label": "Which GitHub team signs the readiness review (SRE or platform)? Only with a review signed off by SRE or the platform team",
        "defaultValue": "@shop/sre"
      },
      {
        "key": "PRR_MONTHS",
        "label": "After how many months must the readiness review be held again, even without a major change?",
        "defaultValue": "12",
        "type": "number"
      },
      {
        "key": "GAP_DAYS",
        "label": "Within how many days of the review must a gap it found be closed?",
        "defaultValue": "90",
        "type": "number"
      },
      {
        "key": "RUNBOOK_DAYS",
        "label": "Within how many days must each runbook be reviewed again?",
        "defaultValue": "180",
        "type": "number"
      },
      {
        "key": "GAMEDAY_DAYS",
        "label": "How many days may pass between two game days? Only with game days",
        "defaultValue": "92",
        "type": "number"
      },
      {
        "key": "CHAOS_DAYS",
        "label": "Within how many days must each chaos experiment have completed a run? Only with automated chaos experiments",
        "defaultValue": "7",
        "type": "number"
      }
    ]
  },
  "nodes": [
    {
      "id": "need",
      "type": "need",
      "label": "Ready to run before it goes live",
      "x": 0,
      "y": 0,
      "kind": "brief",
      "source": "Hub concern pack: Operational readiness",
      "description": "Before this element takes its first production traffic, the people who will run it must know that it can be run: who owns it, what pages and who answers, where the next step is written, and that its targets, alerts, load tests, restores and rollback have been decided and tried. After launch the team has to keep practising, or the runbooks and the response decay until the night they are needed. The snippets assume one repository per element (order-api, labelled Order API in the architecture model) with the review checklist at docs/operations/prr-checklist.md and the signed reviews as docs/operations/prr/YYYY-MM-DD.md, the runbooks under docs/runbooks, the Prometheus alerting rules under monitoring/rules, the game-day records as docs/gamedays/YYYY-MM-DD.md, catalog-info.yaml or README.md at the root, the architecture model as a Radical Markdown folder under architecture/, and js-yaml among the development dependencies."
    },
    {
      "id": "req-prr-gate",
      "type": "requirement",
      "label": "No production deployment without a review",
      "x": 260,
      "y": 0,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a production deployment of the element starts without an approved readiness review on record, or with one older than {{PRR_MONTHS}} months",
      "action": "stop the deployment before it changes anything in production, and name the missing or stale review",
      "rationale": "A review held after launch reviews nothing; tying it to the deployment makes the first production traffic wait for it, and the age limit catches the drift that no single change announced (Google SRE book, chapter 32; AWS Well-Architected OPS07-BP02).",
      "hubWhen": {
        "PRR": [
          "sre",
          "self"
        ]
      }
    },
    {
      "id": "req-prr-gaps",
      "type": "requirement",
      "label": "Gaps written down with a date",
      "x": 260,
      "y": 130,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a checklist item is not met when the review is signed",
      "action": "record it in the review as a gap with a ticket and a due date at most {{GAP_DAYS}} days after the review, so that a review may approve with known gaps but never with unknown ones",
      "rationale": "Waiting for a perfect review delays launch until the review is skipped; an approval with written, dated gaps keeps both the launch and the follow-up honest (AWS whitepaper, Operational Readiness Reviews).",
      "hubWhen": {
        "PRR": [
          "sre",
          "self"
        ]
      }
    },
    {
      "id": "req-prr-signoff",
      "type": "requirement",
      "label": "Review signed outside the team",
      "x": 260,
      "y": 260,
      "ears_type": "ubiquitous",
      "action": "have every readiness review approved by a member of {{PRR_TEAM}}, who checks each checklist item against its evidence, through a required code-owner review of the pull request that adds the record",
      "rationale": "The team that built the element is the worst judge of what it forgot; the engaging SRE team checks it against its checklist (Google SRE book, chapter 32), and the required code-owner approval is the signature (GitHub Docs, About code owners).",
      "hubWhen": {
        "PRR": [
          "sre"
        ]
      }
    },
    {
      "id": "req-prr-checklist",
      "type": "requirement",
      "label": "One checklist that links, not copies",
      "x": 260,
      "y": 390,
      "ears_type": "ubiquitous",
      "action": "be reviewed against one checklist kept in the repository, with a section for each of ownership, availability objective, alerts and on-call, runbooks, capacity and load test, backup and restore, rollout and rollback, incident response, dependencies and failure modes, and practice, each section linking to the decision or the latest record it rests on instead of repeating its numbers",
      "rationale": "A written checklist makes reviews comparable across elements and reviewers; links instead of copies keep it right when a neighbouring decision changes (AWS whitepaper, Operational Readiness Reviews; Google SRE workbook, chapter 18).",
      "hubWhen": {
        "PRR": [
          "sre",
          "self"
        ]
      }
    },
    {
      "id": "req-prr-major",
      "type": "requirement",
      "label": "Reviewed again after a major change",
      "x": 260,
      "y": 520,
      "ears_type": "event-driven",
      "trigger": "a major change reaches the element: a new dependency or data store, a new region, a higher availability target or a new owning team",
      "action": "review it again against the checklist before the change takes production traffic, with every dependency the architecture model shows listed in the new review",
      "rationale": "Most of what a first review finds comes back with a new dependency or a new owner, and the review is cheapest before the change is live (Google SRE book, chapter 32).",
      "hubWhen": {
        "PRR": [
          "sre",
          "self"
        ]
      }
    },
    {
      "id": "req-prr-none",
      "type": "requirement",
      "label": "Unreviewed only while nobody else depends on it",
      "x": 260,
      "y": 650,
      "ears_type": "state-driven",
      "precondition": "the element runs in production without a readiness review",
      "action": "serve no user outside the owning team, and have the first such user, or an availability target above 99.0 %, supersede the decision with a review",
      "rationale": "Skipping the review is a bet that nobody depends on the element yet; writing down when the bet ends keeps it from becoming permanent.",
      "unchecked": "The owning team's lead confirms at each quarterly planning that nobody outside the team uses the element; who calls it in production is a fact no repository check sees reliably.",
      "hubWhen": {
        "PRR": [
          "none"
        ]
      }
    },
    {
      "id": "req-runbook-alert",
      "type": "requirement",
      "label": "Each alert links its own runbook",
      "x": 260,
      "y": 780,
      "ears_type": "ubiquitous",
      "action": "give every alerting rule a runbook_url annotation that resolves to a runbook page of its own under docs/runbooks, shared with no other alert, which says what the alert means, the user impact, and how to diagnose, mitigate and escalate",
      "rationale": "The engineer who is paged starts from the alert; a playbook written ahead of time cuts the time to repair roughly threefold compared with winging it (Google SRE book, chapter 1), and a short page per alert is found from the page and kept current (AWS Well-Architected OPS07-BP03).",
      "hubWhen": {
        "RUNBOOKS": [
          "alert"
        ]
      }
    },
    {
      "id": "req-runbook-element",
      "type": "requirement",
      "label": "Each alert links its section of the runbook",
      "x": 260,
      "y": 910,
      "ears_type": "ubiquitous",
      "action": "keep one runbook for the element under docs/runbooks, with its dependencies, dashboards and routine operations, and give every alerting rule a runbook_url annotation that resolves to the section of that runbook written for the alert, no two alerts sharing a section",
      "rationale": "The engineer who is paged starts from the alert; a playbook written ahead of time cuts the time to repair roughly threefold compared with winging it (Google SRE book, chapter 1), and an anchor to the alert's own section saves the scrolling (AWS Well-Architected OPS07-BP03).",
      "hubWhen": {
        "RUNBOOKS": [
          "element"
        ]
      }
    },
    {
      "id": "req-runbook-review",
      "type": "requirement",
      "label": "Runbooks reviewed on time",
      "x": 260,
      "y": 1040,
      "ears_type": "ubiquitous",
      "action": "have every runbook reviewed by someone on the rotation at least every {{RUNBOOK_DAYS}} days and after each incident in which it was used, with the date of the last review in the runbook itself",
      "rationale": "Runbooks decay as the element changes; a review date the check reads makes the decay visible before the night it matters (AWS Well-Architected OPS07-BP03)."
    },
    {
      "id": "req-gameday",
      "type": "requirement",
      "label": "Game days held and recorded",
      "x": 260,
      "y": 1170,
      "ears_type": "ubiquitous",
      "action": "hold a game day at least every {{GAMEDAY_DAYS}} days, in which at least two people on the rotation respond with the runbooks to a failure injected on a written scenario with a hypothesis, and record the scenario, the hypothesis, the participants, the outcome and a ticket for each finding under docs/gamedays",
      "rationale": "A practised response is what makes a runbook trustworthy; a written scenario and hypothesis turn the afternoon into an experiment rather than a demonstration (AWS Well-Architected REL12-BP05; Principles of Chaos Engineering).",
      "hubWhen": {
        "PRACTICE": [
          "gameday"
        ]
      }
    },
    {
      "id": "req-chaos",
      "type": "requirement",
      "label": "Chaos experiments run continuously",
      "x": 260,
      "y": 1300,
      "ears_type": "ubiquitous",
      "action": "complete a run of each of its chaos experiments against staging at least every {{CHAOS_DAYS}} days, each stating a steady-state hypothesis on the service level indicator and injecting one failure mode the readiness review or an incident named",
      "rationale": "Systems drift; experiments that run continuously against a hypothesis about the steady state catch what a change broke before an incident does (Principles of Chaos Engineering; AWS Well-Architected REL12-BP04).",
      "hubWhen": {
        "PRACTICE": [
          "chaos"
        ]
      }
    },
    {
      "id": "req-chaos-abort",
      "type": "requirement",
      "label": "Experiments stop when the steady state breaks",
      "x": 260,
      "y": 1430,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "the steady state breaks while an experiment runs",
      "action": "stop the experiment at once through a stop condition on the alarm that measures the steady state, so that no experiment of the element is defined without one",
      "rationale": "Minimising the blast radius is a principle of chaos engineering, and a stop condition bound to the steady-state alarm is its mechanism (Principles of Chaos Engineering; AWS Fault Injection Service, stop conditions).",
      "hubWhen": {
        "PRACTICE": [
          "chaos"
        ]
      }
    },
    {
      "id": "req-owner-catalog",
      "type": "requirement",
      "label": "Owner and escalation in the catalogue",
      "x": 260,
      "y": 1560,
      "ears_type": "ubiquitous",
      "action": "be described by a catalog-info.yaml at its repository root as a Backstage Component whose spec.owner names a group in the catalogue with at least one member, whose spec.lifecycle is experimental, production or deprecated, and whose pagerduty.com/service-id annotation names the paging service to escalate to",
      "rationale": "One file beside the code, read by the catalogue, answers who owns it and whom to call for every element in one place; owner and lifecycle are required fields of a Component (Backstage, Descriptor Format).",
      "hubWhen": {
        "OWNERSHIP": [
          "catalog"
        ]
      }
    },
    {
      "id": "req-owner-readme",
      "type": "requirement",
      "label": "Owner and escalation in the README",
      "x": 260,
      "y": 1690,
      "ears_type": "ubiquitous",
      "action": "state in README.md, under an Ownership heading, the owning GitHub team, its channel and the on-call schedule to escalate to, the team having at least one member",
      "rationale": "Without a catalogue the README is the first place anyone looks; a fixed heading and fixed fields let a check keep it filled in and the team behind it real.",
      "hubWhen": {
        "OWNERSHIP": [
          "readme"
        ]
      }
    },
    {
      "id": "sc-prr-gate",
      "type": "scenario",
      "label": "Stale review stops the deployment",
      "x": 520,
      "y": 0,
      "given": "an element whose newest review record is older than {{PRR_MONTHS}} months",
      "when": "a production deployment starts",
      "then": "the deployment stops before any change and names the stale review; once an approved record is merged, it runs",
      "hubWhen": {
        "PRR": [
          "sre",
          "self"
        ]
      }
    },
    {
      "id": "sc-prr-gaps",
      "type": "scenario",
      "label": "Missing load test becomes a dated gap",
      "x": 520,
      "y": 130,
      "given": "a review held before the first load test has run",
      "when": "the record is signed",
      "then": "it lists the load test as a gap with a ticket and a due date within {{GAP_DAYS}} days, and a gap without either fails the review check",
      "hubWhen": {
        "PRR": [
          "sre",
          "self"
        ]
      }
    },
    {
      "id": "sc-prr-signoff",
      "type": "scenario",
      "label": "Owning team cannot sign alone",
      "x": 520,
      "y": 260,
      "given": "a pull request adding a review record, approved only by the owning team",
      "when": "it is to be merged",
      "then": "the merge is blocked until a member of {{PRR_TEAM}} approves it",
      "hubWhen": {
        "PRR": [
          "sre"
        ]
      }
    },
    {
      "id": "sc-prr-checklist",
      "type": "scenario",
      "label": "Checklist keeps its sections",
      "x": 520,
      "y": 390,
      "given": "the checklist in the repository",
      "when": "a section is removed, or a section holds no link",
      "then": "the checklist check fails naming the section",
      "hubWhen": {
        "PRR": [
          "sre",
          "self"
        ]
      }
    },
    {
      "id": "sc-prr-major",
      "type": "scenario",
      "label": "New dependency asks for a review",
      "x": 520,
      "y": 520,
      "given": "the architecture model and the newest review, which lists the element's dependencies",
      "when": "a pull request adds a call from the element to a new system in the model",
      "then": "the dependency check fails until a new review lists the system",
      "hubWhen": {
        "PRR": [
          "sre",
          "self"
        ]
      }
    },
    {
      "id": "sc-prr-none",
      "type": "scenario",
      "label": "First outside user ends the exemption",
      "x": 520,
      "y": 650,
      "given": "an element running without a readiness review",
      "when": "a team outside the owning team asks to use it",
      "then": "the decision is superseded and the element is reviewed before that team's traffic arrives",
      "hubWhen": {
        "PRR": [
          "none"
        ]
      }
    },
    {
      "id": "sc-runbook-alert",
      "type": "scenario",
      "label": "Alert without a runbook refused",
      "x": 520,
      "y": 780,
      "given": "the alerting rules",
      "when": "an alert is added without a runbook_url, with one that does not resolve, or with one another alert uses",
      "then": "the runbook check fails naming the alert",
      "hubWhen": {
        "RUNBOOKS": [
          "alert"
        ]
      }
    },
    {
      "id": "sc-runbook-element",
      "type": "scenario",
      "label": "Broken anchor refused",
      "x": 520,
      "y": 910,
      "given": "the alerting rules and the element's runbook",
      "when": "an alert links to a section heading that does not exist, or to the section of another alert",
      "then": "the runbook check fails naming the alert",
      "hubWhen": {
        "RUNBOOKS": [
          "element"
        ]
      }
    },
    {
      "id": "sc-runbook-review",
      "type": "scenario",
      "label": "Stale runbook flagged",
      "x": 520,
      "y": 1040,
      "given": "a runbook last reviewed {{RUNBOOK_DAYS}} days and one day ago",
      "when": "the daily runbook check runs",
      "then": "it fails naming the runbook"
    },
    {
      "id": "sc-gameday",
      "type": "scenario",
      "label": "Overdue game day flagged",
      "x": 520,
