        ]
      }
    },
    {
      "id": "ff-functions-aws",
      "type": "fitness-fn",
      "label": "Lambda functions bounded",
      "x": 1040,
      "y": 2340,
      "category": "structural",
      "threshold": "100% of functions have a concurrency limit (reserved concurrency, or a maximum concurrency on every SQS trigger) and a dead-letter queue or on-failure destination",
      "description": "A check after each deploy lists the account's functions and fails on one with neither a reserved concurrency nor a maximum concurrency on each of its SQS triggers (the event source mapping's ScalingConfig, which caps the function's pollers without carving from the account's pool), or without either a dead-letter queue or an on-failure destination. Provisioned concurrency keeps instances warm but sets no ceiling, so it does not count as a limit.\n\nTool: AWS CLI (lambda) with jq\n\n```bash\n#!/usr/bin/env bash\n# every function: a concurrency limit (reserved, or a maximum on every SQS trigger)\n# and a dead-letter queue or on-failure destination\nset -euo pipefail\nfail=0\nfor fn in $(aws lambda list-functions --query 'Functions[].FunctionName' --output text); do\n  reserved=$(aws lambda get-function-concurrency --function-name \"$fn\" --query ReservedConcurrentExecutions --output text)\n  read -r sqs unbounded < <(aws lambda list-event-source-mappings --function-name \"$fn\" --output json | jq -r '\n    [.EventSourceMappings[] | select(.EventSourceArn | startswith(\"arn:aws:sqs:\"))]\n    | \"\\(length) \\(map(select(.ScalingConfig.MaximumConcurrency == null)) | length)\"')\n  dlq=$(aws lambda get-function-configuration --function-name \"$fn\" --query 'DeadLetterConfig.TargetArn' --output text)\n  dest=$(aws lambda get-function-event-invoke-config --function-name \"$fn\" \\\n    --query 'DestinationConfig.OnFailure.Destination' --output text 2>/dev/null || echo None)\n  if [ \"$reserved\" = None ] && { [ \"$sqs\" -eq 0 ] || [ \"$unbounded\" -gt 0 ]; }; then\n    echo \"$fn: no concurrency limit (reserved, or a maximum concurrency on every SQS trigger)\"; fail=1\n  fi\n  [ \"$dlq\" != None ] || [ \"$dest\" != None ] || { echo \"$fn: no dead-letter queue or on-failure destination\"; fail=1; }\ndone\nexit $fail\n```",
      "hubWhen": {
        "HOSTING": [
          "serverless"
        ],
        "CLOUD": [
          "aws"
        ]
      }
    },
    {
      "id": "ff-functions-azure",
      "type": "fitness-fn",
      "label": "Azure Functions functions bounded",
      "x": 1040,
      "y": 2470,
      "category": "structural",
      "threshold": "100% of function apps have a scale-out limit (functionAppScaleLimit above 0)",
      "description": "A check after each deploy lists the subscription's function apps and fails on one whose site configuration has no scale-out limit. Failed Service Bus and Event Hubs events dead-letter on the queue itself, which the Messaging pack decides; Flex Consumption apps carry the limit in az functionapp scale config show instead.\n\nTool: Azure CLI (functionapp)\n\n```bash\n#!/usr/bin/env bash\n# every function app: a scale-out limit\nset -euo pipefail\nfail=0\nwhile IFS=$'\\t' read -r name group; do\n  limit=$(az functionapp config show --name \"$name\" --resource-group \"$group\" --query functionAppScaleLimit --output tsv)\n  [ \"${limit:-0}\" -gt 0 ] || { echo \"$name: no scale-out limit (functionAppScaleLimit)\"; fail=1; }\ndone < <(az functionapp list --query '[].[name, resourceGroup]' --output tsv)\nexit $fail\n```",
      "hubWhen": {
        "HOSTING": [
          "serverless"
        ],
        "CLOUD": [
          "azure"
        ]
      }
    },
    {
      "id": "ff-functions-gcp",
      "type": "fitness-fn",
      "label": "Cloud Run functions functions bounded",
      "x": 1040,
      "y": 2600,
      "category": "structural",
      "threshold": "100% of functions have a maximum instance count, and every event-triggered one an explicit retry policy",
      "description": "A check after each deploy lists the project's functions (2nd gen) and fails on one without a maximum instance count or, for an event trigger, without an explicit retry policy; failed events dead-letter on the Pub/Sub subscription, which the Messaging pack decides.\n\nTool: gcloud (functions)\n\n```bash\n#!/usr/bin/env bash\n# every function: a maximum instance count; event-triggered ones an explicit retry policy\nset -euo pipefail\nfail=0\nwhile IFS=, read -r name max trigger retry; do\n  [ -n \"$max\" ] && [ \"$max\" -gt 0 ] || { echo \"$name: no maximum instance count\"; fail=1; }\n  [ -z \"$trigger\" ] || [ -n \"$retry\" ] || { echo \"$name: event trigger without an explicit retry policy\"; fail=1; }\ndone < <(gcloud functions list --v2 --format='csv[no-heading](name, serviceConfig.maxInstanceCount, eventTrigger.trigger, eventTrigger.retryPolicy)')\nexit $fail\n```",
      "hubWhen": {
        "HOSTING": [
          "serverless"
        ],
        "CLOUD": [
          "gcp"
        ]
      }
    },
    {
      "id": "ff-image-age",
      "type": "fitness-fn",
      "label": "No machine on an old image",
      "x": 1040,
      "y": 2730,
      "category": "operational",
      "threshold": "0 machines whose image was built more than 30 days ago; the alert opens a ticket after 1 hour",
      "description": "Packer bakes the build time into /etc/image-release; at boot, cloud-init writes it as a node_exporter textfile metric, and a Prometheus rule fires for any machine whose image is older than 30 days, in every cloud and on premises alike.\n\nTool: Prometheus with node_exporter (textfile collector)\n\n```yaml\n# at boot (cloud-init), from the file Packer baked in: /etc/image-release holds BUILD_DATE=<epoch seconds>\n#   . /etc/image-release && echo \"image_build_timestamp_seconds $BUILD_DATE\" > /var/lib/node_exporter/textfile/image.prom\ngroups:\n  - name: machine-images\n    rules:\n      - alert: MachineImageOlderThan30Days\n        expr: time() - image_build_timestamp_seconds > 30 * 86400\n        for: 1h\n        labels: { severity: ticket }\n        annotations:\n          summary: \"{{ $labels.instance }} runs an image built {{ $value | humanizeDuration }} ago; replace it from the current image\"\n```",
      "hubWhen": {
        "HOSTING": [
          "vms"
        ]
      }
    },
    {
      "id": "ff-cdn-origin",
      "type": "fitness-fn",
      "label": "Only through the CDN",
      "x": 1040,
      "y": 2860,
      "category": "operational",
      "threshold": "The site answers over TLS with an HSTS header; its page with Cache-Control no-cache (or max-age=0 with must-revalidate) and a content-hashed asset with max-age=31536000; the origin answers a direct request for the page with 403, 404 or 409",
      "description": "A check after each deploy fetches the page and one content-hashed asset of the build through the CDN and reads their headers against adr-cdn's caching rule (hashed assets cached for a year, the page revalidated), then requests the page directly from the origin bucket's URL and expects it refused: 403 or 404 from S3 and Cloud Storage, 409 (PublicAccessNotPermitted) from Azure Blob Storage with public access off.\n\nTool: curl (post-deploy check)\n\n```bash\n#!/usr/bin/env bash\n# SITE_URL: through the CDN; ORIGIN_URL: the bucket's own endpoint;\n# ASSET_PATH: one content-hashed file of this build (by default the first script under dist/assets)\nset -euo pipefail\nasset=${ASSET_PATH:-$(cd dist && ls assets/*.js | head -n 1)}\npage=$(curl -fsSI \"$SITE_URL/\" | tr -d '\\r')\ngrep -qi '^strict-transport-security:' <<<\"$page\" || { echo \"no HSTS header on $SITE_URL\"; exit 1; }\npage_cc=$(grep -i '^cache-control:' <<<\"$page\" || true)\n[[ \"$page_cc\" =~ no-cache ]] || { [[ \"$page_cc\" =~ max-age=0([^0-9]|$) ]] && [[ \"$page_cc\" =~ must-revalidate ]]; } \\\n  || { echo \"the page is not revalidated on each request ($page_cc)\"; exit 1; }\nasset_cc=$(curl -fsSI \"$SITE_URL/$asset\" | tr -d '\\r' | grep -i '^cache-control:' || true)\n[[ \"$asset_cc\" =~ max-age=31536000 ]] || { echo \"$asset is not cached for a year ($asset_cc)\"; exit 1; }\ncode=$(curl -s -o /dev/null -w '%{http_code}' \"$ORIGIN_URL/index.html\")\n[ \"$code\" = 403 ] || [ \"$code\" = 404 ] || [ \"$code\" = 409 ] \\\n  || { echo \"origin $ORIGIN_URL answers $code to a direct request (must refuse)\"; exit 1; }\n```",
      "hubWhen": {
        "HOSTING": [
          "cdn"
        ]
      }
    },
    {
      "id": "ff-ephemeral-k8s",
      "type": "fitness-fn",
      "label": "No forgotten environments (namespaces)",
      "x": 1040,
      "y": 2990,
      "category": "operational",
      "threshold": "0 ephemeral namespaces alive after their pull request closed or idle for more than {{EPHEMERAL_HOURS}} hours",
      "description": "A scheduled job lists the namespaces labelled as ephemeral, deletes those whose pull request is closed or whose last deploy (an annotation the deploy writes) is past the limit, and reports what it removed. Runs on Linux (GNU date).\n\nTool: kubectl with the GitHub CLI (scheduled job)\n\n```bash\n#!/usr/bin/env bash\nset -euo pipefail\nlimit=$(( $(date +%s) - {{EPHEMERAL_HOURS}} * 3600 ))\nkubectl get ns -l env-type=ephemeral -o json \\\n  | jq -r '.items[] | [.metadata.name, .metadata.labels.pr, (.metadata.annotations[\"last-deploy\"] // \"\")] | @tsv' |\nwhile IFS=$'\\t' read -r ns pr last; do\n  state=$(gh pr view \"$pr\" --repo \"$GITHUB_REPOSITORY\" --json state -q .state)\n  if [ \"$state\" != OPEN ] || [ -z \"$last\" ] || [ \"$(date -d \"$last\" +%s)\" -lt \"$limit\" ]; then\n    echo \"deleting $ns (PR $pr $state, last deploy ${last:-unknown})\"; kubectl delete ns \"$ns\" --wait=false\n  fi\ndone\n```",
      "hubWhen": {
        "ENVIRONMENTS": [
          "ephemeral"
        ],
        "HOSTING": [
          "kubernetes"
        ]
      }
    },
    {
      "id": "ff-ephemeral-terraform",
      "type": "fitness-fn",
      "label": "No forgotten environments (workspaces)",
      "x": 1040,
      "y": 3120,
      "category": "operational",
      "threshold": "0 ephemeral environments alive after their pull request closed or idle for more than {{EPHEMERAL_HOURS}} hours",
      "description": "A scheduled job lists the Terraform workspaces named pr-<number>, destroys those whose pull request is closed or last updated past the limit, and deletes the workspace. Runs on Linux (GNU date).\n\nTool: Terraform with the GitHub CLI (scheduled job)\n\n```bash\n#!/usr/bin/env bash\n# in envs/ephemeral; workspaces are named pr-<number>\nset -euo pipefail\nlimit=$(( $(date +%s) - {{EPHEMERAL_HOURS}} * 3600 ))\nfor ws in $(terraform workspace list | tr -d '* ' | grep -E '^pr-[0-9]+$'); do\n  pr=${ws#pr-}\n  read -r state updated < <(gh pr view \"$pr\" --repo \"$GITHUB_REPOSITORY\" --json state,updatedAt -q '\"\\(.state) \\(.updatedAt)\"')\n  if [ \"$state\" != OPEN ] || [ \"$(date -d \"$updated\" +%s)\" -lt \"$limit\" ]; then\n    echo \"destroying $ws (PR $pr $state, last activity $updated)\"\n    terraform workspace select \"$ws\"\n    terraform destroy -auto-approve -input=false -var \"pr=$pr\"\n    terraform workspace select default && terraform workspace delete \"$ws\"\n  fi\ndone\n```",
      "hubWhen": {
        "ENVIRONMENTS": [
          "ephemeral"
        ],
        "HOSTING": [
          "paas",
          "serverless",
          "vms",
          "cdn"
        ],
        "IAC": [
          "terraform"
        ]
      }
    },
    {
      "id": "ff-ephemeral-terraform-fallback",
      "type": "fitness-fn",
      "label": "No forgotten environments (workspaces)",
      "x": 1040,
      "y": 3250,
      "category": "operational",
      "threshold": "0 ephemeral environments alive after their pull request closed or idle for more than {{EPHEMERAL_HOURS}} hours",
      "description": "A scheduled job lists the Terraform workspaces named pr-<number>, destroys those whose pull request is closed or last updated past the limit, and deletes the workspace. Runs on Linux (GNU date).\n\nTool: Terraform with the GitHub CLI (scheduled job)\n\n```bash\n#!/usr/bin/env bash\n# in envs/ephemeral; workspaces are named pr-<number>\nset -euo pipefail\nlimit=$(( $(date +%s) - {{EPHEMERAL_HOURS}} * 3600 ))\nfor ws in $(terraform workspace list | tr -d '* ' | grep -E '^pr-[0-9]+$'); do\n  pr=${ws#pr-}\n  read -r state updated < <(gh pr view \"$pr\" --repo \"$GITHUB_REPOSITORY\" --json state,updatedAt -q '\"\\(.state) \\(.updatedAt)\"')\n  if [ \"$state\" != OPEN ] || [ \"$(date -d \"$updated\" +%s)\" -lt \"$limit\" ]; then\n    echo \"destroying $ws (PR $pr $state, last activity $updated)\"\n    terraform workspace select \"$ws\"\n    terraform destroy -auto-approve -input=false -var \"pr=$pr\"\n    terraform workspace select default && terraform workspace delete \"$ws\"\n  fi\ndone\n```",
