          "serverless",
          "vms",
          "cdn"
        ],
        "IAC": [
          "native"
        ],
        "CLOUD": [
          "aws",
          "azure"
        ]
      }
    },
    {
      "id": "ff-parity",
      "type": "fitness-fn",
      "label": "Environments share their code",
      "x": 1040,
      "y": 3640,
      "category": "structural",
      "threshold": "The test environment's and production's folders under envs/ differ only in their variable files",
      "description": "A check in every pull request compares the test environment's root with production's, ignoring the variable files of the tool in use (tfvars, Pulumi stack configuration, Bicep or CloudFormation parameter files); any other difference, a module version or an extra resource, fails it.\n\nTool: diff (CI job)\n\n```bash\n#!/usr/bin/env bash\n# TEST_ENV: staging, or test when there is no staging\nset -euo pipefail\ndiff -rq \"envs/${TEST_ENV:-staging}\" envs/production \\\n  --exclude='*.tfvars' --exclude='*.auto.tfvars' --exclude='Pulumi.*.yaml' --exclude='*.bicepparam' --exclude='*.params.json' \\\n  && echo \"environments share the same code\" \\\n  || { echo \"the environments differ beyond their variable files (above)\"; exit 1; }\n```"
    },
    {
      "id": "ff-promote",
      "type": "fitness-fn",
      "label": "Only the tested digest reaches production",
      "x": 1040,
      "y": 3770,
      "category": "process",
      "threshold": "The digest the production deploy job deploys equals the digest recorded by the latest staging deployment; any other digest fails the job",
      "description": "The staging deploy job records the image digest in the payload of the GitHub deployment it creates; the production deploy job reads the latest staging deployment's payload and refuses to continue with any other digest, so production never gets a rebuild or a newer image than staging tested.\n\nTool: GitHub CLI (deployments API) in the deploy pipeline\n\n```bash\n#!/usr/bin/env bash\n# production deploy step; IMAGE_DIGEST is what this job is about to deploy\nset -euo pipefail\ntested=$(gh api \"repos/$GITHUB_REPOSITORY/deployments?environment=staging&per_page=1\" -q '.[0].payload.digest')\n[ \"$tested\" = \"$IMAGE_DIGEST\" ] || { echo \"production would get $IMAGE_DIGEST; staging tested $tested\"; exit 1; }\n# the staging deploy job created its deployment with:\n#   gh api \"repos/$GITHUB_REPOSITORY/deployments\" -f ref=\"$GITHUB_SHA\" -f environment=staging -f \"payload[digest]=$IMAGE_DIGEST\"\n```",
      "hubWhen": {
        "ENVIRONMENTS": [
          "staged",
          "ephemeral"
        ]
      }
    }
