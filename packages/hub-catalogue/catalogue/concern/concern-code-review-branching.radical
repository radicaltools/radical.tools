{
  "hub": {
    "id": "concern-code-review-branching",
    "category": "concern",
    "name": "Code review and branching",
    "description": "How a change travels from a developer's machine to the main branch: the branching model, who reviews it and how many must approve, who owns which code, how big a change may be and how old a branch, and what a commit message says.",
    "tags": [
      "maintainability",
      "code review",
      "branching",
      "trunk-based development",
      "codeowners",
      "conventional commits",
      "pull requests"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "concern": {
      "id": "code-review-branching",
      "trigger": "LIST NODES WHERE (type = \"container\" OR type = \"webapp\") AND external != true",
      "why": "code lives in these elements and several people change it, so how a change is branched, reviewed and merged has to be decided; one decision usually covers a whole repository and is bound to every element built from it.",
      "group": "sdlc"
    },
    "sources": [
      {
        "title": "Google Engineering Practices: Code Review Developer Guide",
        "url": "https://google.github.io/eng-practices/review/"
      },
      {
        "title": "Paul Hammant: Trunk Based Development",
        "url": "https://trunkbaseddevelopment.com/"
      },
      {
        "title": "Martin Fowler: Patterns for Managing Source Code Branches",
        "url": "https://martinfowler.com/articles/branching-patterns.html"
      },
      {
        "title": "DORA: DevOps Research and Assessment (Accelerate, State of DevOps)",
        "url": "https://dora.dev/"
      },
      {
        "title": "Vincent Driessen: A successful Git branching model (with the 2020 note of reflection)",
        "url": "https://nvie.com/posts/a-successful-git-branching-model/"
      },
      {
        "title": "Conventional Commits 1.0.0",
        "url": "https://www.conventionalcommits.org/en/v1.0.0/"
      },
      {
        "title": "SmartBear: Best Practices for Peer Code Review (the Cisco review study)",
        "url": "https://smartbear.com/learn/code-review/best-practices-for-peer-code-review/"
      },
      {
        "title": "GitHub Docs: About code owners",
        "url": "https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners"
      },
      {
        "title": "GitHub Docs: About rulesets",
        "url": "https://docs.github.com/en/repositories/configuring-branches-and-merges-in-your-repository/managing-rulesets/about-rulesets"
      }
    ],
    "templateParams": [
      {
        "key": "BRANCHING",
        "title": "Branching",
        "label": "How do changes reach the main branch?",
        "hint": "This decides how long a change lives apart from everyone else's, how unfinished work is hidden, and whether there are branches for versions at all.",
        "defaultValue": "trunk",
        "options": [
          {
            "value": "trunk",
            "label": "trunk-based development",
            "description": "Everyone works on main: a change is a branch of at most a day or two merged through a short pull request; unfinished work ships behind a feature flag. Pick it for a service you deploy continuously (see the Deployment pack) with a test suite the team trusts and a team willing to split work into small steps."
          },
          {
            "value": "feature-pr",
            "label": "feature branches with a pull request each",
            "description": "Each change is a branch with a pull request, merged to main when reviewed and green; main is always releasable and nothing lives on it that is not reviewed. Pick it for most teams: it needs no feature flags for unfinished work, as long as branches stay under a week (set the branch age to 7) and are rebased daily."
          },
          {
            "value": "gitflow",
            "label": "GitFlow with release and hotfix branches",
            "description": "A develop branch collects the next version, a release/x.y branch stabilises it, main holds only tagged releases merged with merge commits, and hotfix branches patch a version in support. Pick it only for a product shipped in numbered versions that customers install and keep running (desktop, on-premises, embedded, SDKs); for a deployed service its own author advises against it (Driessen, 2020 note)."
          }
        ]
      },
      {
        "key": "REVIEW",
        "title": "Review",
        "label": "Who must approve a change?",
        "hint": "A review catches the mistakes tests do not describe and spreads knowledge of the code; the rule says how many eyes a change gets and whether a pair counts.",
        "defaultValue": "one-reviewer",
        "options": [
          {
            "value": "one-reviewer",
            "label": "one approving review from someone other than the author",
            "description": "Every pull request needs one approval from a person who did not write it; a new commit dismisses stale approvals. Pick it as the baseline for a team of three or more; it is what Google's practice assumes."
          },
          {
            "value": "two-critical",
            "label": "two reviews on critical paths, one elsewhere",
            "description": "Changes under the critical directories (payments/, auth/ and migrations/ by default) need two approvals; everything else needs one. Pick it when some directories move money, decide access or change the schema, so a mistake there costs more than a second review."
          },
          {
            "value": "pairing",
            "label": "pair or mob programming counts as the review",
            "description": "A change written by a pair or mob carries Co-authored-by trailers and the partner's approval merges it; a change written alone still needs one review from someone who did not write it. Pick it for a team that pairs most of the day and wants to merge within the hour instead of waiting for an asynchronous review."
          }
        ]
      },
      {
        "key": "OWNERSHIP",
        "title": "Ownership",
        "label": "Who owns which code?",
        "hint": "Ownership decides who is asked to review and who may say no; without it, reviews go to whoever is free and nobody is accountable for a directory. Other packs refer to this answer where they need an owner.",
        "defaultValue": "codeowners",
        "options": [
          {
            "value": "codeowners",
            "label": "CODEOWNERS per directory",
            "description": "A CODEOWNERS file maps every top-level directory to a team; a change under a directory needs that team's approval and GitHub asks it automatically. Pick it with two or more teams in one repository, or anywhere a directory holds code with a single accountable team."
          },
          {
            "value": "collective",
            "label": "collective ownership with rotating reviewers",
            "description": "Anyone may change and review anything; a reviewer is assigned round-robin from the team so that reviews spread and knowledge does too. Pick it for one team of up to about eight on one codebase, where naming owners per directory would create bottlenecks."
          }
        ]
      },
      {
        "key": "SIZE",
        "title": "Size",
        "label": "Is there a limit on the size of a change?",
        "hint": "Reviewers find most defects in the first 200 to 400 lines and little after that; a limit forces the split that reviewers would otherwise have to ask for.",
        "defaultValue": "limit",
        "options": [
          {
            "value": "limit",
            "label": "a hard limit per pull request",
            "description": "A pull request may change at most a set number of lines (400 by default; generated files and lock files excluded) and is split otherwise; a lead may label an exception. Pick it whenever reviews are slow or shallow today: a limit is the one lever that changes both."
          },
          {
            "value": "none",
            "label": "no limit, with the size reported",
            "description": "The changed-line count is posted on every pull request but nothing blocks; a reviewer may send a large change back. Pick it for a small, disciplined team where large changes are rare and already questioned."
          }
        ]
      },
      {
        "key": "COMMITS",
        "title": "Commits",
        "label": "What must a commit message say?",
        "hint": "The history of main is what the next incident is debugged from and, with a convention, what the changelog and version number are computed from.",
        "defaultValue": "conventional",
        "options": [
          {
            "value": "conventional",
            "label": "Conventional Commits, enforced by commitlint",
            "description": "Every commit subject is type(scope): description (feat, fix, refactor, …), checked by a commit-msg hook, in CI over the branch's commits and on the pull request title that becomes the squash subject; the changelog and the next version are derived from the types. Pick it when you publish a changelog or version numbers, or several teams read one history."
          },
          {
            "value": "free",
            "label": "free-form subjects, squash-merged",
            "description": "A subject line under 72 characters in the imperative, a body that says why; pull requests are squash-merged so the integration branch holds one commit per change with its pull request number. Pick it when nothing is derived from the messages and the pull request, not the commit, is the unit of history."
          }
        ]
      },
      {
        "key": "MAX_PR_LINES",
        "label": "How many changed lines may a pull request have at most?",
        "defaultValue": "400",
        "type": "number"
      },
      {
        "key": "MAX_BRANCH_DAYS",
        "label": "How old may a branch get before it is flagged (days)?",
        "defaultValue": "2",
        "type": "number"
      },
      {
        "key": "REVIEW_HOURS",
        "label": "Within how many working hours must a pull request get its first review?",
        "defaultValue": "4",
        "type": "number"
      },
      {
        "key": "CRITICAL_PATHS",
        "label": "Which directories are critical (need the stricter review)? Comma-separated, each ending with /",
        "defaultValue": "payments/, auth/, migrations/"
      }
    ]
  },
  "nodes": [
    {
      "id": "need",
      "type": "need",
      "label": "Changes merge small, reviewed and soon",
      "x": 0,
      "y": 0,
      "kind": "brief",
      "source": "Hub concern pack: Code review and branching",
      "description": "Several people change this element every day. Each change must reach the main branch while it is still small enough to review and fresh enough to merge without conflict, must be seen by someone other than its author before it lands, must be looked at by the people accountable for the code it touches, and must leave a history that explains itself a year later. Reviews must not become the queue everything waits in."
    },
    {
      "id": "req-protected-main",
      "type": "requirement",
      "label": "Main branch protected",
      "x": 260,
      "y": 0,
      "ears_type": "ubiquitous",
      "action": "protect the main branch with a ruleset that refuses direct pushes, force pushes and deletion, requires a pull request with at least one approval and stale-review dismissal, and requires the status checks named by the Code quality gate and Test strategy decisions to pass",
      "rationale": "A rule that lives in people's memory is skipped under pressure; one in the repository's rulesets is not (GitHub Docs: About rulesets; Fowler, Patterns for Managing Source Code Branches: mainline)."
    },
    {
      "id": "req-linear-history",
      "type": "requirement",
      "label": "Main history is linear",
      "x": 260,
      "y": 130,
      "ears_type": "ubiquitous",
      "action": "keep the history of main linear: the ruleset requires linear history, merge commits are disabled in the repository settings, and every commit on main belongs to a merged pull request",
      "rationale": "A linear history is what bisect and blame work on, and a commit on main without a pull request is a change nobody reviewed (Fowler, Patterns for Managing Source Code Branches: mainline integration; GitHub Docs: About rulesets).",
      "hubWhen": {
        "BRANCHING": [
          "trunk",
          "feature-pr"
        ]
      }
    },
    {
      "id": "req-one-review",
      "type": "requirement",
      "label": "One review from another person",
      "x": 260,
      "y": 260,
      "ears_type": "state-driven",
      "precondition": "a pull request has no approving review from a person other than its author, or its last approval predates its latest commit",
      "action": "refuse to merge it",
      "rationale": "The author is the one person who cannot see their own blind spots; a stale approval has not seen the code being merged (Google, Code Review Developer Guide: the standard of code review).",
      "hubWhen": {
        "REVIEW": [
          "one-reviewer"
        ]
      }
    },
    {
      "id": "req-two-critical",
      "type": "requirement",
      "label": "Two reviews on critical paths",
      "x": 260,
      "y": 390,
      "ears_type": "state-driven",
      "precondition": "a pull request changes a file under {{CRITICAL_PATHS}}",
      "action": "require two current approving reviews from people other than the author before it merges; one approval elsewhere",
      "rationale": "Where a mistake moves money, grants access or loses data, a second reviewer is cheaper than the incident; everywhere else a second review only lengthens the queue (SmartBear, review study: inspection rate and defect density).",
      "hubWhen": {
        "REVIEW": [
          "two-critical"
        ]
      }
    },
    {
      "id": "req-pairing",
      "type": "requirement",
      "label": "Pair counts as review",
      "x": 260,
      "y": 520,
      "ears_type": "event-driven",
      "trigger": "a pull request is opened",
      "action": "merge it on an approval from someone other than the author when every commit carries a Co-authored-by trailer, and otherwise only on an approval from someone who authored or co-authored none of its commits",
      "rationale": "Two people at one keyboard have reviewed every line as it was written; the trailer makes that visible and auditable, and a solo change gets the review it did not have (Fowler, Patterns for Managing Source Code Branches: pre-integration review vs. pairing).",
      "hubWhen": {
        "REVIEW": [
          "pairing"
        ]
      }
    },
    {
      "id": "req-turnaround",
      "type": "requirement",
      "label": "First review within hours",
      "x": 260,
      "y": 650,
      "ears_type": "event-driven",
      "trigger": "a pull request is marked ready for review",
      "action": "give it a first review, review comment or comment from someone other than the author within {{REVIEW_HOURS}} working hours, with the median over the pull requests merged in the last 30 days under {{REVIEW_HOURS}} working hours and the 90th percentile under one working day (8 hours)",
      "rationale": "A review that waits a day stalls the change, grows it while it waits, and pushes the author to start another branch; Google asks for a reply within one business day at most and prefers hours (Google, Speed of Code Reviews; DORA, lead time for changes)."
    },
    {
      "id": "req-owner-approval",
      "type": "requirement",
      "label": "Owning team approves",
      "x": 260,
      "y": 780,
      "ears_type": "event-driven",
      "trigger": "a pull request changes a file under a directory listed in CODEOWNERS",
      "action": "request a review from the owning team automatically and refuse to merge until a member of it approves (the ruleset requires a code-owner review), with every top-level directory listed in CODEOWNERS and every owner a team",
      "rationale": "The team accountable for a directory is the one that knows what a change there breaks; a directory without an owner is reviewed by nobody in particular (GitHub Docs: About code owners).",
      "hubWhen": {
        "OWNERSHIP": [
          "codeowners"
        ]
      }
    },
    {
      "id": "req-rotation",
      "type": "requirement",
      "label": "Reviewer assigned by rotation",
      "x": 260,
      "y": 910,
      "ears_type": "event-driven",
      "trigger": "a pull request is marked ready for review",
      "action": "assign one reviewer from the team round-robin within 15 minutes (the team's review assignment set to round robin), so that over the pull requests merged in the last 30 days no one person gave more than 40% of the reviews",
      "rationale": "Collective ownership works only when reviews actually spread; left to volunteers they go to the same two people (Fowler, Patterns for Managing Source Code Branches; Google, The Standard of Code Review: knowledge sharing).",
      "hubWhen": {
        "OWNERSHIP": [
          "collective"
        ]
      }
    },
    {
      "id": "req-pr-size",
      "type": "requirement",
      "label": "Oversized change split",
      "x": 260,
      "y": 1040,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a pull request changes more than {{MAX_PR_LINES}} lines, generated files and lock files excluded",
      "action": "fail the size check with the count and the suggestion to split, and allow the merge only with a size-exception label set by a lead",
      "rationale": "Reviewers find most defects in the first 200 to 400 lines and little after; past that a review is a formality (SmartBear, review study: 200 to 400 LOC per review; Google, Small CLs).",
      "hubWhen": {
        "SIZE": [
          "limit"
        ]
      }
    },
    {
      "id": "req-size-reported",
      "type": "requirement",
      "label": "Size shown on every pull request",
      "x": 260,
      "y": 1170,
      "ears_type": "event-driven",
      "trigger": "a pull request is opened or updated",
      "action": "post its changed-line count (generated files and lock files excluded) in the check summary, without blocking the merge",
      "rationale": "A number in front of the reviewer is what makes \"please split this\" a fair request instead of a feeling (Google, Small CLs; SmartBear, review study).",
      "hubWhen": {
        "SIZE": [
          "none"
        ]
      }
    },
    {
      "id": "req-branch-age",
      "type": "requirement",
      "label": "Old branches flagged",
      "x": 260,
      "y": 1300,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a branch other than main, develop or a release or hotfix branch has not been merged {{MAX_BRANCH_DAYS}} days after its first commit",
      "action": "flag it in the daily report with its last author, so that it is merged, split or deleted; bot branches (renovate/, dependabot/) are listed apart and not counted",
      "rationale": "The cost of a merge grows with the time apart; a branch older than a few days is already a merge nobody wants to do (Hammant, Trunk Based Development: short-lived feature branches; DORA: lead time)."
    },
    {
      "id": "req-conventional",
      "type": "requirement",
      "label": "Conventional commit messages",
      "x": 260,
      "y": 1430,
      "ears_type": "ubiquitous",
      "action": "accept only commits whose subject follows Conventional Commits 1.0.0 (type, optional scope, description, the header under 72 characters; a ! or BREAKING CHANGE footer for breaking changes), checked by a commit-msg hook on every machine, by commitlint over the pull request's commits in CI, and on the pull request title",
      "rationale": "A typed history is read by people and by tools: the changelog and the next version are computed from it, and a breaking change is marked where it was made; with squash merges the pull request title is the subject that lands on main (Conventional Commits 1.0.0).",
      "hubWhen": {
        "COMMITS": [
          "conventional"
        ]
      }
    },
    {
      "id": "req-free-commits",
      "type": "requirement",
      "label": "Short subjects, one commit per change",
      "x": 260,
      "y": 1560,
      "ears_type": "ubiquitous",
      "action": "keep every commit subject under 72 characters in the imperative with a body saying why, and squash-merge pull requests so that the integration branch (main, or develop under GitFlow) holds one commit per change with the pull request number in its subject",
      "rationale": "Without a convention, the pull request is the unit of history; squashing keeps the integration branch as one line per change with a link to the discussion that explains it (Fowler, Patterns for Managing Source Code Branches: mainline integration).",
      "hubWhen": {
        "COMMITS": [
          "free"
        ]
      }
    },
    {
      "id": "req-trunk",
      "type": "requirement",
      "label": "Branches merge within days",
      "x": 260,
      "y": 1690,
      "ears_type": "ubiquitous",
      "action": "merge every branch to main within {{MAX_BRANCH_DAYS}} days of its first commit, hide unfinished work behind a feature flag (as the Deployment decision sets) or a branch by abstraction, and have every developer integrate to main on at least 80% of the days they commit",
      "rationale": "Daily integration is the practice behind the DORA findings on lead time and change failure rate; a change that waits a week is a week of other people's changes to merge against (Hammant, Trunk Based Development; DORA, Trunk-based development capability).",
      "hubWhen": {
        "BRANCHING": [
          "trunk"
        ]
      }
    },
    {
      "id": "req-feature-pr",
      "type": "requirement",
      "label": "Main always releasable",
      "x": 260,
      "y": 1820,
      "ears_type": "ubiquitous",
      "action": "make every change through a branch and a pull request, merge only when reviewed and green, keep branches under {{MAX_BRANCH_DAYS}} days, and let no commit reach main outside a merged pull request",
      "rationale": "A pull request per change gives every change its review and its checks before it lands; the branch age keeps the model close to continuous integration instead of drifting to long-lived feature branches (Fowler, Patterns for Managing Source Code Branches: feature branching; Hammant: short-lived branches).",
      "hubWhen": {
        "BRANCHING": [
          "feature-pr"
        ]
      }
    },
    {
      "id": "req-gitflow",
      "type": "requirement",
      "label": "Releases and hotfixes branched",
      "x": 260,
      "y": 1950,
      "ears_type": "event-driven",
      "trigger": "a version is about to ship, or a shipped version needs a fix",
      "action": "create release/x.y from develop (fixes only, no features), merge it to main with a merge commit and an annotated tag vX.Y.Z and back into develop, and for a fix branch hotfix/x.y.z from the tag on main and merge it to both main and develop, so that main holds only tagged release and hotfix merges and develop is protected like main",
      "rationale": "Customers who installed version 2.3 need a 2.3.1 without the features of 2.4; release and hotfix branches give each supported version a place to be fixed (Driessen, A successful Git branching model).",
      "hubWhen": {
        "BRANCHING": [
          "gitflow"
        ]
      }
    },
    {
      "id": "sc-protected-main",
      "type": "scenario",
      "label": "Direct push refused",
      "x": 520,
      "y": 0,
      "given": "a developer with write access",
      "when": "they push a commit straight to main, then force-push a branch that was merged",
      "then": "both pushes are refused by the ruleset and the only way in is a pull request with green checks"
    },
    {
      "id": "sc-linear-history",
      "type": "scenario",
      "label": "Merge commit refused",
      "x": 520,
      "y": 130,
      "given": "the ruleset on main",
      "when": "a merge commit is pushed and the weekly history check runs",
      "then": "the push is refused by the linear-history rule, and the check finds no commit on main without a pull request",
      "hubWhen": {
        "BRANCHING": [
          "trunk",
          "feature-pr"
        ]
      }
    },
    {
      "id": "sc-one-review",
      "type": "scenario",
      "label": "Stale approval dismissed",
      "x": 520,
      "y": 260,
      "given": "a pull request approved by a reviewer",
      "when": "the author pushes another commit",
      "then": "the approval is dismissed and the merge button stays disabled until someone approves again",
      "hubWhen": {
        "REVIEW": [
          "one-reviewer"
        ]
      }
    },
    {
      "id": "sc-two-critical",
      "type": "scenario",
      "label": "Second approval required",
      "x": 520,
      "y": 390,
      "given": "a pull request changing a file under {{CRITICAL_PATHS}} with one approval",
      "when": "the merge is attempted",
      "then": "the required check \"critical-paths-review\" fails naming the files and the missing second approval",
      "hubWhen": {
        "REVIEW": [
          "two-critical"
        ]
      }
    },
    {
      "id": "sc-pairing",
      "type": "scenario",
      "label": "Solo change still reviewed",
      "x": 520,
      "y": 520,
      "given": "two pull requests, one with Co-authored-by trailers on all commits and one without",
      "when": "each is approved by a co-author of the first",
      "then": "the first may merge; the second waits for a review from someone who did not write it",
      "hubWhen": {
        "REVIEW": [
          "pairing"
        ]
      }
    },
    {
      "id": "sc-turnaround",
      "type": "scenario",
      "label": "Review turnaround measured",
      "x": 520,
      "y": 650,
      "given": "the pull requests merged in the last 30 days",
      "when": "the working hours from ready-for-review to the first review or comment by someone else are computed from each timeline",
      "then": "the median is under {{REVIEW_HOURS}} working hours and the 90th percentile under 8"
    },
    {
      "id": "sc-owner-approval",
      "type": "scenario",
      "label": "Owner review requested",
      "x": 520,
      "y": 780,
      "given": "a CODEOWNERS file naming a team for payments/",
      "when": "a pull request changes payments/refund.ts",
      "then": "the team is requested automatically and the merge waits for one of its members; the CODEOWNERS check fails on a top-level directory without a team",
      "hubWhen": {
        "OWNERSHIP": [
          "codeowners"
        ]
      }
    },
    {
      "id": "sc-rotation",
      "type": "scenario",
      "label": "Reviews spread",
      "x": 520,
      "y": 910,
      "given": "the team with round-robin assignment and the pull requests merged in the last 30 days",
      "when": "the weekly rotation check runs",
      "then": "every pull request got its review request within 15 minutes of ready-for-review, and no reviewer gave more than 40% of the reviews",
      "hubWhen": {
        "OWNERSHIP": [
          "collective"
        ]
      }
    },
    {
      "id": "sc-pr-size",
      "type": "scenario",
      "label": "Large pull request blocked",
      "x": 520,
      "y": 1040,
      "given": "a pull request changing {{MAX_PR_LINES}} + 1 lines of source",
      "when": "the size check runs",
      "then": "it fails with the line count, and passes only after a split or a size-exception label",
      "hubWhen": {
        "SIZE": [
          "limit"
        ]
      }
    },
    {
      "id": "sc-size-reported",
      "type": "scenario",
      "label": "Size posted",
      "x": 520,
      "y": 1170,
      "given": "a pull request changing 900 lines",
      "when": "the size step runs",
      "then": "the check summary shows 900 changed lines and the check passes",
      "hubWhen": {
        "SIZE": [
          "none"
        ]
      }
    },
    {
      "id": "sc-branch-age",
      "type": "scenario",
      "label": "Stale branch reported",
      "x": 520,
      "y": 1300,
      "given": "a branch whose first commit is {{MAX_BRANCH_DAYS}} + 1 days old and unmerged",
