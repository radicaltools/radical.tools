        "url": "https://response.pagerduty.com/training/incident_commander/"
      },
      {
        "title": "PagerDuty Incident Response: Postmortem Process",
        "url": "https://response.pagerduty.com/after/post_mortem_process/"
      },
      {
        "title": "Atlassian Incident Management Handbook: Responding to an incident",
        "url": "https://www.atlassian.com/incident-management/handbook/incident-response"
      },
      {
        "title": "Atlassian Incident Management Handbook: Postmortems",
        "url": "https://www.atlassian.com/incident-management/handbook/postmortems"
      },
      {
        "title": "Atlassian: Understanding incident severity levels",
        "url": "https://www.atlassian.com/incident-management/kpis/severity-levels"
      },
      {
        "title": "ITIL 4 Practice Guide: Incident Management (Axelos)",
        "url": "https://www.axelos.com/resource-hub/practice/incident-management-itil-4-practice-guide"
      },
      {
        "title": "ServiceNow: Define priority lookup rules (priority from impact and urgency)",
