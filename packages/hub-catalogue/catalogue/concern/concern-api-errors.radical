{
  "hub": {
    "id": "concern-api-errors",
    "category": "concern",
    "name": "Errors",
    "description": "What an error looks like to a caller of an HTTP API: the body's format, stable error codes, how validation errors are reported, and where the codes are documented. What must never reach a caller is decided in Error handling and logging conventions.",
    "tags": [
      "api",
      "errors",
      "problem details",
      "rfc 9457",
      "error codes",
      "validation"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "concern": {
      "id": "api-errors",
      "trigger": "LIST RELATIONS WHERE source.type != \"person\" AND target.external != true AND (target.type = \"container\" OR target.type = \"component\")",
      "applyTo": "target",
      "why": "other parts of the system or other systems call these elements, so what an error looks like to a caller has to be decided once for every operation they offer.",
      "group": "api"
    },
    "sources": [
      {
        "title": "RFC 9457, Problem Details for HTTP APIs",
        "url": "https://www.rfc-editor.org/rfc/rfc9457"
      },
      {
        "title": "RFC 6901, JavaScript Object Notation (JSON) Pointer",
        "url": "https://www.rfc-editor.org/rfc/rfc6901"
      },
      {
        "title": "RFC 9110, HTTP Semantics (15. Status Codes)",
        "url": "https://www.rfc-editor.org/rfc/rfc9110#name-status-codes"
      },
      {
        "title": "Microsoft Azure REST API Guidelines: Handling errors",
        "url": "https://github.com/microsoft/api-guidelines/blob/vNext/azure/Guidelines.md#handling-errors"
      },
      {
        "title": "Google AIP-193, Errors",
        "url": "https://google.aip.dev/193"
      },
      {
        "title": "google/rpc/error_details.proto (ErrorInfo, BadRequest, RequestInfo, Help)",
        "url": "https://github.com/googleapis/googleapis/blob/master/google/rpc/error_details.proto"
      },
      {
        "title": "Zalando RESTful API Guidelines: MUST support problem JSON [176], MUST not expose stack traces [177]",
        "url": "https://opensource.zalando.com/restful-api-guidelines/#176"
      },
      {
        "title": "OWASP Error Handling Cheat Sheet",
        "url": "https://cheatsheetseries.owasp.org/cheatsheets/Error_Handling_Cheat_Sheet.html"
      },
      {
        "title": "Spectral: custom rulesets",
        "url": "https://github.com/stoplightio/spectral/blob/develop/docs/guides/4-custom-rulesets.md"
      }
    ],
    "templateParams": [
      {
        "key": "FORMAT",
        "title": "Error body",
        "label": "What does an error look like to a caller?",
        "hint": "Every client parses this body, so it is the one shape the whole API keeps. Follow the guide chosen in the API style guide pack: Zalando's guidelines ask for problem details, Microsoft's for its error object, Google's AIPs for google.rpc.Status. How the shape changes across versions is the API evolution pack's decision.",
        "defaultValue": "problem-details",
        "options": [
          {
            "value": "problem-details",
            "label": "RFC 9457 problem details",
            "description": "Every error is application/problem+json with type (a URI reference naming the problem), title, status, detail and instance, plus a stable code and the correlation id as extension members. Pick it for any HTTP API with more than one client or a public one, and whenever the chosen guide is Zalando's or your own: it is the IETF standard, and Spring, ASP.NET Core and most gateways write it already."
          },
          {
            "value": "microsoft",
            "label": "Microsoft's error object",
            "description": "Every error is a JSON body {\"error\": {\"code\", \"message\", \"target\", \"details\", \"innererror\"}} with the code repeated in an x-ms-error-code header, as the Microsoft Azure REST API Guidelines require. Pick it when the chosen guide is Microsoft's, or the API sits beside Azure or Microsoft Graph APIs whose clients already parse that shape."
          },
          {
            "value": "google",
            "label": "google.rpc.Status as JSON",
            "description": "Every error is a JSON body {\"error\": {\"code\", \"message\", \"status\", \"details\"}} where code is the HTTP status, status the google.rpc.Code name and details holds a google.rpc.ErrorInfo with a stable reason, as Google AIP-193 requires. Pick it when the chosen guide is Google's AIPs, or the API is gRPC transcoded to HTTP/JSON, where this is the shape the gateway speaks."
          },
          {
            "value": "minimal",
            "label": "a minimal body of status, code and message",
            "description": "The HTTP status plus a JSON body holding only a stable code, a message and the correlation id. Pick it for an internal API with one client owned by the same team, where a standard shape buys nothing yet; moving to problem details later is a breaking change."
          }
        ]
      },
      {
        "key": "CODES",
        "title": "Error codes",
        "label": "How does a client tell one error from another?",
        "hint": "The status says what kind of failure it was; a code says which one. A code a client keys on is part of the contract, so it must be listed and must never change meaning.",
        "defaultValue": "catalogue",
        "options": [
          {
            "value": "catalogue",
            "label": "a catalogue of stable codes, listed per operation",
            "description": "Every error carries a machine-readable code from one catalogue kept with the OpenAPI document (ORDER_NOT_FOUND, PAYMENT_DECLINED), each operation lists the codes it may return, and a released code is never renamed or removed. Pick it when clients act differently on errors of the same status, or the API is public or used by partners."
          },
          {
            "value": "status-only",
            "label": "the HTTP status alone",
            "description": "Clients key on the HTTP status only; where the format has a code field it holds the status's reason phrase (NOT_FOUND, INTERNAL_SERVER_ERROR), and problem details use type about:blank. Pick it for an internal API whose one client treats every error of a status the same, so a catalogue would be paperwork."
          }
        ]
      },
      {
        "key": "VALIDATION",
        "title": "Invalid input",
        "label": "How are invalid fields in a request reported?",
        "hint": "A client that fills a form wants to mark every wrong field at once; one that only logs the failure needs just the first.",
        "defaultValue": "all",
        "options": [
          {
            "value": "all",
            "label": "every field error in one response",
            "description": "One response lists every invalid field of the request body, each with its location (a JSON Pointer, RFC 6901, or the dotted field path of google.rpc.BadRequest) and a field-level code. Pick it whenever a person fills the request in through a form, and as the default for any public API."
          },
          {
            "value": "first",
            "label": "the first field error only",
            "description": "Validation stops at the first invalid field and the response names that one, with its location and code. Pick it for machine-to-machine APIs whose callers build requests in code and treat any invalid request as a bug."
          }
        ]
      },
      {
        "key": "DOCS",
        "title": "Code documentation",
        "label": "Where does a developer read what a code means?",
        "hint": "Only when codes come from a catalogue: with the HTTP status alone there is nothing beyond the status to document, and this answer decides nothing. RFC 9457 suggests type URIs that resolve to a page; Zalando deliberately keeps them as identifiers documented in the OpenAPI document.",
        "defaultValue": "page",
        "options": [
          {
            "value": "page",
            "label": "a documentation page per code",
            "description": "Every code has a public page under one base URL (when it happens, what the caller should do), which the problem details type URI or a google.rpc.Help link points to. Pick it for public and partner APIs, where the developer who hits an error is not the one who read the reference."
          },
          {
            "value": "identifiers",
            "label": "identifiers documented in the OpenAPI document only",
            "description": "Codes and type URIs are identifiers that do not resolve (type /problems/order-not-found); each code is described in the catalogue and published with the OpenAPI document beside the operations that return it. Pick it for internal APIs, or when a separate documentation site would fall out of step with the contract, as the Zalando guidelines argue."
          }
        ]
      },
      {
        "key": "CODE_PATTERN",
        "label": "Regular expression every error code and field-level code matches",
        "defaultValue": "^[A-Z][A-Z0-9_]*[A-Z0-9]$"
      },
      {
        "key": "VALIDATION_STATUS",
        "label": "Status of a response to a request body that fails validation (400, or 422 for content that parses but breaks a rule)",
        "defaultValue": "400",
        "type": "number"
      },
      {
        "key": "GENERIC_MESSAGE",
        "label": "Text every unexpected (5xx) error gives its caller",
        "defaultValue": "An unexpected error occurred. Quote the trace id of this response when you contact support."
      },
      {
        "key": "ERROR_DOCS_URL",
        "label": "Base URL of the error code pages (a documentation page per code only)",
        "defaultValue": "https://developer.example.com/errors/"
      }
    ]
  },
  "nodes": [
    {
      "id": "need",
      "type": "need",
      "label": "Errors a caller can act on",
      "x": 0,
      "y": 0,
      "kind": "brief",
      "source": "Hub concern pack: Errors",
      "description": "Every client of this API has to handle its errors in code: tell one failure from another without parsing prose, mark every wrong field for its user, and quote one id to support. That only works if every operation answers errors in one documented shape, with codes that keep their meaning and text written for the caller rather than copied from an exception. The snippets assume one OpenAPI document per API under api/ (api/orders.yaml), the error code catalogue at api/errors/codes.yaml, the error rules in api/style/errors.yaml beside the style ruleset the API style guide pack keeps, the app exported from src/app (an Express app, with test-only routes: GET /__boom throws an unexpected error and GET /__expected an expected one, both with the text in the ERROR_MARK variable), POST /orders validating email, items[].quantity and currency, and the tests under test/ run with NODE_ENV=production."
    },
    {
      "id": "req-problem-details",
      "type": "requirement",
      "label": "Errors answered as problem details",
      "x": 260,
      "y": 0,
      "ears_type": "event-driven",
      "trigger": "an operation answers with a 4xx or 5xx status",
      "action": "send a body of media type application/problem+json holding type (a URI reference), title, status equal to the response's status, detail, instance, and as extension members a code matching {{CODE_PATTERN}} and the correlation id under the field set in Error handling and logging conventions; where codes are the HTTP status alone, type is about:blank and title the status's reason phrase",
      "rationale": "One standard shape lets every client parse every error with one library, and the extension members carry what the five standard ones do not; clients must ignore extensions they do not know, so adding one breaks nobody (RFC 9457, sections 3.1, 3.2 and 4.2.1; Zalando guidelines, rule 176).",
      "hubWhen": {
        "FORMAT": [
          "problem-details"
        ]
      }
    },
    {
      "id": "req-microsoft-error",
      "type": "requirement",
      "label": "Errors answered as Microsoft's error object",
      "x": 260,
      "y": 130,
      "ears_type": "event-driven",
      "trigger": "an operation answers with a 4xx or 5xx status",
      "action": "send a JSON body whose only top-level member is error, an object holding code (matching {{CODE_PATTERN}}), message, and where they apply target and details (each an object of the same shape), with the correlation id as a property of error under the field set in Error handling and logging conventions; repeat the code in an x-ms-error-code header, and send no innererror with production settings",
      "rationale": "The guidelines make the top-level code and the header the contract and leave the other fields free; innererror is for debugging detail, which belongs in the log, not in the answer (Microsoft Azure REST API Guidelines, Handling errors; OWASP Error Handling Cheat Sheet).",
      "hubWhen": {
        "FORMAT": [
          "microsoft"
        ]
      }
    },
    {
      "id": "req-google-status",
      "type": "requirement",
      "label": "Errors answered as google.rpc.Status",
      "x": 260,
      "y": 260,
      "ears_type": "event-driven",
      "trigger": "an operation answers with a 4xx or 5xx status",
      "action": "send a JSON body whose only top-level member is error, holding code (the HTTP status), status (the google.rpc.Code name, such as NOT_FOUND or INTERNAL), message, and details with exactly one google.rpc.ErrorInfo (reason matching {{CODE_PATTERN}}, domain the service's name) and one google.rpc.RequestInfo whose requestId is the correlation id, no detail type twice",
      "rationale": "AIP-193 requires an ErrorInfo in every error and keeps its reason and domain stable as the machine-readable identity of the error; RequestInfo is the detail meant for the id a client quotes when it reports a problem (Google AIP-193; google/rpc/error_details.proto).",
      "hubWhen": {
        "FORMAT": [
          "google"
        ]
      }
    },
    {
      "id": "req-minimal",
      "type": "requirement",
      "label": "Errors answered as status, code and message",
      "x": 260,
      "y": 390,
      "ears_type": "event-driven",
      "trigger": "an operation answers with a 4xx or 5xx status",
      "action": "send a JSON body holding only code (matching {{CODE_PATTERN}}), message and the correlation id under the field set in Error handling and logging conventions, plus the list of field errors when the request failed validation, and nothing else",
      "rationale": "A client owned by the same team needs a code to key on and an id to quote; every further field is one more thing to keep stable and one more place for internals to slip out (OWASP Error Handling Cheat Sheet).",
      "hubWhen": {
        "FORMAT": [
          "minimal"
        ]
      }
    },
    {
      "id": "req-correlation",
      "type": "requirement",
      "label": "Every error carries the request's id",
      "x": 260,
      "y": 520,
      "ears_type": "event-driven",
      "trigger": "an operation answers with a 4xx or 5xx status",
      "action": "carry in the error body the correlation id of the request (the trace id of an incoming traceparent header, or the id created at the edge when there is none), in the place the error format gives it and under the field set in Error handling and logging conventions",
      "rationale": "The id in the answer is what a client quotes to support and what finds the one log line of that failure among millions; without it a report of an error cannot be traced (RFC 9457, section 3.2 extension members; google.rpc.RequestInfo; OWASP Error Handling Cheat Sheet)."
    },
    {
      "id": "req-caller-text",
      "type": "requirement",
      "label": "Error text written for the caller",
      "x": 260,
      "y": 650,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "an error is caused by an exception, a driver error or an upstream system's answer",
      "action": "fill the human-readable text of the error body (detail, message) only with text written for callers (the code's catalogue entry, or the operation's own wording), never with the exception's or upstream's message, and give every 5xx error the fixed text \"{{GENERIC_MESSAGE}}\"",
      "rationale": "An exception's message is written for the developer and describes the code, not what the caller should do; passing it through also passes on whatever it names. The leak of stack traces, class names and SQL is ruled out in Error handling and logging conventions; this rules out the text (OWASP Error Handling Cheat Sheet; RFC 9457, section 4: not a debugging tool)."
    },
    {
      "id": "req-documented",
      "type": "requirement",
      "label": "Error responses documented per operation",
      "x": 260,
      "y": 780,
      "ears_type": "ubiquitous",
      "action": "document in the OpenAPI document, for every operation, at least one 4xx response and a default response, each with its content described, so that 0 operations leave a caller to guess what their errors look like",
      "rationale": "Clients are generated from the document; an error response it does not describe is one the client has no type for (Zalando guidelines, rule 151, MUST specify success and error responses; Microsoft Azure REST API Guidelines, Handling errors)."
    },
    {
      "id": "req-codes",
      "type": "requirement",
      "label": "Codes come from one catalogue",
      "x": 260,
      "y": 910,
      "ears_type": "ubiquitous",
      "action": "take every error code from the one catalogue api/errors/codes.yaml (each code matching {{CODE_PATTERN}}, with its status of at least 400, a title and a description), list in each operation's x-error-codes the codes it may return, and never rename or remove a released code",
      "rationale": "A client keys on codes, so a code is part of the contract: renamed or removed, it breaks callers silently, and a code returned but never listed is one no client was written for (Microsoft Azure REST API Guidelines: error codes are part of the API contract; Google AIP-193: the same reason and domain for the same error, consistent over time).",
      "hubWhen": {
        "CODES": [
          "catalogue"
        ]
      }
    },
    {
      "id": "req-status-only",
      "type": "requirement",
      "label": "Errors keyed on the status alone",
      "x": 260,
      "y": 1040,
      "ears_type": "ubiquitous",
      "action": "give every error the code of its HTTP status where the format has a code field (the status's reason phrase in upper snake case: NOT_FOUND, UNPROCESSABLE_CONTENT, INTERNAL_SERVER_ERROR), and in problem details the type about:blank, so that no code carries more than the status does",
      "rationale": "With one client that treats every error of a status alike, a code that only repeats the status is honest about what the client may rely on; about:blank is the type RFC 9457 defines for exactly that (RFC 9457, section 4.2.1; RFC 9110, section 15).",
      "hubWhen": {
        "CODES": [
          "status-only"
        ]
      }
    },
    {
      "id": "req-validation-all",
      "type": "requirement",
      "label": "Every invalid field reported at once",
      "x": 260,
      "y": 1170,
      "ears_type": "event-driven",
      "trigger": "a request body fails validation",
      "action": "answer {{VALIDATION_STATUS}} listing every invalid field in one response, each with its location (a JSON Pointer per RFC 6901 into the body; the dotted field path of google.rpc.BadRequest in that format) and a field-level code matching {{CODE_PATTERN}}",
      "rationale": "A user who submits a form with three mistakes should learn of all three at once, and a client can only mark the fields if it can locate them; RFC 9457 shows exactly this list of detail and pointer (RFC 9457, section 3; RFC 6901; google.rpc.BadRequest field violations).",
      "hubWhen": {
        "VALIDATION": [
          "all"
        ]
      }
    },
    {
      "id": "req-validation-first",
      "type": "requirement",
      "label": "First invalid field reported",
      "x": 260,
      "y": 1300,
      "ears_type": "event-driven",
      "trigger": "a request body fails validation",
      "action": "answer {{VALIDATION_STATUS}} naming only the first invalid field found, with its location (a JSON Pointer per RFC 6901 into the body; the dotted field path of google.rpc.BadRequest in that format) and a field-level code matching {{CODE_PATTERN}}, in the place the format keeps field errors",
      "rationale": "A caller that builds requests in code fixes a bug, not a form; one located error is enough to find it, and stopping early keeps validation simple (RFC 6901; RFC 9110, section 15.5.1).",
      "hubWhen": {
        "VALIDATION": [
          "first"
        ]
      }
    },
    {
      "id": "req-docs-page",
      "type": "requirement",
      "label": "A page for every code",
      "x": 260,
      "y": 1430,
      "ears_type": "ubiquitous",
      "action": "publish for every code of the catalogue a page at {{ERROR_DOCS_URL}} followed by the code in lower case with dashes (ORDER_NOT_FOUND at order-not-found), reachable without signing in and answering 200 with HTML that names the code",
      "rationale": "The developer who meets an error is often not the one who read the reference; a type URI that resolves to human-readable documentation is what RFC 9457 recommends, and AIP-193 requires the links of a publicly documented service to be reachable without authentication (RFC 9457, sections 3.1.1 and 4; Google AIP-193, Help).",
      "hubWhen": {
        "CODES": [
          "catalogue"
        ],
        "DOCS": [
          "page"
        ]
      }
    },
    {
      "id": "req-docs-identifiers",
      "type": "requirement",
      "label": "Codes documented in the contract",
      "x": 260,
      "y": 1560,
      "ears_type": "ubiquitous",
      "action": "document every code in its catalogue entry with a description of when it happens and what the caller should do, published with the OpenAPI document beside the operations whose x-error-codes list it",
      "rationale": "An identifier that does not resolve is fine when the contract itself explains it; the Zalando guidelines keep type URIs as identifiers precisely so that the documentation lives in the OpenAPI document and cannot drift from it (Zalando guidelines, rule 176; RFC 9457, section 3.1.1: the type URI may be non-resolvable).",
      "hubWhen": {
        "CODES": [
          "catalogue"
        ],
        "DOCS": [
          "identifiers"
        ]
      }
    },
    {
      "id": "sc-problem-details",
      "type": "scenario",
      "label": "Not found and crash answered as problems",
      "x": 520,
      "y": 0,
      "given": "the element running with production settings",
      "when": "an order that does not exist is requested and a route that throws an unexpected error is called, both with a traceparent header",
      "then": "both answers are application/problem+json with type, title, status equal to the response's, detail, instance, a code matching {{CODE_PATTERN}} and the trace id of the traceparent",
      "hubWhen": {
        "FORMAT": [
          "problem-details"
        ]
      }
    },
    {
      "id": "sc-microsoft-error",
      "type": "scenario",
      "label": "Not found and crash answered as error objects",
      "x": 520,
      "y": 130,
      "given": "the element running with production settings",
      "when": "an order that does not exist is requested and a route that throws an unexpected error is called, both with a traceparent header",
      "then": "both answers are JSON with only the member error, whose code matches {{CODE_PATTERN}} and equals the x-ms-error-code header, which has a message and the trace id of the traceparent, and no innererror",
      "hubWhen": {
        "FORMAT": [
          "microsoft"
        ]
      }
    },
    {
      "id": "sc-google-status",
      "type": "scenario",
      "label": "Not found and crash answered as statuses",
      "x": 520,
      "y": 260,
      "given": "the element running with production settings",
      "when": "an order that does not exist is requested and a route that throws an unexpected error is called, both with a traceparent header",
      "then": "both answers are JSON with only the member error, whose code equals the response's status, whose status is a google.rpc.Code name, and whose details hold one ErrorInfo with a reason matching {{CODE_PATTERN}} and one RequestInfo with the trace id of the traceparent",
      "hubWhen": {
        "FORMAT": [
          "google"
        ]
      }
    },
    {
      "id": "sc-minimal",
      "type": "scenario",
      "label": "Not found and crash answered minimally",
      "x": 520,
      "y": 390,
      "given": "the element running with production settings",
      "when": "an order that does not exist is requested and a route that throws an unexpected error is called, both with a traceparent header",
      "then": "both answers are JSON with exactly the fields code, message and the correlation field, the code matching {{CODE_PATTERN}} and the id the trace id of the traceparent",
      "hubWhen": {
        "FORMAT": [
          "minimal"
        ]
      }
    },
    {
      "id": "sc-correlation",
      "type": "scenario",
      "label": "Trace id handed back",
      "x": 520,
      "y": 520,
      "given": "a request with the traceparent 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "when": "it fails with a 404 and another fails with a 500",
      "then": "both error bodies carry 4bf92f3577b34da6a3ce929d0e0e4736 as the correlation id"
    },
    {
      "id": "sc-caller-text",
      "type": "scenario",
      "label": "Exception text stays inside",
      "x": 520,
      "y": 650,
      "given": "a route that throws an unexpected error and one that throws an expected error, both with a random marker in their message",
      "when": "each is called with production settings",
      "then": "neither answer holds the marker, and the 500 answer holds \"{{GENERIC_MESSAGE}}\""
    },
    {
      "id": "sc-documented",
      "type": "scenario",
      "label": "Undocumented errors refused",
      "x": 520,
      "y": 780,
      "given": "a pull request adding an operation with only a 200 response, and one whose 404 response has no content",
      "when": "the Spectral rules run on the OpenAPI documents",
      "then": "both fail, naming the operation and the missing response or content"
    },
    {
      "id": "sc-codes",
      "type": "scenario",
      "label": "Unknown and renamed codes refused",
      "x": 520,
      "y": 910,
      "given": "a pull request that lists a code on an operation that the catalogue lacks, and another that renames a code in the catalogue",
      "when": "the catalogue test runs",
      "then": "the first fails naming the operation and the code, the second fails the snapshot of the codes",
      "hubWhen": {
        "CODES": [
          "catalogue"
        ]
      }
    },
    {
      "id": "sc-status-only",
      "type": "scenario",
      "label": "Status names the error",
      "x": 520,
      "y": 1040,
      "given": "the element running with production settings",
      "when": "an order that does not exist is requested and a route that throws an unexpected error is called",
      "then": "the first answer is 404 with the code NOT_FOUND and the second 500 with INTERNAL_SERVER_ERROR, and a problem details type is about:blank",
      "hubWhen": {
        "CODES": [
          "status-only"
        ]
      }
    },
    {
      "id": "sc-validation-all",
      "type": "scenario",
      "label": "Three mistakes, one answer",
      "x": 520,
      "y": 1170,
      "given": "a new order with an invalid e-mail address, a quantity of 0 in its first item and an unknown currency",
      "when": "it is posted",
      "then": "the answer is {{VALIDATION_STATUS}} and lists exactly three field errors, located at the e-mail address, the first item's quantity and the currency, each with a code matching {{CODE_PATTERN}}",
      "hubWhen": {
        "VALIDATION": [
          "all"
        ]
      }
    },
    {
      "id": "sc-validation-first",
      "type": "scenario",
      "label": "Three mistakes, the first reported",
      "x": 520,
      "y": 1300,
      "given": "a new order with an invalid e-mail address, a quantity of 0 in its first item and an unknown currency",
      "when": "it is posted",
      "then": "the answer is {{VALIDATION_STATUS}} and lists exactly one field error, with a location and a code matching {{CODE_PATTERN}}",
      "hubWhen": {
        "VALIDATION": [
