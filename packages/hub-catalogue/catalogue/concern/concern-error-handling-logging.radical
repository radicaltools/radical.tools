{
  "hub": {
    "id": "concern-error-handling-logging",
    "category": "concern",
    "name": "Error handling and logging conventions",
    "description": "How the code signals, propagates and records failures: the error style, where errors are handled, what an error that reaches a caller looks like, how a log line is shaped, and what must never be in one.",
    "tags": [
      "maintainability",
      "error handling",
      "exceptions",
      "result types",
      "logging",
      "redaction",
      "problem details"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "concern": {
      "id": "error-handling-logging",
      "trigger": "LIST NODES WHERE (type = \"container\" OR type = \"webapp\") AND external != true",
      "why": "code lives in these elements and fails in production, so how a failure is signalled, where it is handled and how it is recorded has to be decided once for everyone who writes in them; one decision usually covers a whole repository and is bound to every element built from it.",
      "group": "maintainability"
    },
    "sources": [
      {
        "title": "RFC 9457, Problem Details for HTTP APIs",
        "url": "https://www.rfc-editor.org/rfc/rfc9457"
      },
      {
        "title": "OWASP Logging Cheat Sheet",
        "url": "https://cheatsheetseries.owasp.org/cheatsheets/Logging_Cheat_Sheet.html"
      },
      {
        "title": "OWASP Error Handling Cheat Sheet",
        "url": "https://cheatsheetseries.owasp.org/cheatsheets/Error_Handling_Cheat_Sheet.html"
      },
      {
        "title": "OWASP Top 10 2021, A09: Security Logging and Monitoring Failures",
        "url": "https://owasp.org/Top10/A09_2021-Security_Logging_and_Monitoring_Failures/"
      },
      {
        "title": "Microsoft .NET: Best practices for exceptions",
        "url": "https://learn.microsoft.com/en-us/dotnet/standard/exceptions/best-practices-for-exceptions"
      },
      {
        "title": "Joe Duffy: The Error Model",
        "url": "https://joeduffyblog.com/2016/02/07/the-error-model/"
      },
      {
        "title": "The Rust Programming Language, chapter 9: Error Handling",
        "url": "https://doc.rust-lang.org/book/ch09-00-error-handling.html"
      },
      {
        "title": "Martin Fowler: Replacing Throwing Exceptions with Notification",
        "url": "https://martinfowler.com/articles/replaceThrowWithNotification.html"
      },
      {
        "title": "pino documentation: Redaction",
        "url": "https://getpino.io/#/docs/redaction"
      },
      {
        "title": "structlog documentation",
        "url": "https://www.structlog.org/en/stable/"
      },
      {
        "title": "The Twelve-Factor App, XI. Logs",
        "url": "https://12factor.net/logs"
      },
      {
        "title": "Google SRE book, chapter 6: Monitoring Distributed Systems",
        "url": "https://sre.google/sre-book/monitoring-distributed-systems/"
      },
      {
        "title": "ISO/IEC 25010, Maintainability: analysability",
        "url": "https://iso25000.com/index.php/en/iso-25000-standards/iso-25010"
      }
    ],
    "templateParams": [
      {
        "key": "STYLE",
        "title": "Error style",
        "label": "How does code signal a failure?",
        "hint": "The style decides whether an expected failure is visible in a function's signature, how much ceremony each call carries, and what the language and its linters can check for you.",
        "defaultValue": "exceptions",
        "options": [
          {
            "value": "exceptions",
            "label": "exceptions with a small domain hierarchy",
            "description": "One base error class, typed subclasses for the expected failures (NotFound, Validation, Conflict, UpstreamUnavailable), and unexpected ones left to propagate untouched to the edge. Pick it as the default in Java, C#, Python, TypeScript and Kotlin, where the libraries throw anyway and the frameworks map exceptions to responses."
          },
          {
            "value": "result",
            "label": "explicit result types for expected failures",
            "description": "A function that can fail in an expected way returns a Result or Either (Rust Result, Go error values, Kotlin Result, neverthrow or fp-ts in TypeScript), and exceptions or panics are kept for bugs. Pick it in Rust and Go, or in a TypeScript or Kotlin codebase whose team wants failures in the type signature and is ready to handle one at every call."
          },
          {
            "value": "codes",
            "label": "error codes from a catalogue",
            "description": "Every error is a code from one catalogue (code, HTTP status, message), returned as a value and never invented at the call site. Pick it for C and embedded code, protocol-driven code bases, and APIs whose clients key on stable codes and need them documented."
          }
        ]
      },
      {
        "key": "BOUNDARY",
        "title": "Where handled",
        "label": "Where are errors handled?",
        "hint": "Handling in one place keeps inner code honest and the log free of repeats; handling per layer keeps a layer's callers free of its dependencies' error types.",
        "defaultValue": "edge",
        "options": [
          {
            "value": "edge",
            "label": "one handler at the edge",
            "description": "One middleware, exception filter or handler at the edge (HTTP, queue consumer, CLI main) maps every error to a response, logs it once and ends the request; inner code only throws or returns. Pick it for services and web apps of one or two layers, where a 404 or 409 is the same decision everywhere."
          },
          {
            "value": "layered",
            "label": "translation at every layer",
            "description": "Each layer catches the errors of the layer below and raises its own, with the original as the cause: a repository turns a driver error into a persistence error, the domain turns that into a domain error, the API maps domain errors to responses. Pick it when the domain must not depend on the drivers' error types, or when a layer is reused behind several edges (HTTP, messaging, batch)."
          }
        ]
      },
      {
        "key": "LOGS",
        "title": "Log shape",
        "label": "How is a log line shaped?",
        "hint": "A line is read by machines first: parsed, indexed, counted, searched by request id. Fields it does not have cannot be searched. The Observability pack takes this shape as given.",
        "defaultValue": "structured",
        "options": [
          {
            "value": "structured",
            "label": "structured JSON lines",
            "description": "One JSON object per line with a fixed set of fields (timestamp, level as a word, message, service, the correlation id, and an error object with type, message and stack), written by pino, structlog, Serilog, zap or a JSON encoder for logback. Pick it for anything that runs as a service and whose logs are shipped and searched."
          },
          {
            "value": "text",
            "label": "fixed-layout text lines",
            "description": "One human-readable line per event in a fixed layout (time, level, correlation id in brackets, message, key=value fields), parsed with one regular expression. Pick it for CLIs, build tools and small utilities whose logs are read by a person on a terminal, not indexed."
          }
        ]
      },
      {
        "key": "REDACTION",
        "title": "Redaction",
        "label": "How are secrets and personal data kept out of logs?",
        "hint": "Redaction by hand at each call fails the first time someone logs an object whole; it has to live in the logger. The Observability pack takes this as given.",
        "defaultValue": "denylist",
        "options": [
          {
            "value": "allowlist",
            "label": "an allow-list of logged fields",
            "description": "The logger drops every field that is not on its list and every object goes through a serializer that picks the fields allowed for its type; nothing is ever logged whole. Pick it when logs leave the organisation (a SaaS log backend), when the data is regulated (health, payments), or after one leak too many."
          },
          {
            "value": "denylist",
            "label": "a deny-list of redacted paths",
            "description": "The logger redacts known secret and personal-data fields by path (password, token, authorization, cookie, e-mail, IBAN) wherever they appear, and everything else is allowed. Pick it as the baseline for an internal log store, where a new field is more often useful than dangerous."
          }
        ]
      },
      {
        "key": "CALLER",
        "title": "What a caller sees",
        "label": "What does an error look like to a caller?",
        "hint": "A client acts on what it is given: a stable code it can key on, a message it may show, and never a stack trace to learn from.",
        "defaultValue": "problem-details",
        "options": [
          {
            "value": "problem-details",
            "label": "RFC 9457 problem details",
            "description": "Every error response is application/problem+json with type (a URI that documents the error), title, status, detail, instance, a stable code and the correlation id; no stack traces in production. Pick it for any HTTP API with more than one client or a public one. How the shape evolves across API versions is the API evolution concern's decision."
          },
          {
            "value": "minimal",
            "label": "status, code and message",
            "description": "An error response is the HTTP status plus a JSON body with a stable code, a message and the correlation id, nothing more. Pick it for an internal API with one client owned by the same team, or a non-HTTP edge (queue, CLI) where problem details do not apply."
          }
        ]
      },
      {
        "key": "BASE_ERROR",
        "label": "Name of the base error class or error type",
        "defaultValue": "AppError"
      },
      {
        "key": "CORRELATION_FIELD",
        "label": "Name of the correlation field in every log line and error response",
        "defaultValue": "traceId"
      },
      {
        "key": "LEVELS",
        "label": "Log levels in use, highest first (comma-separated, lower case)",
        "defaultValue": "error, warn, info, debug"
      },
      {
        "key": "REDACTED_FIELDS",
        "label": "Fields that must never appear in a log line (comma-separated)",
        "defaultValue": "password, token, authorization, cookie, email, iban"
      },
      {
        "key": "MAX_MESSAGE_CHARS",
        "label": "Longest allowed log message (characters); the rest goes in fields",
        "defaultValue": "200",
        "type": "number"
      }
    ]
  },
  "nodes": [
    {
      "id": "need",
      "type": "need",
      "label": "Failures explained, not leaked",
      "x": 0,
      "y": 0,
      "kind": "brief",
      "source": "Hub concern pack: Error handling and logging conventions",
      "description": "When something goes wrong in the element, the person investigating must find every line about that request by one id, see the first cause rather than the last symptom, and tell a bug from an expected refusal at a glance. The caller must get an answer it can act on, with nothing in it about how the element is built. Nobody reading the logs, inside or outside the team, may learn a password, a token or a customer's personal data from them. All of this must hold in code written by many people, so a tool must hold it."
    },
    {
      "id": "req-no-swallow",
      "type": "requirement",
      "label": "No error swallowed",
      "x": 260,
      "y": 0,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "code catches an error it cannot recover from",
      "action": "rethrow or return it to the caller with the original attached as the cause, so that 0 catch blocks are empty and 0 catch blocks consist of a log call alone",
      "rationale": "A swallowed error turns a failure into a wrong result that surfaces later, somewhere else, with no trace back to the cause (Microsoft, Best practices for exceptions: do not catch what you cannot handle; Duffy, The Error Model)."
    },
    {
      "id": "req-cause",
      "type": "requirement",
      "label": "Errors carry their cause",
      "x": 260,
      "y": 130,
      "ears_type": "event-driven",
      "trigger": "an error is wrapped in another error",
      "action": "attach the original as the cause (Error.cause, inner exception, __cause__ via raise from, source() in Rust, %w in Go) so that the whole chain and the first stack trace are kept and logged",
      "rationale": "The last error says what failed for the caller; the first says why; a wrap that drops the original leaves the investigator with the symptom only (Microsoft, Best practices for exceptions: inner exceptions; ISO 25010 analysability)."
    },
    {
      "id": "req-hierarchy",
      "type": "requirement",
      "label": "Expected failures typed",
      "x": 260,
      "y": 260,
      "ears_type": "ubiquitous",
      "action": "raise every expected failure as a subclass of {{BASE_ERROR}} that names the case (not found, validation, conflict, upstream unavailable) and carries a stable code, keep the hierarchy under ten classes, throw only Error instances, and let unexpected errors propagate untouched to the boundary",
      "rationale": "A small hierarchy lets the boundary map the expected cases without a chain of string matches, and treats what is not in it as a bug (Microsoft, Best practices for exceptions: derive from Exception, use the predefined types; Fowler, Notification: exceptions for the unexpected).",
      "hubWhen": {
        "STYLE": [
          "exceptions"
        ]
      }
    },
    {
      "id": "req-result",
      "type": "requirement",
      "label": "Expected failures returned",
      "x": 260,
      "y": 390,
      "ears_type": "ubiquitous",
      "action": "return every expected failure as a Result (or Either, or an error value) in the function's signature, with an error type that names the case and carries a stable code, treat an ignored Result as a build error, and reserve exceptions or panics for bugs and broken invariants",
      "rationale": "With the failure in the signature the compiler, not the reviewer, finds the caller who forgot it; exceptions stay for what no caller can handle (Rust book, chapter 9: recoverable errors with Result; Duffy, The Error Model).",
      "hubWhen": {
        "STYLE": [
          "result"
        ]
      }
    },
    {
      "id": "req-codes",
      "type": "requirement",
      "label": "Errors come from the catalogue",
      "x": 260,
      "y": 520,
      "ears_type": "ubiquitous",
      "action": "signal every error with a code from the one catalogue in the repository (code, status, message template), 0 codes invented at a call site, and never remove or rename a code once released (a code can only be added or deprecated)",
      "rationale": "Clients key on codes; a code that changes meaning or vanishes breaks them silently, and a code made up inline is one the catalogue cannot document (RFC 9457, section 4.2: extension members for stable codes; OWASP Error Handling Cheat Sheet).",
      "hubWhen": {
        "STYLE": [
          "codes"
        ]
      }
    },
    {
      "id": "req-edge",
      "type": "requirement",
      "label": "Handled once at the edge",
      "x": 260,
      "y": 650,
      "ears_type": "event-driven",
      "trigger": "an error reaches the edge of the element (HTTP handler, queue consumer, CLI main, scheduled job)",
      "action": "map it in the one error handler to the response shape, log it exactly once with its cause chain and the {{CORRELATION_FIELD}}, and answer; no other code in the element imports the response mapping or an HTTP framework",
      "rationale": "One handler means one place where a mapping is right or wrong, and one log line per failure; inner code that knows status codes cannot be reused behind another edge (OWASP Error Handling Cheat Sheet: global handler; Fowler, Notification).",
      "hubWhen": {
        "BOUNDARY": [
          "edge"
        ]
      }
    },
    {
      "id": "req-layered",
      "type": "requirement",
      "label": "Each layer owns its errors",
      "x": 260,
      "y": 780,
      "ears_type": "ubiquitous",
      "action": "translate the errors of the layer below into its own error types at every layer boundary (driver error → persistence error → domain error → API response), with the original as the cause, so that 0 driver or framework error types cross into the domain or application layer",
      "rationale": "A domain that catches a vendor's exception is coupled to that vendor; translation at each boundary keeps a layer's callers free of its dependencies' types while the cause chain keeps the detail (Microsoft, Best practices for exceptions: wrapping; Duffy, The Error Model).",
      "hubWhen": {
        "BOUNDARY": [
          "layered"
        ]
      }
    },
    {
      "id": "req-log-once",
      "type": "requirement",
      "label": "Each error logged once",
      "x": 260,
      "y": 910,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "an error is caught by a layer that rethrows it",
      "action": "pass it on without logging it there, so that 0 catch blocks both log and rethrow, and one failure produces exactly 1 error-level log line, written where the error is finally handled",
      "rationale": "An error logged at every layer on its way up is five lines, five alerts and one event; the one line at the handler has the full cause chain anyway (Sonar rule S2139; OWASP Logging Cheat Sheet)."
    },
    {
      "id": "req-correlation",
      "type": "requirement",
      "label": "Every line carries the request id",
      "x": 260,
      "y": 1040,
      "ears_type": "ubiquitous",
      "action": "put the {{CORRELATION_FIELD}} of the current request, message or job in every log line, taken from the incoming trace context or request id or created at the edge, through the logger's context (async-local storage, MDC, contextvars), never by hand at each call",
      "rationale": "The id is how one request's lines are found among millions and joined across elements; a line without it is noise at the moment it is needed (OWASP Logging Cheat Sheet: event attributes; The Twelve-Factor App, XI)."
    },
    {
      "id": "req-structured",
      "type": "requirement",
      "label": "Lines are JSON with fixed fields",
      "x": 260,
      "y": 1170,
      "ears_type": "ubiquitous",
      "action": "write every log line as one JSON object on standard output through the one configured logger (never console or print), with the fields timestamp, level (as a word from {{LEVELS}}), message, service, {{CORRELATION_FIELD}} and, for errors, an error object with type, message, stack and cause; the message is a constant phrase of at most {{MAX_MESSAGE_CHARS}} characters and variable data goes in fields",
      "rationale": "A fixed shape is parsed, indexed and counted without regular expressions, and a constant message groups one event across millions of lines (The Twelve-Factor App, XI; structlog and pino documentation).",
      "hubWhen": {
        "LOGS": [
          "structured"
        ]
      }
    },
    {
      "id": "req-text",
      "type": "requirement",
      "label": "Lines follow one layout",
      "x": 260,
      "y": 1300,
      "ears_type": "ubiquitous",
      "action": "write every log line through the one configured logger (never console or print) in the layout \"ISO-8601 time, LEVEL in upper case, [{{CORRELATION_FIELD}}], message, key=value fields\", one event per line with the message at most {{MAX_MESSAGE_CHARS}} characters and stack traces indented on the following lines",
      "rationale": "A fixed layout is readable on a terminal and still parsed by one regular expression when it has to be; free-form lines are neither (OWASP Logging Cheat Sheet: event format).",
      "hubWhen": {
        "LOGS": [
          "text"
        ]
      }
    },
    {
      "id": "req-no-secrets",
      "type": "requirement",
      "label": "No secrets or personal data logged",
      "x": 260,
      "y": 1430,
      "ears_type": "ubiquitous",
      "action": "keep {{REDACTED_FIELDS}} and every other secret, credential and personal-data value out of log lines by {{REDACTION}} configured in the logger itself, with 0 log calls that pass a whole request, response, headers or body object",
      "rationale": "Logs are read by more people and tools than the database and copied to places with weaker access; a secret or personal datum in them is a breach, and redaction done by hand at each call fails on the first whole object logged (OWASP Logging Cheat Sheet: data to exclude; OWASP Top 10 A09; pino, Redaction)."
    },
    {
      "id": "req-problem-details",
      "type": "requirement",
      "label": "Callers get problem details, never a stack",
      "x": 260,
      "y": 1560,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "an error reaches a caller in production",
      "action": "answer with application/problem+json holding type (a URI that documents the error), title, status, detail, instance, a stable code and the {{CORRELATION_FIELD}}, and never a stack trace, exception class name, SQL, file path or internal host name; for an unexpected error the detail is generic and the status 500",
      "rationale": "A documented shape lets clients act on the code and show the detail, and the correlation id lets support find the lines; a stack trace tells an attacker the framework and the file layout (RFC 9457; OWASP Error Handling Cheat Sheet; OWASP Top 10 A09).",
      "hubWhen": {
        "CALLER": [
          "problem-details"
        ]
      }
    },
    {
      "id": "req-minimal",
      "type": "requirement",
      "label": "Callers get status, code and message, never a stack",
      "x": 260,
      "y": 1690,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "an error reaches a caller in production",
      "action": "answer with the HTTP status (or exit status at a CLI, or a dead-letter reason at a queue) and a body holding only a stable code, a message and the {{CORRELATION_FIELD}}, never a stack trace, exception class name, SQL, file path or internal host name; for an unexpected error the message is generic",
      "rationale": "A client needs a code to key on and an id to quote to support; everything else in an error body is attack surface (OWASP Error Handling Cheat Sheet; OWASP Top 10 A09).",
      "hubWhen": {
        "CALLER": [
          "minimal"
        ]
      }
    },
    {
      "id": "req-levels",
      "type": "requirement",
      "label": "Levels mean something",
      "x": 260,
      "y": 1820,
      "ears_type": "ubiquitous",
      "action": "use the levels {{LEVELS}} by meaning: error only for a failure that lost work or needs a person to act, warn for a failure handled or degraded, info for business events and lifecycle, debug for diagnosis and off in production; a request answered with a 4xx status is logged at warn or info, never error",
      "rationale": "Alerts and dashboards count by level; a 404 logged at error buries the real failures and teaches everyone to ignore the level (Google SRE book, chapter 6: as simple as possible, no simpler; OWASP Logging Cheat Sheet)."
    },
    {
      "id": "sc-no-swallow",
      "type": "scenario",
      "label": "Swallowing refused",
      "x": 520,
      "y": 0,
      "given": "a change that adds an empty catch block and one that adds a catch block holding only a log call",
      "when": "the linters run on the pull request",
      "then": "each fails naming its block, and the change is not merged until the error is rethrown, returned or handled with a stated recovery"
    },
    {
      "id": "sc-cause",
      "type": "scenario",
      "label": "Dropped cause refused",
      "x": 520,
      "y": 130,
      "given": "a catch block that throws a new error without passing the caught one as its cause",
      "when": "the linter runs on the pull request",
      "then": "it fails naming the throw (preserve-caught-error in TypeScript, B904 in Python, S1166 on the JVM)"
    },
    {
      "id": "sc-hierarchy",
      "type": "scenario",
      "label": "Hierarchy holds",
      "x": 520,
      "y": 260,
      "given": "the error classes exported from src/errors",
      "when": "the hierarchy test runs",
      "then": "every class extends {{BASE_ERROR}} and carries a non-empty code, there are at most ten of them, and a thrown non-Error anywhere in src fails the lint",
      "hubWhen": {
        "STYLE": [
          "exceptions"
        ]
      }
    },
    {
      "id": "sc-result",
      "type": "scenario",
      "label": "Ignored result refused",
      "x": 520,
      "y": 390,
      "given": "a call to a function returning a Result whose value is never matched or unwrapped",
      "when": "the build runs",
      "then": "it fails naming the call; once the error branch is handled or returned, it passes",
      "hubWhen": {
        "STYLE": [
          "result"
        ]
      }
    },
    {
      "id": "sc-codes",
      "type": "scenario",
      "label": "Unknown code refused",
      "x": 520,
      "y": 520,
      "given": "a change that returns a code that is not in the catalogue",
      "when": "the catalogue test runs",
      "then": "it fails naming the code; a change that renames an existing code fails the catalogue snapshot",
      "hubWhen": {
        "STYLE": [
          "codes"
        ]
      }
    },
    {
      "id": "sc-edge",
      "type": "scenario",
      "label": "Only the edge maps",
      "x": 520,
      "y": 650,
      "given": "a module outside src/http that imports the error handler, and a domain module that imports the HTTP framework",
      "when": "the dependency rules run",
      "then": "both fail the build naming the module and the import",
      "hubWhen": {
        "BOUNDARY": [
          "edge"
        ]
      }
    },
    {
      "id": "sc-layered",
      "type": "scenario",
      "label": "Driver error stays below",
      "x": 520,
      "y": 780,
      "given": "a domain class that depends on a driver exception type, and a persistence adapter method that declares one",
      "when": "the architecture test runs",
      "then": "it fails naming both; a domain exception that does not extend {{BASE_ERROR}} fails it too",
      "hubWhen": {
        "BOUNDARY": [
          "layered"
        ]
      }
    },
    {
      "id": "sc-log-once",
      "type": "scenario",
      "label": "Log-and-rethrow refused",
      "x": 520,
      "y": 910,
      "given": "a catch block that logs the error and throws it on",
      "when": "the Semgrep rules run on the pull request",
      "then": "it fails naming the block (S2139 on the JVM)"
    },
    {
      "id": "sc-correlation",
      "type": "scenario",
      "label": "Every line correlated",
      "x": 520,
      "y": 1040,
      "given": "the log output of a full test run",
      "when": "each line is read",
      "then": "every line carries a {{CORRELATION_FIELD}} of 16 to 36 hex characters (dashes allowed); one without fails the test"
    },
    {
      "id": "sc-structured",
      "type": "scenario",
      "label": "Every line parses",
      "x": 520,
      "y": 1170,
      "given": "the log output of a full test run",
      "when": "each line is parsed as JSON",
      "then": "every line parses, has a level from {{LEVELS}}, the {{CORRELATION_FIELD}} and a message of at most {{MAX_MESSAGE_CHARS}} characters",
      "hubWhen": {
        "LOGS": [
          "structured"
        ]
      }
    },
    {
      "id": "sc-text",
      "type": "scenario",
      "label": "Every line matches",
      "x": 520,
      "y": 1300,
      "given": "the log output of a full test run",
      "when": "each line is matched against the layout",
      "then": "every line matches, with a level from {{LEVELS}} in upper case and the {{CORRELATION_FIELD}} in brackets",
      "hubWhen": {
        "LOGS": [
          "text"
        ]
      }
    },
    {
      "id": "sc-no-secrets",
