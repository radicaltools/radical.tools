{
  "hub": {
    "id": "concern-backend-stack",
    "category": "concern",
    "name": "Backend stack",
    "description": "The language, runtime and framework a server-side service is built on, why, the version policy that keeps it on supported releases, and the footprint it is held to when performance decides.",
    "tags": [
      "technology",
      "backend",
      "runtime",
      "language",
      "framework",
      "end of life",
      "version policy",
      "footprint"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "concern": {
      "id": "backend-stack",
      "trigger": "LIST NODES WHERE type = \"container\" AND external != true",
      "why": "these are server-side services, so what they are built on and how they are kept on supported versions has to be decided.",
      "group": "technology"
    },
    "sources": [
      {
        "title": "endoflife.date: end-of-life dates and support lifecycles",
        "url": "https://endoflife.date/"
      },
      {
        "title": "Thoughtworks Technology Radar",
        "url": "https://www.thoughtworks.com/radar"
      },
      {
        "title": "ISO/IEC 25010, Maintainability, Flexibility and Performance efficiency",
        "url": "https://iso25000.com/index.php/en/iso-25000-standards/iso-25010"
      },
      {
        "title": "OpenSSF Scorecard",
        "url": "https://github.com/ossf/scorecard"
      },
      {
        "title": "deps.dev API v3 (Open Source Insights)",
        "url": "https://docs.deps.dev/api/v3/"
      },
      {
        "title": "OWASP Top 10 2021, A06 Vulnerable and Outdated Components",
        "url": "https://owasp.org/Top10/A06_2021-Vulnerable_and_Outdated_Components/"
      },
      {
        "title": "Ford, Parsons, Kua, Sadalage: Building Evolutionary Architectures, 2nd ed.",
        "url": "https://www.oreilly.com/library/view/building-evolutionary-architectures/9781492097532/"
      }
    ],
    "templateParams": [
      {
        "key": "RUNTIME",
        "title": "Runtime",
        "label": "What is the service built on?",
        "hint": "The runtime brings the language, the framework, the libraries and the people who can work on it. Changing it later means rewriting the service.",
        "defaultValue": "jvm",
        "options": [
          {
            "value": "jvm",
            "label": "the JVM (Java or Kotlin, Spring Boot)",
            "description": "Mature, fast after warm-up, the widest choice of enterprise libraries and drivers. Pick it for long-lived business services, when the team knows Java or Kotlin, or integrations need JVM-only SDKs."
          },
          {
            "value": "dotnet",
            "label": ".NET (C#, ASP.NET Core)",
            "description": "Fast, one vendor-backed stack from language to web framework and ORM. Pick it when the team knows C#, the organisation runs Microsoft tooling or Azure, or desktop and server share code."
          },
          {
            "value": "node",
            "label": "Node.js (TypeScript, NestJS or Fastify)",
            "description": "One language with the web front end, quick to start, very large package ecosystem. Pick it for web back ends, BFFs and I/O-bound APIs, when the team writes TypeScript in the front end too."
          },
          {
            "value": "go",
            "label": "Go",
            "description": "Small static binaries, fast start-up, low memory, simple concurrency. Pick it for infrastructure-like services, high-throughput network services and CLIs, when a small standard library is enough. Go has no LTS releases: not with the LTS-only version policy."
          },
          {
            "value": "python",
            "label": "Python (FastAPI or Django)",
            "description": "The data and machine-learning ecosystem, quick to write. Pick it when the service serves models or data pipelines, or the team are data people; CPU-heavy request handling is not its strength. Python has no LTS releases: not with the LTS-only version policy."
          }
        ]
      },
      {
        "key": "CRITERION",
        "title": "Deciding factor",
        "label": "What weighs most in the choice?",
        "hint": "Every stack can do most things; the criterion that decides adds the requirement that keeps the choice honest.",
        "defaultValue": "skills",
        "options": [
          {
            "value": "skills",
            "label": "the team's skills",
            "description": "The team already knows the stack well. Pick it in most cases: a known stack is faster and safer than a better one nobody knows."
          },
          {
            "value": "ecosystem",
            "label": "the ecosystem",
            "description": "The libraries, SDKs and drivers the service needs exist and are maintained in this stack. Pick it when integrations (a payment SDK, a data or ML library) decide what is practical."
          },
          {
            "value": "performance",
            "label": "performance",
            "description": "Memory and start-up time drive cost or scaling. Pick it only when load or cost figures show it matters, and hold the stack to the footprint numbers asked below."
          }
        ]
      },
      {
        "key": "UPGRADE",
        "title": "Version policy",
        "label": "Which versions of the runtime and framework may run?",
        "hint": "Unsupported versions get no security fixes; versions far behind make each upgrade a project. Go and Python have no LTS releases: with them, pick the latest or the previous major.",
        "defaultValue": "lts",
        "options": [
          {
            "value": "lts",
            "label": "supported LTS releases only",
            "description": "Only long-term-support releases, each new LTS adopted within 6 months. Pick it for business systems that value stability and upgrade a few times a year. Not with Go or Python, which have no LTS releases."
          },
          {
            "value": "n1",
            "label": "the latest or the previous major",
            "description": "Never more than one release cycle behind the latest, LTS or not. Pick it when the stack has no LTS for what you use (Go, Python, most frameworks) or you want new features sooner."
          },
          {
            "value": "latest",
            "label": "the latest release within 30 days",
            "description": "Each new release cycle of the runtime and framework is adopted within 30 days. Pick it for small services with a strong test suite and automated updates."
          }
        ]
      },
      {
        "key": "EOL_DAYS",
        "label": "How many days before end of support must a version be replaced?",
        "defaultValue": "180",
        "type": "number"
      },
      {
        "key": "MEMORY_MB",
        "label": "How much memory may one instance use at peak (MB)? Held to when performance is the deciding factor",
        "defaultValue": "512",
        "type": "number"
      },
      {
        "key": "STARTUP_SECONDS",
        "label": "Within how many seconds must a new instance be ready for traffic? Held to when performance is the deciding factor",
        "defaultValue": "10",
        "type": "number"
      }
    ]
  },
  "nodes": [
    {
      "id": "need",
      "type": "need",
      "label": "Services built to last",
      "x": 0,
      "y": 0,
      "kind": "brief",
      "source": "Hub concern pack: Backend stack",
      "description": "The service has to be built on a language, runtime and framework the team can work in well, that have the libraries it needs, that fit the footprint the hosting pays for, and that keep receiving security fixes for as long as the service runs. The choice must be written down with its reasons, and keeping it current must be routine work, not a project every few years. The checks assume one service per repository, with its Dockerfile and build manifest at the root, a versions.txt listing the endoflife.date products and cycles in use, and team.txt with the owning team's e-mail addresses next to CODEOWNERS."
    },
    {
      "id": "req-one-stack",
      "type": "requirement",
      "label": "Built on the chosen stack",
      "x": 260,
      "y": 0,
      "ears_type": "ubiquitous",
      "action": "build the service on {{RUNTIME}}, using another runtime or main framework only after a new decision record supersedes this one",
      "rationale": "Each extra stack multiplies the skills, pipelines, base images and patching a team must keep up (Thoughtworks Technology Radar on polyglot sprawl; ISO 25010 maintainability)."
    },
    {
      "id": "req-eol",
      "type": "requirement",
      "label": "Supported versions only",
      "x": 260,
      "y": 130,
      "ears_type": "ubiquitous",
      "action": "run only runtime, framework and base image versions under vendor support, replacing each at least {{EOL_DAYS}} days before its end of support",
      "rationale": "After end of support no security fixes come; the lead time leaves room to upgrade without a rush (endoflife.date; OWASP Top 10 A06 Vulnerable and Outdated Components)."
    },
    {
      "id": "req-lts",
      "type": "requirement",
      "label": "New LTS adopted",
      "x": 260,
      "y": 260,
      "ears_type": "event-driven",
      "trigger": "a new long-term-support release of the runtime or main framework is published",
      "action": "move the service to it within 6 months, and run no non-LTS release in production",
      "rationale": "Moving from one LTS to the next while the old one is supported keeps every upgrade one step long (endoflife.date support lifecycles).",
      "hubWhen": {
        "UPGRADE": [
          "lts"
        ]
      }
    },
    {
      "id": "req-n1",
      "type": "requirement",
      "label": "At most one release behind",
      "x": 260,
      "y": 390,
      "ears_type": "ubiquitous",
      "action": "run the latest or the previous release cycle of the runtime and the main framework, never older",
      "rationale": "Most projects support only the last one or two release cycles (Go: the two latest releases); staying within them keeps fixes coming and upgrades short (endoflife.date).",
      "hubWhen": {
        "UPGRADE": [
          "n1"
        ]
      }
    },
    {
      "id": "req-latest",
      "type": "requirement",
      "label": "Latest release adopted",
      "x": 260,
      "y": 520,
      "ears_type": "event-driven",
      "trigger": "a new release cycle of the runtime or main framework is published",
      "action": "move the service to it within 30 days",
      "rationale": "Small, frequent upgrades are cheaper than large rare ones, and new security hardening arrives sooner (Building Evolutionary Architectures, incremental change).",
      "hubWhen": {
        "UPGRADE": [
          "latest"
        ]
      }
    },
    {
      "id": "req-skills",
      "type": "requirement",
      "label": "Enough people know it",
      "x": 260,
      "y": 650,
      "ears_type": "ubiquitous",
      "action": "keep at least two engineers in the owning team who have merged production changes to the service on {{RUNTIME}} in the last 12 months",
      "rationale": "A stack chosen for the team's skills is only as safe as the number of people who have them (bus factor).",
      "hubWhen": {
        "CRITERION": [
          "skills"
        ]
      }
    },
    {
      "id": "req-maintained",
      "type": "requirement",
      "label": "Dependencies are maintained",
      "x": 260,
      "y": 780,
      "ears_type": "event-driven",
      "trigger": "a change adds a direct dependency",
      "action": "accept it only when it had a release in the last 12 months and an OpenSSF Scorecard score of at least 5, or a reviewer records why it is still acceptable",
      "rationale": "An ecosystem is worth what its maintained libraries are worth; an abandoned dependency becomes your code to maintain (OpenSSF Scorecard: Maintained check; deps.dev).",
      "hubWhen": {
        "CRITERION": [
          "ecosystem"
        ]
      }
    },
    {
      "id": "req-footprint",
      "type": "requirement",
      "label": "Small and quick to start",
      "x": 260,
      "y": 910,
      "ears_type": "state-driven",
      "precondition": "the service runs under the load test decided in the Capacity and scaling pack",
      "action": "use at most {{MEMORY_MB}} MB of memory per instance, and have a new instance ready for traffic within {{STARTUP_SECONDS}} seconds of its start",
      "rationale": "A stack chosen for performance has to be held to the numbers that justified it: memory sets the cost per instance, start-up time how fast it scales out (ISO 25010 performance efficiency: resource utilisation).",
      "hubWhen": {
        "CRITERION": [
          "performance"
        ]
      }
    },
    {
      "id": "sc-one-stack",
      "type": "scenario",
      "label": "Other runtime refused",
      "x": 520,
      "y": 0,
      "given": "the service's build files and container images",
      "when": "a change brings a base image or a build manifest of another runtime",
      "then": "the stack check fails until the manifest is listed in .stack-exceptions with the decision record that allows it"
    },
    {
      "id": "sc-eol",
      "type": "scenario",
      "label": "End of support ahead",
      "x": 520,
      "y": 130,
      "given": "a runtime version whose end of support is less than {{EOL_DAYS}} days away",
      "when": "the version check runs",
      "then": "it fails naming the version and its end-of-support date"
    },
    {
      "id": "sc-lts",
      "type": "scenario",
      "label": "LTS upgrade on time",
      "x": 520,
      "y": 260,
      "given": "a new LTS release of the runtime",
      "when": "6 months have passed since its release",
      "then": "the service runs on it in production, and the version check fails otherwise",
      "hubWhen": {
        "UPGRADE": [
          "lts"
        ]
      }
    },
    {
      "id": "sc-n1",
      "type": "scenario",
      "label": "Two releases behind refused",
      "x": 520,
      "y": 390,
      "given": "a framework whose latest release cycle is N",
      "when": "the service still runs on N-2",
      "then": "the version check fails",
      "hubWhen": {
        "UPGRADE": [
          "n1"
        ]
      }
    },
    {
      "id": "sc-latest",
      "type": "scenario",
      "label": "Release adopted in 30 days",
      "x": 520,
      "y": 520,
      "given": "a new release cycle of the main framework",
      "when": "30 days have passed",
      "then": "the service runs on it in production, and the version check fails otherwise",
      "hubWhen": {
        "UPGRADE": [
          "latest"
        ]
      }
    },
    {
      "id": "sc-skills",
      "type": "scenario",
      "label": "Two people can ship",
      "x": 520,
      "y": 650,
      "given": "the owning team's members and the service's history",
      "when": "the authors of the last 12 months are counted",
      "then": "at least two members of the team merged production changes to the service",
      "hubWhen": {
        "CRITERION": [
          "skills"
        ]
      }
    },
    {
      "id": "sc-maintained",
      "type": "scenario",
      "label": "Abandoned library flagged",
      "x": 520,
      "y": 780,
      "given": "a pull request adding a library without a release for two years",
      "when": "the dependency check runs",
      "then": "it fails and the pull request cannot merge without the dependency-exception label and the reviewer's reason",
      "hubWhen": {
        "CRITERION": [
          "ecosystem"
        ]
      }
    },
    {
      "id": "sc-footprint",
      "type": "scenario",
      "label": "Instance stays within footprint",
      "x": 520,
      "y": 910,
      "given": "a release candidate's image",
      "when": "one instance is started under a {{MEMORY_MB}} MB limit and the load test runs against it",
      "then": "it is ready within {{STARTUP_SECONDS}} seconds, is not killed for memory, and its peak memory stays under {{MEMORY_MB}} MB",
      "hubWhen": {
        "CRITERION": [
          "performance"
        ]
      }
    },
    {
      "id": "adr-jvm",
      "type": "adr",
      "label": "Built on the JVM",
      "x": 780,
      "y": 0,
      "concern": "backend-stack",
      "status": "accepted",
      "date": "",
      "context": "This element is a server-side service, and the runtime, language and main framework it is written in will outlive most of the people who chose them. The forces: the team's skills decide how fast and how safely it can work, and hiring follows the choice; the ecosystem decides which libraries, drivers and SDKs exist and are maintained; runtimes and frameworks reach end of support on published dates, after which security fixes stop; performance (memory, start-up time) matters where load or cost is high and rarely elsewhere; every dependency added is code someone else maintains, at their pace; and upgrades put off for years turn into rewrites.",
      "decision": "The service runs on the JVM: Java (or Kotlin where the team prefers it) on a JDK release the version policy allows, from a supported distribution (Eclipse Temurin, Amazon Corretto or Microsoft Build of OpenJDK), with Spring Boot as the framework, built with Gradle or Maven. Deciding factor: {{CRITERION}}. Version policy: {{UPGRADE}}; each version replaced at least {{EOL_DAYS}} days before its end of support, tracked through endoflife.date (eclipse-temurin, spring-boot). Footprint budget, held to when performance decides: at most {{MEMORY_MB}} MB per instance at peak, ready within {{STARTUP_SECONDS}} seconds. Dependency updates: as decided in the Dependency hygiene pack. Vulnerable dependencies: as decided in the Software supply chain pack. Latency and load: as decided in the Capacity and scaling pack. Choosing Java or Kotlin: Kotlin for null safety and concise domain code when the team knows it; Java when more people need to read it. Choosing Spring Boot or Quarkus: Spring Boot for the widest ecosystem; Quarkus (or Spring with GraalVM native image) when start-up time and memory matter, e.g. scale-to-zero.",
      "consequences": "• The widest choice of enterprise libraries, drivers and SDKs, and many people who know it.\n• Higher memory use and slower start than Go or .NET native AOT, unless native images are used.\n• Spring Boot's major versions follow the JDK baseline; framework and JDK upgrades are planned together.\n• A new JDK every six months and an LTS every two years: the version policy sets whether that is one upgrade a year or one every two.",
      "alternatives": "1. .NET: similar maturity and performance, a single vendor stack.\n2. Go: smaller and faster to start, fewer enterprise libraries.\n3. Node.js (TypeScript): one language with the front end, weaker for CPU-heavy work.",
      "hubWhen": {
        "RUNTIME": [
          "jvm"
        ]
      }
    },
    {
      "id": "adr-dotnet",
      "type": "adr",
      "label": "Built on .NET",
      "x": 780,
      "y": 130,
      "concern": "backend-stack",
      "status": "accepted",
      "date": "",
      "context": "This element is a server-side service, and the runtime, language and main framework it is written in will outlive most of the people who chose them. The forces: the team's skills decide how fast and how safely it can work, and hiring follows the choice; the ecosystem decides which libraries, drivers and SDKs exist and are maintained; runtimes and frameworks reach end of support on published dates, after which security fixes stop; performance (memory, start-up time) matters where load or cost is high and rarely elsewhere; every dependency added is code someone else maintains, at their pace; and upgrades put off for years turn into rewrites.",
      "decision": "The service runs on .NET with C#, on a release the version policy allows (an LTS every two years, supported three years; an STS in between, supported two), with ASP.NET Core (minimal APIs or controllers) and Entity Framework Core or Dapper for data access. Deciding factor: {{CRITERION}}. Version policy: {{UPGRADE}}; each version replaced at least {{EOL_DAYS}} days before its end of support, tracked through endoflife.date (dotnet). Footprint budget, held to when performance decides: at most {{MEMORY_MB}} MB per instance at peak, ready within {{STARTUP_SECONDS}} seconds. Dependency updates: as decided in the Dependency hygiene pack. Vulnerable dependencies: as decided in the Software supply chain pack. Latency and load: as decided in the Capacity and scaling pack. Choosing EF Core or Dapper: EF Core for domain models and migrations; Dapper where queries are hand-tuned. Native AOT only when start-up time matters and every library used supports trimming.",
      "consequences": "• One coherent stack (language, web framework, ORM, test tooling) maintained by one vendor, with good performance.\n• A release every November: the version policy decides whether every one is adopted or only the LTS ones, every two years.\n• Fewer open-source libraries than the JVM or Node.js for some niches.\n• Strong fit with Azure and Microsoft identity; runs equally on Linux containers.",
      "alternatives": "1. The JVM with Spring Boot: the widest ecosystem.\n2. Go: smaller and simpler, fewer abstractions.\n3. Node.js (TypeScript): shares the language with the front end.",
      "hubWhen": {
        "RUNTIME": [
          "dotnet"
        ]
      }
    },
    {
      "id": "adr-node",
      "type": "adr",
      "label": "Built on Node.js",
      "x": 780,
      "y": 260,
      "concern": "backend-stack",
      "status": "accepted",
      "date": "",
      "context": "This element is a server-side service, and the runtime, language and main framework it is written in will outlive most of the people who chose them. The forces: the team's skills decide how fast and how safely it can work, and hiring follows the choice; the ecosystem decides which libraries, drivers and SDKs exist and are maintained; runtimes and frameworks reach end of support on published dates, after which security fixes stop; performance (memory, start-up time) matters where load or cost is high and rarely elsewhere; every dependency added is code someone else maintains, at their pace; and upgrades put off for years turn into rewrites.",
      "decision": "The service runs on Node.js, on a release line the version policy allows (the even-numbered majors become LTS lines), written in TypeScript in strict mode, with Fastify or NestJS as the framework (Express only for small services). Deciding factor: {{CRITERION}}. Version policy: {{UPGRADE}}; the version is pinned in .nvmrc and the base image, replaced at least {{EOL_DAYS}} days before its end of support, tracked through endoflife.date (nodejs). Footprint budget, held to when performance decides: at most {{MEMORY_MB}} MB per instance at peak, ready within {{STARTUP_SECONDS}} seconds. Dependency updates: as decided in the Dependency hygiene pack. Vulnerable dependencies: as decided in the Software supply chain pack. Latency and load: as decided in the Capacity and scaling pack. Choosing Fastify or NestJS: Fastify for lean APIs and speed; NestJS when the team wants modules and dependency injection in a larger codebase.",
      "consequences": "• One language across the front end and back end; types can be shared through generated contracts.\n• Very large package ecosystem, of very uneven quality: dependencies need review and updates more often than elsewhere.\n• Single-threaded event loop: excellent for I/O-bound APIs, poor for CPU-heavy work, which goes to worker threads or another service.\n• A new major every six months and an LTS line every year, each supported about 30 months: the version policy sets the upgrade rhythm.",
      "alternatives": "1. Go: better for CPU-bound and high-throughput services, a separate language from the front end.\n2. The JVM or .NET: more structure and performance for large business domains.\n3. Deno or Bun: modern runtimes with built-in tooling, younger ecosystems and support policies.",
      "hubWhen": {
        "RUNTIME": [
          "node"
        ]
      }
    },
    {
      "id": "adr-go",
      "type": "adr",
      "label": "Built on Go",
      "x": 780,
      "y": 390,
      "concern": "backend-stack",
      "status": "accepted",
      "date": "",
      "context": "This element is a server-side service, and the runtime, language and main framework it is written in will outlive most of the people who chose them. The forces: the team's skills decide how fast and how safely it can work, and hiring follows the choice; the ecosystem decides which libraries, drivers and SDKs exist and are maintained; runtimes and frameworks reach end of support on published dates, after which security fixes stop; performance (memory, start-up time) matters where load or cost is high and rarely elsewhere; every dependency added is code someone else maintains, at their pace; and upgrades put off for years turn into rewrites.",
      "decision": "The service is written in Go, on a release the version policy allows (the Go team supports the two latest releases), using the standard library's net/http with a thin router (chi or the standard ServeMux) rather than a large framework, sqlc or pgx for data access, and distroless or scratch base images. Deciding factor: {{CRITERION}}. Version policy: {{UPGRADE}}; the toolchain is pinned in go.mod, replaced at least {{EOL_DAYS}} days before its end of support, tracked through endoflife.date (go). Footprint budget, held to when performance decides: at most {{MEMORY_MB}} MB per instance at peak, ready within {{STARTUP_SECONDS}} seconds. Dependency updates: as decided in the Dependency hygiene pack. Vulnerable dependencies: as decided in the Software supply chain pack. Latency and load: as decided in the Capacity and scaling pack.",
      "consequences": "• Small static binaries, start-up in milliseconds, low memory: cheap to run and to scale.\n• Each Go release is supported for about a year, so the toolchain is upgraded every six to twelve months; the Go 1 compatibility promise makes that routine.\n• Fewer high-level libraries (ORMs, enterprise SDKs); more code written by hand.\n• Simple language, fast to learn; less expressive for rich domain models.",
      "alternatives": "1. The JVM or .NET: richer frameworks for large business domains, heavier to run.\n2. Rust: more control and safety, slower to write and to learn.\n3. Node.js (TypeScript): one language with the front end, weaker under CPU load.",
      "hubWhen": {
        "RUNTIME": [
          "go"
        ]
      }
    },
    {
      "id": "adr-python",
      "type": "adr",
      "label": "Built on Python",
      "x": 780,
      "y": 520,
      "concern": "backend-stack",
      "status": "accepted",
      "date": "",
      "context": "This element is a server-side service, and the runtime, language and main framework it is written in will outlive most of the people who chose them. The forces: the team's skills decide how fast and how safely it can work, and hiring follows the choice; the ecosystem decides which libraries, drivers and SDKs exist and are maintained; runtimes and frameworks reach end of support on published dates, after which security fixes stop; performance (memory, start-up time) matters where load or cost is high and rarely elsewhere; every dependency added is code someone else maintains, at their pace; and upgrades put off for years turn into rewrites.",
      "decision": "The service is written in Python on a 3.x release the version policy allows (each supported five years, a new one every October), with FastAPI (async APIs, Pydantic models) or Django (data-heavy apps with an admin), type-checked with mypy or pyright and linted with Ruff, dependencies locked with uv or Poetry. Deciding factor: {{CRITERION}}. Version policy: {{UPGRADE}}; the version is pinned in pyproject.toml and the base image, replaced at least {{EOL_DAYS}} days before its end of support, tracked through endoflife.date (python, django). Footprint budget, held to when performance decides: at most {{MEMORY_MB}} MB per instance at peak, ready within {{STARTUP_SECONDS}} seconds. Dependency updates: as decided in the Dependency hygiene pack. Vulnerable dependencies: as decided in the Software supply chain pack. Latency and load: as decided in the Capacity and scaling pack. Choosing FastAPI or Django: FastAPI for APIs and model serving; Django when the service owns a relational data model and needs an admin and its migrations.",
      "consequences": "• Direct access to the data and machine-learning ecosystem (NumPy, pandas, PyTorch, scikit-learn).\n• Slower and more memory-hungry per request than the JVM, .NET or Go; CPU-heavy work goes to native libraries or worker processes.\n• Dynamic typing needs type checking in the build to keep a large codebase safe to change.\n• A new release every October, each supported five years: the version policy sets how many are skipped.",
      "alternatives": "1. Go or the JVM for the request-handling service, with Python only where models run.\n2. Node.js (TypeScript): faster for I/O-bound APIs, weaker data ecosystem.\n3. Notebooks deployed as services: quick, but neither testable nor maintainable.",
      "hubWhen": {
        "RUNTIME": [
          "python"
        ]
      }
    },
    {
      "id": "ff-only-jvm",
      "type": "fitness-fn",
      "label": "Only the JVM",
      "x": 1040,
      "y": 0,
      "category": "structural",
      "threshold": "100% of Dockerfiles end in a stage FROM a JVM image; 0 build manifests of another runtime outside .stack-exceptions",
      "description": "A job in every build reads the final stage of each Dockerfile (a stage alias is resolved to its image) and lists the build manifests in the repository; it fails on a final image that is not a JVM image or on a manifest of another runtime (*.csproj, *package.json, *go.mod, *pyproject.toml, *requirements.txt). A manifest a decision record allows is listed in .stack-exceptions with that record's id. Runs on Linux (git, awk, GNU grep).\n\nTool: git with awk and grep (CI job)\n\n```bash\n#!/usr/bin/env bash\n# Only the JVM: the final-stage base images and the build manifests of the repository\nset -euo pipefail\nAPPROVED='^(eclipse-temurin|amazoncorretto|mcr\\.microsoft\\.com/openjdk/jdk|gcr\\.io/distroless/java[0-9]*(-debian[0-9]+)?)(:|@|$)'\nFOREIGN=('*.csproj' '*package.json' '*go.mod' '*pyproject.toml' '*requirements.txt')\nfail=0\nfor df in $(git ls-files -- '*Dockerfile*'); do\n  final=$(awk 'toupper($1)==\"FROM\" { img=\"\"; for (i=2;i<=NF;i++) if ($i !~ /^--/) { img=$i; break }\n                                    if (img in alias) img=alias[img]\n                                    for (i=2;i<=NF;i++) if (toupper($i)==\"AS\") alias[$(i+1)]=img\n                                    final=img } END { print final }' \"$df\")\n  [[ \"$final\" =~ $APPROVED ]] || { echo \"::error file=$df::final stage FROM $final is not a JVM image (ADR Built on the JVM)\"; fail=1; }\ndone\nforeign=$(git ls-files -- \"${FOREIGN[@]}\" | grep -vxFf <(cat .stack-exceptions 2>/dev/null) || true)\n[ -z \"$foreign\" ] || { echo \"::error::build manifests of another runtime: $(tr '\\n' ' ' <<<\"$foreign\")\"; fail=1; }\nexit $fail\n```",
      "hubWhen": {
        "RUNTIME": [
          "jvm"
        ]
      }
    },
