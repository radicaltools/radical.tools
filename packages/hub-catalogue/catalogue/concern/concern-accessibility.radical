{
  "hub": {
    "id": "concern-accessibility",
    "category": "concern",
    "name": "Accessibility",
    "description": "Whether everyone can use the web front end, people with disabilities and assistive technology included: the WCAG level it conforms to, the law it answers to (European Accessibility Act, Web Accessibility Directive), how it is tested, the accessibility statement, and what a failure found does to a change.",
    "tags": [
      "ux",
      "accessibility",
      "wcag",
      "wcag 2.2",
      "en 301 549",
      "european accessibility act",
      "axe-core",
      "screen reader",
      "keyboard"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "concern": {
      "id": "accessibility",
      "trigger": "LIST RELATIONS WHERE source.type = \"person\" AND target.type = \"webapp\" AND target.external != true",
      "applyTo": "target",
      "why": "people use these web front ends, so the accessibility level they conform to, the law they answer to, and how that is tested and stated has to be decided.",
      "group": "ux"
    },
    "sources": [
      {
        "title": "W3C: Web Content Accessibility Guidelines (WCAG) 2.2",
        "url": "https://www.w3.org/TR/WCAG22/"
      },
      {
        "title": "ETSI EN 301 549 V3.2.1: Accessibility requirements for ICT products and services",
        "url": "https://www.etsi.org/deliver/etsi_en/301500_301599/301549/03.02.01_60/en_301549v030201p.pdf"
      },
      {
        "title": "Directive (EU) 2019/882, the European Accessibility Act",
        "url": "https://eur-lex.europa.eu/eli/dir/2019/882/oj"
      },
      {
        "title": "Directive (EU) 2016/2102, the Web Accessibility Directive",
        "url": "https://eur-lex.europa.eu/eli/dir/2016/2102/oj"
      },
      {
        "title": "Commission Implementing Decision (EU) 2018/1523, the model accessibility statement",
        "url": "https://eur-lex.europa.eu/eli/dec_impl/2018/1523/oj"
      },
      {
        "title": "W3C WAI: Developing an Accessibility Statement",
        "url": "https://www.w3.org/WAI/planning/statements/"
      },
      {
        "title": "W3C WAI: Evaluating Web Accessibility Overview",
        "url": "https://www.w3.org/WAI/test-evaluate/"
      },
      {
        "title": "W3C: Understanding SC 2.4.11 Focus Not Obscured (Minimum)",
        "url": "https://www.w3.org/WAI/WCAG22/Understanding/focus-not-obscured-minimum.html"
      },
      {
        "title": "axe-core: API, rule tags",
        "url": "https://github.com/dequelabs/axe-core/blob/develop/doc/API.md"
      },
      {
        "title": "@axe-core/playwright",
        "url": "https://github.com/dequelabs/axe-core-npm/tree/develop/packages/playwright"
      },
      {
        "title": "Playwright: Accessibility testing",
        "url": "https://playwright.dev/docs/accessibility-testing"
      }
    ],
    "templateParams": [
      {
        "key": "LEVEL",
        "title": "Conformance",
        "label": "Which level must the front end conform to?",
        "hint": "The level decides which success criteria apply and which automated rules run. EN 301 549, and through it the European Accessibility Act and the Web Accessibility Directive, rests on WCAG level AA.",
        "defaultValue": "wcag22aa",
        "options": [
          {
            "value": "wcag22aa",
            "label": "WCAG 2.2 level AA",
            "description": "The current W3C recommendation. It includes everything of 2.1 AA, so it also meets EN 301 549 V3.2.1, which points at 2.1 AA, and adds focus not obscured, dragging alternatives, consistent help and accessible authentication. Pick it for every new front end."
          },
          {
            "value": "aaa",
            "label": "WCAG 2.2 level AA, and level AAA where feasible",
            "description": "AA, plus the AAA criteria taken on one by one where the content allows (enhanced contrast of 7:1, link purpose from the link alone, no timing), with the automated AAA rules switched on. W3C does not advise AAA as a policy for whole sites. Pick it for services used mostly by older people or people with low vision or cognitive disabilities, or when a contract asks for it."
          },
          {
            "value": "wcag21aa",
            "label": "WCAG 2.1 level AA",
            "description": "The level EN 301 549 V3.2.1 names today, without the nine criteria 2.2 added. Pick it only for an existing front end being brought up to standard, with a dated plan to move to 2.2."
          }
        ]
      },
      {
        "key": "SCOPE",
        "title": "Legal frame",
        "label": "Which accessibility law does the front end answer to?",
        "hint": "The law decides who may enforce it, what must be published, and which exemptions exist. The level above is the technical answer to each of them.",
        "defaultValue": "eaa",
        "options": [
          {
            "value": "eaa",
            "label": "the European Accessibility Act",
            "description": "A consumer product or service offered in the EU (online shops, consumer banking, e-books, passenger transport, electronic communications), from 28 June 2025. Microenterprises that provide services are exempt. Pick it for anything sold or offered to consumers in the EU."
          },
          {
            "value": "public",
            "label": "the Web Accessibility Directive",
            "description": "A website or app of a public-sector body in the EU: national, regional and local authorities and bodies governed by public law. It requires a published accessibility statement with a feedback mechanism. Pick it for public services."
          },
          {
            "value": "internal",
            "label": "no accessibility law of its own (an internal tool)",
            "description": "A tool used only by the organisation's own staff. No product law applies, but employment equality law (Directive 2000/78/EC) asks for reasonable accommodation of employees with disabilities, and a tool that excludes them has to be replaced or worked around. Pick it for back-office and internal tools."
          }
        ]
      },
      {
        "key": "AT_TESTING",
        "title": "Assistive technology",
        "label": "Is the front end tested with assistive technology?",
        "hint": "Automated rules find only part of the failures: whether a screen reader announces a control sensibly, or a journey makes sense without sight, takes a person.",
        "defaultValue": "manual",
        "options": [
          {
            "value": "manual",
            "label": "a screen-reader pass before each release (NVDA and VoiceOver)",
            "description": "Before each release candidate is released, someone completes the main journeys with NVDA on Windows and VoiceOver on macOS and iOS and records the pass. Pick it for public services, consumer products, and anything with complex widgets (date pickers, comboboxes, drag and drop)."
          },
          {
            "value": "automated",
            "label": "automated checks only",
            "description": "axe-core and the keyboard walk on every pull request, and no screen-reader pass. Pick it for internal tools built entirely from a tested accessible component library, and record the risk."
          }
        ]
      },
      {
        "key": "STATEMENT",
        "title": "Statement",
        "label": "Is an accessibility statement published?",
        "hint": "A statement tells users how accessible the front end is, what is not and what to do instead, and how to report a problem. Public bodies must publish one; the European Accessibility Act asks service providers to make the same information available.",
        "defaultValue": "published",
        "options": [
          {
            "value": "published",
            "label": "an accessibility statement, published and kept current",
            "description": "A statement after the EU model, linked from every page's footer, reviewed at least once a year. Pick it always for the public sector, and for consumer services under the European Accessibility Act."
          },
          {
            "value": "none",
            "label": "no accessibility statement",
            "description": "Nothing is published. Pick it only for internal tools, where staff reach the team directly; not with the Web Accessibility Directive, which requires a statement."
          }
        ]
      },
      {
        "key": "FAILURES",
        "title": "Failures",
        "label": "What does a serious or critical violation found by the automated checks do?",
        "hint": "Blocking keeps the front end clean but can stop a release for a third-party widget; tracking lets work go on, and only works with a deadline someone checks.",
        "defaultValue": "blocking",
        "options": [
          {
            "value": "blocking",
            "label": "it blocks the change until it is fixed",
            "description": "A serious or critical violation fails the pull request; there is no list of accepted violations. Pick it for new front ends and wherever the components are your own."
          },
          {
            "value": "deadline",
            "label": "it is tracked and fixed within a set number of days",
            "description": "A violation that cannot be fixed in the change is listed with an issue and a due date within the days set below; the build fails on any violation not listed, and a nightly check fails once a due date has passed. Pick it for an existing front end being brought up to standard, or one with third-party widgets you cannot change at once."
          }
        ]
      },
      {
        "key": "FIX_DAYS",
        "label": "With tracking: within how many days must a tracked violation be fixed?",
        "defaultValue": "30",
        "type": "number"
      }
    ]
  },
  "nodes": [
    {
      "id": "need",
      "type": "need",
      "label": "Everyone can use it",
      "x": 0,
      "y": 0,
      "kind": "brief",
      "source": "Hub concern pack: Accessibility",
      "description": "People with disabilities use this front end with a keyboard, a screen reader, magnification or voice control, and the law may require that they can. Every function of the main journeys must work for them, to a WCAG level that is decided and checked on every change, with what automated checks cannot see tested by people, what is not yet accessible stated openly, and failures fixed on a schedule rather than when someone complains. The checks assume Playwright tests under tests/a11y with tests/a11y/pages.ts listing the pages of the main journeys (PAGES: path) and the states worth checking (STATES: a name, a path and, where needed, the steps that open a dialog, show a form's errors or empty a list); playwright.config sets the baseURL and, for pages behind sign-in, a storageState. Each test fails on its own in a plain run and, run by radical sense playwright, writes what it measured as a radical-metrics/1 file into RADICAL_METRICS_DIR."
    },
    {
      "id": "req-conformance",
      "type": "requirement",
      "label": "Conforms to the chosen WCAG level",
      "x": 260,
      "y": 0,
      "ears_type": "ubiquitous",
      "action": "conform to {{LEVEL}} on every page of the main journeys and in each of their states (open dialogs and menus, error messages, empty and loading states); a serious or critical violation found by the automated checks is handled as decided: {{FAILURES}}",
      "rationale": "WCAG level AA is what EN 301 549 requires and so what the European Accessibility Act and the Web Accessibility Directive presume conformity by (W3C WCAG 2.2; EN 301 549 clause 9). Dialogs and error states are where automated checks most often find failures, so they are checked as states, not only pages. Reflow and target size are decided and measured in the Mobile and perceived performance pack; link purpose, consistent navigation and how form errors are shown in the Usability pack."
    },
    {
      "id": "req-keyboard",
      "type": "requirement",
      "label": "Operable by keyboard alone",
      "x": 260,
      "y": 130,
      "ears_type": "ubiquitous",
      "action": "let every function of the main journeys be operated with the keyboard alone, with no keyboard trap, a visible focus indicator on every focused control, and no focused control entirely hidden by sticky headers, footers or other content",
      "rationale": "Keyboard access is what screen readers, switch access and voice control build on (WCAG 2.1.1 Keyboard, 2.1.2 No Keyboard Trap, 2.4.7 Focus Visible, 2.4.11 Focus Not Obscured (Minimum), new in 2.2). Automated rules cannot walk a journey, so a test does."
    },
    {
      "id": "req-at-manual",
      "type": "requirement",
      "label": "Screen-reader pass before release",
      "x": 260,
      "y": 260,
      "ears_type": "event-driven",
      "trigger": "a release candidate is built",
      "action": "complete the main journeys with NVDA and Firefox or Chrome on Windows and with VoiceOver and Safari on macOS and iOS, record the pass, and fix every blocker found before the candidate is released",
      "rationale": "Whether a control is announced with a sensible name, role and state, and whether a journey makes sense without sight, only a person with the assistive technology can tell (W3C WAI, Evaluating Web Accessibility). NVDA and VoiceOver with those browsers are the most used free combinations.",
      "hubWhen": {
        "AT_TESTING": [
          "manual"
        ]
      }
    },
    {
      "id": "req-statement",
      "type": "requirement",
      "label": "Accessibility statement published and current",
      "x": 260,
      "y": 390,
      "ears_type": "ubiquitous",
      "action": "publish an accessibility statement, linked from the footer of every page, that states the conformance status against {{LEVEL}}, the content that is not accessible with the reason and the alternative, how to report a problem or ask for content in another form, the enforcement procedure, and the date of its last review, reviewed at least once every 365 days",
      "rationale": "The Web Accessibility Directive (Article 7) requires a statement after the model of Implementing Decision (EU) 2018/1523, with a feedback mechanism and a link to the enforcement procedure; the European Accessibility Act (Annex V) asks service providers to make the same information available; a statement is only worth something while it is current (W3C WAI, Developing an Accessibility Statement).",
      "hubWhen": {
        "STATEMENT": [
          "published"
        ]
      }
    },
    {
      "id": "req-failures-blocking",
      "type": "requirement",
      "label": "Violations block the change",
      "x": 260,
      "y": 520,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a change brings a serious or critical violation found by the automated checks",
      "action": "refuse to merge the change until the violation is fixed, keeping no list of accepted violations",
      "rationale": "A violation fixed in the change that brought it costs minutes; one shipped is found by a user, or by an enforcement body (W3C WAI, Evaluating Web Accessibility).",
      "hubWhen": {
        "FAILURES": [
          "blocking"
        ]
      }
    },
    {
      "id": "req-failures-deadline",
      "type": "requirement",
      "label": "Violations fixed by a deadline",
      "x": 260,
      "y": 650,
      "ears_type": "event-driven",
      "trigger": "a serious or critical violation found by the automated checks cannot be fixed in the change that finds it",
      "action": "record it in tests/a11y/known.json with its rule, the state it appears in, an issue and a due date at most {{FIX_DAYS}} days after it was found, and fail the nightly check once the due date has passed",
      "rationale": "An existing front end or a third-party widget may not be fixable at once; a list with issues and due dates keeps the debt visible and bounded, and the statement can name it as content not yet accessible.",
      "hubWhen": {
        "FAILURES": [
          "deadline"
        ]
      }
    },
    {
      "id": "sc-conformance",
      "type": "scenario",
      "label": "Page passes accessibility checks",
      "x": 520,
      "y": 0,
      "given": "each page of the main journeys in each listed state",
      "when": "the automated checks run",
      "then": "no serious or critical violation is reported that is not handled as decided"
    },
    {
      "id": "sc-keyboard",
      "type": "scenario",
      "label": "Main journey by keyboard",
      "x": 520,
      "y": 130,
      "given": "the main journey",
      "when": "it is walked with Tab, Shift+Tab, Enter, Space and the arrow keys only",
      "then": "every step is reached and completed, and focus is visible and not hidden at every step"
    },
    {
      "id": "sc-at-manual",
      "type": "scenario",
      "label": "Journeys completed with screen readers",
      "x": 520,
      "y": 260,
      "given": "a release candidate",
      "when": "the main journeys are walked with NVDA on Windows and VoiceOver on macOS and iOS",
      "then": "the pass is recorded, and the candidate is released only with no open blocker",
      "hubWhen": {
        "AT_TESTING": [
          "manual"
        ]
      }
    },
    {
      "id": "sc-statement",
      "type": "scenario",
      "label": "Statement linked and current",
      "x": 520,
      "y": 390,
      "given": "the pages of the main journeys and the statement",
      "when": "the statement test runs",
      "then": "every page links the statement from its footer, the statement has each required section, and its last review is at most 365 days old",
      "hubWhen": {
        "STATEMENT": [
          "published"
        ]
      }
    },
    {
      "id": "sc-failures-blocking",
      "type": "scenario",
      "label": "Violation blocks the merge",
      "x": 520,
      "y": 520,
      "given": "a pull request that adds an image button without an accessible name",
      "when": "the automated checks run",
      "then": "the check fails, naming the state, the rule and the element, and the pull request cannot be merged",
      "hubWhen": {
        "FAILURES": [
          "blocking"
        ]
      }
    },
    {
      "id": "sc-failures-deadline",
      "type": "scenario",
      "label": "Overdue violation fails the night",
      "x": 520,
      "y": 650,
      "given": "a tracked violation whose due date has passed",
      "when": "the nightly check runs",
      "then": "it fails, naming the violation and its issue",
      "hubWhen": {
        "FAILURES": [
          "deadline"
        ]
      }
    },
    {
      "id": "adr-a11y-eaa",
      "type": "adr",
      "label": "Accessible under the European Accessibility Act",
      "x": 780,
      "y": 0,
      "concern": "accessibility",
      "status": "accepted",
      "date": "",
      "context": "People with disabilities use this web front end with a keyboard, a screen reader, magnification, voice control or switch access, and many more people with a temporary injury, a bright screen or an old phone. The forces: accessibility is a legal duty in the EU (the European Accessibility Act for consumer products and services from 28 June 2025, the Web Accessibility Directive for the public sector, both presuming conformity through EN 301 549 and so WCAG) and in many other markets; it is cheap when built into components and expensive when retrofitted page by page; automated checkers find only part of the failures, so keyboard walks and screen-reader passes are needed for the rest; a failure found late either blocks a release or is shipped with a promise, and promises without a date are forgotten; and an accessibility statement is required of public bodies and expected of everyone, and is only worth something while it is true.",
      "decision": "The front end is a consumer service under the European Accessibility Act (Directive (EU) 2019/882, applying from 28 June 2025) and conforms to {{LEVEL}}, the technical basis of EN 301 549, the harmonised standard that presumes conformity. Every page and state of the main journeys is checked by axe-core and walked with the keyboard on every pull request; assistive technology: {{AT_TESTING}}; a serious or critical violation found: {{FAILURES}}. Statement: {{STATEMENT}}; Annex V asks for the information on how the service meets the requirements in the terms and conditions or another public place, so the statement is the place it is kept. A claim that a requirement would be a disproportionate burden (Article 14) is assessed and documented before it is relied on, never assumed. Reflow and target size are decided and measured in the Mobile and perceived performance pack; link purpose, consistent navigation and how form errors are shown in the Usability pack.",
      "consequences": "• Market surveillance authorities can act on a complaint; the checks and the statement are the evidence of conformity.\n• Accessible components are built once in the design system and reused, which is where most of the cost goes.\n• Third-party widgets (payment, chat, maps) must meet the level too, so their accessibility is part of choosing them.\n• Content that is not yet accessible is stated, with an alternative, rather than hidden.",
      "alternatives": "1. Accessibility only where a complaint arrives: cheaper at first, and a legal risk from June 2025.\n2. An overlay widget that claims to fix accessibility at run time: does not make the front end conform, and is criticised by disabled users.\n3. A separate accessible version of the site: falls behind the main one and is not equal treatment.",
      "hubWhen": {
        "SCOPE": [
          "eaa"
        ]
      }
    },
    {
      "id": "adr-a11y-public",
      "type": "adr",
      "label": "Accessible under the Web Accessibility Directive",
      "x": 780,
      "y": 130,
      "concern": "accessibility",
      "status": "accepted",
      "date": "",
      "context": "People with disabilities use this web front end with a keyboard, a screen reader, magnification, voice control or switch access, and many more people with a temporary injury, a bright screen or an old phone. The forces: accessibility is a legal duty in the EU (the European Accessibility Act for consumer products and services from 28 June 2025, the Web Accessibility Directive for the public sector, both presuming conformity through EN 301 549 and so WCAG) and in many other markets; it is cheap when built into components and expensive when retrofitted page by page; automated checkers find only part of the failures, so keyboard walks and screen-reader passes are needed for the rest; a failure found late either blocks a release or is shipped with a promise, and promises without a date are forgotten; and an accessibility statement is required of public bodies and expected of everyone, and is only worth something while it is true.",
      "decision": "The front end belongs to a public-sector body under the Web Accessibility Directive (Directive (EU) 2016/2102) and conforms to {{LEVEL}}, the technical basis of EN 301 549. Every page and state of the main journeys is checked by axe-core and walked with the keyboard on every pull request; assistive technology: {{AT_TESTING}}; a serious or critical violation found: {{FAILURES}}. Statement: {{STATEMENT}}; the Directive (Article 7) requires one after the model of Implementing Decision (EU) 2018/1523, with a feedback mechanism people use to report problems and ask for content in another form, and a link to the enforcement procedure, so a statement is not optional here. Reflow and target size are decided and measured in the Mobile and perceived performance pack; link purpose, consistent navigation and how form errors are shown in the Usability pack.",
      "consequences": "• The national monitoring body checks samples of public sites and apps; the checks and the statement are what it reads.\n• The feedback mechanism needs someone who answers, with the response time the member state sets.\n• Content exempt under the Directive (older office files, third-party content not under the body's control) is listed in the statement, not left unsaid.",
      "alternatives": "1. Accessibility only where a complaint arrives: does not meet the Directive.\n2. An overlay widget: does not make the front end conform.\n3. A separate accessible version: falls behind and is not equal treatment.",
      "hubWhen": {
        "SCOPE": [
          "public"
        ]
      }
    },
    {
      "id": "adr-a11y-internal",
      "type": "adr",
      "label": "An internal tool usable by every employee",
      "x": 780,
      "y": 260,
      "concern": "accessibility",
      "status": "accepted",
      "date": "",
      "context": "People with disabilities use this web front end with a keyboard, a screen reader, magnification, voice control or switch access, and many more people with a temporary injury, a bright screen or an old phone. The forces: accessibility is a legal duty in the EU (the European Accessibility Act for consumer products and services from 28 June 2025, the Web Accessibility Directive for the public sector, both presuming conformity through EN 301 549 and so WCAG) and in many other markets; it is cheap when built into components and expensive when retrofitted page by page; automated checkers find only part of the failures, so keyboard walks and screen-reader passes are needed for the rest; a failure found late either blocks a release or is shipped with a promise, and promises without a date are forgotten; and an accessibility statement is required of public bodies and expected of everyone, and is only worth something while it is true.",
      "decision": "The front end is an internal tool, outside the European Accessibility Act and the Web Accessibility Directive, and still conforms to {{LEVEL}}: employment equality law (Directive 2000/78/EC, Article 5) asks for reasonable accommodation of employees with disabilities, and a tool that one employee cannot use has to be fixed or worked around at a worse moment. Every page and state of the main journeys is checked by axe-core and walked with the keyboard on every pull request; assistive technology: {{AT_TESTING}}; a serious or critical violation found: {{FAILURES}}. Statement: {{STATEMENT}}. Reflow and target size are decided and measured in the Mobile and perceived performance pack; link purpose, consistent navigation and how form errors are shown in the Usability pack.",
      "consequences": "• No regulator, but the same level: a new colleague with a disability can start on day one.\n• The same accessible components serve internal and public front ends alike.\n• Should the tool later be offered to customers, it is already at the level the Act asks for.",
      "alternatives": "1. Accessibility on request, when an employee needs it: a retrofit under time pressure, for one person who waits.\n2. A lower level (WCAG level A): fewer checks, and keyboard and contrast failures that affect many more people than screen-reader users.",
      "hubWhen": {
        "SCOPE": [
          "internal"
        ]
      }
    },
    {
      "id": "ff-axe-wcag22aa",
      "type": "fitness-fn",
      "label": "No accessibility violations",
      "x": 1040,
      "y": 0,
      "characteristic": "interaction-capability",
      "scope": "holistic",
      "cadence": "triggered",
      "trigger": "pull-request",
      "invocation": "automated",
      "description": "A Playwright test opens each page of the main journeys in each state that matters (STATES in tests/a11y/pages.ts: open dialogs and menus, a form showing its errors, an empty list) and runs axe-core on it with the rules of WCAG 2.2 level AA. It writes a11y.violations{impact=critical|serious|moderate|minor}, the elements found per impact and a11y.states, the states checked (a run that checked none measured nothing), and fails on any serious or critical violation, naming the state, rule and elements. The target-size rule is switched off: target size is decided and measured in the Mobile and perceived performance pack. Automated rules find only part of the failures; the keyboard walk and, where decided, the screen-reader pass cover more. Bind it with radical sense playwright tests/a11y/axe.spec.ts and the conditions a11y.violations{impact=critical} <= 0 and a11y.violations{impact=serious} <= 0.\n\nThreshold: a11y.violations{impact=critical} = 0 and a11y.violations{impact=serious} = 0 on every page and state of the main journeys, against the axe rules tagged wcag2a, wcag2aa, wcag21a, wcag21aa, wcag22aa\n\nTool: axe-core with Playwright (@axe-core/playwright 4.x, @playwright/test), measured by radical sense playwright\n\n```ts\n// tests/a11y/axe.spec.ts: a plain Playwright test (1.50 or later), or measured with\n//   radical sense playwright tests/a11y/axe.spec.ts\nimport { mkdirSync, writeFileSync } from 'node:fs'\nimport { join } from 'node:path'\nimport AxeBuilder from '@axe-core/playwright'\nimport { expect, test } from '@playwright/test'\nimport { STATES } from './pages'   // [{ name: 'checkout, address error', path: '/checkout', open: async (page) => { … } }, …]\n\nconst TAGS = ['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa', 'wcag22aa']   // WCAG 2.2 level AA\n\ntype Measurement = { metric: string; value: number; unit?: string; labels?: Record<string, string> }\n/** Writes what the test measured where radical sense playwright reads it; a plain run writes nothing. */\nfunction writeMetrics(file: string, measurements: Measurement[]): void {\n  const dir = process.env.RADICAL_METRICS_DIR\n  if (!dir) return\n  mkdirSync(dir, { recursive: true })\n  writeFileSync(join(dir, file), JSON.stringify({ format: 'radical-metrics', version: 1, source: file, at: new Date().toISOString(), measurements }, null, 1))\n}\n\ntest('the main journeys meet WCAG 2.2 level AA', async ({ page }) => {\n  const byImpact: Record<string, number> = { critical: 0, serious: 0, moderate: 0, minor: 0 }\n  const failing: string[] = []\n  for (const state of STATES) {\n    await page.goto(state.path)\n    await state.open?.(page)\n    const { violations } = await new AxeBuilder({ page })\n      .withTags(TAGS)\n      .disableRules(['target-size'])   // decided and measured in the Mobile and perceived performance pack\n      .analyze()\n    for (const v of violations) {\n      byImpact[v.impact ?? 'minor'] += v.nodes.length\n      if (v.impact !== 'serious' && v.impact !== 'critical') continue\n      failing.push(`${state.name}: ${v.id} (${v.impact}) at ${v.nodes.map((n) => n.target.join(' ')).join(', ')}`)\n    }\n  }\n  writeMetrics('axe.json', [\n    ...Object.entries(byImpact).map(([impact, value]) => ({ metric: 'a11y.violations', value, labels: { impact } })),\n    { metric: 'a11y.states', value: STATES.length },\n  ])\n  expect(failing, 'serious and critical violations').toEqual([])\n})\n```",
