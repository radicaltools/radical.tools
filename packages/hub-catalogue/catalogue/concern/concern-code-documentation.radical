{
  "hub": {
    "id": "concern-code-documentation",
    "category": "concern",
    "name": "Code documentation",
    "description": "What about the element is written down, where it lives and how it stays true: the decisions, the API reference, the README of each module, the documentation site, and the diagrams or the architecture model.",
    "tags": [
      "maintainability",
      "documentation",
      "adr",
      "docs as code",
      "api docs",
      "diagrams",
      "readme"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "concern": {
      "id": "code-documentation",
      "trigger": "LIST NODES WHERE (type = \"container\" OR type = \"webapp\") AND external != true",
      "why": "code lives in these elements, so what is written down about it, where, and how it is kept true has to be decided.",
      "group": "maintainability"
    },
    "sources": [
      {
        "title": "Michael Nygard: Documenting Architecture Decisions",
        "url": "https://cognitect.com/blog/2011/11/15/documenting-architecture-decisions"
      },
      {
        "title": "MADR: Markdown Any Decision Records",
        "url": "https://adr.github.io/madr/"
      },
      {
        "title": "Simon Brown: The C4 model for visualising software architecture",
        "url": "https://c4model.com/"
      },
      {
        "title": "Write the Docs: Docs as Code",
        "url": "https://www.writethedocs.org/guide/docs-as-code/"
      },
      {
        "title": "Diátaxis: a systematic approach to technical documentation",
        "url": "https://diataxis.fr/"
      },
      {
        "title": "Google developer documentation style guide",
        "url": "https://developers.google.com/style"
      },
      {
        "title": "OpenAPI Specification",
        "url": "https://spec.openapis.org/oas/latest.html"
      },
      {
        "title": "Principles behind the Agile Manifesto (working software, sustainable pace)",
        "url": "https://agilemanifesto.org/principles.html"
      },
      {
        "title": "ISO/IEC 25010, Maintainability: analysability",
        "url": "https://iso25000.com/index.php/en/iso-25000-standards/iso-25010"
      },
      {
        "title": "lychee link checker",
        "url": "https://lychee.cli.rs/"
      },
      {
        "title": "MkDocs: strict builds and configuration",
        "url": "https://www.mkdocs.org/user-guide/configuration/"
      }
    ],
    "templateParams": [
      {
        "key": "DECISIONS",
        "title": "Decisions",
        "label": "Where are architecture decisions recorded?",
        "hint": "A decision that is not written down is re-argued at every change. Where the record lives decides who reads it, who reviews it, and whether anything checks that it is still true.",
        "defaultValue": "adr-repo",
        "options": [
          {
            "value": "adr-repo",
            "label": "decision records as files in the repository",
            "description": "One Markdown file per decision in the repository, in the Nygard or MADR format (status, date, context, decision, consequences), reviewed in the pull request with the code that implements it. Pick it when the people who need the decisions are the people who open the repository, and you want the record versioned and reviewed like code."
          },
          {
            "value": "model",
            "label": "decisions in an architecture model next to the code",
            "description": "Decisions live in an architecture model kept in the repository (a radical.tools Markdown folder, or Structurizr DSL with its ADR tooling), each linked to the elements it constrains and to the requirements and checks behind it, and a CI job checks the model. Pick it when you already keep a C4 model or want decisions, diagrams and requirements to be one connected thing rather than three folders."
          },
          {
            "value": "wiki",
            "label": "a decision log in a wiki or document space",
            "description": "Decisions are pages in Confluence, Notion or a similar space, from one template, with an index page per system and a link from the repository. Pick it when most readers (product, operations, architecture board, auditors) never open a repository and need to find and comment on decisions where they already work."
          }
        ]
      },
      {
        "key": "API_DOCS",
        "title": "API reference",
        "label": "How is the API documented?",
        "hint": "Generated reference is always current but says what, never why; a written guide explains, but goes stale unless its examples are run.",
        "defaultValue": "generated",
        "options": [
          {
            "value": "generated",
            "label": "generated from the code or the contract on every build",
            "description": "OpenAPI from annotations or an OpenAPI file as the source of truth; TSDoc, Javadoc or docstrings rendered by TypeDoc, Javadoc or Sphinx; published as a site on every release, with a check that the published contract and the running code agree. Pick it for any API other teams or customers call."
          },
          {
            "value": "written",
            "label": "a hand-written guide in the repository, with examples run by tests",
            "description": "A guide written for readers (how to authenticate, the three calls that matter, the error model), kept next to the code, whose code examples are executed in CI (doctests, executed Markdown snippets). Pick it for a library or SDK where a tutorial beats a reference, and someone owns the text."
          },
          {
            "value": "none",
            "label": "no public API; internal types documented in code only",
            "description": "Nothing outside the team calls the element; its types and functions carry doc comments and nothing is published. Pick it for a web app or a batch job with no callers, so that no one builds a reference nobody reads."
          }
        ]
      },
      {
        "key": "READMES",
        "title": "READMEs",
        "label": "Where does a newcomer read how to run and test a module?",
        "hint": "The README is read more than any other page; what it must say decides whether a new person runs the module on day one or asks.",
        "defaultValue": "per-module",
        "options": [
          {
            "value": "per-module",
            "label": "a README in every package, module or service",
            "description": "Every package, module or service directory holds a README with the same sections (purpose, how to run, how to test, who owns it), and a check fails when one is missing or a section is absent. Pick it for a monorepo or any repository with more than one deployable or publishable unit."
          },
          {
            "value": "root-only",
            "label": "one README at the repository root",
            "description": "One README at the root explains the whole repository and holds a table of its modules with a line of purpose and an owner each. Pick it for a single-purpose repository where per-module READMEs would repeat the same text."
          }
        ]
      },
      {
        "key": "DOCS_SITE",
        "title": "Documentation",
        "label": "Where is the longer documentation kept and published?",
        "hint": "Documentation that lives in the repository is reviewed and built with the code and can fail the build on a broken link; documentation outside it reaches more readers but nothing checks it.",
        "defaultValue": "docs-as-code",
        "options": [
          {
            "value": "docs-as-code",
            "label": "docs as code in the repository, built and published in CI",
            "description": "Markdown or AsciiDoc in the repository, organised by Diátaxis (tutorials, how-to guides, reference, explanation), built by Docusaurus, MkDocs or Antora on every pull request and published on merge; a broken link or a warning fails the build. Pick it when the writers are the developers and the readers are developers or operators."
          },
          {
            "value": "external",
            "label": "kept and published outside the repository",
            "description": "Documentation lives in Confluence, Notion, GitBook or a help-centre product, written by people who do not work in the repository, with a link from the README and the version it describes on each page. Pick it when technical writers or support own the documentation, or the readers are end users."
          }
        ]
      },
      {
        "key": "DIAGRAMS",
        "title": "Diagrams",
        "label": "How are the architecture diagrams kept?",
        "hint": "A diagram drawn once is out of date after the next merge; a diagram rendered from a model or from text in the repository changes in the pull request that changes the system.",
        "defaultValue": "model",
        "options": [
          {
            "value": "model",
            "label": "rendered from a model or diagram-as-code in the repository",
            "description": "Diagrams are rendered from a model or text kept in the repository (radical.tools, Structurizr DSL, PlantUML with C4-PlantUML, Mermaid) and reviewed in the pull request with the change they show. Pick it by default: the diagram is a diff, and a check can tell when code changed and the diagram did not."
          },
          {
            "value": "images",
            "label": "hand-drawn images, dated, in the docs folder",
            "description": "Diagrams are drawn in draw.io, Excalidraw or on a whiteboard and kept as images in the docs folder, each with its date, author and editable source file next to it. Pick it for a small system with one or two diagrams, or sketches whose value is the conversation, not the record."
          }
        ]
      },
      {
        "key": "ADR_DAYS",
        "label": "Within how many days of being made must a decision be recorded?",
        "defaultValue": "14",
        "type": "number"
      },
      {
        "key": "ADR_DIR",
        "label": "Which directory holds the decision records?",
        "defaultValue": "docs/adr"
      },
      {
        "key": "MODEL_DIR",
        "label": "Which folder holds the architecture model?",
        "defaultValue": "architecture"
      },
      {
        "key": "README_SECTIONS",
        "label": "Which sections must every README have?",
        "defaultValue": "Purpose, Run, Test, Owner"
      },
      {
        "key": "DOC_COMMENT_COVERAGE_PCT",
        "label": "What share of the public API must carry doc comments (%)?",
        "defaultValue": "90",
        "type": "number"
      },
      {
        "key": "LINK_CHECK_MINUTES",
        "label": "Within how many minutes must the documentation build, link check included, finish?",
        "defaultValue": "5",
        "type": "number"
      },
      {
        "key": "MAX_DOC_AGE_DAYS",
        "label": "After how many days without review is a documentation page stale?",
        "defaultValue": "365",
        "type": "number"
      }
    ]
  },
  "nodes": [
    {
      "id": "need",
      "type": "need",
      "label": "The element can be understood without asking",
      "x": 0,
      "y": 0,
      "kind": "brief",
      "source": "Hub concern pack: Code documentation",
      "description": "People who did not write the element have to change it, run it and reason about it: a new team member, an on-call engineer at night, a reviewer in another team, the author a year later. They need to find why it is built the way it is, what it offers to its callers, how to run and test each part, and how its parts fit together, and what they find has to be true today, not when it was written. ISO 25010 calls this analysability; in practice it is the difference between a change that takes an afternoon and one that takes a week of archaeology."
    },
    {
      "id": "req-adr-recorded",
      "type": "requirement",
      "label": "Significant decisions are recorded",
      "x": 260,
      "y": 0,
      "ears_type": "event-driven",
      "trigger": "an architecturally significant decision is made (a new or removed dependency, external service or data store, a protocol or format other systems rely on, a security or data-handling choice, or going against an earlier decision)",
      "action": "record it within {{ADR_DAYS}} days as one decision record with a title, status, date, context, decision and consequences, in: {{DECISIONS}}",
      "rationale": "A decision that is not written down is re-argued at every change or reversed without anyone noticing; the fields are the minimum that lets a later reader judge whether the context still holds (Nygard, Documenting Architecture Decisions; MADR)."
    },
    {
      "id": "req-adr-supersede",
      "type": "requirement",
      "label": "Superseded decisions link forward",
      "x": 260,
      "y": 130,
      "ears_type": "event-driven",
      "trigger": "a new decision replaces or amends an earlier one",
      "action": "mark the earlier record as superseded with a link to the new one, link the new one back, and never delete or rewrite the earlier record",
      "rationale": "The old record explains code that is still there; a reader who finds it must be sent to the current decision, and a reader of the new one must see what it replaced (Nygard: records are immutable, status superseded)."
    },
    {
      "id": "req-adr-with-code",
      "type": "requirement",
      "label": "Decision reviewed with its code",
      "x": 260,
      "y": 260,
      "ears_type": "ubiquitous",
      "action": "keep the decision record in the repository and change it in the same pull request as the first code that implements the decision, so that the reviewer of the code reviews the decision",
      "rationale": "A decision reviewed with its code gets the same scrutiny as the code and is versioned with it; one reviewed elsewhere is approved by people who do not see what it costs (Nygard; Write the Docs, Docs as Code).",
      "hubWhen": {
        "DECISIONS": [
          "adr-repo",
          "model"
        ]
      }
    },
    {
      "id": "req-adr-linked",
      "type": "requirement",
      "label": "Decisions linked to what they constrain",
      "x": 260,
      "y": 390,
      "ears_type": "ubiquitous",
      "action": "link every decision in the model to at least one element it constrains and, where one exists, to the automated check that enforces it, and fail the CI check on a decision without status, date or a constrained element",
      "rationale": "In a model a decision is only useful if a reader of an element can reach it from that element; an unlinked decision is a file in a different folder with extra steps (C4 model; radical check rules on decisions).",
      "hubWhen": {
        "DECISIONS": [
          "model"
        ]
      }
    },
    {
      "id": "req-adr-wiki-index",
      "type": "requirement",
      "label": "Decision log is findable from the code",
      "x": 260,
      "y": 520,
      "ears_type": "ubiquitous",
      "action": "keep one decision log index page per system listing every decision with its status and date, make every decision page from the same template, and link the index from the repository README and from the code that implements a decision",
      "rationale": "Pages outside the repository are found only through links; without an index and a link from the code, the log is what the person who wrote it remembers (Nygard; Google developer documentation style guide on navigation).",
      "hubWhen": {
        "DECISIONS": [
          "wiki"
        ]
      }
    },
    {
      "id": "req-api-regenerated",
      "type": "requirement",
      "label": "API reference regenerated and in sync",
      "x": 260,
      "y": 650,
      "ears_type": "event-driven",
      "trigger": "a release is built",
      "action": "regenerate the API reference from the code or the contract and publish it with the release version, and fail the build when the published contract and the specification generated from the running code differ in any operation, parameter, field or status code",
      "rationale": "A generated reference is only as current as its last build, and a contract file that drifts from the code documents an API that does not exist (OpenAPI Specification; Fowler, the contract as a source of truth in concern API evolution).",
      "hubWhen": {
        "API_DOCS": [
          "generated"
        ]
      }
    },
    {
      "id": "req-doc-comments",
      "type": "requirement",
      "label": "Public API carries doc comments",
      "x": 260,
      "y": 780,
      "ears_type": "ubiquitous",
      "action": "carry a doc comment with a one-line summary and every parameter and return value on at least {{DOC_COMMENT_COVERAGE_PCT}}% of exported or public symbols, measured on each pull request",
      "rationale": "The reference is generated from the comments, and a symbol without one is a blank page; a threshold on the whole keeps the gate from blocking every typo (Google developer documentation style guide on API reference comments; ISO 25010 analysability).",
      "hubWhen": {
        "API_DOCS": [
          "generated",
          "written"
        ]
      }
    },
    {
      "id": "req-examples-run",
      "type": "requirement",
      "label": "Examples in the docs are executed",
      "x": 260,
      "y": 910,
      "ears_type": "ubiquitous",
      "action": "execute every code example in the API guide as a test on each pull request, and fail the build when an example does not compile, raises, or prints something other than what the guide shows",
      "rationale": "A written guide stays true only if its examples are run; an example that nobody runs is the first thing to break and the last to be noticed (Write the Docs, Docs as Code; Python doctest).",
      "hubWhen": {
        "API_DOCS": [
          "written"
        ]
      }
    },
    {
      "id": "req-readme-per-module",
      "type": "requirement",
      "label": "Every module has its README",
      "x": 260,
      "y": 1040,
      "ears_type": "ubiquitous",
      "action": "hold a README.md in every package, module or service directory with the sections {{README_SECTIONS}}, and fail the build when a directory lacks the file or a section",
      "rationale": "The README is the page read first and most; the same sections everywhere let a newcomer run and test any module without asking who owns it (Google developer documentation style guide; Write the Docs on READMEs).",
      "hubWhen": {
        "READMES": [
          "per-module"
        ]
      }
    },
    {
      "id": "req-readme-root",
      "type": "requirement",
      "label": "Root README lists every module",
      "x": 260,
      "y": 1170,
      "ears_type": "ubiquitous",
      "action": "hold in the root README a table with one row per module naming its purpose, how to run and test it, and its owner, and fail the build when a module directory has no row",
      "rationale": "With one README, the table is the only place a newcomer learns what a directory is for and who to ask; a module missing from it is invisible (Google developer documentation style guide).",
      "hubWhen": {
        "READMES": [
          "root-only"
        ]
      }
    },
    {
      "id": "req-links",
      "type": "requirement",
      "label": "Broken links fail the docs build",
      "x": 260,
      "y": 1300,
      "ears_type": "unwanted-behaviour",
      "unwanted_condition": "a page of the documentation holds a link to a page, anchor or URL that does not resolve, or the site generator reports a warning",
      "action": "fail the documentation build on the pull request, naming the page and the link, within {{LINK_CHECK_MINUTES}} minutes",
      "rationale": "A broken link is the reader's first sign that nobody maintains the page; a build that fails on one keeps the whole site trustworthy at the cost of one fix per pull request (Write the Docs, Docs as Code; lychee).",
      "hubWhen": {
        "DOCS_SITE": [
          "docs-as-code"
        ]
      }
    },
    {
      "id": "req-external-versioned",
      "type": "requirement",
      "label": "External docs name their version",
      "x": 260,
      "y": 1430,
      "ears_type": "ubiquitous",
      "action": "link the documentation space from the repository README, state on every page the release it describes, and update the pages for a release before the release is announced",
      "rationale": "Documentation outside the repository is not built with the code, so the only guard against describing a version that no longer runs is naming the version on the page (Google developer documentation style guide on versioned documentation).",
      "hubWhen": {
        "DOCS_SITE": [
          "external"
        ]
      }
    },
    {
      "id": "req-doc-owner",
      "type": "requirement",
      "label": "Pages have an owner and a review date",
      "x": 260,
      "y": 1560,
      "ears_type": "state-driven",
      "precondition": "a documentation page (a guide, a README, a decision log index or a diagram page) has a review date older than {{MAX_DOC_AGE_DAYS}} days or no owner",
      "action": "list it in the stale-page report, tell its owner (or the team when it has none), and remove or re-date it within 30 days",
      "rationale": "A page nobody owns is a page nobody updates; a review date makes \"is this still true?\" a question with an answer instead of a guess (Google developer documentation style guide; Write the Docs on documentation maintenance)."
    },
    {
      "id": "req-diagram-same-pr",
      "type": "requirement",
      "label": "Diagrams change with the code",
      "x": 260,
      "y": 1690,
      "ears_type": "event-driven",
      "trigger": "a pull request changes the structure of a diagrammed module (a new or removed container, component, dependency between modules, data store or external call)",
      "action": "change the model or diagram source in the same pull request, and fail the check when the source under a diagrammed module changes structure and the model folder {{MODEL_DIR}} does not change",
      "rationale": "A diagram kept as text or a model is a diff; the pull request that changes the system is the one moment the author knows what changed (Simon Brown, C4 model and diagrams as code).",
      "hubWhen": {
        "DIAGRAMS": [
          "model"
        ]
      }
    },
    {
      "id": "req-diagram-dated",
      "type": "requirement",
      "label": "Image diagrams are dated with their source",
      "x": 260,
      "y": 1820,
      "ears_type": "ubiquitous",
      "action": "keep every diagram image in the docs folder with its date and author in the caption, its editable source file (.drawio, .excalidraw) next to it, and a diagram older than {{MAX_DOC_AGE_DAYS}} days reviewed or removed",
      "rationale": "An image cannot be diffed, so the date tells a reader how far to trust it and the source file lets the next person change it instead of redrawing (Simon Brown, C4 model: notation and dating of diagrams).",
      "hubWhen": {
        "DIAGRAMS": [
          "images"
        ]
      }
    },
    {
      "id": "sc-adr-recorded",
      "type": "scenario",
      "label": "Decision gets a record",
      "x": 520,
      "y": 0,
      "given": "a pull request that adds a dependency on a new external service",
      "when": "it is reviewed",
      "then": "a decision record with title, status, date, context, decision and consequences exists for it, dated within {{ADR_DAYS}} days of the decision"
    },
    {
      "id": "sc-adr-supersede",
      "type": "scenario",
      "label": "Old decision points to the new",
      "x": 520,
      "y": 130,
      "given": "an accepted decision record",
      "when": "a new decision replaces it",
      "then": "the old record reads superseded and links to the new one, the new one links back, and the old text is unchanged"
    },
    {
      "id": "sc-adr-with-code",
      "type": "scenario",
      "label": "Decision and code in one pull request",
      "x": 520,
      "y": 260,
      "given": "a change that implements a new decision",
      "when": "its pull request is opened",
      "then": "the diff holds both the decision record and the code, and the record is not merged ahead of the code",
      "hubWhen": {
        "DECISIONS": [
          "adr-repo",
          "model"
        ]
      }
    },
    {
      "id": "sc-adr-linked",
      "type": "scenario",
      "label": "Unlinked decision fails the check",
      "x": 520,
      "y": 390,
      "given": "the architecture model with a decision linked to no element",
      "when": "the CI check runs",
      "then": "it fails naming the decision, and passes once the decision constrains an element",
      "hubWhen": {
        "DECISIONS": [
          "model"
        ]
      }
    },
    {
      "id": "sc-adr-wiki-index",
      "type": "scenario",
      "label": "Decision reached from the code",
      "x": 520,
      "y": 520,
      "given": "a module that implements a decision",
      "when": "a developer opens its README and follows the link",
      "then": "the decision log index lists the decision with status and date, and its page follows the template",
      "hubWhen": {
        "DECISIONS": [
          "wiki"
        ]
      }
    },
    {
      "id": "sc-api-regenerated",
      "type": "scenario",
      "label": "Drift fails the release",
      "x": 520,
      "y": 650,
      "given": "a contract file and code that adds a response field without updating it",
      "when": "the release is built",
      "then": "the drift check fails naming the field, and passes once contract and code agree",
      "hubWhen": {
        "API_DOCS": [
          "generated"
        ]
      }
    },
    {
      "id": "sc-doc-comments",
      "type": "scenario",
      "label": "Undocumented export refused",
      "x": 520,
      "y": 780,
      "given": "a pull request exporting a new function without a doc comment",
      "when": "the lint and coverage step runs",
      "then": "the step fails when coverage falls below {{DOC_COMMENT_COVERAGE_PCT}}%, and names the function",
      "hubWhen": {
        "API_DOCS": [
          "generated",
          "written"
        ]
      }
    },
    {
      "id": "sc-examples-run",
      "type": "scenario",
      "label": "Broken example fails the build",
      "x": 520,
      "y": 910,
      "given": "a guide whose example calls a function that was renamed",
      "when": "the pull request runs its tests",
      "then": "the example test fails naming the guide and the line",
      "hubWhen": {
        "API_DOCS": [
          "written"
        ]
      }
    },
    {
      "id": "sc-readme-per-module",
      "type": "scenario",
      "label": "Module without README fails",
      "x": 520,
      "y": 1040,
      "given": "a new package directory added without a README.md",
      "when": "the build runs",
      "then": "the README check fails naming the directory, and passes once the file holds {{README_SECTIONS}}",
      "hubWhen": {
        "READMES": [
          "per-module"
        ]
      }
    },
    {
      "id": "sc-readme-root",
      "type": "scenario",
      "label": "Unlisted module fails",
      "x": 520,
      "y": 1170,
      "given": "a new module directory not in the root README table",
      "when": "the build runs",
      "then": "the README check fails naming the directory",
      "hubWhen": {
        "READMES": [
          "root-only"
        ]
      }
    },
    {
      "id": "sc-links",
      "type": "scenario",
      "label": "Broken link stops the merge",
      "x": 520,
      "y": 1300,
      "given": "a pull request that renames a page other pages link to",
      "when": "the documentation build runs",
      "then": "it fails within {{LINK_CHECK_MINUTES}} minutes naming each page with a broken link",
      "hubWhen": {
        "DOCS_SITE": [
          "docs-as-code"
        ]
      }
    },
    {
