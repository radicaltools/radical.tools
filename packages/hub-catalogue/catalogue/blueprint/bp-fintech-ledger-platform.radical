    {
      "id": "req-balanced-entry-enforcement",
      "type": "requirement",
      "label": "Balanced Entry Enforcement",
      "x": 0,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "unwanted-behaviour",
      "status": "draft",
      "priority": "must",
      "unwanted_condition": "a journal entry's debits and credits do not sum to zero",
      "action": "reject the entry at the posting API and never persist it to the journal",
      "rationale": "An unbalanced entry that reaches the journal is no longer a bug that can be fixed — it's a permanent, immutable fact the books now have to carry."
    },
    {
      "id": "req-reconciliation-freshness",
      "type": "requirement",
      "label": "Reconciliation Freshness",
      "x": 320,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "match at least 99.5% of settlement events against journal entries within {{RECONCILIATION_LAG_MIN}} minutes of receipt",
      "rationale": "The faster a mismatch surfaces, the more context — logs, the originating request, the person who can explain it — is still around to resolve it.",
      "templateParams": [
        {
          "key": "RECONCILIATION_LAG_MIN",
          "label": "Reconciliation freshness (minutes)",
          "hint": "15",
          "type": "number",
          "defaultValue": "15"
        }
      ]
    },
    {
      "id": "req-statement-accuracy-cutoff",
      "type": "requirement",
      "label": "Statement Accuracy Cutoff",
      "x": 640,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "ubiquitous",
      "status": "draft",
      "priority": "must",
      "action": "generate each customer's statement strictly from balances as replayed through a fixed cutoff timestamp, delivered within {{STATEMENT_GENERATION_HOURS}} hours of period close",
      "rationale": "A statement that mixes balances from different points in time is not wrong by a little — it's internally inconsistent, and inconsistency is what erodes trust in a financial record fastest.",
      "templateParams": [
        {
          "key": "STATEMENT_GENERATION_HOURS",
          "label": "Statement generation SLA (hours)",
          "hint": "24",
          "type": "number",
          "defaultValue": "24"
        }
      ]
    },
    {
      "id": "req-dispute-investigation-sla",
      "type": "requirement",
      "label": "Dispute Investigation SLA",
      "x": 960,
      "y": 1540,
      "width": 260,
      "height": 80,
      "collapsed": false,
      "ears_type": "event-driven",
      "status": "draft",
      "priority": "must",
      "trigger": "a customer disputes a transaction on their statement",
      "action": "open an investigation and provide a resolution or explanation within {{DISPUTE_INVESTIGATION_DAYS}} days",
      "rationale": "An open-ended dispute process is indistinguishable from an ignored one, both to the customer and to a regulator asking to see the process.",
      "templateParams": [
        {
          "key": "DISPUTE_INVESTIGATION_DAYS",
          "label": "Dispute investigation SLA (days)",
          "hint": "10",
          "type": "number",
          "defaultValue": "10"
        }
      ]
    },
    {
      "id": "ff-settlement-backlog-guard",
      "type": "fitness-fn",
      "label": "Settlement Backlog Guard",
      "description": "Watches how many inbound settlement events are waiting to be matched, and for how long.",
      "x": 0,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "operational",
      "automated": true,
      "trigger": "continuous",
      "threshold": "Unmatched settlement events never exceed 100 items or 1 hour of age, whichever triggers first",
      "status": "proposed"
    },
    {
      "id": "ff-manual-adjustment-rate-guard",
      "type": "fitness-fn",
      "label": "Manual Adjustment Rate Guard",
      "description": "Tracks compensating entries as a share of total postings — a rising rate signals an upstream posting defect, not just a one-off correction.",
      "x": 320,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "process",
      "automated": true,
      "trigger": "periodic",
      "threshold": "Compensating entries stay below {{MAX_ADJUSTMENT_RATE_PCT}}% of total posted entries per month",
      "status": "proposed"
    },
    {
      "id": "ff-regulatory-report-timeliness",
      "type": "fitness-fn",
      "label": "Regulatory Report Timeliness",
      "description": "Confirms scheduled compliance extracts reach the regulator by their filing deadline.",
      "x": 640,
      "y": 1740,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "category": "process",
      "automated": true,
      "trigger": "periodic",
      "threshold": "Scheduled compliance extracts are delivered by their filing deadline, 100% of cycles",
      "status": "proposed"
    },
    {
      "id": "adr-suspense-account-for-unmatched",
      "type": "adr",
      "label": "ADR: Suspense account for unmatched settlements",
      "x": 0,
      "y": 1912,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "status": "accepted",
      "date": "",
      "context": "Some inbound settlement events won't match any known journal entry — timing differences, partial data, a bank-side correction. Reconciliation has to do something with the amount, not just log a warning.",
      "decision": "Post unmatched amounts to a suspense account visible on the trial balance, rather than discarding them or blocking the pipeline.",
      "consequences": "Money is never silently lost from the books, and the suspense balance itself becomes a visible health metric; Finance Ops must actively clear suspense entries, or the account grows unbounded and stops meaning anything.",
      "alternatives": "1. Drop or log unmatched events — fastest, but money can effectively vanish from the books. 2. Block the whole reconciliation pipeline until matched — safest for correctness, but one bad event halts all reconciliation. 3. Suspense account (chosen). 4. Best-effort fuzzy matching with auto-accept — risks matching the wrong entry, corrupting two accounts instead of flagging one."
    },
    {
      "id": "adr-ledger-as-system-of-record",
      "type": "adr",
      "label": "ADR: Ledger is the system of record, not the bank feed",
      "x": 320,
      "y": 1912,
      "width": 260,
      "height": 52,
      "collapsed": false,
      "status": "accepted",
      "date": "",
      "context": "The internal journal must remain authoritative for customer-facing balances even though the bank or processor also keeps its own records of the same money movement.",
      "decision": "The internal journal is the source of truth for what the product shows the customer; the bank feed is an input reconciled against it, not the other way round.",
      "consequences": "A balance can update the instant a posting is accepted, before the bank settles — which means \"posted\" and \"reconciled\" must be visibly different states, or a customer or support agent will confuse a provisional balance with a settled one.",
      "alternatives": "1. Bank/processor as source of truth, product waits for their confirmation — correct by construction, but the customer's balance now lags the actual action by the settlement delay. 2. Internal ledger as source of truth (chosen). 3. Dual-write both, resolve conflicts on read — no clear authority, hardest of the three to reason about when they disagree."
    },
