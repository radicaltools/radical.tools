  "sequences": [
    {
      "id": "bp-fintech-ledger-platform-seq",
      "name": "Settlement arrives, posts, and reconciles",
      "relationIds": [
        "bank-rail--settlement-events",
        "settlement-events--posting-api",
        "posting-api--journal-store",
        "balance-projector--journal-store",
        "balance-projector--balance-store",
        "reconciliation-worker--journal-store",
        "reconciliation-worker--bank-rail"
      ],
      "stepDescriptions": [
        "Bank / payment rail delivers a settlement webhook.",
        "Settlement event triggers posting of the now-confirmed transaction.",
        "Posting API checks the entry balances and appends it to the journal.",
        "Balance projector picks up the new entry from its subscription to the journal.",
        "Balance projector updates the affected accounts' balance — the customer sees the new balance immediately.",
        "Reconciliation worker independently reads posted entries from the journal.",
        "Reconciliation worker also fetches the bank's own end-of-day statement in a nightly batch and matches it against what was posted, catching anything the event stream alone would have missed."
      ]
    },
    {
      "id": "seq-flow-customer",
      "name": "Customer journey",
      "relationIds": [
        "mockup-accounts-overview--mockup-statement",
        "mockup-statement--mockup-transaction-detail",
        "mockup-transaction-detail--mockup-dispute",
        "mockup-dispute--mockup-dispute-status"
      ],
      "stepDescriptions": [
        "View statements → Account Statement. Customer statement generated strictly from balances replayed through a fixed cut-off; each line links to a dispute.",
        "Open transaction → Transaction Detail. One statement line with its settlement status and the journal entry behind it.",
        "Dispute → Dispute a Transaction. Opens an investigation the moment it is submitted; the customer gets a resolution or explanation within {{DISPUTE_INVESTIGATION_DAYS}} days.",
        "Submit dispute → Dispute Status. Open dispute with the time left until the {{DISPUTE_INVESTIGATION_DAYS}}-day resolution deadline."
      ]
    },
    {
      "id": "seq-flow-finance-ops",
      "name": "Finance Ops journey",
      "relationIds": [
        "mockup-reconciliation-exceptions--mockup-exception-detail",
        "mockup-exception-detail--mockup-compensating-entry",
        "mockup-compensating-entry--mockup-entry-approval",
        "mockup-entry-approval--mockup-journal-entry",
        "mockup-journal-entry--mockup-reconciliation-exceptions",
        "mockup-exception-detail--mockup-reconciliation-exceptions"
      ],
      "stepDescriptions": [
        "Open exception → Exception Detail. Settlement event next to candidate journal entries; a manual match or a compensating entry clears it.",
        "Compensating entry → Compensating Entry. Double-entry form that cannot be submitted unless debits equal credits.",
        "Submit for approval → Four-Eyes Approval. A second person approves before the entry is posted; nobody approves their own entries.",
        "Approve & post → Journal Entry. Posted entries are immutable; the only correction is another entry.",
        "Exception cleared → Reconciliation Exceptions. Finance Ops queue of settlement events not matched within {{RECONCILIATION_LAG_MIN}} minutes.",
        "Confirm match → Reconciliation Exceptions. Finance Ops queue of settlement events not matched within {{RECONCILIATION_LAG_MIN}} minutes."
      ]
    },
    {
      "id": "seq-flow-compliance",
      "name": "Compliance journey",
      "relationIds": [
        "mockup-audit-trail--mockup-regulatory-reports"
      ],
      "stepDescriptions": [
        "Reports → Regulatory Reports. Scheduled regulatory extracts built from the journal at a fixed cut-off, signed off by Compliance."
      ]
    }
  ],
