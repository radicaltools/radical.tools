\n  <text x=\"16\" y=\"244\" font-size=\"8\" fill=\"#666\">We'll open an investigation right away and reply within the investigation window.</text>\n  <rect x=\"16\" y=\"258\" width=\"90\" height=\"20\" rx=\"3\" fill=\"#fff\" stroke=\"#999\"/>\n  <text x=\"61.0\" y=\"271.0\" font-size=\"9\" fill=\"#333\" font-weight=\"bold\" text-anchor=\"middle\">Cancel</text>\n  <rect x=\"264\" y=\"258\" width=\"120\" height=\"20\" rx=\"3\" fill=\"#2563eb\" stroke=\"#2563eb\"/>\n  <text x=\"324.0\" y=\"271.0\" font-size=\"9\" fill=\"#fff\" font-weight=\"bold\" text-anchor=\"middle\">Submit dispute</text>\n</svg>"
