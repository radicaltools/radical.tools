{
  "hub": {
    "id": "ff-startup-shutdown-check",
    "category": "fitness-function",
    "name": "Startup & Shutdown Verification",
    "description": "Automatically verifies every service becomes ready within its startup budget and, on SIGTERM, drains in-flight requests within its shutdown budget instead of being killed mid-request — checked on every deploy, not assumed.",
    "tags": [
      "operational",
      "disposability",
      "kubernetes",
      "deployment"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "templateParams": [
      {
        "key": "STARTUP_SECONDS",
        "label": "Max time to become ready (s)",
        "hint": "10",
        "type": "number",
        "defaultValue": "10"
      },
      {
        "key": "DRAIN_TIMEOUT_SECONDS",
        "label": "Graceful shutdown drain timeout (s)",
        "hint": "30",
        "type": "number",
        "defaultValue": "30"
      }
    ],
    "hubRefs": [
      "req-fast-startup-graceful-shutdown",
      "req-zero-downtime-deploy"
    ]
  },
  "nodes": [
