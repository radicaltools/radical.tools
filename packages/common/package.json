    "./hubFormat": "./src/hubFormat.ts",
    "./hubViews": "./src/hubViews.ts",
    "./hubImport": "./src/hubImport.ts",
    "./wireframe": "./src/wireframe.ts",
    "./formats/structurizrDsl": "./src/formats/structurizrDsl.ts",
    "./formats/mdFolder": "./src/formats/mdFolder.ts",
    "./formats/mdFolderSync": "./src/formats/mdFolderSync.ts",
    "./formats/canvasSelection": "./src/formats/canvasSelection.ts",
    "./formats/exportGherkin": "./src/formats/exportGherkin.ts",
    "./ai/queryLanguage": "./src/ai/queryLanguage.ts",
    "./ai/diagramFacade": "./src/ai/diagramFacade.ts",
    "./ai/modelFacade": "./src/ai/modelFacade.ts",
    "./ai/metamodelContext": "./src/ai/metamodelContext.ts",
    "./ai/systemPrompt": "./src/ai/systemPrompt.ts",
    "./ai/tools": "./src/ai/tools/index.ts",
    "./ai/forge": "./src/ai/forge/index.ts"
