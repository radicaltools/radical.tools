{
  "name": "@radical/markdown",
  "version": "0.0.0",
  "private": true,
  "description": "Markdownlint defaults with type-specific rules, optional frontmatter schemas, and editor-independent diagnostics.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "homepage": "https://github.com/radicaltools/radical.tools/tree/main/packages/markdown",
  "repository": {
    "type": "git",
    "url": "https://github.com/radicaltools/radical.tools.git",
    "directory": "packages/markdown"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "npm run build && node examples/validate.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "ajv": "^8.20.0",
    "markdownlint": "^0.40.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
