      ],
      "stepDescriptions": [
        "PlaceOrder command arrives.",
        "Aggregate is rehydrated; OrderPlaced is appended.",
        "Projector receives OrderPlaced from its subscription.",
        "Order summary view is updated.",
        "User requests the order summary.",
        "View is returned; may lag the write by milliseconds."
      ]
    }
  ],
