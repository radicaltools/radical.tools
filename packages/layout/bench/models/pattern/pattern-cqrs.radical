      "technology": "SQL / HTTP"
    },
    {
      "id": "user--query-api",
      "sourceId": "user",
      "targetId": "query-api",
      "label": "Queries order views",
      "technology": "HTTPS / JSON"
    },
    {
      "id": "query-api--read-store",
      "sourceId": "query-api",
      "targetId": "read-store",
      "label": "Reads",
      "technology": "SQL / HTTP"
    }
  ],
  "sequences": [
    {
      "id": "pattern-cqrs-seq",
      "name": "Place order and read it back",
      "relationIds": [
        "user--command-api",
        "command-api--event-store",
        "projector--event-store",
        "projector--read-store",
        "user--query-api",
