{
  "hub": {
    "id": "pattern-cqrs",
    "category": "pattern",
    "name": "CQRS with Event Sourcing",
    "description": "Commands are validated by the write model and stored as an append-only stream of events; projections turn those events into read models shaped for each query. Writes and reads scale and evolve independently.",
    "tags": [
      "cqrs",
      "event-sourcing",
      "ddd",
      "read-model"
    ],
    "requiredMetamodel": "c4-ddd-governance-builtin",
    "hubRefs": [
      "pattern-event-driven",
      "req-idempotency",
      "adr-data-store",
      "pattern-saga",
      "adr-data-consistency-model"
    ]
  },
  "nodes": [
    {
      "id": "user",
      "type": "person",
      "label": "User",
      "description": "Issues commands and views results.",
      "x": 0,
      "y": 0,
      "width": 150,
      "height": 170,
      "collapsed": false
    },
    {
      "id": "platform",
      "type": "system",
      "label": "Order Management",
      "description": "Separate write and read paths.",
      "x": 0,
      "y": 270,
      "width": 930,
      "height": 580,
      "collapsed": false
    },
    {
      "id": "command-api",
      "type": "container",
      "label": "Command API",
      "description": "Loads the aggregate from its event stream, validates the command against invariants, appends new events.",
      "technology": "C# / .NET",
      "parentId": "platform",
      "x": 30,
      "y": 110,
      "width": 300,
      "height": 200,
      "collapsed": false
    },
    {
      "id": "event-store",
      "type": "database",
      "label": "Event Store",
      "description": "Append-only streams per aggregate; the system of record. Supports catch-up subscriptions and replay.",
      "technology": "EventStoreDB",
      "parentId": "platform",
      "x": 370,
      "y": 110,
      "width": 190,
      "height": 130,
      "collapsed": false
    },
    {
      "id": "projector",
      "type": "container",
      "label": "Projector",
      "description": "Subscribes to the event streams and updates read models. Can be reset and replayed from the beginning.",
      "technology": "C# / .NET worker",
      "parentId": "platform",
      "x": 600,
      "y": 110,
      "width": 300,
      "height": 200,
      "collapsed": false
    },
    {
      "id": "query-api",
      "type": "container",
      "label": "Query API",
      "description": "Serves reads straight from the read models. No business rules.",
      "technology": "C# / .NET",
      "parentId": "platform",
      "x": 30,
      "y": 350,
      "width": 300,
      "height": 200,
      "collapsed": false
    },
    {
      "id": "read-store",
      "type": "database",
      "label": "Read Store",
      "description": "Denormalised views: order summaries, customer history, dashboards.",
      "technology": "PostgreSQL / Elasticsearch",
      "parentId": "platform",
      "x": 370,
      "y": 350,
      "width": 190,
      "height": 130,
      "collapsed": false
    }
  ],
  "relations": [
    {
      "id": "user--command-api",
      "sourceId": "user",
