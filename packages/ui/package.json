  "devDependencies": {
    "@types/d3-zoom": "^3.0.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^4.1.4"
