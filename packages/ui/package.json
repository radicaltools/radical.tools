    "./store/userCamera": "./src/store/userCamera.ts",
    "./store/showInView": "./src/store/showInView.ts",
    "./components/Canvas": "./src/components/Canvas.tsx",
    "./components/WikiView": "./src/components/WikiView.tsx",
    "./components/TableView": "./src/components/TableView.tsx",
    "./components/WarnierView": "./src/components/WarnierView.tsx",
    "./components/MarkdownText": "./src/components/MarkdownText.tsx",
    "./components/RightPanel": "./src/components/RightPanel.tsx",
    "./components/SelectionActions": "./src/components/SelectionActions.tsx",
    "./components/propertiesCover": "./src/components/propertiesCover.ts",
    "./components/NotificationHost": "./src/components/NotificationHost.tsx",
    "./components/MilestoneChip": "./src/components/MilestoneChip.tsx",
