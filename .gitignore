node_modules/
dist/
# Test reports for radical check (npm run test:reports, the e2e suite)
reports/
# Test reports that are a fixture's input, not a run's output.
!packages/assay/tests/fixtures/**/reports/
release/
out/
.DS_Store
*.log
.playwright-mcp/

# Visual layout harness output (regenerated locally; large binaries)
packages/layout/tests/visual/out-*.svg
packages/layout/tests/visual/out-*.png

# VS Code extension: the webview is the Studio web build, copied in by
# `npm run bundle-webview -w vscode-radical`; packaged .vsix files are CI artifacts
apps/vscode/webview/
*.vsix

# Editor / OS
.vscode/
.idea/
Thumbs.db

# Terraform local state + credentials (never commit these)
infra/.terraform/
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/terraform.tfstate.*.backup
infra/*.tfvars
infra/tfplan
infra/override.tf
infra/override.tf.json
# Note: infra/.terraform.lock.hcl IS committed (pins provider versions)
# Note: packages/hub-catalogue/catalogue/**/*.radical IS committed — it is the canonical
# concept catalogue served at hub.radical.tools/hub/ (index.json is generated)

# E2E (Playwright) run output; baselines under apps/e2e/tests/__screenshots__ are committed
apps/e2e/test-results/
apps/e2e/playwright-report/
apps/e2e/blob-report/
apps/e2e/all-blob-reports/

# What Studio and radical check keep beside the architecture model (canvas
# selection, Forge run status, test results) in its .state/, and in the
# .radical/ of versions before it; the model itself is committed. Each has a
# .gitignore of its own too.
/.radical/model/.state/
/.radical/model/.radical/

